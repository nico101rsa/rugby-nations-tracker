{
  // rugby-tracker-fans: the full-time pulse (src/pulse.js). Its own Worker,
  // apart from the cron Worker in worker/, so that nothing a fan sends can
  // touch the match-day scheduler. See src/index.js.
  "name": "rugby-tracker-fans",
  "main": "src/index.js",

  // Nico's Cloudflare account: an identifier, not a credential (see the note
  // in worker/wrangler.jsonc).
  "account_id": "997d246130cd10a5c973035bf7ab227c",

  "compatibility_date": "2026-07-25",

  // Served at rugby-tracker-fans.4jc94jpbb7.workers.dev; the app calls it
  // there (src/pulse-client.js in the app repo).
  "workers_dev": true,

  // One Durable Object holding the votes in its own SQLite file. Declared
  // here and created by the deploy: nothing to set up by hand. SQLite-backed
  // classes are the kind the free plan allows.
  "durable_objects": {
    "bindings": [{ "name": "PULSE", "class_name": "PulseStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PulseStore"] }],

  "observability": {
    "enabled": true
  }
}
