    "390": {
      "date": "2026-11-19",
      "edition": "Thursday 19 November",
      "sections": [
        {
          "kicker": "Defensive stand",
          "heading": "Gregor Townsend hails Scotland's defence after Australia 'arm wrestle' at Murrayfield",
          "body": "Scotland head coach Gregor Townsend rated Sunday's 15-12 Nations Championship win over Australia as a defensive high point: \"Defensively, that's one of the best performances I've seen in the last couple of years.\" It followed a heavy defeat by New Zealand in which Scotland failed to score a second-half point. Townsend said keeping the Wallabies out of Scotland's 22 was a lesson learned from that game. The win held only after Scotland's Darcy Graham bundled Australia full-back Tom Wright into touch with the clock in the red."
        },
        {
          "kicker": "Around the world",
          "heading": "Wales beat All Blacks 35-28",
          "body": "England name Furbank, Chessum, Atkinson for All Blacks test."
        }
      ],
      "match": {
        "venue": "Murrayfield, Edinburgh"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-11-19",
      "edition": "Thursday 19 November",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Wales set to recall Wainwright, Carter and Adams for Australia test",
          "body": "Head coach Steve Tandy is weighing changes for Saturday's Australia test after the 35-28 win over New Zealand, WalesOnline reports. Back-rower Aaron Wainwright, who missed that game with a minor leg injury, is expected to start at No. 8 if he comes through training. Lock Ben Carter could replace Adam Beard, who is nursing an apparent shoulder injury. Flyer Josh Adams, left out for his heavy load, looks set to return. Flanker James Botham is due to become a father this week, with Alex Mann starting if he is unavailable."
        },
        {
          "kicker": "Around the world",
          "heading": "Scotland beat Australia 15-12 in Nations Championship",
          "body": "England name Furbank, Chessum, Atkinson for All Blacks test."
