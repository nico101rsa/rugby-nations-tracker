  "digests": {
    "28": {
      "date": "2026-08-11",
      "edition": "Tuesday 11 August",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Fijian forward Saimoni Vunilagi dies in Japan from suspected heatstroke",
          "body": "Fijian rugby is mourning the tragic passing of 26-year-old forward Saimoni Vunilagi in Japan. The former Tokyo Sungoliath back-rower, who recently joined second-division club Kyuden Voltex, died on Friday after collapsing with severe heatstroke symptoms following a training session in Fukuoka, where temperatures reached 35C. His devastated club praised his \"generous spirit and powerful style of play\" as tributes poured in from Japan Rugby League One. The 117-kilogram forward had played in Japan since his professional career began in 2023."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "386": {
      "date": "2026-08-11",
      "edition": "Tuesday 11 August",
      "sections": [
        {
          "kicker": "GLADIATOR ROLE",
          "heading": "Joe Marler confirmed as the first celebrity Gladiator on the BBC",
          "body": "Former England prop Joe Marler is set to transition from the scrum to the small screen after being confirmed as the BBC's first celebrity Gladiator. The 36-year-old, who also took part in Celebrity Traitors, will perform under the moniker 'Mauler' when the show's fourth series begins in 2027. Filming is currently under way in Sheffield, with the former front-rower expected to bring his trademark physicality and humour to the arena. 'Mauler will see you now,' Marler said."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-08-11",
      "edition": "Tuesday 11 August",
      "sections": [
        {
          "kicker": "Form tracker",
          "heading": "France secure consecutive victories to steady their Nations Championship campaign",
          "body": "Les Bleus have established a run of two straight wins following their most recent outing, which was a 42-15 away victory against Japan in the Nations Championship group stage in July. Across their last five matches, France have registered three victories. Head coach Fabien Galthié's side suffered two defeats during that same five-match period as they seek to build consistency ahead of their remaining group fixtures."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-11",
      "edition": "Tuesday 11 August",
      "sections": [
        {
          "kicker": "Concussion lawsuit",
          "heading": "Irish players await High Court ruling as landmark concussion lawsuit remains ongoing",
          "body": "The situation remains unchanged today regarding the landmark rugby brain injury litigation. First reported earlier this month, the legal case remains in the balance as the High Court has yet to issue its formal ruling on the 95 per cent strikeout application. With the courts silent today, the future of this pivotal legal battle — and its potential impact on affected former Irish players — remains unresolved."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-08-11",
      "edition": "Tuesday 11 August",
      "sections": [
        {
          "kicker": "Campaign update",
          "heading": "Italy slide down tournament standings following their heavy defeat against Australia",
          "body": "Italy sit 11th out of 12 teams in the Nations Championship table after three rounds. In their opening three fixtures of this campaign, they have suffered three defeats. The team scored 37 points across those matches. They also conceded 131 points over the same period, leaving them with a points difference of minus 94. Their most recent outing ended in a 10-57 loss to Australia. Looking ahead, Italy suffered a 32-14 home defeat against South Africa when the teams last met in November 2025."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-11",
      "edition": "Tuesday 11 August",
      "sections": [
        {
          "kicker": "Coaching transition",
          "heading": "Dave Butcher gathers Scotland squad at Oriam following Sione Fukofuka’s exit",
          "body": "The national training squad convened at Oriam yesterday under interim head coach Dave Butcher to begin preparations for the WXV series. Butcher stepped up last week after Sione Fukofuka resigned due to family stress, calling it \"the hardest professional decision of my life.\" While a permanent successor has yet to be appointed, the coaching ticket has been reshaped. Assistant Ioan Cunningham departed last week, with Chris Laidlaw and Tom Luke arriving to support Butcher's interim tenure ahead of September's home fixtures."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-11",
      "edition": "Tuesday 11 August",
      "sections": [
        {
          "kicker": "Rankings boost",
          "heading": "Wales return to world top 10 following Australia victory over Japan",
          "body": "Wales have climbed back into the top 10 of the World Rugby rankings for the first time since July 2024 without even playing a match. The rise to a two-year high was triggered by Australia's narrow 35-32 victory over Japan in Osaka. That result docked the Brave Blossoms rating points and dragged them down two places to 12th, allowing Wales to move up into 10th. It provides a minor statistical boost for the national side following their recent 43-0 thrashing by South Africa in Durban."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "460": {
      "date": "2026-08-11",
      "edition": "Tuesday 11 August",
      "sections": [
        {
          "kicker": "Tactical blueprint",
          "heading": "Dave Rennie says Los Pumas exposed the Springboks' kicking game",
          "body": "All Blacks head coach Dave Rennie believes Los Pumas have provided a blueprint on how to disrupt the Springboks. Despite Argentina suffering a narrow 17-10 defeat at Estadio José Amalfitani, Rennie praised the way Felipe Contepomi's men forced the world champions into an arm wrestle and uncharacteristic errors. Rennie noted that \"the Argentinians did a really good job defusing their kicking game\" on Saturday, offering valuable tactical lessons."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "461": {
      "date": "2026-08-11",
      "edition": "Tuesday 11 August",
      "sections": [
        {
          "kicker": "Winning start",
          "heading": "Les Kiss starts Wallabies tenure with narrow victory over Japan in Osaka",
          "body": "The Les Kiss era began with a frantic 35-32 victory in Saturday's opening test against Japan in Osaka, despite lock Miles Amatosero receiving a 20-minute red card. Making his first start, the 24-year-old was sent off before half-time for a high shot on Warner Dearns, leaving Australia temporarily down to 14 men. Despite the setback, the Wallabies crossed for five tries, with captain Harry Wilson praising the squad’s resilience. Kiss acknowledged the sweltering conditions, saying: \"When we had to find a way, we did find a way.\""
        }
      ],
      "match": {
        "venue": "Hanazono Rugby Stadium, Osaka"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-11",
      "edition": "Tuesday 11 August",
      "sections": [
        {
          "kicker": "Heatstroke tragedy",
          "heading": "Kyuden Voltex back-rower Saimoni Vunilagi dies of suspected heatstroke in Fukuoka",
          "body": "Japanese rugby is in mourning after Kyuden Voltex back-rower Saimoni Vunilagi passed away on Friday of suspected heatstroke. The 26-year-old Fijian, who formerly represented Tokyo Sungoliath, suffered severe symptoms following a training session in Fukuoka, where temperatures reached 35C. Japan Rugby League One expressed profound condolences after the tragedy. The news overshadowed the international in Osaka, where the Brave Blossoms narrowly lost 35-32 to Australia in similarly sweltering conditions."
        }
      ],
      "match": {
        "venue": "Hanazono Rugby Stadium, Osaka"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "465": {
      "date": "2026-08-11",
      "edition": "Tuesday 11 August",
      "sections": [
        {
          "kicker": "Squad recall",
          "heading": "Dave Rennie hints at Richie Mo’unga recall following Billy Proctor injury",
          "body": "The All Blacks have opened the door for a sensational Richie Mo’unga return following Billy Proctor’s tour-ending shoulder injury. Proctor, who fractured his shoulder blade during Friday’s 38-21 win over the Stormers, will return home for a 10-week recovery period. Coach Dave Rennie confirmed a replacement is imminent, stating “we’re working through that process” when asked if the 56-Test fly-half—now eligible via the NPC—would join the squad. Meanwhile, Cam Roigard has been withdrawn from Tuesday’s Sharks fixture as a calf precaution."
        }
      ],
      "match": {
        "venue": "Kings Park, Durban"
      },
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-08-11",
      "edition": "Tuesday 11 August",
      "sections": [
        {
          "kicker": "Squad recall",
          "heading": "Rassie Erasmus recalls Deon Fourie as Siya Kolisi faces injury scan",
          "body": "Deon Fourie has been drafted back into the Springbok squad following his standout performance for the Stormers against the All Blacks. The 39-year-old provides vital back-row cover as captain Siya Kolisi awaits scan results on a hamstring injury sustained during Saturday's 17-10 win in Argentina. \"He injured his hamstring, the other hamstring,\" Rassie Erasmus noted, \"but it doesn't look too bad.\" Fourie joins the camp in Johannesburg today alongside returning regulars Cheslin Kolbe and Damian Willemse."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
