  "digests": {
    "28": {
      "date": "2026-11-29",
      "edition": "Sunday 29 November",
      "sections": [
        {
          "kicker": "Coach's verdict",
          "heading": "Jake White hails Fiji as 'Harlem Globetrotters', targets maul and scrum fixes",
          "body": "After Friday's 23-21 defeat to Italy at Twickenham, the head coach said one of Fiji's tries was probably the best of the tournament, with prop forwards passing out of the back of their hands. His verdict was simple: “they are the Harlem Globetrotters of rugby.” His priorities are more basic. Stopping mauls remains a work in progress, and he wants a scrum that does not give penalties away before adding the bells and whistles. White predicted Fiji will be much better by next year's World Cup."
        },
        {
          "kicker": "Around the world",
          "heading": "New Zealand beat England 26-8 to reverse last week's defeat",
          "body": "Wales beat Japan 40-10 in Nations Championship play-off. Italy's Tommaso Menoncello needs shoulder surgery, looks set to miss Six Nations. Rory Darge returns from injury to captain Scotland against Argentina."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "386": {
      "date": "2026-11-29",
      "edition": "Sunday 29 November",
      "sections": [
        {
          "kicker": "Discipline costs",
          "heading": "Coles and Pollock sin-binned as All Blacks beat England 26-8 at Twickenham",
          "body": "Saturday's Nations Championship play-off went the way of Dave Rennie's side a week after England's 37-12 rout, with Richie Mo'unga landing four penalties and two conversions. Borthwick's side needed 12 entries to the 22 for a single try, Jamie George finishing a maul, while yellow cards for Alex Coles — a head-high tackle on 33 minutes — and Henry Pollock kept Mo'unga's boot busy. On 60 minutes Twickenham booed its own team after an aimless Marcus Smith kick found the New Zealand backfield."
        },
        {
          "kicker": "Around the world",
          "heading": "Wales beat Japan 40-10 in Nations Championship play-off",
          "body": "Italy's Tommaso Menoncello needs shoulder surgery, looks set to miss Six Nations. Rory Darge returns from injury to captain Scotland against Argentina."
        }
      ],
      "source": {
        "name": "Rugby World"
      }
    },
    "387": {
      "date": "2026-11-29",
      "edition": "Sunday 29 November",
      "sections": [
        {
          "kicker": "Front-row gamble",
          "heading": "Fabien Galthié starts all-Bordeaux front row of Poirot, Lamothe and Falatea",
          "body": "The Bordeaux-Bègles trio get the nod for today's Nations Championship final against South Africa at Twickenham, with Jean-Baptiste Gros and Peato Mauvaka held back for the last half-hour. Planet Rugby reads it as a trio picked to fight the Springboks on the floor as much as in the scrum. It is a pointed call: in Paris a fortnight ago, France led 21-7 before the Bok scrum took over, and they conceded 14 penalties and three yellow cards in hanging on to win 21-19."
        },
        {
          "kicker": "Around the world",
          "heading": "New Zealand beat England 26-8 to reverse last week's defeat",
          "body": "Wales beat Japan 40-10 in Nations Championship play-off. Italy's Tommaso Menoncello needs shoulder surgery, looks set to miss Six Nations. Rory Darge returns from injury to captain Scotland against Argentina."
        }
      ],
      "match": {
