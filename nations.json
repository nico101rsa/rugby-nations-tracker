    "387": {
      "date": "2026-10-23",
      "edition": "Friday 23 October",
      "sections": [
        {
          "kicker": "Squad recall",
          "heading": "Gregory Alldritt recalled to France squad after year away under Galthié",
          "body": "Gregory Alldritt is back in Fabien Galthié's France squad for the November Nations Championship matches, a year after he last featured. The La Rochelle number eight, 29, has 58 caps and captained Les Bleus against Australia in November 2025 in Antoine Dupont's absence, but fell out of favour and was sidelined in July with a calf injury. Galthié also named seven newcomers in his 42-man squad, and Alldritt is in contention for the second part of the Nations Championship, which includes South Africa on 13 November in Paris."
        },
        {
          "kicker": "Around the world",
          "heading": "Wallabies drop to seventh after back-to-back Bledisloe Cup defeats",
          "body": ""
        }
      ],
