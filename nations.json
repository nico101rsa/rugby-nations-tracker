  "digests": {
    "28": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "TRANSFER COLLAPSE",
          "heading": "Joji Nasova secures Newcastle Red Bulls release to stay with Fijian Drua",
          "body": "Fijian international winger Joji Nasova has chosen to remain with the Drua after securing a release from his contract with Newcastle Red Bulls. The 25-year-old Olympic silver medallist, who has scored four tries in three appearances for his country, will no longer join the Premiership side due to personal reasons. Newcastle general manager Neil McIlroy confirmed the release, stating they \"fully understand and respect the unique personal circumstances\" behind the decision."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "386": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "Squad management",
          "heading": "Steve Borthwick wins praise from George Kruis for resting Maro Itoje",
          "body": "Former England lock George Kruis has praised head coach Steve Borthwick for omitting Maro Itoje from the recent Nations Championship tour. Borthwick rested the England captain for the three-match Southern Hemisphere leg to manage his physical and mental load ahead of next year's World Cup. Kruis, who won 45 caps for his country, strongly endorsed the player-welfare decision. \"Looking after a player mentally and physically is super important,\" Kruis said. \"You can’t keep going to the well.\""
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "CHAMPIONSHIP PROGRESS",
          "heading": "Maxime Lucu tallies 15 points as France move third in Nations Championship",
          "body": "France sit third in the Nations Championship standings after three rounds of competition following a 42-15 victory over Japan. Scrum-half Maxime Lucu headlined the win with a 15-point haul, helping Les Bleus record their second victory of the tournament. The squad now look ahead to Fiji, a side they defeated 34-21 in their most recent encounter during November 2025. Across their opening three fixtures, the French have scored 116 points and conceded 75."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "COACHING RETURN",
          "heading": "Joe Schmidt returns to Irish rugby in consultancy role with Ulster",
          "body": "Former Ireland head coach Joe Schmidt has secured a return to the Irish system, joining Ulster on a 12-month consultancy basis following his departure from the Wallabies. Schmidt, who led Ireland to three Six Nations titles and a Grand Slam, will provide strategic support and mentorship to Richie Murphy’s coaching staff. The New Zealander said: \"Ulster has a proud rugby tradition and further developing the coaching pathway in the region is something that we believe can add value.\" His appointment strengthens the provincial setup after Ireland's Southern Hemisphere tour."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "RANKING HISTORY",
          "heading": "Italy occupy 11th place in standings after three Nations Championship losses",
          "body": "Italy currently sit 11th in the 12-team Nations Championship table after their first three fixtures. The side recorded three losses in that opening block. In those three matches, the Azzurri scored 37 points. The defence conceded 131 points across the same period. This leaves the team with a points difference of -94 ahead of their November fixture against South Africa. In terms of global standing, Italy reached their highest world ranking of No. 8 in 2007. They matched that record ranking again during the 2024 season."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "LEADERSHIP BLOW",
          "heading": "Scottish Rugby sacks chief executive Alex Williamson following independent conduct inquiry",
          "body": "The board of Scottish Rugby has dismissed chief executive Alex Williamson with immediate effect following an independent investigation into his conduct. Williamson, who succeeded Mark Dodson in 2025, had been on extended leave since May before the board concluded his conduct had fallen \"significantly below the standards we set as an organisation.\" Chief financial officer David White assumes the interim role as the governing body begins another search for permanent leadership ahead of a busy autumn schedule featuring the All Blacks."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "REGIONAL REFORM",
          "heading": "Welsh Rugby Union forces Scarlets and Ospreys into licence battle",
          "body": "The Welsh Rugby Union has confirmed that Cardiff and the Dragons will receive professional licences, leaving Scarlets and Ospreys to fight for the single remaining \"west\" slot. Under the governing body’s plan to reduce the professional tier to three teams by 2028, the rivals must now prove their long-term viability or consider a merger. Swansea Council has resumed legal proceedings against the WRU, while Professional Rugby Board chair Marianne Okland admitted \"there will be ongoing uncertainty until a final decision on the west licence is made\" next year."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "460": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Rassie Erasmus recalls Siya Kolisi and key veterans against Los Pumas",
          "body": "South Africa coach Rassie Erasmus has confirmed the return of captain Siya Kolisi alongside Eben Etzebeth, Lood de Jager, Sacha Feinberg-Mngomezulu, and Morné van den Berg for their upcoming Test in Buenos Aires. The Springboks boss intends to use the fixture to integrate players returning from injury while managing the workload of those who featured heavily during the Nations Championship. Erasmus noted, “We tried to get the balance right between giving some guys who are returning from injury a valuable run.”"
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "Coaching focus",
          "heading": "Les Kiss prioritises defensive structure ahead of upcoming Japan Test series",
          "body": "New Wallabies head coach Les Kiss has identified a revamped defensive system as the immediate priority for his side ahead of the two-match series against Japan. Kiss, who arrived at camp recently, confirmed that new assistant Scott McLeod is implementing key principles designed to improve connectivity and pressure. \"The boys have already bought into the real key principles he has brought in,\" Kiss noted. He acknowledged that while squad transition remains a challenge, fostering competitive depth remains his central mission."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "LEGAL CHALLENGE",
          "heading": "Twenty-four players launch legal action against Japan Rugby League One",
          "body": "Twenty-four players have launched legal action against Japan Rugby League One regarding new eligibility rules. The players claim these changes discriminate against foreign-born professionals, including naturalised citizens who have represented Japan internationally. The move potentially threatens the lucrative pathway that has long allowed international players to sustain careers within the Japanese professional system. While the challenge focuses on league competition rules, it highlights growing tensions regarding the future of residency and eligibility within the broader Japanese rugby framework."
        }
      ],
      "rung": "data"
    },
    "465": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "Tour preparations",
          "heading": "Dave Rennie prioritises mental freshness as All Blacks reach South Africa",
          "body": "All Blacks head coach Dave Rennie has arrived in Cape Town, prioritising balance for his 44-man squad during the demanding tour. While the team faces a packed schedule of seven matches, Rennie remains focused on the need to get players’ \"head out of footy at times.\" Captain Ardie Savea will join the group later, having been granted extra time out following a heavy workload since early 2025. Rennie described the reception in South Africa as \"incredible\" as the team begins their preparations."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Siya Kolisi returns as Rassie Erasmus names squad for Argentina",
          "body": "Captain Siya Kolisi headlines a 26-man squad for the upcoming one-off Test against Argentina. Following his absence throughout the Nations Championship, Kolisi is joined by returnees Sacha Feinberg-Mngomezulu and Morne van den Berg. Rassie Erasmus is prioritising a balance between testing squad depth and managing player workloads ahead of the All Blacks series. “We tried to get the balance right between giving some guys who are returning from injury and who have not had too much game time in our last four matches a valuable run,” said Erasmus."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
}