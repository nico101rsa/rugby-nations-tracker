  "digests": {
    "28": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "Tournament form",
          "heading": "Fiji drop to bottom of standings after suffering third consecutive defeat",
          "body": "Fiji achieved their highest ever world ranking of No. 7 back in 2023. In the current competition, the team sit bottom of the standings in 12th place. They have suffered three defeats in their opening three matches. Across those three fixtures, the team scored 49 points. They conceded 145 points during that same period. Their last result was a 17-33 loss to Scotland in the third round."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "Contract backlash",
          "heading": "Ben Youngs accuses Conor O'Shea of having 'blinkers on' over Borthwick backing",
          "body": "Former England scrum-half Ben Youngs has criticised the RFU’s decision to extend head coach Steve Borthwick’s contract beyond the 2027 World Cup. Youngs claimed performance director Conor O'Shea has \"some blinkers on\" after the union backed Borthwick following a review into a disappointing 2026 Six Nations campaign. While the holding pattern to 2028 is designed to prevent pre-tournament uncertainty, Youngs argued the timing is wrong, warning that RFU chiefs must be held accountable if the World Cup goes badly."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "Form guide",
          "heading": "France maintain third place in the Nations Championship following consecutive victories",
          "body": "France hold third place out of 12 teams in the Nations Championship table following their 42-15 away victory over Japan in the Group Stage. That July fixture extended Les Bleus' current run to two straight wins, bringing their record to three wins and two defeats in their last five matches. Across three tournament rounds, the French side have accumulated two wins and one loss, registering 116 points for and 75 against to leave them with a positive difference of 41."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "Fixture plans",
          "heading": "IRFU rejects World Rugby proposal to play Six Nations matches in America",
          "body": "The Irish Rugby Football Union has ruled out moving future Six Nations fixtures across the Atlantic, insisting there are \"currently no plans or discussions\" to play matches in the United States. The statement followed suggestions from World Rugby chief executive Alan Gilpin, who floated an Ireland against Italy fixture in New York or Boston to grow the game. The IRFU maintained that home games remain \"a central part of the competition's appeal\" for local supporters."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "Expansion plans",
          "heading": "Italy's Six Nations rivals resist World Rugby plans for American fixtures",
          "body": "World Rugby has floated radical plans to move select Six Nations matches to the United States to help grow the game globally. However, several of Italy's tournament rivals have already distanced themselves from the proposal, with the Irish Rugby Football Union and Scottish Rugby stating they have no such plans, while England look set to protect their Twickenham revenues. There is no coverage of Italy's stance on the proposal in today's press."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "Campaign update",
          "heading": "Scotland occupy fifth in the international standings after beating Fiji 33-17",
          "body": "With domestic and international media focusing on the women's national team, there is no coverage of the men's senior squad in today's press. Scotland currently occupy fifth place in the 12-team international standings after securing two wins from their opening three fixtures. That campaign record includes a 33-17 victory over Fiji, leaving the men's senior side with 108 points scored and 97 conceded. Scotland's next scheduled fixture is an autumn test against New Zealand."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "Injury update",
          "heading": "Wales lock Ben Carter cleared to return after recovering from ankle injury",
          "body": "Wales lock Ben Carter has recovered from the ankle injury that ruled him out of the mid-July Nations Championship defeat against South Africa. The 25-year-old sustained the blow in training and was on crutches, but he avoided surgery and is now fully fit for the Dragons' upcoming season opener. Defence coach Dale MacLeod praised the forward's physical condition, stating: \"He is going really well and is probably in the best nick that I have seen him.\""
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "Mendoza thriller",
          "heading": "Argentina hold out with 13 men to secure dramatic Mendoza draw",
          "body": "Last weekend's second Test in Mendoza saw Argentina salvage a 28-28 draw against Australia despite playing the final minutes with only 13 men. Down 14-0 in the first half, Los Pumas fought back with tries from Pablo Matera and Ignacio Ruiz. However, late disciplinary trouble left the hosts short-handed as the Wallabies levelled through a penalty try. The Argentine defence held firm in the final moments to deny Les Kiss's side the win, though the visitors secured the series."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "461": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "Career transition",
          "heading": "James Slipper pauses playing career to join Brumbies as temporary scrum coach",
          "body": "James Slipper will transition into a temporary coaching role with the Brumbies, pausing his playing career for the upcoming Super Rugby AU season. The veteran prop, who holds a record 154 Test appearances, joins Stephen Larkham’s backroom staff as a specialist scrum coach to replace the Wallabies-bound John Ulugia. Despite the shift, Slipper remains committed to a recently signed one-year contract extension. “I’ve been around a lot of scrums over the years, so hopefully I can pass on a bit of what I’ve learnt,” Slipper noted."
        }
      ],
      "match": {
        "venue": "Twickenham, London"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "Nations Cup",
          "heading": "Eddie Jones targets home final as Japan face USA in Osaka",
          "body": "Japan host the USA at Hanazono Rugby Stadium today in the second semi-final of the Pacific Nations Cup. Head coach Eddie Jones is targeting a return to the winner’s circle after consecutive second-place finishes behind Fiji. Though the historic head-to-head is closely fought, the Brave Blossoms have won nine of their last 10 encounters with the Eagles. USA head coach Scott Lawrence admitted the Brave Blossoms represent a \"big step up for us in terms of their speed of play, physicality, and overall accuracy.\""
        }
      ],
      "match": {
        "venue": "Hanazono Rugby Stadium, Osaka"
      },
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Dave Rennie selects Richie Mo’unga to start as All Blacks reshuffle pack",
          "body": "Following a 40-21 victory over Ireland to remain second in the table, the All Blacks have turned to Richie Mo’unga at fly-half. Coach Dave Rennie has prioritised set-piece stability, retaining only Sam Darry in a heavily altered starting front five. While Ruben Love’s form in recent Tests earned praise from Stephen Donald, Mo'unga’s return to the No. 10 jersey is expected to provide greater continuity. Rennie acknowledged the need for cleaner possession, stating \"the thing that frustrated us was the continuity we wanted, and that's our own issue.\""
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "Series decider",
          "heading": "Rassie Erasmus names near-identical side to secure historic Baltimore series win",
          "body": "South Africa head into Saturday's final Test in Baltimore leading the Greatest Rivalry series 2-1, with Rassie Erasmus making just two changes to his starting XV. Damian Willemse returns at full-back for the injured Cheslin Kolbe, while Morne van den Berg replaces Cobus Reinach at scrum-half. Former coach Nick Mallett noted \"there's been no foot (taken) off the throat with the selections here,\" as the world champions seek to deny New Zealand bragging rights after the All Blacks outscored them 13 tries to eight across the first three matches."
        }
      ],
      "match": {
        "venue": "M&T Bank Stadium, Baltimore"
      },
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
}