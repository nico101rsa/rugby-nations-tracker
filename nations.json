  "digests": {
    "28": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "FORM TRACKER",
          "heading": "Fiji slide to three consecutive defeats following home loss against Scotland",
          "body": "The Flying Fijians are enduring a difficult run of form, having slipped to three straight defeats in international play. In their last five matches, the team has recorded only one victory. Across those same five fixtures, they have suffered four defeats. This challenging run was compounded in July 2026 during the Nations Championship group stage, where Fiji suffered a 33-17 defeat against Scotland on home soil."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "Contract talks",
          "heading": "Eddie Hearn's million-pound demand stalls Henry Pollock's Northampton contract negotiations",
          "body": "Northampton Saints are yet to reach an agreement with Henry Pollock following sports promoter Eddie Hearn’s demand earlier this month that the England flanker be handed a one-million-pound contract. Hearn’s ultimatum has stalled negotiations, with pundits recently dismissing the seven-figure sum as unrealistic for Premiership Rugby. Pollock, who impressed for England in July's victory against Argentina, is also weighing a separate offer to join the international sevens circuit. No deal has been finalised as the deadlock enters September."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "387": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "Transfer rumour",
          "heading": "France star Thomas Ramos linked with shock Toulouse exit to Racing 92",
          "body": "According to reports in L'Equipe, France star Thomas Ramos is being linked with a sensational switch from Toulouse to Top 14 rivals Racing 92 after the 2027 Rugby World Cup. The full-back has made 200 appearances for Toulouse, securing four league titles and two Champions Cups. The prospective move to Paris could see Ramos deployed at fly-half, a position he has occupied for Les Bleus but only started twice for his club last season."
        }
      ]
    },
    "388": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "LEGAL UPDATE",
          "heading": "High Court ruling keeps IRFU in legal battle over player brain injuries",
          "body": "A landmark High Court ruling has allowed the rugby brain injury litigation to proceed, keeping the IRFU under intense legal scrutiny. The case, which was reportedly brought back from the brink of collapse, remains unresolved as the court’s decision leaves the ultimate outcome in the balance. Former players are seeking damages for concussion-related brain injuries, ensuring that the governing bodies face a prolonged legal battle before any final verdict is reached."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "Form guide",
          "heading": "Italy concede 318 points over their last 11 international matches",
          "body": "Across their last 11 games, Italy have conceded 318 points, averaging 28.9 points conceded per game in that period. Over that same 11-match window, the team scored 190 points, recording an average of 17.3 points per game across those fixtures. The biggest win in that 11-game stretch was a 34-19 home victory against Chile in a November 2025 International Friendly."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "Legal battle",
          "heading": "Scotland watches closely as High Court leaves rugby concussion lawsuit in balance",
          "body": "The landmark concussion legal battle brought by hundreds of former players against rugby governing bodies remains unresolved. Following a High Court ruling that initially kept the brain injury case alive, the litigation has been left hanging in the balance. Scottish rugby administrators face a protracted wait alongside fellow governing bodies, as the eventual outcome of this massive legal struggle promises to fundamentally reshape safety protocols and financial liabilities across the global game."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "Boardroom crisis",
          "heading": "Abi Tierney rejects resignation calls as Wales legend demands board's exit",
          "body": "Welsh Rugby Union chief executive Abi Tierney has dismissed calls for her resignation despite mounting pressure on the governing body’s leadership. The stance comes as a prominent Wales legend publicly urged the board to step down following a series of disappointing performances on and off the field. The administrative turmoil coincides with a difficult period for the men's national side; following their 0-43 loss to South Africa, Wales sit ninth in the standings with just one victory from three matches played this season."
        }
      ]
    },
    "460": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "HOME SLUMP",
          "heading": "Gerónimo Prisciantelli and Joaquín Moro scores fail to mask Argentina slump",
          "body": "Saturday’s 21-27 defeat in San Salvador de Jujuy highlighted a troubling trend, as the side has now managed only one win in their last five home matches. While tries from Gerónimo Prisciantelli, Joaquín Moro, and Boris Wenger kept Los Pumas within striking distance, three Australian scores inside the first 20 minutes proved decisive. Santiago Carreras added six points through conversions, yet the performance was undermined by a clinical Wallabies attack that dominated most facets of play at Estadio 23 de Agosto."
        }
      ],
      "match": {
        "venue": "Estadio 23 de Agosto, San Salvador de Jujuy"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "Coach’s verdict",
          "heading": "Les Kiss flags smart changes for Mendoza after identifying clunky bits",
          "body": "Australia secured a fourth consecutive Test victory with Saturday's 27-21 win over Argentina, though coach Les Kiss remains unsatisfied with the \"clunky bits\" of the performance. While the Wallabies’ clinical finishing in the opposition 22 yielded four tries, Kiss highlighted issues with ruck speed and defensive spacing in San Salvador de Jujuy. Changes are expected for the series finale in Mendoza as Kiss continues to explore squad depth. \"We're going to have to be better in that area next week,\" Kiss admitted."
        }
      ],
      "match": {
        "venue": "San Salvador de Jujuy"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "LEGAL SETTLEMENT",
          "heading": "Timothy Lafaele and naturalised Brave Blossoms stars settle domestic eligibility dispute",
          "body": "Japan Rugby League One has reached a settlement with a group of 24 foreign-born players, including Brave Blossoms stalwarts Timothy Lafaele and Jiwon Gu, over proposed eligibility restrictions. The league previously planned to limit matchday squads for the 2026-27 season based on local schooling history. Under the revised rules, naturalised citizens holding Japanese citizenship by May 2025 retain their domestic status. Crucially, any player with 30 or more Japan caps will now be reclassified to Category A-1, ensuring their professional futures remain secure."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "COACHING ROW",
          "heading": "Dave Rennie's scrum complaints labelled 'nonsense' by fuming Springboks coach Rassie Erasmus",
          "body": "Dave Rennie’s decision to query the legality of the Springboks' scrum with World Rugby has sparked a sharp rebuttal from Rassie Erasmus. Following Saturday’s 33-26 defeat in Cape Town, Erasmus dismissed claims of the hosts \"walking around\" at the set-piece as \"nonsense\", suggesting the All Blacks were \"under pressure\". While the visitors outscored South Africa four tries to three, pundit Nick Mallett claimed on a podcast that New Zealand were lucky to avoid several scrum penalties from referee Angus Gardner."
        }
      ],
      "match": {
        "venue": "DHL Stadium, Cape Town",
        "referee": "Angus Gardner"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "Coaching friction",
          "heading": "Rassie Erasmus labels Dave Rennie’s scrum allegations \"nonsense\" following Springbok series-levelling win",
          "body": "South Africa reclaimed the world No. 1 ranking after Saturday’s 33-26 victory over New Zealand, though the result was overshadowed by a row over scrummaging. Rassie Erasmus bristled at claims from All Blacks coach Dave Rennie that the Boks were \"walking around\" the set piece, retorting, \"I don’t come with that nonsense.\" Despite Erasmus swapping his entire starting front row an hour before kick-off, 18 points from Cheslin Kolbe and a late Cameron Hanekom turnover secured the vital win."
        }
      ],
      "match": {
        "venue": "Cape Town Stadium, Cape Town",
        "referee": "Angus Gardner"
      },
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
