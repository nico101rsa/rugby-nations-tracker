      }
    },
    "388": {
      "date": "2026-11-24",
      "edition": "Tuesday 24 November",
      "sections": [
        {
          "kicker": "Finals draw",
          "heading": "Ireland meet Australia in third-v-third finals clash after 20-17 Springbok win",
          "body": "The inaugural Nations Championship finals weekend pairs Farrell's side with the Wallabies, with every match staged at Allianz Stadium, Twickenham. There is more than placing at stake. Each of the first five matches earns a point for the winner's hemisphere, and the final between France and South Africa is worth two. The Guardian's Robert Kitson paired the 20-17 defeat of the world champion Springboks with England's 37-12 win over the All Blacks as another resounding northern-hemisphere double."
        },
        {
          "kicker": "Around the world",
          "heading": "Argentina lose 45-17 to France after Mayco Vivas red card",
          "body": "France recall Thomas Ramos for Springboks final. South Africa's Marco van Staden likely banned for France final."
        }
      ],
      "match": {
        "venue": "Allianz Stadium, Twickenham"
      },
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "389": {
      "date": "2026-11-24",
      "edition": "Tuesday 24 November",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Italy lose Miotti and Ferrari to injury after 16-21 Fiji defeat",
          "body": "Domingo Miotti, lively until he left the field in the 48th minute of Saturday's 16-21 defeat by Fiji in Udine, has a left hamstring injury, according to Italy's medical staff. Simone Ferrari, named in the matchday squad, withdrew an hour before kick-off with a left upper-limb injury, Marco Riccioni taking his place. Both will have scans in camp and then return to their clubs — Miotti to Montpellier, Ferrari to Treviso — with rehabilitation run jointly with the national team's staff."
        },
        {
          "kicker": "Around the world",
          "heading": "Ireland beat Springboks 20-17 to set up Australia finals clash",
