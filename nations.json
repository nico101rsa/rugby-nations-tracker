  "digests": {
    "28": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Tragic Loss",
          "heading": "Fijian forward Saimoni Vunilagi dies aged 26 after training in Japan",
          "body": "The Fijian rugby community is mourning the tragic death of 26-year-old Saimoni Vunilagi, who passed away in Fukuoka after suffering suspected heatstroke. The back-row forward, who stood 196cm and weighed 117kg, began his professional career in Japan in 2023 and had recently joined second-division club Kyushu KV. The club expressed their devastation, stating, 'The players, staff, and all team associates are devastated by this sudden news.' Vunilagi displayed symptoms after a training session where temperatures hit 35 degrees Celsius."
        }
      ]
    },
    "386": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Community season",
          "heading": "RFU postpones start of England’s community rugby season due to drought",
          "body": "The Rugby Football Union has delayed the start of the community rugby season until the week commencing 21 September due to critical pitch conditions. Following a record-breaking dry July, 71.3% of England is currently in drought, making many grounds unsuitable for safe full-contact activity. RFU president Sir Bill Beaumont stated the decision prioritises player welfare, providing clubs and schools with greater certainty after gathering feedback from across the country as they attempt to manage the impact of the ongoing dry weather."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Position focus",
          "heading": "Maxime Lucu leads the way as France’s scrum-half depth persists",
          "body": "While global rankings continue to celebrate Antoine Dupont, current analysis from Planet Rugby highlights that France’s strength at scrum-half extends well beyond their legendary captain. Maxime Lucu has been identified as the most in-form number nine in the game, effectively pushing Nolann Le Garrec into a secondary role behind both him and Dupont. Despite the competitive nature of the position, Le Garrec remains a world-class operator, particularly noted for his trademark passing ability in his club duties for La Rochelle."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "388": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Legal proceedings",
          "heading": "High Court ruling allows rugby brain injury lawsuits to progress further",
          "body": "The long-running legal battle regarding neurological injuries in rugby reached a significant juncture this week, as the High Court ruled that concussion-related lawsuits against World Rugby and other governing bodies may proceed to trial. The decision marks a defeat for the defendants, who had sought to have the claims struck out. With the court permitting the litigation to advance, hundreds of former players continue their pursuit of damages, citing the scale and complexity of the issues involved in the ongoing legal action."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Disciplinary sanction",
          "heading": "Marco Riccioni receives two-match ban following red card in Perth",
          "body": "Prop Marco Riccioni has been suspended for two matches after receiving a red card during the 10-57 defeat against Australia. Although not part of the match-day squad, Riccioni was observed leaving the dugout to engage in a sideline altercation during the second half. Following a review, the foul play review committee found him guilty of conduct contrary to the spirit of good sportsmanship. The Perpignan forward will now miss upcoming club fixtures against Biarritz and Bath next month."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Legal battle",
          "heading": "High Court dismisses bid by rugby authorities to stop injury lawsuits",
          "body": "The long-running legal challenge surrounding neurological injuries in rugby has reached a significant milestone, as the High Court has dismissed an attempt by World Rugby and UK governing bodies to strike out the pending claims. With the bid to throw out the cases rejected, the multi-million-pound litigation brought by a group of former players is now set to continue. The proceedings remain a point of serious concern for the sport's administrators regarding long-term liability."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Boardroom appointment",
          "heading": "Alun Wyn Jones returns to Ospreys as new club director",
          "body": "Former Wales captain Alun Wyn Jones has joined the Ospreys board of directors with immediate effect. The 40-year-old, who made 257 appearances for the region, enters the role at a critical time as the club navigates the uncertainty of the Welsh Rugby Union’s plan to reduce the number of professional sides. Chairman James Davies-Yandle stated the club was not seeking a figurehead, but a director capable of holding his own in the boardroom to help drive long-term stability."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Tactical analysis",
          "heading": "Kieran Read highlights how Argentina exposed the Springboks' defensive edge",
          "body": "Former All Blacks captain Kieran Read has identified Argentina’s performance in Buenos Aires a fortnight ago as a potential tactical blueprint for unlocking the Springboks' rush defence. Despite a 17-10 defeat, Los Pumas successfully utilised cross-field kicks and chips to exploit space on the fringes where South Africa’s defensive line is typically narrow. Read noted that Argentina’s willingness to trust their depth and move the ball wide created genuine scoring opportunities that other teams should look to replicate."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "461": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Squad selection",
          "heading": "Len Ikitau and Joseph-Aukuso Suaalii return for Australia’s Argentina tour",
          "body": "Wallabies coach Les Kiss has bolstered his squad for the upcoming tour of Argentina with the return of star centres Len Ikitau and Joseph-Aukuso Suaalii. Ikitau recovers from an ankle injury sustained against Italy, while Suaalii returns following a hamstring strain. The pair rejoin a settled group as Australia prepares for back-to-back Tests in San Salvador de Jujuy and Mendoza. “As coaches we’ve looked to maintain consistency in selection,” Kiss said, noting the squad’s foundation built over recent weeks."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "463": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Community tribute",
          "heading": "Japan rugby community mourns passing of Fijian back-rower Saimoni Vunilagi",
          "body": "The Japanese rugby community is in mourning following the death of Saimoni Vunilagi, who passed away on Friday after suffering from severe heatstroke. The 26-year-old Kyushu Kyuden Voltex player fell ill following a training session earlier this month. A minute's silence was held to honour his memory before Japan’s recent Test against Australia. Vunilagi, who had previously played for Suntory Sungoliath, was remembered by his former club and the Japan Rugby League One organisation for his generous spirit and powerful style of play."
        }
      ]
    },
    "465": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Anton Segner ruled out as All Blacks confirm late squad change",
          "body": "Coach Dave Rennie was forced into a late change for the series opener at Ellis Park on Saturday, which the All Blacks won 33-16. Flanker Anton Segner was withdrawn from the match 23 due to a swollen ankle, diagnosed as acute inflammatory arthritis. An All Blacks spokesperson confirmed that his return to play is yet to be determined. Simon Parker, who previously featured in the tour matches against the Stormers and Bulls, replaced Segner on the bench for the statement victory."
        }
      ],
      "match": {
        "venue": "Ellis Park, Johannesburg",
        "referee": "Matthew Carley"
      },
      "source": {
