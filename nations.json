  "digests": {
    "28": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "Log standings",
          "heading": "Fiji remain bottom of Nations Championship log following three straight defeats",
          "body": "Fiji remain bottom of the Nations Championship log as the side navigates a difficult run of international results. The team has managed just one victory in its last five matches, suffering four defeats in that window. This current sequence includes three straight losses, the most recent being a 17-33 defeat against Scotland during July’s home fixture. Fiji currently sit 12th of 12 in the standings, having conceded 145 points while scoring 49 across their first three tournament appearances."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "Borthwick extension",
          "heading": "Steve Borthwick earns contract extension until after the 2028 Six Nations.",
          "body": "The RFU will hand Steve Borthwick a contract extension until the conclusion of the 2028 Six Nations, a move designed to eliminate \"uncertainty\" ahead of next year’s World Cup. Performance director Conor O’Shea confirmed the decision, despite previously describing England’s recent Six Nations as \"horrendous.\" While the deal provides short-term security for the coaching staff, O’Shea noted that future backing remains dependent on tournament results in Australia. Borthwick remains under pressure following a mixed Nations Championship campaign that yielded two wins from three matches."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "WXV Global Series",
          "heading": "France host Black Ferns in opening match of global series tournament",
          "body": "France welcome the Black Ferns to the Matmut Stadium de Gerland this weekend for the opening fixture of the 2026 WXV Global Series. This encounter marks the beginning of a demanding international campaign for both nations as they build towards the 2029 Women’s Rugby World Cup in Australia. Having met previously in the 2025 World Cup bronze medal match, both sides look to stamp their authority on this new home-and-away format before the series shifts to New Zealand in October."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "388": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "Selection talk",
          "heading": "Josh van der Flier dismisses negative noise regarding Ireland’s recent form",
          "body": "Josh van der Flier has moved to distance himself from the recent criticism surrounding Ireland’s performance levels. While acknowledging the disappointment of the recent southern hemisphere tour, the 33-year-old maintained he has not been focused on the media reaction. “I honestly haven’t seen much of it in terms of (negative) talk,” he noted. Looking ahead to the next fixture against Argentina, the flanker emphasised his commitment to the group’s internal standards rather than external analysis of the team’s current standing."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "Coaching suspension",
          "heading": "World Rugby bans Italy head coach Gonzalo Quesada for referee comments",
          "body": "Gonzalo Quesada has become the first coach suspended under the newly implemented Match Official Abuse Sanctioning Process. The governing body handed the Italy head coach a two-test ban following his public criticism of referee Luc Ramos after the loss to the All Blacks in July. The sanction prohibits Quesada from all match-day proceedings, including attendance at the stadium, for the upcoming fixtures. This new disciplinary framework was established at the recent Shape of the Game forum to address increased official abuse."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "Player focus",
          "heading": "Scotland winger Kyle Rowe integrates performance psychology into his match preparation",
          "body": "Scotland winger Kyle Rowe is taking an analytical approach to his game, revealing a side hustle in performance psychology to sharpen his competitive edge. The back-three player, who has been honing these mental techniques, openly admitted, \"I use myself as a guinea pig\" to test how these psychological frameworks influence his on-field performance. This self-driven commitment to improvement highlights the evolving, multifaceted preparation styles now being adopted by players within the national setup."
        }
      ]
    },
    "391": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "Strategic shift",
          "heading": "Rhys Long outlines plan for Wales to challenge for world titles",
          "body": "New WRU technical director Rhys Long has challenged the current narrative surrounding Welsh rugby, insisting the nation can return to the sport's summit. Addressing the current gulf between Wales and the leading international sides, Long dismissed the idea of managing decline, instead focusing on a talent development system designed for the next 15 years. While acknowledging the current rebuild is a long-term prospect, he believes a unified approach can eventually produce teams capable of winning a World Cup."
        }
      ]
    },
    "460": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "WXV ball trial",
          "heading": "World Rugby continues smaller ball trial despite growing player concerns voiced",
          "body": "The contentious trial of a smaller rugby ball in the women's game remains an active, unresolved storyline. As professional squads prepare for upcoming WXV fixtures, the implementation has sparked significant debate. While some stakeholders support the objective of enhancing handling, recent reporting highlighted that current players feel the modification makes it 'harder to do my job.' World Rugby has yet to issue a final ruling on the trial's conclusion or potential permanent adoption, leaving the international game in a state of ongoing evaluation."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "461": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "Selection blow",
          "heading": "Carter Gordon faces two months out after suffering a broken leg",
          "body": "The Wallabies face a significant personnel challenge after scans confirmed Carter Gordon sustained a leg fracture during the weekend’s draw with Argentina. The 25-year-old playmaker is expected to be sidelined for two months, ruling him out of the upcoming Test against South Africa and the Bledisloe Cup series. Ben Donaldson, who started in Mendoza, is expected to continue in the role, though options for the wider squad remain a point of discussion as coach Les Kiss looks to manage his flyhalf depth."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "Fixture release",
          "heading": "JRLO confirms opening round matchups for 2026-2027 Division One season",
          "body": "The NTT Japan Rugby League One has released the fixtures for the upcoming Division One campaign, which gets underway on December 12, 2026. Defending champions Kobelco Kobe Steelers begin their title defence by hosting Toyota Verblitz at Noevir Stadium Kobe, while Tokyo Suntory Sungoliath face Ricoh Black Rams Tokyo. The 18-game regular season runs until May 2027, culminating in the playoff tournament final on June 6, 2027, with fixtures structured to ensure no team is favoured based on previous standings."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "Squad rotation",
          "heading": "Dave Rennie confirms personnel changes ahead of series decider in Baltimore",
          "body": "Dave Rennie has revealed that the All Blacks planned to make changes for Saturday's series finale regardless of the result in Johannesburg, though injuries to captain Ardie Savea, Luke Jacobson and Quinn Tupaea have altered those plans. Following a 29-24 defeat at FNB Stadium that handed the Springboks a 2-1 series lead, Rennie stated, “We sort of always thought we would make changes in the fourth Test regardless of whether we won that third one or not.” Ethan de Groot, Josh Lord and Richie Mo’unga are among the options coming into contention for the Baltimore clash."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "Squad depth",
          "heading": "Rassie Erasmus admits Springboks have monitored Faf de Klerk's domestic form",
          "body": "Springboks head coach Rassie Erasmus has revealed the coaching staff have kept a close eye on Faf de Klerk as the veteran scrum-half continues his impressive form for the Cheetahs. Speaking during a teleconference ahead of the series finale against New Zealand, Erasmus explained that the heavy squad rotation implemented throughout the season was deliberately designed to peak for the closing stages of Rugby's Greatest Rivalry. While Morné van den Berg gets the nod to start in Baltimore, Erasmus noted that they evaluated De Klerk's current output as the world champions manage their wealth of experienced half-backs."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
}