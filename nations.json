  "digests": {
    "28": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Form tracker",
          "heading": "Fiji concede 326 points across their last 11 international matches",
          "body": "Fiji have struggled to find defensive consistency in their recent Test programme. Over their last 11 games, the Flying Fijians have conceded 326 points, representing an average of 29.6 points per match. While they scored 315 points of their own during this same span — averaging 28.6 points per game — their defensive fragility has proved costly. The highlight of this 11-match window remains a resounding 63-10 home victory over Canada in September 2025 during the Pacific Nations Cup knockout stage."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Contract demand",
          "heading": "Eddie Hearn demands one million pound deal for England back-rower Henry Pollock",
          "body": "Promoter Eddie Hearn has sparked debate by demanding a one million-pound-a-year contract for England’s rising back-rower Henry Pollock. The 21-year-old is on a deal at Northampton Saints — currently worth £150,000 — but his stock has risen after earning senior caps under Steve Borthwick and touring with the Lions. Dan Cole suggested Hearn must \"lower his standards\" regarding rugby's finances compared to boxing. Pollock’s inclusion in England’s new 25-man enhanced elite player contract squad further highlights the battle to retain one of the country's most promising talents."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Form guide",
          "heading": "France hold third place in the standings after beating Japan 42-15",
          "body": "France currently occupy third place in the Nations Championship table following their 42-15 victory over Japan. Across their opening three fixtures of the competition, Les Bleus have secured two wins. The side has suffered one defeat during that same window. Fabien Galthié's team has scored 116 points in the tournament. They have also conceded 75 points during those matches, leaving them with a positive points difference of 41. Looking ahead, France recorded a 34-21 victory in their last encounter with Fiji in November 2025."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Jack Crowley ruled out for Ireland until the new year",
          "body": "Munster have confirmed that Ireland fly-half Jack Crowley will remain sidelined until the new year due to a lower limb vascular injury. The 26-year-old, who has earned 35 caps for his country, has been unavailable since April and will now miss the upcoming block of international fixtures in November. Munster head coach Clayton McMillan stated: \"Jack Crowley is a very important player for Munster and Ireland with a big future in the game and ensuring he gets back to 100% is the priority.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Disciplinary update",
          "heading": "Marco Riccioni serves suspension following Nations Championship red card incident",
          "body": "Italy prop Marco Riccioni will miss two club matches after receiving a red card during the recent defeat to Australia. Although not in the match-day squad, Riccioni was dismissed for an altercation on the touchline during the second half of the 57-10 loss. Having admitted to the act of foul play, he will now sit out upcoming fixtures for Perpignan. Italy currently find themselves on a run of 4 consecutive defeats, having won only one of their last 5 matches."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Coaching vacancy",
          "heading": "Scottish Rugby remains in search for permanent Women's head coach successor",
          "body": "The vacancy for the Scotland Women’s head coach remains open following Sione Fukofuka’s resignation earlier this month. While media reports have expressed surprise that Fukofuka was appointed by Australia days after leaving his Scottish role for stated personal reasons, Scottish Rugby has yet to announce a permanent replacement. With the Vodafone Scotland WXV Series fast approaching, the squad continues their preparations for the upcoming three-match home series at Hive Stadium without a confirmed long-term successor at the helm."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Concussion litigation",
          "heading": "High Court ruling keeps major brain injury legal battle against rugby alive",
          "body": "The multi-million-pound legal action involving over 200 former players alleging governing bodies failed to mitigate concussion risks remains active. Despite attempts by rugby authorities to have the lawsuits thrown out, the High Court recently allowed the claims to proceed. The case, which has seen participation from prominent former internationals, continues to move through the legal system as claimants seek damages for neurological injuries. There has been no further update on a potential settlement since the court's recent landmark decision."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Felipe Contepomi names unchanged Argentina XV to face visiting Australia side",
          "body": "Head coach Felipe Contepomi has kept faith in the starting group that pushed the Springboks close in their previous outing, naming an unchanged XV to face the Wallabies in Jujuy. Pablo Matera continues to captain the side in the absence of Julián Montoya, who remains unavailable due to club commitments. While the starting lineup remains settled, Contepomi has shifted his bench composition to a 5:3 split, bringing in prop Rodrigo Martinez and Nicolas Roger to provide additional tactical flexibility for the second-half challenge."
        }
      ],
      "match": {
        "venue": "Estadio 23 de Agosto, San Salvador de Jujuy",
        "referee": "Ben O'Keeffe"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Allan Alaalatoa named captain as Les Kiss rotates Wallabies forward pack",
          "body": "Les Kiss has opted to reshuffle his starting pack for the upcoming Test against Argentina, handing the captaincy to tighthead prop Allan Alaalatoa. Regular skipper Harry Wilson has been rested for the fixture, with Rob Valetini moving to No 8 to anchor the back row. Kiss described the rotation as a \"worthwhile exploring\" exercise to test squad depth, with Isaac Kailea returning to the starting XV for the first time since 2024 to join a restructured front row."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "League eligibility",
          "heading": "Japan Rugby League One settles legal dispute over player registration categories",
          "body": "Japan Rugby League One has officially revised its 2026-27 registration categories following a legal challenge from 25 players, including several Japan internationals. The league confirmed that naturalised players who held citizenship by May 2025 will remain in the same category as Japan-born players. Additionally, players with 30 or more national team caps will now be reclassified from the restrictive A-2 category to A-1. The league stated it would reflect on the \"insufficient\" prior communication regarding these system changes."
        }
      ]
    },
    "465": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Selection twist",
          "heading": "Springboks shuffle pack and bring in Feinberg-Mngomezulu for second Test",
          "body": "South Africa have made a late change to their starting lineup for the second Test in Cape Town, with Sacha Feinberg-Mngomezulu replacing the injured Handré Pollard at fly-half. The hosts have also rotated their front row, bringing in Gerhard Steenekamp, Deon Fourie and Thomas du Toit. Rassie Erasmus had initially prioritised experience to address the tactical errors from the opening defeat, but the inclusion of the more adventurous Feinberg-Mngomezulu signals a potential shift in strategy as the Boks look to bridge the current series deficit."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "467": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Series levelled",
          "heading": "Springboks beat New Zealand 33-26 to level the rivalry series",
          "body": "South Africa secured a vital 33-26 victory over New Zealand at the DHL Stadium on Saturday, successfully leveling the two-test series at 1-1. Despite a week of disruption caused by late injuries, including the withdrawal of Handré Pollard, the hosts delivered a clinical performance. Cheslin Kolbe, named player of the match for his all-round influence and accurate goal-kicking, helped drive the team forward as the Springboks regained momentum in Cape Town."
        }
      ],
      "match": {
        "venue": "DHL Stadium, Cape Town"
      },
      "source": {
        "name": "Guardian Rugby Union"
      }
    }
  }
}