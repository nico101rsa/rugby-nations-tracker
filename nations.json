  "digests": {
    "28": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Form guide",
          "heading": "Fiji turn their attention to France following heavy defeat against Scotland",
          "body": "The Flying Fijians occupy 12th place in the standings after suffering three consecutive defeats. Their most recent outing ended in a 17-33 loss against Scotland in the third round. Across those three tournament matches, the team has conceded 145 points. Meanwhile, they have scored 49. Fiji must now prepare to face France. In the last fixture between the two sides, Fiji suffered a 34-21 away defeat in November 2025."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Autumn ultimatum",
          "heading": "Fly-half Fin Smith issues blunt ultimatum to England over autumn form.",
          "body": "Fin Smith demands England confront their squad trajectory immediately if they underperform during the autumn campaign. The fly-half, who started the last five Tests, dismissed transition excuses following a run of just three wins in eight matches. 'If we have a pretty ropey autumn, on the back of building some momentum over the summer, I think we will need to have a pretty hard look at ourselves,' Smith told the BBC's Rugby Union Weekly podcast. England host Australia, Japan and New Zealand in November."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Psychological barrier",
          "heading": "Former England scrum-half Ben Youngs warns France to beat South Africa",
          "body": "Former England scrum-half Ben Youngs warns Fabien Galthié’s side that they must defeat South Africa this November to dismantle a growing psychological barrier before the World Cup. Speaking on the For the Love of Rugby podcast, Youngs claimed failure to beat the world champions in Paris would leave an insurmountable hurdle. The Springboks previously edged France 29-28 in the 2023 World Cup quarter-final before winning 32-17 there last November despite playing with 14 men."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "388": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "TEST DEBUT",
          "heading": "Head coach Scott Bemand hands Jemima Adams Verling senior Ireland debut",
          "body": "Jemima Adams Verling starts at blind-side flanker to make her senior Ireland debut against the United States in Dublin. Head coach Scott Bemand named the 20-year-old in an experienced pack to launch Ireland’s WXV Global Series campaign. She joins captain Erin King and Aoife Wafer in the back row as Bemand targets depth building ahead of the next Rugby World Cup. With Sam Monaghan sidelined by an Achilles injury, Dorothy Wall and Fiona Tuite-O’Sullivan form the second-row partnership."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Stateside proposal",
          "heading": "World Rugby proposes moving future Italy Six Nations matches to America",
          "body": "World Rugby aims to transplant a Six Nations fixture to the United States, a move that places Italy's future tournament travel on the agenda. First reported on Thursday, the plan to grow the sport stateside has met mixed responses, with England reportedly reluctant to participate. The proposal remains unresolved while Six Nations organisers debate the commercial benefits against logistics. For the Azzurri, any approved switch of a home fixture would mean sacrificing Rome's Stadio Olimpico atmosphere for a lucrative American audience."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Ball controversy",
          "heading": "John Mitchell reveals stance as Scotland face expanded smaller ball trial",
          "body": "World Rugby expands its controversial trial of a smaller ball in the women's game, a development directly impacting Scotland during their WXV campaign. The initiative remains highly contentious among players and coaches alike. While Red Roses coach John Mitchell has revealed his stance on the trial, critics argue that women do not need 'help' they would not get in the men's game. Some players have voiced frustration, warning that the change makes it 'harder to do my job' on the pitch."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "WXV opener",
          "heading": "Coach Sean Lynn's Wales Women crush South Africa to end losing run",
          "body": "Wales Women emphatically snapped a nine-test losing streak on Friday, running in eight tries to demolish South Africa 50-19 in their WXV Global Series opener at Cardiff Arms Park. Head coach Sean Lynn's experimental selection paid off handsomely, with playmaker Keira Bevan shifting to fly-half to orchestrate a stunning 38-5 half-time lead. Tighthead Sisilia Tuipulotu scored a try in each half, while co-captain Alex Callender marked her return from injury with a player-of-the-match performance to secure a vital bonus-point victory."
        }
      ],
      "match": {
        "venue": "Cardiff Arms Park, Cardiff"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Results update",
          "heading": "Argentina battle to home draw against Australia in latest international friendly",
          "body": "Argentina recorded a 28-28 draw against Australia at home in a September international friendly. In their last five games overall, Los Pumas have secured one victory, suffered three defeats, and registered one draw. They sit eighth in the Nations Championship table. Across three rounds, the team have won one match. They have also lost two fixtures. Argentina have scored 97 points in the competition. They have conceded 99 points, leaving them with a points difference of minus two following their recent 24-31 loss to England."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Tactical approach",
          "heading": "Wallabies coach Les Kiss vows to take on the Springboks challenge",
          "body": "Wallabies head coach Les Kiss urges his squad to embrace an unconventional, unpredictable style of play ahead of their upcoming test against world No. 1 South Africa. Acknowledging the monumental challenge of facing the Springboks, Kiss insists his side will not back down. \"We won’t shy away; we’ll take it on,\" Kiss said, drawing inspiration from artificial intelligence and Wallabies legend David Campese to champion a free-flowing approach. The coach believes this mindset can dismantle the Springboks' structured dominance."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "SELECTION CALL",
          "heading": "Eddie Jones promotes Faulua Makisi to starting XV for Fiji final",
          "body": "Eddie Jones has named a hardened matchday squad for Saturday’s Pacific Nations Cup final in Tokyo. Faulua Makisi starts at No. 8, while Tomoki Osada returns on the left wing as Jack Cornelsen shifts to lock. Japan aim to avoid a third consecutive final defeat against the Flying Fijians following losses in 2024 and 2025. Skipper Naoto Saito leads an experienced side, with Jones banking on \"good experience and toughness\" to secure the Brave Blossoms' first title in this competition since 2019."
        }
      ],
      "match": {
        "venue": "Prince Chichibu Memorial Stadium, Tokyo"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "465": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Coaching endorsement",
          "heading": "Murray Mexted predicts South African tour will define Dave Rennie's squad",
          "body": "Murray Mexted believes the All Blacks' recent series against South Africa will prove the making of head coach Dave Rennie. Despite the tour's intensity, the former number eight argues the experience exposed essential truths about which squad members are truly Test quality. While Ruben Love started three Tests against the Springboks, Richie Mo'unga’s impact in the Baltimore finale has reignited the fly-half debate. 'He’s definitely given Love plenty of room to move,' Mexted said, noting the importance of blooding talent before next year's World Cup."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "PLAYER PRAISE",
          "heading": "Former Springbok Gio Aplon hails Kurt-Lee Arendse after the winger’s sensational performance",
          "body": "Kurt-Lee Arendse has earned glowing praise from former Springbok Gio Aplon following South Africa’s 43-28 victory over New Zealand in Baltimore. The wing scored a well-taken try and gained 140 metres as the world champions secured a 3-1 series win. Rudy Paige described Arendse’s clinical execution in transition as \"unbelievable\" during the six-try performance. After a quiet start to the season, the winger’s return to peak form reinforces the Boks’ attacking potency heading into the November Test window."
        }
      ],
      "match": {
        "venue": "M&T Stadium, Baltimore"
      },
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
}