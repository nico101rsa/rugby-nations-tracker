  "digests": {
    "28": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "WOMEN'S RUGBY",
          "heading": "Fijian Drua women fall to Waratahs in historic home final",
          "body": "Fijian Drua fell short of the Super Rugby Women’s title after a 34-17 grand final defeat to the NSW Waratahs in Ba. Playing the showcase match in Fiji for the first time, the minor premiers suffered from errors, including six lost lineout throws, as the visitors raced to a 24-0 lead. Despite a late rally with three tries, the Drua could not prevent the Australian side from securing a record-extending seventh crown and completing a hat-trick of consecutive titles."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "386": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "CHARITY FIXTURE",
          "heading": "Jamie George recruits Owen Farrell for rugby versus cricket charity fixture",
          "body": "Jamie George will captain a ‘Team Rugby’ side against Somerset’s professional cricketers on 19 August to raise funds for the Motor Neurone Disease Association. The England hooker has recruited international teammates Owen Farrell, Ben Earl and Elliot Daly for the T20 fixture at the County Ground. George noted that his Saracens teammates use cricket for every warm-up, stating: \"The boys love it because they're mad-keen cricket fans.\" The rugby squad will rely on the former age-grade county experience of Daly and Earl."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "SEVENS SUCCESS",
          "heading": "France men claim fifth Rugby Europe 7s Championship Series title",
          "body": "France have secured their fifth Rugby Europe 7s Championship Series title after a dominant final display in Split. Les Bleus surged through the knockout stages with emphatic victories over Georgia and Spain before securing the trophy with a 43-0 win against Italy in the final. This result ensured they successfully retained their European crown, building on their performances throughout the two-leg series hosted in Hamburg and Split to finish at the top of the overall standings."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "TOURING WOES",
          "heading": "Andy Farrell rues error-strewn display as Ireland fall to New Zealand",
          "body": "Andy Farrell has criticised an error-riddled performance following Ireland’s 40-21 defeat to New Zealand in the Nations Championship. The head coach described his side as “inaccurate,” citing discipline issues and basic handling mistakes as the primary factors behind the result. While tries from Jack Conan, Joe McCarthy, and Hugo Keenan provided a brief second-half spark, the visitors were unable to bridge the gap created by a punishing first half. Ireland now looks to re-assess after concluding their season in Auckland."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "389": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "PERFORMANCE DATA",
          "heading": "Italy maintains scoring average of 17.3 points in last 11 matches",
          "body": "In their last 11 fixtures, Italy have scored 190 points and conceded 318 points, averaging 17.3 and 28.9 points per game respectively. The side’s most significant success within this period came during the November 2025 international window, where they secured a 34-19 home victory over Chile. These figures reflect the team's ongoing challenge as they prepare to return to competitive action later this year."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "LEADERSHIP CHANGE",
          "heading": "Scottish Rugby dismisses chief executive Alex Williamson following independent inquiry",
          "body": "Scottish Rugby has sacked chief executive Alex Williamson with immediate effect. Chairman John McGuigan confirmed the decision followed the conclusion of an independent investigation, stating the board concluded that Williamson's conduct had fallen significantly below the standards set by the organisation. Williamson, who had been on extended leave since late May, is being replaced in the interim by chief financial officer David White. The governing body now begins the search for a new leader ahead of a critical period of fixtures."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "REGIONAL FUTURE",
          "heading": "Scarlets vow to remain at heart of west Wales amid uncertainty",
          "body": "The Scarlets have publicly committed to their future in west Wales, stating their intention to remain \"at the heart of west Wales\" following the Welsh Rugby Union's confirmation of plans to reduce professional teams to three by 2028. With Cardiff and the Dragons secured, the Scarlets and Ospreys are now effectively competing for the final regional licence. The WRU confirmed the formal process to decide the western representative begins in December, though the Scarlets insist their focus remains \"unchanged and unhindered.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "SQUAD SELECTION",
          "heading": "Rassie Erasmus recalls Siya Kolisi and four others for Argentina Test",
          "body": "South Africa have bolstered their touring squad with five significant returnees ahead of their trip to Buenos Aires. Captain Siya Kolisi, Eben Etzebeth, Lood de Jager, Sacha Feinberg-Mngomezulu and Morné van der Berg have been named in the 26-man party as they look to build momentum before facing the All Blacks. Head coach Rassie Erasmus admitted he is aiming to strike a balance by providing \"a valuable run\" to players returning from injury while managing the workloads of his frontline stars."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "COACHING TRANSITION",
          "heading": "Harry Wilson welcomes Les Kiss' energy ahead of Japan test series",
          "body": "Wallabies captain Harry Wilson has praised new head coach Les Kiss, noting that the squad has responded positively to his passion since his recent arrival in camp. While Wilson retains the leadership role, he insists that performance remains the primary metric for selection under the new regime. Kiss has spent his first week implementing a defensive strategy and expressed his focus on making the moments that matter, stating, \"The test arena, it tests you; that's what it's about.\""
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "OPPOSITION WATCH",
          "heading": "Harry Wilson previews Wallabies’ upcoming double-header against Japan under Les Kiss",
          "body": "Wallabies captain Harry Wilson has praised the \"energy\" brought by new head coach Les Kiss ahead of Australia’s upcoming two-match series against Japan. Wilson, who has retained the captaincy under the new regime, noted that the squad has responded positively to Kiss’s inclusive approach. While the new coach is currently assessing his options—including a potential return for cross-code convert Zac Lomax—the Wallabies skipper stressed that he remains focused on earning his place through daily performance as the tests against Japan approach."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "465": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "TOUR PREPARATION",
          "heading": "Dave Rennie prioritises mental freshness as All Blacks arrive in South Africa",
          "body": "All Blacks head coach Dave Rennie has prioritised squad recovery as the team touches down in Cape Town for their seven-match tour. Forty-three of his 44-man squad have assembled, with captain Ardie Savea granted additional leave to rest after a heavy workload since early 2025. Rennie emphasised the need to balance intensity with downtime, noting, \"we've got to make sure that we embrace the country and embrace the challenge and get your head out of footy at times too.\""
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "COACHING PHILOSOPHY",
          "heading": "Rassie Erasmus reveals his biggest fear is losing public connection",
          "body": "Springbok coach Rassie Erasmus has admitted his primary anxiety is not the prospect of defeat, but losing the profound sense of joy the team currently provides to South Africans. Speaking on the Rassie+ podcast, the coach explained that maintaining the genuine bond between the players and the public remains his driving motivation. Erasmus emphasised that while he remains obsessed with tactical preparation, his biggest nightmare is losing the satisfaction of the communal pride currently felt across the country."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
}