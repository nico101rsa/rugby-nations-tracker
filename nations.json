  "digests": {
    "28": {
      "date": "2026-08-18",
      "edition": "Tuesday 18 August",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Fijian back-row forward Saimoni Vunilagi dies of suspected heatstroke in Japan",
          "body": "The Fijian rugby community is mourning the tragic death of 26-year-old back-row forward Saimoni Vunilagi in Japan. Vunilagi, who played for second-division side Kyushu KV, was hospitalised following a training session in Fukuoka on Monday 3 August after exhibiting symptoms of severe heatstroke. He sadly passed away on Friday morning, 7 August. His club expressed deep devastation, remembering his \"generous spirit and powerful style of play\" which had raised high hopes for the upcoming season. Vunilagi moved to Japan for university before turning professional in 2023."
        }
      ]
    },
    "386": {
      "date": "2026-08-18",
      "edition": "Tuesday 18 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Steve Borthwick drops Ollie Lawrence and Elliot Daly from England contracts",
          "body": "Steve Borthwick has reshaped his senior squad ahead of the autumn internationals, omitting Ollie Lawrence and Elliot Daly from England's new 25-man central contracts list. The high-profile duo miss out on the £150,000-a-year enhanced deals alongside Ben Curry and Tom Roebuck. Instead, Borthwick has prioritised the future, handing first-time contracts to five rising stars including Gloucester centre Seb Atkinson and Sale prop Asher Opoku-Fordjour. While Daly and Lawrence remain eligible for selection, their omission signals a ruthless gear shift before next year’s World Cup."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "387": {
      "date": "2026-08-18",
      "edition": "Tuesday 18 August",
      "sections": [
        {
          "kicker": "By the numbers",
          "heading": "France pile on 426 points over their last 11 international matches",
          "body": "France have demonstrated clinical attacking form by scoring 426 points across their last 11 games. In that same 11-match window, the team conceded 291 points. These figures represent scoring averages of 38.7 points scored per game, alongside 26.5 points conceded per match. Fabien Galthié's side achieved their biggest win of this recent period in February 2026, when they beat Wales 54-12 in an away Six Nations fixture."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-18",
      "edition": "Tuesday 18 August",
      "sections": [
        {
          "kicker": "Legal battle",
          "heading": "Irish rugby awaits pivotal ruling as landmark brain injury case faces collapse",
          "body": "The landmark court case regarding brain injury in rugby is reportedly at risk of collapse, according to latest coverage. The proceedings remain open as the game awaits a final ruling from the judge on the potential strikeout of the claims. This follows reports last week that players were seeking new lawyers after a dismissed solicitor continued to act in the case. With no judgment delivered yet, Irish rugby continues to watch the high-stakes litigation closely."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-08-18",
      "edition": "Tuesday 18 August",
      "sections": [
        {
          "kicker": "Form tracker",
          "heading": "Italy slide to eleventh in standings following four consecutive test defeats",
          "body": "Italy sit eleventh out of 12 teams in the standings after a difficult start to their campaign. The Azzurri are currently enduring a run of four straight defeats, having won only one of their last five matches. That run culminated in a 10-57 away defeat against Australia in July 2026 during the Nations Championship group stage. In their three tournament fixtures, Italy remain winless with 37 points scored and 131 conceded."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-18",
      "edition": "Tuesday 18 August",
      "sections": [
        {
          "kicker": "COACHING EXIT",
          "heading": "Scotland left surprised as coach Fukofuka joins rivals Australia after exit",
          "body": "Scotland's coaching setup has been rocked by the sudden departure of Fukofuka, who has been unveiled as the new Australia head coach. The Scottish camp was reportedly left surprised by the rapid appointment, which came just days after the coach parted ways with Scotland citing family reasons. With today's press coverage offering few details on the tactical fallout, the sudden defection to a major international rival leaves Gregor Townsend searching for answers."
        }
      ]
    },
    "391": {
      "date": "2026-08-18",
      "edition": "Tuesday 18 August",
      "sections": [
        {
          "kicker": "Career ends",
          "heading": "Former Wales centre Willis Halaholo announces his retirement from professional rugby",
          "body": "Former Wales and Cardiff centre Willis Halaholo has announced his retirement from professional rugby at the age of 36. Halaholo, who won a Six Nations title with Wales in 2021, made more than 100 appearances during an eight-year spell with Cardiff before returning to New Zealand with Bay of Plenty. He explained on social media that 'the body has had enough' after battling numerous niggling injuries. The Auckland-born player, who also went on to represent Tonga, now plans to turn his attention to coaching."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-08-18",
      "edition": "Tuesday 18 August",
      "sections": [
        {
          "kicker": "Disciplinary ban",
          "heading": "Pumas fly-half Tomás Albornoz accepts four-match ban for intimidating referee Gardner",
          "body": "Argentina fly-half Tomás Albornoz will miss crucial international fixtures after accepting a four-match suspension for intimidating referee Angus Gardner. The incident occurred following the Pumas' dramatic 24-31 defeat to England in Santiago del Estero, where the hosts were denied a late penalty try. Albornoz admitted his conduct was intimidatory after twice approaching the Australian official and needing to be restrained by teammates. The suspension sidelines him for Argentina's matches against South Africa and Australia."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "461": {
      "date": "2026-08-18",
      "edition": "Tuesday 18 August",
      "sections": [
        {
          "kicker": "Selection headache",
          "heading": "Isaac Henry and Carter Gordon spark Wallabies selection headaches after Japan rout",
          "body": "Australia head coach Les Kiss faces pleasant selection dilemmas ahead of the tour of Argentina after an experimental Wallabies side thrashed Japan 56-17 in Townsville. Fly-half Carter Gordon and debutant centre Isaac Henry both shone in the eight-try rout, putting pressure on established stars like Joseph-Aukuso Suaalii. With midfielder Len Ikitau primed to return from an ankle injury, Kiss has successfully fostered the fierce internal competition that his predecessors struggled to generate."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-18",
      "edition": "Tuesday 18 August",
      "sections": [
        {
          "kicker": "TEST DEFEAT",
          "heading": "Eddie Jones laments possession deficit as Wallabies rout Japan 56-17",
          "body": "Japan fell to a heavy 56-17 defeat against Australia on Saturday, collapsing in a tough second half in Townsville. Despite a competitive first half with tries from Harry Hockings, Naoto Saito, and Dylan Riley to trail 21-17, the Brave Blossoms conceded 35 unanswered points after the break. Head coach Eddie Jones rued their breakdown and aerial struggles, saying: \"I think that in order for us to compete properly against such an opponent, we need to maintain more than 50 per cent possession; otherwise it will be difficult to win.\""
        }
      ],
      "match": {
        "venue": "Queensland Country Bank Stadium, Townsville"
      },
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-08-18",
      "edition": "Tuesday 18 August",
      "sections": [
        {
          "kicker": "INJURY BLOW",
          "heading": "Dave Rennie summons Saula Ma’u and Noah Hotham as tour injuries mount",
          "body": "The All Blacks’ \"Greatest Rivalry\" tour has claimed another casualty after prop Ollie Norris was ruled out with a knee injury sustained against the Bulls. He joins George Bell, Billy Proctor and Caleb Clarke on the plane home. Coach Dave Rennie has called up Saula Ma’u as cover, while Tasman’s Noah Hotham joins the squad as Cortez Ratima manages a PCL tear. Rennie remains \"hopeful\" Damian McKenzie will recover from an ankle niggle for Saturday’s opening Test against the Springboks at Ellis Park."
        }
      ],
      "match": {
        "venue": "Ellis Park, Johannesburg"
      },
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-08-18",
      "edition": "Tuesday 18 August",
      "sections": [
        {
          "kicker": "SELECTION CALL",
          "heading": "Rassie Erasmus delays Springboks team announcement to keep All Blacks guessing",
          "body": "Head coach Rassie Erasmus has pushed back the Springboks team announcement until Thursday, citing respect for New Zealand while attempting to limit their tactical preparation time. Captain Siya Kolisi and prop Ox Nché remain injury concerns for Saturday’s series opener at Ellis Park, though Erasmus noted both could feature if they successfully navigated Monday’s training. \"For this one specifically, we think the less time they have to prepare for our team, the better,\" Erasmus explained. He also confirmed two fly-halves will be named in the 23."
        }
      ],
      "match": {
        "venue": "Ellis Park, Johannesburg",
        "referee": "Matthew Carley"
      },
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
