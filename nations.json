    },
    "389": {
      "date": "2026-10-29",
      "edition": "Thursday 29 October",
      "sections": [
        {
          "kicker": "Injury count",
          "heading": "Quesada says 17 Italy players unavailable as captaincy call nears",
          "body": "Gonzalo Quesada put Italy's absences at 17 players at his Nations Championship launch press conference, up from the 12 Reuters reported last week. The head coach called it a serious difficulty, given that several of those players are core members of the group. He said a captaincy decision will come next week, with Giacomo Nicotera and Niccolò Cannone both having captained before. Tommaso Allan is building back toward full training as the team prepares for South Africa, Argentina and Fiji."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa without Kolbe and Etzebeth through injury for Nations Championship",
          "body": "France's Hastoy, Gazzotti and Brau-Boirie sidelined by injury. New Zealand's Jordie Barrett withdraws from Bledisloe Cup Test with calf."
        }
      ],
