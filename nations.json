  "digests": {
    "28": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "Form tracker",
          "heading": "Fiji target first tournament victory after dropping three consecutive matches",
          "body": "Fiji sit at the bottom of the tournament table in 12th place after three matches. The team suffered a 17-33 loss to Scotland in their Round 3 fixture. Looking ahead to the next round, the Flying Fijians travel to face France. In the last meeting between these two sides, which was an international friendly in November 2025, Fiji fell to a 34-21 away defeat."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "Sabbatical benefits",
          "heading": "Maro Itoje endorses summer sabbatical after Steve Borthwick rested England captain",
          "body": "England captain Maro Itoje has endorsed his unexpected summer sabbatical, admitting he was initially shocked when head coach Steve Borthwick suggested the rest. Having exceeded player load guidelines in successive seasons, the 31-year-old lock sat out July's matches against South Africa, Fiji and Argentina. Itoje believes the mental break was crucial after a taxing year both personally and professionally, concluding, \"I don't regret it at all.\""
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "Scoring stats",
          "heading": "France average 38.7 points per game but remain third in table",
          "body": "France have averaged 38.7 points per game across their last 11 fixtures, totalling 426 points scored during that period. Les Bleus currently sit third in the table after three matches, following their recent 42-15 victory over Japan. The biggest win of this high-scoring window remains the 54-12 defeat of Wales during the 2026 Six Nations. However, the side continues to concede an average of 26.5 points per match."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "George Skivington dismisses Ross Byrne Ireland return following Jack Crowley injury",
          "body": "Gloucester head coach George Skivington has dismissed speculation that Ross Byrne will return to Ireland as injury cover for Jack Crowley. Following confirmation that Crowley is ruled out until the new year with a vascular injury, Byrne had been linked with a move to Munster. However, Skivington insists the 31-year-old remains central to his plans for the upcoming campaign. \"Nobody wants him doing that role, that's not what we brought him in for,\" Skivington said, leaving the Irish national coaching staff thin on experienced fly-half options for November."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "Tournament form",
          "heading": "Italy drop to 11th place after heavy Nations Championship defeat in Perth",
          "body": "Italy have lost four consecutive matches following a 57-10 defeat against Australia in July. In their last five games, the side has recorded one win and four losses. This run leaves the team 11th in the 12-team Nations Championship log after three matches. The Azzurri have conceded 131 points in the tournament so far, resulting in a points difference of -94. The squad enters the next round searching for their first win of the competition."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "Community engagement",
          "heading": "Scotland Women players visit local clubs to promote upcoming Test series",
          "body": "Scotland Women internationals have spent the week visiting Balfron High School and Lenzie RFC as part of a community bus tour. The initiative aims to strengthen ties with the grassroots game ahead of next week's WXV Global Series opener at Hive Stadium. Players including Elis Martin and Alex Stewart participated in training sessions and Q&A events. Martin noted the importance of the outreach, stating: \"Building a legacy is one of the most important reasons for why we do what we do.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "New regime",
          "heading": "Steve Tandy takes charge as Wales rebuilds for international success",
          "body": "Steve Tandy has officially commenced his tenure as Wales head coach, following his appointment through to the 2027 World Cup. Tasked with stabilising the senior men’s side, Tandy arrives with experience from both the Ospreys and the Waratahs, as well as his recent coaching role with Scotland. WRU chief executive Abi Tierney cited Tandy’s \"affinity\" for the group and the potential for a \"galvanising effect\" as central reasons for the board’s decision to bring the Welshman back home."
        }
      ]
    },
    "460": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Les Kiss faces captaincy dilemma following Rob Valetini's impressive performance",
          "body": "Coach Les Kiss is weighing up a difficult selection choice for the Wallabies' series finale after Rob Valetini starred at No 8 in last Saturday’s win over Argentina. Filling in for the rested captain Harry Wilson, Valetini’s powerful display has prompted internal debate regarding the leadership and balance of the Australian pack. Kiss has remained committed to squad rotation, but with his unbeaten record at stake, the coach faces pressure to determine if Wilson returns immediately to the starting XV."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "461": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "Tactical scrutiny",
          "heading": "Les Kiss faces questions over Wallabies’ evolving forward-heavy game style",
          "body": "The Wallabies are winning, but head coach Les Kiss faces mounting questions regarding the team's departure from traditional Australian attacking backline play. With 73 per cent of the side’s 2026 tries coming from the forwards, critics argue the team is morphing into a crash-and-bash outfit reminiscent of the Springboks. While the set-piece has been dominant, Kiss admitted the recent win over Argentina was \"clunky\" as his backline struggled to see enough ball. Building necessary depth remains the coach's primary long-term challenge."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "New era begins",
          "heading": "Toshizumi Kitagawa leads Sakura Fifteen against Fijiana in Fukuoka Test",
          "body": "Toshizumi Kitagawa takes charge of the Sakura Fifteen for the first time as head coach in today’s clash against the Fijiana XV at JAPAN BASE. Kitagawa, who previously served as interim head coach, has prioritised youth for this fixture, naming three potential debutants in his matchday 23. Regarding the physical challenge posed by Fiji, Kitagawa noted: \"Fiji has many players who are very fast once they get up to speed, and they are also physically strong. The question is how we can put pressure on them.\""
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "Rankings boost",
          "heading": "New Zealand eye world No. 1 spot against South Africa Saturday",
          "body": "History beckons at the FNB Stadium this weekend as the All Blacks look to reclaim the top spot in the World Rugby rankings. Victory against the Springboks would secure a 2-1 lead in the series and ensure New Zealand returns to the summit regardless of the winning margin. The two nations are guaranteed to occupy the top two positions regardless of Saturday’s outcome, but a win would mark the first time the rankings have changed for three consecutive weeks since 2003."
        }
      ],
      "match": {
        "venue": "FNB Stadium, Soweto"
      },
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "Coaching resignation",
          "heading": "Swys de Bruin resigns as Springbok Women coach following bonus dispute",
          "body": "Swys de Bruin has resigned as Springbok Women head coach following a reported dispute with SA Rugby regarding win bonuses. De Bruin, who led the team to their first-ever World Cup quarter-final last year, has already left his post and is absent from preparations for the upcoming Test against New Zealand at FNB Stadium. In his absence, the team has turned to Junior Boks assistant coach Melusi Mthethwa to assist Kevin Foote with final preparations for the encounter."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
