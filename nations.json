  "digests": {
    "28": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Statistical outlook",
          "heading": "Fiji concede 326 points across last 11 games following Scotland loss",
          "body": "Fiji have averaged 28.6 points per game across their last 11 fixtures, scoring 315 points in total. However, the side has also conceded 326 points in that window, at an average of 29.6 per match. The statistical high point of this period remains the dominant 63-10 victory over Canada in September 2025 during the knockout stages of the Pacific Nations Cup. Currently sitting bottom of the Nations Championship log, the squad must now address a -96 points difference before their November schedule."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Injury concern",
          "heading": "Ben Spencer faces race for fitness ahead of November Test window",
          "body": "Bath have confirmed that Ben Spencer will miss the start of the domestic season following shoulder surgery to correct a long-standing issue. The 34-year-old scrum-half, who featured during England’s July campaign, is not expected to return until later in the autumn. This timeframe places his participation in November’s fixtures against Australia, Japan and New Zealand in doubt, forcing Steve Borthwick to consider his depth options, with Alex Mitchell and Jack van Poortvliet currently positioned as the primary candidates for the half-back roles."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Fixture preview",
          "heading": "France prepare for November encounter with Fiji in Nations Championship",
          "body": "Les Bleus return to international action this November, facing Fiji in Round 4 of the Nations Championship. France will look to build upon their recent form as they host the Pacific Islanders. In their last meeting, France secured a 34-21 victory at home during the November 2025 international window. With two wins from three matches in the current tournament, Fabien Galthié’s side will aim to capitalise on home advantage to strengthen their standing in the competition."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Jack Crowley ruled out for Ireland until the new year",
          "body": "Munster have confirmed that fly-half Jack Crowley is not expected to return to action until the new year due to a long-term lower limb vascular injury. The 26-year-old, who has earned 35 caps for Ireland, will miss the upcoming November Tests against Argentina, Fiji and South Africa. Munster head coach Clayton McMillan stated: \"Jack Crowley is a very important player for Munster and Ireland with a big future in the game and ensuring he gets back to 100% is the priority.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Disciplinary update",
          "heading": "Marco Riccioni receives two-match suspension following red card against Australia",
          "body": "Prop Marco Riccioni will serve a two-match ban following his red card in the defeat to Australia. Though not named in the match-day squad, Riccioni was dismissed for entering the field of play during a second-half scuffle. The foul play review committee initially proposed a four-week suspension but reduced the term to two matches after Riccioni admitted to the act and displayed remorse. He is set to miss fixtures for Perpignan against Biarritz and Bath next month."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Legal update",
          "heading": "Rugby brain injury litigation remains in balance following High Court session",
          "body": "The high-profile brain injury litigation continues to face uncertainty after the High Court recently heard arguments regarding strikeout applications. While previous reports noted that hundreds of players had cleared hurdles to progress their claims, the latest coverage indicates that the defendant bodies are still pushing for the cases to be thrown out. The proceedings remain at a sensitive stage, with both the validity of the claims and the future of the legal challenge currently awaiting further judicial determination."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Rugby legend",
          "heading": "Sir Billy Boston dies at 92 following distinguished Welsh rugby career",
          "body": "Sir Billy Boston has passed away at the age of 92, just weeks after the death of his wife, Lady Joan. A celebrated icon of Welsh sport, Boston began his career playing union for Neath and Pontypridd before pivoting to a historic rugby league career in 1953. The WRU confirmed the death of the \"most famous son of Tiger Bay,\" who earned a knighthood last year for his contributions to the game and his role in opening doors to a more diverse sport."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Test match result",
          "heading": "Australia gain early momentum as Argentina trail at the interval",
          "body": "Los Pumas face a steep challenge at the Estadio 23 de Agosto after a difficult first half left them trailing Australia 14-22. Despite a quick tempo, with 78% of their rucks completed inside three seconds, Argentina struggled to convert territory into points. Australia dominated the breakdown battle early, entering the 22 on four occasions to secure 18 points. Argentina managed to stay in the hunt thanks to a try from Moro, but the visitors maintain a commanding start in Jujuy."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "461": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Allan Alaalatoa named captain as Les Kiss rotates Wallabies forward pack",
          "body": "Coach Les Kiss has reshaped his forward pack for the Test against Argentina, handing the captaincy to tighthead prop Allan Alaalatoa. With regular skipper Harry Wilson rested, Alaalatoa leads a pack featuring a returning Isaac Kailea at loosehead and Rob Valetini moving to number eight. Kiss stated the selection is a “worthwhile exploring” exercise to test squad depth, while the backline retains continuity, including Joseph-Aukuso Suaalii, who provides versatility from the bench as the Wallabies look to test their resources in Jujuy."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "League governance",
          "heading": "Japan Rugby League One resolves eligibility dispute following legal court challenge",
          "body": "Japan Rugby League One has officially revised its controversial registration requirements for the upcoming season, settling a legal dispute that sparked widespread concern among players. Following a challenge at the Tokyo District Court, the league confirmed that naturalised players will retain their status provided they held citizenship by May 2025. Additionally, the JRLO introduced special measures to reclassify players with 30 or more Brave Blossoms caps from Category A-2 to A-1, ensuring fairer professional pathways for established international representatives."
        }
      ]
    },
    "465": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Series levelled",
          "heading": "New Zealand fall to South Africa as Springboks level test series",
          "body": "The All Blacks saw their pursuit of a series victory suffer a setback in Cape Town, falling 33-26 to a clinical South African side. Despite the defeat, New Zealand’s attack remained dangerous, crossing for four tries compared to the hosts’ three. Captain Ardie Savea provided a late glimmer of hope with his 77th-minute score, but a turnover from Cameron Hanekom ultimately secured the result for the world champions. The series is now tied at 1-1, with a final decider scheduled in Soweto."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "467": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Series levelled",
          "heading": "South Africa overcome All Blacks to square Rugby’s Greatest Rivalry series",
          "body": "South Africa successfully levelled their series with New Zealand at 1-1 after a 33-26 victory in Cape Town on Saturday. Rassie Erasmus’s side relied on a powerful first-half display, with tries from Jesse Kriel, Damian de Allende and Siya Kolisi. Cheslin Kolbe proved clinical from the tee, contributing 18 points. Despite a late All Blacks rally, a crucial turnover by replacement Cameron Hanekom in the final moments secured the result. The series now moves to Johannesburg for the third Test next Saturday."
        }
      ],
      "match": {
        "venue": "DHL Stadium, Cape Town"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    }
  }
}