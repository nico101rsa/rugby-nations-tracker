  "digests": {
    "28": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "DISCIPLINARY BAN",
          "heading": "Kuruvoli receives four-week ban for physical abuse in Championship match",
          "body": "The disciplinary decision sidelines the halfback following an incident in the Rugby Nations Championship, compounding the team's struggles at the bottom of the international standings. Having suffered three consecutive defeats to open their campaign, the Flying Fijians must adapt without the key playmaker. The four-week suspension for physical abuse leaves coaching staff searching for alternative options before the squad travels to face France."
        }
      ]
    },
    "386": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "PLAYER WELFARE",
          "heading": "Ben Earl criticises brutal Nations Championship travel demands after global trek",
          "body": "The exhausting reality of the newly formatted tournament has drawn sharp criticism from senior players. Following the 31-24 victory against Argentina, the England number eight questioned the punishing schedule that saw Steve Borthwick's squad cover 26,000 miles across three continents in just three weeks. \"It’s been brutal,\" Earl admitted, after facing South Africa, Fiji and Argentina in quick succession. The back-and-forth travel has prompted calls within the camp for future editions to be hosted in a single country to ease player welfare concerns."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "387": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "RANKING HISTORY",
          "heading": "France's Fabien Galthié oversees a record one-week stint at No. 1",
          "body": "A single week remains the longest unbroken spell the national team has spent at the top of the world rankings. That brief tenure occurred in July 2022, standing as the side's benchmark for time spent in the No. 1 position. Following the 42-15 victory against Japan in the third round of the Nations Championship, the squad currently sits third in the table. Fabien Galthié's men have secured two wins from three matches this season, amassing a points difference of +41."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "LEGAL PROCEEDINGS",
          "heading": "Concussion Litigation Against Governing Bodies Remains Before High Court",
          "body": "The landmark legal action regarding concussion claims brought against World Rugby and the Welsh Rugby Union continues to face uncertainty. Recent reports indicate that players involved remain in limbo as the litigation against the governing bodies takes a complex turn. With the case currently in the balance before the High Court, it remains unclear whether the proceedings will fully collapse or be permitted to progress. No resolution has been reached, and the matter awaits further judicial determination."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "PERFORMANCE METRICS",
          "heading": "Italy struggle to stem defensive tide across last 11 Test matches",
          "body": "In their last 11 fixtures, Italy have recorded 190 points scored and 318 conceded, averaging 17.3 and 28.9 points per game respectively. Despite these challenges, the side found success in this window with a 34-19 home victory against Chile in November 2025. This result currently stands as the team’s largest margin of victory during that 11-match period."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "EXECUTIVE TURMOIL",
          "heading": "Scottish Rugby dismisses chief executive Alex Williamson following independent conduct investigation",
          "body": "The governing body has terminated Alex Williamson’s contract with immediate effect following the conclusion of an independent inquiry into his behaviour. Chairman John McGuigan confirmed the decision, stating that the former chief executive’s conduct had fallen significantly below the standards expected by the organisation. Williamson, who had been on extended leave since late May, is being replaced on an interim basis by chief financial officer David White while the board initiates a new search for a permanent successor."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "REGIONAL REFORM",
          "heading": "Scarlets vow to remain at heart of west Wales amid uncertainty",
          "body": "The Llanelli-based side has declared its intention to secure the sole professional licence for the west as the Welsh Rugby Union finalises plans to reduce the current four professional teams to three by 2028. While Cardiff and the Dragons have been earmarked for the capital and eastern licences, the Scarlets and Ospreys are set to contest the remaining spot. The club confirmed it is pushing forward with recruitment to ensure they remain at the heart of west Wales."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "PLAYER WELFARE",
          "heading": "England players consider pitch walk-off following previous incidents of racist abuse",
          "body": "England captain Jamie George has confirmed that his side is considering a walk-off contingency plan if the squad experiences a repeat of the racist abuse directed at teammates during last year’s visit to Argentina. While England trusts the Argentine Rugby Union’s efforts to ensure a safe environment, the visitors have discussed the necessity of responding with the “strongest of reactions” should further slurs occur. George emphasised that protecting his players remains his absolute priority in the lead-up to the fixture."
        }
      ]
    },
    "461": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "COACHING TRANSITION",
          "heading": "Harry Wilson backs Les Kiss as Wallabies prepare for Japan tour",
          "body": "Captain Harry Wilson has praised the energy brought by new head coach Les Kiss, noting the squad’s enthusiasm for the transition ahead of the upcoming two-match series against Japan. While Kiss has implemented a new defensive strategy, Wilson remains focused on his individual performance to justify his leadership role under the new regime. Kiss emphasised the high stakes of the Test arena, stating, \"The Test arena, it tests you; that's what it's about. You don't have much room for error.\""
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "COACHING UPDATE",
          "heading": "Harry Wilson evaluates Les Kiss impact ahead of Japan match series",
          "body": "Wallabies captain Harry Wilson has praised new head coach Les Kiss for bringing fresh energy and passion to the squad ahead of their upcoming double header against Japan. Wilson, who retained the captaincy under the new regime, noted that Kiss is encouraging players to express themselves while maintaining a competitive environment for selection. The Wallabies are currently looking to solidify their squad dynamics, with Kiss emphasising that holding a leadership title does not guarantee any player a starting position."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "465": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "TOUR PREPARATIONS",
          "heading": "Dave Rennie discusses All Blacks arrival and plans for South Africa",
          "body": "Following their arrival in Cape Town, head coach Dave Rennie has prioritised balancing intensive rugby preparations with necessary recovery for his 44-man squad. While the team navigates a demanding seven-match schedule, Rennie emphasised the importance of players finding downtime. Captain Ardie Savea remains the only squad member yet to join the group, with the loose forward scheduled to link up with his teammates ahead of the first Test match on 22 August in Johannesburg."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "COACHING PHILOSOPHY",
          "heading": "Rassie Erasmus details the nightmare scenario driving his constant tactical planning",
          "body": "Maintaining the national joy brought by the team remains the head coach's primary preoccupation. While he acknowledges that future losses or staff changes are inevitable, he admitted in a recent podcast that his greatest fear is losing the genuine connection between the side and the South African public. This perspective, shared alongside captain Siya Kolisi, highlights the internal pressure to keep the team successful, as the pair prioritises preserving the positive sentiment currently felt by fans across the country."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
