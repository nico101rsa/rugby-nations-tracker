    "28": {
      "date": "2026-10-16",
      "edition": "Friday 16 October",
      "sections": [
        {
          "kicker": "Player eligibility",
          "heading": "Koli Sewabu says Fiji are following Mark Nawaqanitawase's possible switch with interest",
          "body": "Fiji Rugby Union chief executive Koli Sewabu says the union is watching closely after Mark Nawaqanitawase's agent revealed the winger is weighing a switch of allegiance. Nawaqanitawase, eligible for Fiji, Italy and Australia after a three-year stand-down, won 11 Wallabies caps. \"We are aware of the potential switch Mark could make at the next World Cup and follow this with interest,\" Sewabu said. Wallabies head coach Les Kiss says he will wait until the end of the year to see where the player sits."
        },
        {
          "kicker": "Around the world",
          "heading": "Argentina add Shaun Edwards and Mario Ledesma to coaching staff",
          "body": "Wales scrum-half Kieran Hardy needs knee surgery, faces months out. France lock Thibaud Flament faces weeks out with shoulder injury. Wallabies' Ben Donaldson out of Bledisloe Test with upper-leg injury."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "386": {
      "date": "2026-10-16",
      "edition": "Friday 16 October",
      "sections": [
        {
          "kicker": "Eligibility row",
          "heading": "Courtney Lawes and Ellis Genge question England's overseas eligibility rule on podcast",
          "body": "England loosehead Ellis Genge has said on The Good, The Bad and The Rugby podcast: \"I don't think it's fair to say you ain't allowed to do it.\" Genge, 83 caps, backed a 60-cap threshold before a player can move abroad, while forward Courtney Lawes, 105 caps and freshly back from two seasons at Brive, pointed to Wales' 25-cap model as a possible compromise. The current rule, barring overseas-based players save in exceptional circumstances since 2012, is built to protect the Premiership."
        },
        {
          "kicker": "Around the world",
          "heading": "Argentina add Shaun Edwards and Mario Ledesma to coaching staff",
          "body": "Wales scrum-half Kieran Hardy needs knee surgery, faces months out. France lock Thibaud Flament faces weeks out with shoulder injury. Wallabies' Ben Donaldson out of Bledisloe Test with upper-leg injury."
        }
