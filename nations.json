  "digests": {
    "28": {
      "date": "2026-08-24",
      "edition": "Monday 24 August",
      "sections": [
        {
          "kicker": "Form tracker",
          "heading": "Fiji slumped to a third consecutive defeat against Scotland in July",
          "body": "Fiji endured a difficult summer series, culminating in a 17-33 home loss against Scotland in July's Nations Championship group stage. That result in their most recent game extended a disappointing run of form for the national side. Across their last five international fixtures, the team have managed only one win alongside four defeats. This current run of three straight losses leaves the squad searching for answers."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-08-24",
      "edition": "Monday 24 August",
      "sections": [
        {
          "kicker": "Selection debate",
          "heading": "Jeremy Guscott urges Steve Borthwick to hand Henry Pollock a starting spot",
          "body": "Former England centre Jeremy Guscott has called on Steve Borthwick to start rising star Henry Pollock, describing the 21-year-old loose forward as \"one of the most gifted players we have ever seen as a seven.\" The Northampton Saints back-rower has won 13 caps but made only one start, against Ireland in the Six Nations, usually being deployed as an impact player off the bench. Guscott also questioned the omission of Max Ojomoh and urged Borthwick to let Lee Blackett exert more influence."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-24",
      "edition": "Monday 24 August",
      "sections": [
        {
          "kicker": "Log update",
          "heading": "France beat Japan 42-15 to secure third place in tournament standings",
          "body": "France are third in the 12-team standings after three matches of the tournament. They registered two victories and one defeat in that opening three-match window. Les Bleus scored 116 points across those three fixtures. They conceded 75 points over the same period, leaving them with a points difference of +41 after their 42-15 victory over Japan in the third round. Historically, the team's longest unbroken spell at No. 1 in the world rankings lasted for one week, a milestone reached in July 2022."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-24",
      "edition": "Monday 24 August",
      "sections": [
        {
          "kicker": "Legal battle",
          "heading": "Ireland players face further delay as High Court postpones concussion ruling",
          "body": "There is no fresh progress to report in the landmark rugby brain injury litigation, with the High Court yet to deliver its formal ruling on the critical strikeout applications. Since the judge retired earlier this month to consider whether up to 95 per cent of the actions should be struck out, Irish media coverage has remained entirely silent on any new legal developments. The future of the monumental case remains strictly on hold until the court breaks its silence."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-08-24",
      "edition": "Monday 24 August",
      "sections": [
        {
          "kicker": "Stat watch",
          "heading": "Italy concede 318 points across their last 11 test matches",
          "body": "Across their last 11 games, Italy have struggled to contain opponents, conceding 318 points at an average of 28.9 a match. Over the same 11-match stretch, the Azzurri scored 190 points, averaging 17.3 a game. The side's biggest victory in this 11-game window was a 34-19 home win against Chile in November 2025 during the international friendlies."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-24",
      "edition": "Monday 24 August",
      "sections": [
        {
          "kicker": "Transfer news",
          "heading": "Jamie Ritchie signs for Glasgow Warriors following season with USA Perpignan",
          "body": "Former Scotland captain Jamie Ritchie has completed a move to Glasgow Warriors after spending last season in France with Top 14 side USA Perpignan. The 29-year-old back-rower, who won 63 caps and previously made 133 appearances for Glasgow's rivals Edinburgh, joins Franco Smith’s side ahead of the new United Rugby Championship season. Ritchie’s arrival offsets significant summer departures for the Warriors, who have lost Scotland internationals Huw Jones, Adam Hastings and Jack Dempsey."
        }
      ]
    },
    "391": {
      "date": "2026-08-24",
      "edition": "Monday 24 August",
      "sections": [
        {
          "kicker": "Boardroom Return",
          "heading": "Alun Wyn Jones joins Ospreys board to fight Welsh regional axe",
          "body": "Former Wales captain Alun Wyn Jones has joined the Ospreys board of directors with immediate effect. The 40-year-old, who made 257 appearances for the region before retiring in 2023, returns as a director during a turbulent period for domestic rugby. The Welsh Rugby Union plans to reduce professional sides from four to three by 2028, putting the Swansea-based region's future in jeopardy. Jones stated his move is about bringing together his playing and business experience to \"help drive long-term growth and stability for the organisation.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-08-24",
      "edition": "Monday 24 August",
      "sections": [
        {
          "kicker": "Disciplinary ban",
          "heading": "Tomás Albornoz handed four-match ban for intimidating referee Angus Gardner",
          "body": "Argentina fly-half Tomás Albornoz has been suspended for four matches after accepting a misconduct charge for intimidating referee Angus Gardner. The incident occurred following the controversial 31-24 defeat to England in Santiago del Estero, where the Pumas were denied a last-gasp try. Albornoz approached the Australian official twice and had to be restrained by teammates. His suspension ruled him out of the Test against South Africa, the double-header against Australia, and a French Top 14 fixture with Toulon."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "461": {
      "date": "2026-08-24",
      "edition": "Monday 24 August",
      "sections": [
        {
          "kicker": "Playmaker puzzle",
          "heading": "Les Kiss extends playmaker search as Wallabies prepare for Argentina tour",
          "body": "The Wallabies’ search for a settled playmaker pairing remains unresolved as head coach Les Kiss continues to experiment. Following Carter Gordon’s impressive return at fly-half in the 56-17 win over Japan on 15 August, Kiss has yet to lock in his first-choice combinations before the upcoming matches in Argentina. While reports hint at a potential return for veteran Quade Cooper, there is no official word from camp, leaving the crucial position open as Australia’s World Cup preparations intensify."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "463": {
      "date": "2026-08-24",
      "edition": "Monday 24 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Japan suffered heavy defeat in Townsville after Les Kiss reshuffled Wallabies",
          "body": "Following injury concerns, Australia head coach Les Kiss resolved his selection puzzle, explaining he \"looked to find some balance\" by making eight changes for the rematch on 15 August. The strategy paid off in Townsville, where the Wallabies ran in eight tries to condemn Japan to a heavy 56-17 defeat. Although university student Ryunosuke Ito sparked an early reply, Japan faded as Australia cruised clear."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "465": {
      "date": "2026-08-24",
      "edition": "Monday 24 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Richie Mo'unga returns as Dave Rennie names new All Blacks side for Lions",
          "body": "Richie Mo’unga will make his first appearance for the All Blacks since the 2023 World Cup final after being named at fly-half for Tuesday’s match against the Lions. Coach Dave Rennie has overhauled his starting XV following Saturday’s 33-16 victory over the Springboks, making 15 changes for the fixture at Ellis Park. Mo’unga has been playing in Japan and Rennie noted he “gets the chance to put a bit of pressure on” rival Ruben Love as New Zealand target a clean sweep of South African franchises."
        }
      ],
      "match": {
        "venue": "Ellis Park, Johannesburg"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-24",
      "edition": "Monday 24 August",
      "sections": [
        {
