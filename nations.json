  "digests": {
    "28": {
      "date": "2026-08-03",
      "edition": "Monday 3 August",
      "sections": [
        {
          "kicker": "SUPER RUGBY WOMEN",
          "heading": "Fijian Drua women suffer home grand final defeat against NSW Waratahs",
          "body": "A first-ever Super W grand final hosted on Fijian soil ended in disappointment as the hosts suffered a 17-34 defeat in Ba. Despite entering the match as minor premiers, the home side struggled with mistakes, losing six lineout throws, and trailed 24-0 shortly after half-time. Although they fought back with three tries, a brace from Waratahs replacement Amelia Whitaker sealed the title for the visitors, completing their hat-trick of consecutive championships and leaving the hosts to ponder missed opportunities."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "386": {
      "date": "2026-08-03",
      "edition": "Monday 3 August",
      "sections": [
        {
          "kicker": "CHARITY MATCH",
          "heading": "Jamie George assembles England rugby stars for charity cricket match",
          "body": "The national captain is set to skipper a stellar rugby line-up against County Championship cricket professionals on 19 August at Taunton's County Ground. Raising vital funds for the Motor Neurone Disease Association, the T20 fixture features prominent internationals including Ben Earl, Elliot Daly and Owen Farrell. George, a passionate cricket fan who uses the sport in training warm-ups, organised the crossover game to support Somerset captain Lewis Gregory's testimonial year, with England's stars determined to test themselves on the pitch."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-08-03",
      "edition": "Monday 3 August",
      "sections": [
        {
          "kicker": "STATISTICAL FOCUS",
          "heading": "France amass 426 points across their last 11 international matches",
          "body": "An attacking average of 38.7 points per game highlights a formidable run of form for Les Bleus over their last 11 fixtures. The side registered 426 points in total during this period, whilst conceding 291 at an average of 26.5 per match. This high-scoring window was headlined by a dominant display in the Six Nations in February 2026, when they secured their biggest victory of the stretch by beating Wales 54-12 away."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-03",
      "edition": "Monday 3 August",
      "sections": [
        {
          "kicker": "Concussion litigation",
          "heading": "Ireland faces sport-wide uncertainty as landmark rugby concussion lawsuit risks collapse",
          "body": "The sport's landscape could remain unaltered for longer as the landmark concussion lawsuit brought by retired players risks complete collapse. This legal action, which threatens to reshape duty-of-care protocols across the global game, is reportedly at risk of being dismissed after a key lawyer quit. With High Court proceedings stalled, Irish rugby administrators await a ruling that will dictate future safety liabilities, but the sudden legal disarray may now delay any final resolution indefinitely."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-08-03",
      "edition": "Monday 3 August",
      "sections": [
        {
          "kicker": "FORM ANALYSIS",
          "heading": "Italy slip near bottom of Nations Championship after fourth straight defeat",
          "body": "A disappointing run of results has left the national team near the bottom of the standings. In their last five matches, the side have managed only one victory. They have suffered four defeats across that same five-game period. This current run of four straight defeats was compounded by a 57-10 loss away to Australia in the Nations Championship group stage during July. The team have now conceded 131 points whilst scoring 37 in the tournament."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-03",
      "edition": "Monday 3 August",
      "sections": [
        {
          "kicker": "ADMINISTRATION",
          "heading": "Scottish Rugby sacks Chief Executive Alex Williamson after investigation into conduct",
          "body": "An independent investigation into conduct has led to the immediate dismissal of Murrayfield's top official, plunging the governing body into administrative disruption. Alex Williamson, who had been on extended leave since May, was sacked after the board of Scottish Rugby Limited concluded his behaviour fell 'significantly below' organisational standards. Chief financial officer David White assumes the role of interim chief executive. The search for a permanent successor begins as Scotland prepares for autumn fixtures and next year's World Cup."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-08-03",
      "edition": "Monday 3 August",
      "sections": [
        {
          "kicker": "REGIONAL REFORM",
          "heading": "Scarlets fight Ospreys for survival following Welsh Rugby Union licence cuts",
          "body": "A battle for survival in west Wales has been triggered by the Welsh Rugby Union's plans to reduce its professional teams from four to three by 2028. Cardiff and Dragons have been guaranteed licences, leaving Llanelli-based Scarlets and Swansea-based Ospreys fighting for the final slot. The Scarlets insisted they will remain \"at the heart of west Wales\" despite the threat. This survival fight has also prompted Swansea Council to resume legal proceedings against the governing body."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-08-03",
      "edition": "Monday 3 August",
      "sections": [
        {
          "kicker": "Opponent news",
          "heading": "Los Pumas face split Springbok squad after Erasmus leaves coaches behind",
          "body": "Preparing for Saturday's one-off Test in Buenos Aires, the world champions have arrived with a split coaching setup and a heavily rotated squad. Attack coach Tony Brown and Mobi-Unit coach Duane Vermeulen remained in Johannesburg to run a parallel camp with 12 frontline players, leaving head coach Rassie Erasmus to manage a 26-man travelling group. Although returning playmaker Sacha Feinberg-Mngomezulu is set to feature for the visitors, the split resources will test South Africa's depth at Estadio José Amalfitani."
        }
      ],
      "match": {
        "venue": "Estadio José Amalfitani, Buenos Aires"
      },
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "461": {
      "date": "2026-08-03",
      "edition": "Monday 3 August",
      "sections": [
        {
          "kicker": "PLAYMAKER SEARCH",
          "heading": "Quade Cooper targets sensational Wallabies return for 2027 Rugby World Cup",
          "body": "A potential home World Cup campaign has lured the 80-cap fly-half out of unofficial retirement, with the 38-year-old confirming he is interested in reclaiming the gold jersey. After coaching in Japan, the veteran's ambitions received strong backing from SA Rugby high-performance manager Dave Wessels. The development adds intrigue to Australia's ongoing playmaker search, where new head coach Les Kiss is evaluating Carter Gordon, Ben Donaldson and Declan Meredith for the upcoming two-test series against Japan."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-03",
      "edition": "Monday 3 August",
      "sections": [
        {
          "kicker": "Log standings",
          "heading": "Japan remain adrift of record ranking high after heavy France loss",
          "body": "The national side currently sits 10th in the 12-team log. Across three rounds of the current tournament, Japan have recorded one win. They have also suffered two losses. A 15-42 defeat against France in the last fixture leaves the side with a total of 62 points scored. They have conceded 88 points across their three matches. This results in a points difference of -26. Although the Brave Blossoms reached a record high of No. 7 in 2019, they now occupy the lower reaches of the table."
        }
      ],
      "rung": "data"
    },
    "465": {
      "date": "2026-08-03",
      "edition": "Monday 3 August",
      "sections": [
        {
          "kicker": "SELECTION CALL",
          "heading": "Richie Mo'unga qualifies for South Africa tour recall after match-winning Canterbury return",
          "body": "A match-winning cameo during Saturday’s NPC victory for Canterbury has cleared the final hurdle for Richie Mo'unga to return. Appearing for the first time since 2020, the fly-half scored a decisive 78th-minute solo try to secure a 38-31 win over Auckland. Head coach Dave Rennie previously suggested the playmaker would only be added to the tour squad as injury cover, noting \"if we had an injury at 10, then he’s an option to come in.\" His eligibility provides a significant selection boost before the tour opener against the Stormers."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-03",
      "edition": "Monday 3 August",
      "sections": [
        {
          "kicker": "Coach's nightmare",
          "heading": "Rassie Erasmus reveals his 'nightmare' scenario as Springboks land in Argentina",
          "body": "The South African coach has revealed that his \"biggest fear\" is not losing matches, but rather the risk of the national team's current \"satisfaction\" and \"joy\" fading for South Africans. Speaking as the squad arrived in Buenos Aires for a Test against Los Pumas, Erasmus explained that results are secondary to the unity the team provides. Meanwhile, attack coach Tony Brown and Duane Vermeulen have stayed in Johannesburg to lead a parallel training camp for 12 senior stars preparing for the New Zealand series."
        }
      ],
      "match": {
        "venue": "Estadio José Amalfitani, Buenos Aires"
      },
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
