    "28": {
      "date": "2026-11-26",
      "edition": "Thursday 26 November",
      "sections": [
        {
          "kicker": "Breakdown battle",
          "heading": "Fiji's breakdown pressure cost Italy in Udine, admits coach Roberto Santamaria",
          "body": "Santamaria, Italy's forwards coach with a scrum brief, told Tuesday's press session that the Azzurri conceded extra penalties for holding on and side entry at the ruck. He added that Italy knew going in that the Fijians are strong at generating turnovers and exploiting them. Italy made deep breaks through Fiji's defence, he said, yet every such sequence ended in a penalty they could not turn into a try. One drive stalled a metre out. Italy carry a seven-match losing streak into the Twickenham rematch for 11th place."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa's Pieter-Steph du Toit ruled out of France final",
          "body": "Ireland's Dan Sheehan handed two-game suspension. Italy lose Domingo Miotti to thigh injury."
        }
      ],
      "match": {
        "venue": "Twickenham, London"
      },
