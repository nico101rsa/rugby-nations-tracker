  "digests": {
    "28": {
      "date": "2026-08-12",
      "edition": "Wednesday 12 August",
      "sections": [
        {
          "kicker": "Tragic passing",
          "heading": "Fijian forward Saimoni Vunilagi dies aged 26 after training in Japan",
          "body": "The Fijian rugby community is mourning the tragic passing of back-rower Saimoni Vunilagi, who has died in Japan at the age of 26 from suspected heatstroke. Vunilagi, a former Tokyo Sungoliath forward who recently joined second-division club Kyuden Voltex, fell ill following a training session in Fukuoka. Despite receiving hospital treatment, he passed away on Friday. Kyuden Voltex released a statement saying: \"The players, staff, and all team associates are devastated by this sudden news.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "386": {
      "date": "2026-08-12",
      "edition": "Wednesday 12 August",
      "sections": [
        {
          "kicker": "Disciplinary ban",
          "heading": "Tomás Albornoz receives four-match ban for intimidating referee after England win",
          "body": "Argentina fly-half Tomás Albornoz has received a four-match suspension after admitting to intimidating referee Angus Gardner during England's controversial 31-24 victory in Santiago del Estero last month. The Pumas playmaker had to be restrained by teammates after Gardner disallowed a last-gasp try. While Albornoz denied his behaviour was abusive, the ban rules him out of Argentina's upcoming tests, vindicating a result that gave under-fire head coach Steve Borthwick a welcome sigh of relief."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "387": {
      "date": "2026-08-12",
      "edition": "Wednesday 12 August",
      "sections": [
        {
          "kicker": "Fiji preview",
          "heading": "France look to replicate home victory over Fiji from November 2025",
          "body": "France look ahead to their next fixture having beaten Fiji 34-21 at home in November 2025 during an international friendly. Les Bleus currently sit third in the table after three rounds, having won two matches and lost one. Across those three opening fixtures, the team scored 116 points and conceded 75. That leaves them with a positive points difference of 41, boosted by their 42-15 victory against Japan in round three."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-12",
      "edition": "Wednesday 12 August",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Ireland lock Iain Henderson undergoes hip surgery and faces months out",
          "body": "Ireland lock Iain Henderson is set for another lengthy spell on the sidelines after undergoing successful hip surgery. Ulster confirmed the 34-year-old captain will be \"unavailable for a number of months\" following the summer procedure. This marks the veteran lock's third major hip operation, following previous interventions in 2014 and 2020. The news rules Henderson out of the start of the domestic season, meaning national head coach Andy Farrell faces a waiting game on the forward's fitness ahead of the November internationals."
        }
      ]
    },
    "389": {
      "date": "2026-08-12",
      "edition": "Wednesday 12 August",
      "sections": [
        {
          "kicker": "By the numbers",
          "heading": "Italy drop to 11th place in the standings after three defeats",
          "body": "Italy's best world ranking remains No. 8, a position they achieved in 2007 and matched in 2024. In their first three matches of the tournament, the Azzurri suffered three defeats. During this three-game window, the team scored 37 points and conceded 131. Their most recent match ended in a 10-57 loss against Australia. This leaves Italy sitting 11th in the tournament standings as they prepare to face South Africa."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-12",
      "edition": "Wednesday 12 August",
      "sections": [
        {
          "kicker": "Legal dispute",
          "heading": "Scottish Rugby still awaits crucial High Court brain injury lawsuit decision",
          "body": "The High Court has still not delivered its judgment on the governing bodies' applications to dismiss the landmark rugby brain injury lawsuit, which was first heard late last month. Scottish Rugby remains in limbo as the judge continues to deliberate on strike-out applications that could eliminate up to 95 per cent of the claimants' cases. No timeline has been set for the decision, which will also resolve questions surrounding the future of the claimants' legal representation."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-12",
      "edition": "Wednesday 12 August",
      "sections": [
        {
          "kicker": "Rankings rise",
          "heading": "Wales climb into world top 10 after Wallabies defeat Japan in Osaka",
          "body": "Wales have returned to the top 10 of the World Rugby rankings for the first time since July 2024, climbing to 10th place without playing a match. The rise comes courtesy of Australia's narrow 35-32 victory over Japan in Osaka. Under new head coach Les Kiss, the Wallabies' win bumped Japan down two places to 12th, allowing Wales to climb above them. The national side will next face Japan in their upcoming fixture."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "460": {
      "date": "2026-08-12",
      "edition": "Wednesday 12 August",
      "sections": [
        {
          "kicker": "Suspension blow",
          "heading": "Santiago Carreras covers fly-half with Tomás Albornoz serving four-match suspension",
          "body": "Santiago Carreras has stepped up to cover fly-half for Argentina as Tomás Albornoz serves a four-match suspension. With Albornoz unavailable, Carreras transitioned from his usual full-back role to steer the backline. Despite the positional shift, the versatile playmaker ran the game with composure, winning key turnovers in Buenos Aires. The performance offers head coach Felipe Contepomi a vital alternative as Los Pumas manage squad depth ahead of their November internationals."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-08-12",
      "edition": "Wednesday 12 August",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Injury rules Joseph-Aukuso Suaalii out as Les Kiss summons Josh Flook",
          "body": "Wallabies back Joseph-Aukuso Suaalii will miss Saturday's second Test against Japan in Townsville after suffering a minor hamstring strain. Head coach Les Kiss has called Queensland Reds centre Josh Flook into the squad, while forward Tom Hooper returns after recovering from a shoulder injury. Suaalii's absence halts plans to start him on the wing following Australia's tense 35-32 victory in Osaka. Kiss must also replace lock Miles Amatosero, who received a three-match suspension for a dangerous clearout."
        }
      ],
      "match": {
        "venue": "Townsville"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-12",
      "edition": "Wednesday 12 August",
      "sections": [
        {
          "kicker": "Red card fallout",
          "heading": "Miles Amatosero banned for high hit on Japan captain Warner Dearns",
          "body": "Wallabies lock Miles Amatosero has received a three-match suspension following his red card in Saturday’s 35-32 defeat for Japan in Osaka. A disciplinary committee ruled the 24-year-old was guilty of dangerous play after making shoulder contact with the head of Brave Blossoms captain Warner Dearns during a 33rd-minute ruck. Amatosero will miss Australia’s return fixture in Townsville, though Japan head coach Eddie Jones remains focused on his side's narrow loss, having described the close three-point defeat as 'disappointing'."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "465": {
      "date": "2026-08-12",
      "edition": "Wednesday 12 August",
      "sections": [
        {
          "kicker": "Tour triumph",
          "heading": "Damian McKenzie suffers ankle injury as All Blacks thrash Sharks 54-0",
          "body": "Dave Rennie's shadow All Blacks side brushed aside atrocious weather to dismantle the Sharks 54-0 in Durban on Tuesday, crossing for eight tries in a dominant display. Winger Fehi Fineanganofo crossed twice, whilst fly-half Ruben Love slotted seven conversions to complete the rout. However, the victory was marred when playmaker Damian McKenzie hobbled off with an ankle injury in the first half. Emoni Narawa replaced the experienced All Black as the tourists comfortably closed out their second match of the South African tour."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-12",
      "edition": "Wednesday 12 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Rassie Erasmus confirms Jasper Wiese remains first choice Springboks number eight",
          "body": "Erasmus has ended speculation regarding a shift at the back of the scrum despite Cameron Hanekom’s performance in the 17-10 victory over Argentina. While the head coach acknowledged Hanekom is improving with every game, he was blunt regarding the pecking order, stating that Jasper Wiese is \"clearly the number one number eight.\" With the experimental rotation phase now over, South Africa look to settle on a primary 23 to protect their position at the top of the log."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
