  "digests": {
    "28": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Senirusi Seruvakula recalls Caleb Muntz to start Pacific Nations Cup final",
          "body": "Fiji interim head coach Senirusi Seruvakula has recalled fly-half Caleb Muntz to start Saturday’s Pacific Nations Cup final against Japan in Tokyo. Muntz’s inclusion is one of four changes to the side that beat Canada, forcing Isaiah Armstrong-Ravula to shift to full-back. Elsewhere, Elia Canakaivata starts at No. 8 ahead of Isoa Tuwai. With Japan seeking a first title since 2019, Seruvakula is wary of the hosts. \"We are not only looking at them, but we will also be focused on our strengths heading into Saturday,\" he said."
        }
      ],
      "match": {
        "venue": "Prince Chichibu Memorial Stadium, Tokyo"
      },
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "386": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "Premiership return",
          "heading": "Joe Marchant eyes England recall after joining Sale from Stade Français",
          "body": "Joe Marchant is targeting an England recall under Steve Borthwick after ending his three-year spell in France with Stade Français to join Sale Sharks. The 30-year-old centre, who married Alan Shearer's daughter over the summer, became a favourite of Borthwick's during the 2023 World Cup campaign before his move to Paris temporarily halted his international career. Now back in the Premiership, Marchant's defensive communication and aerial skill on the wing make him a prime candidate for November's autumn Tests."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "Mental barrier",
          "heading": "Ben Youngs warns Fabien Galthié of French psychological barrier against Springboks",
          "body": "Former England scrum-half Ben Youngs believes Les Bleus must defeat South Africa during the upcoming Nations Championship to dismantle a growing mental block. Reflecting on France's recent painful defeats to the world champions—including a one-point World Cup quarter-final exit and a 32-17 loss in Paris—Youngs insisted that Fabien Galthié's side face a psychological hurdle they cannot otherwise overcome before the next World Cup. He identified France as one of the few teams capable of challenging the Springboks, provided they can finally heal these Parisian scars."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "388": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "Squad recall",
          "heading": "Jimmy O'Brien reveals Andy Farrell's blunt warning upon summer Ireland recall",
          "body": "Leinster winger Jimmy O'Brien has revealed the blunt warning head coach Andy Farrell gave him during Ireland’s summer tour. After injuries to other options forced a sudden promotion in Sydney, the head coach told the 29-year-old: \"You’re in, don’t f*** it up.\" O'Brien, who had spent years in the international wilderness, seized his opportunity to start all three tour fixtures against Australia, Japan and New Zealand. The redemption puts the winger back in the frame with the run-in to Rugby World Cup 2027 about to get started."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "WXV campaign",
          "heading": "Plinio Sciamanna includes seven uncapped players for Italy’s clash with Japan",
          "body": "New head coach Plinio Sciamanna, who spent five years as assistant coach, has named seven uncapped players in the Azzurre squad for Saturday's WXV Global Series opener in Fontanafredda. Italy boast a strong historical record against Japan with six wins from eight meetings, including a 33-15 victory in Calvisano last year. However, Sciamanna must address discipline issues after the team picked up the most yellow cards in the Six Nations. Under pressure to improve, the hosts will rely on 20-year-old scrum-half Alia Bitonci, who already has 15 caps."
        }
      ],
      "match": {
        "venue": "Stadio Omero Tognon, Fontanafredda"
      },
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "390": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Dave Butcher hands Ceitidh Ainsworth first Scotland start against New Zealand",
          "body": "Interim head coach Dave Butcher has made four changes to Scotland's starting line-up for Saturday's WXV clash with New Zealand at Hive Stadium. Glasgow Warriors scrum-half Ceitidh Ainsworth receives her first international start, replacing clubmate Rhea Clarke, who drops to the bench. Additionally, Harlequins lock Sarah Bonar is poised to secure her 52nd cap off the replacements bench, returning from an injury lay-off. These tactical adjustments follow a heavy 64-26 defeat to Canada, as the hosts look to bounce back against the Black Ferns."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "Award recognition",
          "heading": "Rhys Carré named Welsh Player of the Year following successful international return",
          "body": "Saracens prop Rhys Carré has been named the Welsh Rugby Writers’ Association Men’s Player of the Year, becoming the first prop to win the award since Gethin Jenkins in 2009. Carré has enjoyed a significant career resurgence under Steve Tandy, featuring in 11 of Wales' last 12 Tests following his 2023 World Cup exclusion. \"It’s a bit surreal,\" Carré said of the accolade, which follows a campaign featuring three Six Nations tries and a solo effort in Dublin voted try of the championship."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "Statistical overview",
          "heading": "Argentina maintain high-scoring trend across recent international fixtures",
          "body": "Argentina have displayed significant attacking output in their recent outings, recording a total of 321 points across their last 11 matches. During this same 11-game window, Los Pumas conceded 346 points, resulting in an average of 29.2 points scored and 31.5 points conceded per match. The most prominent attacking performance for the side during this period occurred in November 2025, when they secured a 52-28 victory over Wales in an international friendly."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "Preparation",
          "heading": "Les Kiss insists the Wallabies are ready for physical Springboks challenge",
          "body": "Coach Les Kiss has acknowledged that his side must raise their performance levels for the upcoming one-off Test against the Springboks. While the Wallabies remain unbeaten in four matches under his tenure, Kiss admitted the squad has been somewhat removed from the intense physicality recently displayed in the Rugby’s Greatest Rivalry series. \"The intensity and the physicality of the matches, we’re a little bit removed from that,\" Kiss said, adding that his team is nevertheless \"up for the fight\" in Perth."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "463": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "PNC final",
          "heading": "Eddie Jones demands consistency as Japan targets Pacific Nations Cup title",
          "body": "Japan host Fiji in Saturday’s Asahi Super Dry Pacific Nations Cup final at Prince Chichibu Memorial Stadium, eyeing their first title since 2019. Despite a dominant 63-14 semi-final win over the USA, head coach Eddie Jones warned that his side must improve their concentration. \"At times we lost a bit of concentration, made some silly errors that then compounded,\" Jones noted. Hooker Mamoru Harada has confirmed the squad's target is to secure the trophy against the defending champions."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "John Plumtree considers picking bigger players after losing physical series battle",
          "body": "All Blacks assistant coach John Plumtree has suggested a shift in selection strategy may be required to counter top-tier physicality. Following a 3-1 series loss in Rugby’s Greatest Rivalry, where New Zealand struggled to contain the Springboks' set-piece and gainline dominance, Plumtree admitted: \"If it’s a physical thing and these guys are just too big for us, then they have to start picking some bigger players.\" The coach noted that New Zealand currently lack the size to consistently stop opposition momentum."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "Series review",
          "heading": "Siya Kolisi earns legendary status after Springboks win rivalry series",
          "body": "Following the Springboks’ 3-1 triumph over the All Blacks, Siya Kolisi has been hailed for his influential leadership and physicality throughout the series. After missing the opening loss at Ellis Park, the 35-year-old returned to inspire a revival that saw the world champions clinch successive victories. Kolisi recently praised the collective belief within the camp, stating the team is \"bigger than any individual.\" Analysts now view this success as a vital indicator of the standards required for next year’s World Cup."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
}