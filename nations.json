    "461": {
      "date": "2026-11-15",
      "edition": "Sunday 15 November",
      "sections": [
        {
          "kicker": "Captain's message",
          "heading": "Harry Wilson hunts ruthless Wallabies response to Scotland, citing Springboks win",
          "body": "Wallabies captain Harry Wilson says the side has taken inspiration from their win over the Springboks in Perth as they seek a response to a three-game losing streak. Wilson recalled Australia blowing South Africa away in the first hour before holding on through several late cards. He wants that edge back: \"Just the ruthless mindset we had there and that's what we want to see more of this weekend.\" Carter Gordon's return at flyhalf adds to the attacking case."
        },
        {
          "kicker": "Around the world",
          "heading": "Wales stun All Blacks for first win since 1953",
          "body": "France beat South Africa 21-19. Ireland beat Fiji 43-15."
        }
