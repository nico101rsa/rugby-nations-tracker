  "digests": {
    "28": {
      "date": "2026-07-30",
      "edition": "Thursday 30 July",
      "sections": [
        {
          "kicker": "Disciplinary blow",
          "heading": "Scrum-half Kuruvoli handed four-week ban for physical abuse during Nations Championship",
          "body": "The Flying Fijians’ winless start to the Nations Championship has been further complicated by a four-week ban handed to scrum-half Kuruvoli. The suspension, issued for an act of physical abuse, sidelined the playmaker during a critical stretch where Fiji slumped to three consecutive defeats. Following the recent 17-33 loss to Scotland, the absence of Kuruvoli’s tactical control has left the coaching staff searching for solutions as the side remains rooted to the bottom of the tournament table."
        }
      ]
    },
    "386": {
      "date": "2026-07-30",
      "edition": "Thursday 30 July",
      "sections": [
        {
          "kicker": "PLAYER WELFARE",
          "heading": "George Kruis applauds Steve Borthwick for resting Maro Itoje during recent tour",
          "body": "Former England lock George Kruis has backed Steve Borthwick’s decision to omit Maro Itoje from the recent Nations Championship tour. Speaking after a record-breaking charity sevens match, he highlighted the heavy \"mental load\" carried by the captain, who has balanced leadership duties with personal bereavement. The 45-cap veteran suggested the break is perfectly timed ahead of next year’s World Cup, noting that \"you can’t keep going to the well\" when managing elite talent. England concluded the series with a 31-24 win in Santiago."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-07-30",
      "edition": "Thursday 30 July",
      "sections": [
        {
          "kicker": "SEVENS SUCCESS",
          "heading": "France Men claim fifth European Sevens title by crushing Italy in Split",
          "body": "France secured the Rugby Europe 7s Championship Series 2026 title with a 43-0 victory over Italy in the final match in Split. After finishing second to Germany in the opening leg, Les Bleus regained their dominance in Croatia, recording comprehensive wins over Georgia and Spain to reach the showpiece. This result marks a fifth championship for the men’s programme. The women’s side finished the season as runners-up to Poland, having previously secured the gold medal in the Hamburg leg."
        }
      ]
    },
    "388": {
      "date": "2026-07-30",
      "edition": "Thursday 30 July",
      "sections": [
        {
          "kicker": "Coaching return",
          "heading": "Joe Schmidt returns to Irish rugby in 12-month consultancy role with Ulster",
          "body": "Former Ireland head coach Joe Schmidt has joined Ulster on a one-year consultancy basis following his departure from the Wallabies. The New Zealander, who led Ireland to three Six Nations titles, will provide mentorship and strategic support to Richie Murphy’s coaching staff at all levels. Murphy noted he has worked with Schmidt on \"a number of occasions\" and knows \"first-hand the value he brings\" to the province as they prioritise the long-term development of their coaching pathway."
        }
      ],
      "match": {
        "venue": "Eden Park, Auckland"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-07-30",
      "edition": "Thursday 30 July",
      "sections": [
        {
          "kicker": "Azzurri performance",
          "heading": "Italy finish July in 11th place after shipping 131 points against",
          "body": "Italy enter the tournament break sitting 11th in the Nations Championship table following three consecutive defeats. Across their last 11 fixtures, the Azzurri have averaged 17.3 points scored and 28.9 points conceded per game. During this period, the side has registered 190 total points while shipping 318. The most significant victory in this 11-match window remains the 34-19 win over Chile in November 2025. This defensive trend continued in their last result, a 10-57 loss to Australia."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-07-30",
      "edition": "Thursday 30 July",
      "sections": [
        {
          "kicker": "Concussion lawsuit",
          "heading": "Scottish players enter legal limbo as landmark rugby concussion solicitor is removed",
          "body": "The Scottish contingent involved in the landmark concussion lawsuit remains in limbo following the dismissal of solicitor Richard Boardman, the lawyer previously leading the case against governing bodies. The High Court has left the action in the balance as the group of more than 1,000 former players must now confirm which firm will replace Boardman. With these former internationals seeking damages for brain injuries, the legal process cannot proceed until new representation is finalised."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-07-30",
      "edition": "Thursday 30 July",
      "sections": [
        {
          "kicker": "Playmaker return",
          "heading": "Gareth Anscombe signs for Scarlets after leaving Top 14 side Bayonne",
          "body": "Gareth Anscombe has returned to Wales, signing for the Scarlets to bolster a fly-half department that struggled for depth last season. The 42-cap international joins from Top 14 side Bayonne, where injury limited him to just six appearances. Director of rugby Nigel Davies confirmed the 35-year-old is \"joining Scarlets to challenge for the jersey,\" providing vital competition for Sam Costelow. Following Wales' recent 43-0 defeat in Durban, Anscombe’s experience offers a welcome boost to the domestic options available for national selection."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-07-30",
      "edition": "Thursday 30 July",
      "sections": [
        {
          "kicker": "Squad overhaul",
          "heading": "Felipe Contepomi names 10 rookies after Julián Montoya and Tomás Albornoz banned",
          "body": "Felipe Contepomi has named 10 uncapped players in a 34-man squad for upcoming home Tests against South Africa and Australia. The selection follows a disciplinary fallout from the England defeat, with captain Julián Montoya and fly-half Tomás Albornoz both suspended for referee abuse. Contepomi cited a desire to \"broaden the squad\" while resting several senior figures and navigating European club commitments. The rookie contingent, including fullback Mateo Soler and wing Agustín Fraga, has joined the camp in Cardales ahead of the Buenos Aires opener."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-07-30",
      "edition": "Thursday 30 July",
      "sections": [
        {
          "kicker": "COACHING APPOINTMENT",
          "heading": "Former boss Joe Schmidt joins Ulster as consultant following his Wallabies exit",
          "body": "Joe Schmidt has secured a return to Irish rugby, joining Ulster as a coach development adviser just weeks after concluding his tenure with Australia. The former Wallabies boss, who oversaw the 57-10 win against Italy earlier this month, will provide strategic support in a 12-month consultancy role. Schmidt noted that developing the coaching pathway \"is something that we believe can add value.\" It marks his first appointment since ending a stint that featured six consecutive defeats prior to the victory over Italy."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-07-30",
      "edition": "Thursday 30 July",
      "sections": [
        {
          "kicker": "International series",
          "heading": "Japan prepare to face Australia in historic two-test August series",
          "body": "Japan are set to test themselves against Australia in a historic two-test series this August. While the Brave Blossoms turn their attention to these upcoming meetings—starting at Hanazono Rugby Stadium before shifting to Queensland—the squad must remain focused on the current Nations Championship, where they sit 10th on the log. Though the sides have met rarely since 1975, the series offers a chance for Japan to build on the competitive foundations established under their recent international campaigns."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "465": {
      "date": "2026-07-30",
      "edition": "Thursday 30 July",
      "sections": [
        {
          "kicker": "Selection pathway",
          "heading": "Richie Mo'unga returns for Canterbury ahead of Greatest Rivalry tour",
          "body": "Fly-half Richie Mo'unga is set to make his competitive return for Canterbury in this weekend’s NPC opener. Currently ineligible for the All Blacks due to a self-imposed New Zealand Rugby mandate following his tenure in Japan, Mo'unga must play domestic rugby to be considered for the squad. Head coach Dave Rennie has confirmed that while the playmaker missed the initial 44-man selection, he could be called up as a late injury replacement should he successfully complete his return to the field."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-07-30",
      "edition": "Thursday 30 July",
      "sections": [
        {
          "kicker": "Selection blow",
          "heading": "Rassie Erasmus confirms Ox Nché and Franco Mostert miss Argentina Test",
          "body": "Springbok head coach Rassie Erasmus has confirmed that props Ox Nché and lock Franco Mostert will be unavailable for the upcoming trip to Buenos Aires due to long-term injuries. While Erasmus noted that the squad’s return to fitness is not ideal following recent layoffs, he stressed the importance of the fixture as an audition for the looming series against the All Blacks. “Apart from them, everyone is ready to play,” Erasmus said regarding the remaining members of his touring party."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
}