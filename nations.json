  "digests": {
    "28": {
      "date": "2026-07-28",
      "edition": "Tuesday 28 July",
      "sections": [
        {
          "kicker": "Kuruvoli suspended",
          "heading": "Simione Kuruvoli banned for four weeks following Nations Championship physical abuse",
          "body": "Scrum-half Simione Kuruvoli has been suspended for four weeks following a citing for physical abuse during the Nations Championship. The ban serves as a significant setback for the Flying Fijians, who remain bottom of the standings after three consecutive defeats, most recently against Scotland. Kuruvoli will miss the immediate upcoming schedule after the disciplinary hearing confirmed the sanction. His absence leaves a void at No. 9 as the national side looks to recover from a winless start to the tournament."
        }
      ]
    },
    "386": {
      "date": "2026-07-28",
      "edition": "Tuesday 28 July",
      "sections": [
        {
          "kicker": "Forward depth",
          "heading": "Henry Pollock and Guy Pepper climb depth chart as Steve Borthwick reassesses pack",
          "body": "Steve Borthwick is weighing up his options in the pack after several youngsters seized their opportunities during the Nations Championship. Henry Pollock and Guy Pepper have both climbed the pecking order in the back row following strong displays in July. While injuries to the likes of Sam Underhill and Will Stuart hampered initial plans, they allowed Borthwick to award debut caps to George Kloska and Emmanuel Iyogun. England currently sit fourth in the table after the 31-24 victory over Argentina."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-07-28",
      "edition": "Tuesday 28 July",
      "sections": [
        {
          "kicker": "TACTICAL IDENTITY",
          "heading": "Fabien Galthié’s 'fusion' selection tactics credited with maintaining France’s elite status",
          "body": "Analysis of the Nations Championship’s leading sides credits Fabien Galthié with evolving France’s tactical identity through \"fusion\" selection. Rather than adhering to rigid positional specifications, Galthié treats jersey numbers as administrative conveniences, prioritising a specific blend of skills—such as distribution or jackal threats—for each match. This approach, focusing on versatile talent over traditional roles, sees France sit third in the log following their 42-15 victory over Japan in Round 3."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "388": {
      "date": "2026-07-28",
      "edition": "Tuesday 28 July",
      "sections": [
        {
          "kicker": "TOUR AUTOPSY",
          "heading": "Matt Williams condemns Ireland error count following heavy Eden Park defeat",
          "body": "Former Leinster coach Matt Williams has criticised Ireland’s \"highly inaccurate\" Nations Championship campaign, claiming the side were \"well and truly beaten\" by New Zealand. Despite victories over Australia and Japan, Williams highlighted a \"mountain of errors\" in Auckland, including 18 turnovers and 35 missed tackles. Head coach Andy Farrell agreed that the 40-21 loss was \"inaccurate\", noting that continuity struggled due to discipline and handling errors. Ireland finish the July window with two wins from three as the squad enters the off-season."
        }
      ],
      "match": {
        "venue": "Eden Park, Auckland"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-07-28",
      "edition": "Tuesday 28 July",
      "sections": [
        {
          "kicker": "FORM STRUGGLE",
          "heading": "Italy slide to 11th place following their fourth consecutive international defeat",
          "body": "Italy currently sit 11th in the standings after suffering four consecutive defeats in recent international play. In their last five matches, the Azzurri have recorded one win and four losses, with the most recent result being a 57-10 loss to Australia away in July. This run includes three winless rounds in the current Nations Championship group stage, where Italy have conceded 131 points across three matches. The side has struggled for results since their last victory, leaving them ahead of only one team."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-07-28",
      "edition": "Tuesday 28 July",
      "sections": [
        {
          "kicker": "BOLD AMBITION",
          "heading": "Pierre Schoeman insists Scotland are world's top five following Fiji victory",
          "body": "Following the 33-17 victory over Fiji, Pierre Schoeman claimed Gregor Townsend's side now belongs among the global elite. Schoeman, who provided one of four second-half tries from a high-impact bench, stated: \"I feel we are a top-three, top-five team in the world.\" The result sees Scotland equal their best-ever world ranking while sitting fifth in the overall log. While Rassie Erasmus recently dubbed them a top-three nation, Schoeman is targeting the November visit of New Zealand to prove they can go \"toe-to-toe\" for 80 minutes."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-07-28",
      "edition": "Tuesday 28 July",
      "sections": [
        {
          "kicker": "CONCUSSION LAWSUIT",
          "heading": "Alix Popham confirms new legal representation in concussion lawsuit against WRU",
          "body": "Former Wales international Alix Popham has confirmed a change in legal representation for the multi-million-pound concussion lawsuit against the Welsh Rugby Union and other governing bodies. Following two days of High Court proceedings, Popham clarified that appointing a new firm was necessary due to the \"scale and complexity\" of the litigation involving 561 former players. The switch follows criticism from Senior Master Jeremy David Cook regarding previous management of the case. The judge is now deliberating on whether to strike out claims that lack required neurological documentation."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "460": {
      "date": "2026-07-28",
      "edition": "Tuesday 28 July",
      "sections": [
        {
          "kicker": "Santiago hostilities",
          "heading": "Ellis Genge footage reveals how football rivalry sparked Santiago’s hostile atmosphere",
          "body": "Freshly released footage from the England dressing room has exposed the volatile backdrop to the recent 24-31 loss in Santiago del Estero. Vice-captain Ellis Genge was recorded using a profanity-laden speech to urge his side to 'cause some pain' after Argentina’s football team beat England in a World Cup semi-final. The Test, which produced a record number of yellow cards, was overshadowed by claims of hostility. Sidelined veteran George Ford had also cautioned England that Los Pumas would attempt to get under their skin."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-07-28",
      "edition": "Tuesday 28 July",
      "sections": [
        {
          "kicker": "TACTICAL SHIFT",
          "heading": "Les Kiss outlines new Wallabies gameplan focused on width and collaboration",
          "body": "New Wallabies head coach Les Kiss has outlined a shift towards a more expansive gameplan, promising to introduce greater width to Australia’s attack. The Bundaberg-born coach, who named his first 34-man squad for the upcoming series against Japan, intends to move away from the more structured approach of his predecessor, Joe Schmidt. \"I work off the strong principle of going forward, but I do like a lot more width in the game,\" Kiss said. The squad includes a recall for Lukhan Salakaia-Loto and a maiden call-up for Isaac Henry."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-07-28",
      "edition": "Tuesday 28 July",
      "sections": [
        {
          "kicker": "Suntory signing",
          "heading": "James Lowe joins Suntory Sungoliath as Irish winger replaces Cheslin Kolbe",
          "body": "Ireland winger James Lowe has confirmed a move to Suntory Sungoliath, signing a two-year deal to replace Springbok Cheslin Kolbe at the League One club. The 45-cap international, who featured in the British and Irish Lions’ recent tour of Australia, arrives following a successful stint with Leinster. Lowe said he aims to bring \"energy, physicality and a positive attacking mindset\" to the side. His arrival marks another high-profile addition to the Japanese top flight as domestic clubs prioritise world-class Test talent."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "465": {
      "date": "2026-07-28",
      "edition": "Tuesday 28 July",
      "sections": [
        {
          "kicker": "BOMBSHELL SIGNING",
          "heading": "All Blacks legend Ma'a Nonu signs short-term deal with the Sharks",
          "body": "Ma'a Nonu will continue his professional career in South Africa after signing a short-term deal with the Durban-based Sharks. The 44-year-old double World Cup winner joins the franchise following a second spell at RC Toulon, where he became the oldest player to feature in the Top 14. Nonu reportedly spent two weeks in New Zealand pondering the move before agreeing to a modest salary. He is expected to mentor young talent like Jurenzo Julius at the eighth professional club of his storied career."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-07-28",
      "edition": "Tuesday 28 July",
      "sections": [
        {
          "kicker": "Squad update",
          "heading": "Rassie Erasmus recalls 10 experienced Springboks for upcoming Test series build-up",
          "body": "Rassie Erasmus has bolstered his 44-man squad with 10 seasoned stars, including Siya Kolisi, Eben Etzebeth, and Sacha Feinberg-Mngomezulu, as preparations intensify for the upcoming series. The coach’s decision to integrate these veterans follows a productive Nations Championship block where 43 players saw action. While the group continues to evolve, Steve Hansen has praised the coaching staff for being \"clever\" in how they build cohesion, ensuring new prospects are surrounded by a core of established, experienced players."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
