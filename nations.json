  "digests": {
    "28": {
      "date": "2026-09-02",
      "edition": "Wednesday 2 September",
      "sections": [
        {
          "kicker": "CAMPAIGN METRICS",
          "heading": "Fiji anchor the global standings after three successive test defeats",
          "body": "Fiji anchor the bottom of the standings after suffering three straight defeats, culminating in a 17-33 loss to Scotland in the previous round. Across their last 11 matches, the Flying Fijians have scored 315 points. They conceded 326 points over that span, averaging 28.6 points scored per game against 29.6 conceded. The biggest win in this 11-game window remains a 63-10 home victory over Canada in September 2025 during the Pacific Nations Cup knockout stage."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-02",
      "edition": "Wednesday 2 September",
      "sections": [
        {
          "kicker": "Legal battle",
          "heading": "High Court rejects RFU bid to dismiss landmark concussion lawsuit",
          "body": "The RFU's attempt to halt landmark brain injury litigation failed last week after the High Court ruled the group action by hundreds of former players can proceed. Alongside World Rugby and the Welsh Rugby Union, English rugby's governing body lost its joint application to dismiss the cases. The ruling prevents a costly, indefinite delay for the claimants, who allege the authorities failed to protect them from permanent brain damage. Legal proceedings will now focus on establishing a manageable timetable towards a full trial."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "387": {
      "date": "2026-09-02",
      "edition": "Wednesday 2 September",
      "sections": [
        {
          "kicker": "Fiji rematch",
          "heading": "Fabien Galthié targets repeat performance after France beat Fiji in 2025",
          "body": "France enter the autumn window looking to build on their last meeting with Fiji, where Les Bleus secured a 34-21 home victory in November 2025. Fabien Galthié's side currently sit third in the Nations Championship table after three rounds of action. In those three fixtures, France have recorded two victories alongside a single defeat. The squad has scored 116 points during the tournament. Conversely, the defence has conceded 75 points, leaving France with a positive points difference of 41 as they prepare for the fourth round."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-02",
      "edition": "Wednesday 2 September",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Vascular injury rules Jack Crowley out of Ireland’s November tests",
          "body": "Ireland have suffered a major setback ahead of their autumn series, with fly-half Jack Crowley ruled out until the new year. Munster head coach Clayton McMillan confirmed the 26-year-old is sidelined with a lower limb vascular injury that has kept him out since April. Having missed the July tests, Crowley will now sit out November’s games against Argentina, Fiji, and South Africa. McMillan emphasised that “ensuring he gets back to 100% is the priority” as Ireland look to alternatives like Sam Prendergast."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-02",
      "edition": "Wednesday 2 September",
      "sections": [
        {
          "kicker": "Campaign statistics",
          "heading": "Italy drop to 11th in Nations Championship after heavy Australia defeat",
          "body": "Italy occupy 11th place in the Nations Championship table after three matches of the campaign. The Azzurri have lost all three of those fixtures. In those three matches, the team scored 37 points. They conceded 131 points across the same period. This leaves them with a point difference of -94. This run follows a 10-57 defeat against Australia in the previous round. Historically, Italy reached their highest world ranking of No. 8 in both 2007 and 2024."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-09-02",
      "edition": "Wednesday 2 September",
      "sections": [
        {
          "kicker": "LEGAL ACTION",
          "heading": "Scottish Rugby offers no comment as High Court allows concussion lawsuits",
          "body": "The ongoing multi-million-pound concussion legal battle over brain and neurological injuries has been allowed to continue following a High Court ruling. A former Wales star released a statement noting the rising 'scale and complexity' of the litigation, but there is currently no coverage of Scottish Rugby's response to the development in today's press. The sport's governing bodies face ongoing pressure, but any implications for Scotland remain unaddressed as the lawsuits proceed."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-02",
      "edition": "Wednesday 2 September",
      "sections": [
        {
          "kicker": "Rugby legend",
          "heading": "Wales mourns icon Sir Billy Boston following his death at 92",
          "body": "The Welsh rugby community is in mourning following the death of Sir Billy Boston at the age of 92. A national icon who emerged from Cardiff’s Tiger Bay to become a legend of the game, Sir Billy passed away peacefully just weeks after the death of his wife, Lady Joan. The Welsh Rugby Union paid tribute to their former Neath and Pontypridd player, describing him as one of the most iconic figures in the history of Welsh sport."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-09-02",
      "edition": "Wednesday 2 September",
      "sections": [
        {
          "kicker": "Tactical scrutiny",
          "heading": "Les Kiss admits to clunky performance as Australia eyes rematch improvements",
          "body": "Wallabies coach Les Kiss has acknowledged that his side’s 27-21 victory in San Salvador de Jujuy was marred by several “clunky bits” that require urgent attention before next weekend’s series finale. While the visitors claimed a narrow win, Kiss noted that Argentina successfully controlled the ruck and disrupted Australia’s momentum throughout the match. “We weren’t perfect. Neither were they,” Kiss admitted, emphasising that his side must become more compact and efficient in their attack to avoid repeating the inaccuracies seen on Saturday."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-09-02",
      "edition": "Wednesday 2 September",
      "sections": [
        {
          "kicker": "Coaching scrutiny",
          "heading": "Les Kiss faces questions over Wallabies’ evolving forward-heavy attacking style",
          "body": "While Les Kiss celebrates a fourth consecutive win after victory against Argentina, analysts are questioning the team's reliance on a forward-oriented attack. With 25 of the side's 34 tries this year scored by the pack, critics suggest the game plan is becoming increasingly unfamiliar for Australian fans. Kiss acknowledged the side's \"clunky bits\" following the weekend’s 27-21 win and admitted that he will need to make \"smart\" changes as he continues to search for greater depth across the squad."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-02",
      "edition": "Wednesday 2 September",
      "sections": [
        {
          "kicker": "League update",
          "heading": "Japan Rugby League One adjusts eligibility rules after settling court challenge",
          "body": "Japan Rugby League One has officially revised its registration categories following a legal settlement with 25 players who challenged the proposed A-1 and A-2 classification system. Under the updated framework, players holding 30 or more Brave Blossoms caps will be reclassified from A-2 to A-1 status. The league admitted that its initial communication regarding the changes was insufficient, opting to introduce these special measures to address the concerns of senior internationals, including Timothy Lafaele and Jiwon Gu."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-02",
      "edition": "Wednesday 2 September",
      "sections": [
        {
          "kicker": "High stakes",
          "heading": "Taine Randell warns All Blacks regarding the third Greatest Rivalry clash",
          "body": "Former skipper Taine Randell has challenged the All Blacks to embrace the intensity of Saturday’s third test in Soweto. With the series locked at 1-1, Randell told The Platform NZ podcast that this encounter represents the biggest test many of these players have faced. Having observed both teams maintain consistent squad selections, he anticipates a contest defined by pure will rather than tactical evolution, noting that the narrow margin in the previous round keeps the series outcome finely poised."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-09-02",
      "edition": "Wednesday 2 September",
      "sections": [
        {
          "kicker": "Series decider",
          "heading": "Rassie Erasmus targets All Blacks' wide attack ahead of third Test",
          "body": "Following South Africa's 33-26 win to level the series, Rassie Erasmus has identified New Zealand’s ability to win one-on-one battles in wider channels as the Springboks' primary defensive challenge. While the Boks were more clinical in Cape Town than in the opening Test, Erasmus admits his side must improve their containment of the All Blacks’ attacking threats. The world champions now prepare for the series-defining third Test at FNB Stadium in Soweto, a venue Erasmus describes as an \"exciting\" prospect."
        }
