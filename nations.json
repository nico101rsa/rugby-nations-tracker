  "digests": {
    "28": {
      "date": "2026-10-04",
      "edition": "Sunday 4 October",
      "sections": [
        {
          "kicker": "Scoring trends",
          "heading": "Fiji defeat Canada 63-10 to register biggest win of recent window",
          "body": "The Fiji men's senior international side secured the biggest win of their last 11 games with a 63-10 home victory against Canada in September 2025 during the Pacific Nations Cup knockout stage. In that same 11-match window, they scored a total of 314 points, averaging 28.5 points per game. Defensively, they conceded 351 points across those 11 fixtures, which averages out to 31.9 points let in per match."
        }
      ],
      "match": {
        "venue": "Groupama Stadium, Lyon"
      },
      "rung": "data"
    },
    "386": {
      "date": "2026-10-04",
      "edition": "Sunday 4 October",
      "sections": [
        {
          "kicker": "Injury concern",
          "heading": "England centre Benhard Janse van Rensburg stretchered off in Bristol victory",
          "body": "England centre Benhard Janse van Rensburg was stretchered off during Bristol’s 41-26 victory over Northampton on Saturday. The midfielder required an eight-minute stoppage for treatment after a collision with Henry Pollock left him knocked out. While Bristol secured a bonus-point win, the focus turned to the severity of the incident as the player was carried from the pitch. There is no further update on his condition following the conclusion of the weekend's Premiership fixtures."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-10-04",
      "edition": "Sunday 4 October",
      "sections": [
        {
          "kicker": "Eligibility focus",
          "heading": "Jack Willis confirms desire for international return despite Top 14 status",
          "body": "Jack Willis has reiterated his ambition to play Test rugby despite his continued commitment to the Top 14. While the flanker remains highly valued in France, recent reports confirm his eligibility for international selection with rivals, adding intrigue to his future. Willis has made no secret of his desire to compete at the highest level, though current RFU policies regarding players based overseas continue to shape the conversation around his potential return to the international stage."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "388": {
      "date": "2026-10-04",
      "edition": "Sunday 4 October",
      "sections": [
        {
          "kicker": "Test victory",
          "heading": "Ireland women seal seven-try win over Japan in Cork fixture",
          "body": "The Ireland women’s side secured a comprehensive 43-19 victory over Japan at Virgin Media Park on Saturday. After recovering from an early deficit, the hosts dominated proceedings with seven tries, including efforts from Eilis Cahill, Brittany Hogan, and a record-extending 25th international try for Beibhinn Parsons. Debuting replacements Alana McInerney and Sophie Barrett also crossed the whitewash late in the contest. Scott Bemand’s squad now carries this momentum into their upcoming two-match series against South Africa in the WXV."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-10-04",
      "edition": "Sunday 4 October",
      "sections": [
        {
          "kicker": "Referee scrutiny",
          "heading": "Michael Hooper faces sustained backlash over call to ban Andrea Piardi",
          "body": "The dispute regarding Michael Hooper’s public demand for World Rugby to sanction official Andrea Piardi remains unresolved. Following the former Australia captain’s call for a ban, the incident has drawn significant attention across the rugby press, with recent reporting highlighting a divide in opinion over his claims of referee bias. No formal ruling has been issued by World Rugby to date, and the official remains an active part of the current officiating pool as the international season continues."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-10-04",
      "edition": "Sunday 4 October",
      "sections": [
        {
          "kicker": "Club selection",
          "heading": "Finn Russell and Cameron Redpath start for Bath against Exeter Chiefs",
          "body": "Finn Russell and Cameron Redpath are both in the starting XV for Bath’s Premiership fixture against Exeter Chiefs. Redpath earns his first start of the season at inside centre, pairing with Ollie Lawrence in the midfield, while Russell directs the game from fly-half. The duo will be looking to build on Bath's momentum following their victory in the opening round. Across the pitch, Tommy Wyatt returns to the Exeter side for his first league appearance since May 2025."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-10-04",
      "edition": "Sunday 4 October",
      "sections": [
        {
          "kicker": "World Cup target",
          "heading": "Josh Adams eyes third tournament appearance as World Cup clock ticks",
          "body": "Wales wing Josh Adams has declared his ambition to compete at a third Rugby World Cup, aiming for next year’s tournament in Australia. The 31-year-old, who missed July’s defeat to South Africa with a calf injury, is currently working back to full fitness for club side Cardiff. With exactly one year remaining until Wales open their campaign against Zimbabwe, Adams emphasised the need for careful preparation, noting, \"I am training, but it's important that you navigate your way through correctly and there's no rush.\""
        },
        {
          "kicker": "Around the world",
          "heading": "All Blacks captain Ardie Savea signs with Blues for 2027",
          "body": "South Africa: Springbok Andre-Hugo Venter suffers head injury in Stormers defeat. Australia U18 side reshuffles pack for New Zealand Schools finale."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-10-04",
      "edition": "Sunday 4 October",
      "sections": [
        {
          "kicker": "Historical context",
          "heading": "Argentina continue to build upon their highest ever world ranking",
          "body": "Argentina maintains a consistent presence within the upper tiers of international rugby, continuing to draw on the pedigree of a side that once climbed as high as No. 3 in the world rankings. That milestone, reached during the 2007–08 period, remains the best position the team has held on record. As the current squad looks to improve their standing in the log, they reflect on a challenging season that has seen them test their depth against world-class opposition."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-10-04",
      "edition": "Sunday 4 October",
      "sections": [
        {
          "kicker": "Bledisloe build-up",
          "heading": "Richie Mo’unga warns All Blacks of resurgent Wallabies' growing confidence",
          "body": "All Blacks fly-half Richie Mo’unga expects Australia to be a major threat heading into the upcoming Bledisloe Cup series. Following the recent result against the Springboks, the 32-year-old warned that the opposition will have “grown an arm and a leg” in confidence. Mo’unga, who has returned to the New Zealand set-up under coach Dave Rennie, acknowledged the high-pressure environment of the rivalry and the significant challenge posed by Les Kiss’s side as they prepare to visit Eden Park."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "463": {
      "date": "2026-10-04",
      "edition": "Sunday 4 October",
      "sections": [
        {
          "kicker": "Match report",
          "heading": "Japan Sakura XV women's side suffer comprehensive defeat to Ireland",
          "body": "The Japan Sakura XV women's side fell to a 43-19 defeat against Ireland in Cork on Saturday. Despite an early try from Sakurako Korai, the visitors were unable to contain Ireland’s attacking threat, conceding seven tries in total. While Japan showed glimpses of their established rolling maul strength with a second-half score from Nijiho Nagata, the side was hampered by a high penalty count and a late yellow card, marking the end of their two-match series in Ireland."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "465": {
      "date": "2026-10-04",
      "edition": "Sunday 4 October",
      "sections": [
        {
          "kicker": "Eligibility switch",
          "heading": "Dane Gagai cleared to switch rugby league status to New Zealand",
          "body": "Dane Gagai has been cleared to switch his international rugby league eligibility from Australia to New Zealand, according to reports in today's press. While the development marks a significant shift in his career prospects, it remains distinct from the senior men’s international rugby union setup. The All Blacks continue their preparations for the upcoming Test against Scotland, currently sitting second on the log with three wins from three outings and a point difference of plus 51."
        }
      ]
    },
    "467": {
      "date": "2026-10-04",
      "edition": "Sunday 4 October",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Andre Esterhuizen captains Sharks as Springboks return for Leinster fixture",
          "body": "The Sharks have welcomed back several returning Springboks for their United Rugby Championship clash against Leinster in Durban. Andre Esterhuizen will captain the side from inside centre after recently leading the national team in Australia. Head coach JP Pietersen also named Thomas du Toit at loosehead prop for his second debut for the club following his stint with Bath. World Cup winners Ox Nche and Eben Etzebeth feature among the replacements as the Durban outfit opts for a traditional five-three split on the bench."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
