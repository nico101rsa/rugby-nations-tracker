  "digests": {
    "28": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Interim coach Senirusi Seruvakula recalls Caleb Muntz for Tokyo title decider",
          "body": "Interim head coach Senirusi Seruvakula has recalled Caleb Muntz to start at fly-half for Saturday’s Pacific Nations Cup final against Japan. Muntz’s inclusion triggers a backline reshuffle, with Isaiah Armstrong-Ravula shifting to full-back and Tuidraki Samusamuvodre stepping in at inside centre. Fiji are chasing a third consecutive title after defeating the Brave Blossoms in the previous two finals. Seruvakula noted the hosts are “a well-coached side,” but insisted his side will prioritise their own strengths as they seek to improve their tournament record."
        }
      ],
      "match": {
        "venue": "Prince Chichibu Memorial Stadium, Tokyo"
      },
      "rung": "data"
    },
    "386": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Autumn ultimatum",
          "heading": "Fin Smith warns England squad must improve during upcoming autumn tests",
          "body": "Fly-half Fin Smith has challenged his teammates to show fundamental progress during the autumn series or risk facing difficult questions about their trajectory. With England winning only three of their 8 tests this year, Smith argued that the squad must look at themselves if results do not improve. “If we have a pretty ropey autumn, on the back of building some momentum over the summer, I think we will need to have a pretty hard look at ourselves,” he stated."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Psychological hurdle",
          "heading": "Ben Youngs claims France must defeat South Africa to ensure confidence",
          "body": "Former England scrum-half Ben Youngs insists that France must overcome the Springboks in their upcoming encounter to dismantle a significant psychological barrier. Highlighting recent losses, including the 2023 World Cup quarter-final and last November's defeat, Youngs suggested on his podcast that Les Bleus must clear this hurdle to be genuine contenders in Australia. While acknowledging their clear quality, Youngs argued that France currently struggle to overcome the world champions, labelling the upcoming test a necessary statement before the tournament."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "388": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Scott Bemand hands debut to Jemima Adams Verling for WXV opener",
          "body": "Jemima Adams Verling will make her senior international debut this weekend as Ireland kicks off the WXV Global Series against the United States. The 20-year-old Connacht back row joins an experienced forward pack at blind-side flanker, lining up alongside captain Erin King and Aoife Wafer. Head coach Scott Bemand has made four changes from the side that secured their Six Nations win against Scotland, with Jane Clohessy and Aoibheann Reilly also returning to the matchday squad after recovering from injury."
        }
      ],
      "match": {
        "venue": "Tallaght Stadium, Dublin"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "WXV Global Series",
          "heading": "Italy women face Japan today at Stadio Omero Tognon in Pordenone",
          "body": "The Italy women’s team continue their WXV Global Series campaign against Japan today. Plinio Sciamanna takes charge of the Azzurre for the first time as head coach, overseeing a squad that features seven potential debutants. While Italy holds a strong historical record against the Sakura XV—winning six of their eight previous encounters—the side will be looking to improve their discipline and scrum performance after a Six Nations campaign that saw them lead the competition in turnovers and jackals."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Ceitidh Ainsworth earns first Scotland start as Sarah Bonar returns home",
          "body": "Interim head coach Dave Butcher has handed Ceitidh Ainsworth her first start at scrum-half for today’s WXV Global Series meeting with New Zealand. The Glasgow Warrior replaces Rhea Clarke, one of four changes to the side defeated by Canada last weekend. Experienced lock Sarah Bonar also returns to the match-day squad for the first time since the 2025 World Cup, poised to earn her 52nd cap from the bench as Scotland look to bounce back at Hive Stadium."
        }
      ],
      "match": {
        "venue": "Hive Stadium, Edinburgh"
      },
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "WXV Global Series",
          "heading": "Sean Lynn leads Wales to emphatic eight-try victory over South Africa",
          "body": "Wales secured a stunning 50-19 victory over South Africa at Cardiff Arms Park on Friday, ending a nine-match winless streak in spectacular fashion. Co-captain Alex Callender was named player of the match, while tighthead prop Sisilia Tuipulotu scored two of the hosts’ eight tries. Head coach Sean Lynn hailed the performance as the start of a new DNA for the side, noting, \"Those 23 players were aligned in everything, both sides of the ball, and they had that belief.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Recent form",
          "heading": "Argentina reflects on recent performance following the loss to England",
          "body": "Argentina enters the latest period of the international season holding a record of one win, three losses, and one draw across their last five matches. The team most recently suffered a 24-31 defeat against England in Round 3. With a current tournament standing of 8th in the 12-team table, Los Pumas have recorded 97 points for and 99 points against, resulting in a points difference of -2 as they prepare for their next fixture against Ireland."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Springbok challenge",
          "heading": "Les Kiss eyes bold tactical surprise against world-leading Springbok opposition",
          "body": "As Australia prepare to face the world No 1 Springboks in their next Test, coach Les Kiss has hinted at an unconventional approach to the match. Referencing a fabled strategic play that defied traditional wisdom, the coach remains defiant despite South Africa's status as heavy favourites. “It’s a massive opportunity to challenge a fantastic team that is second to none in the world,” Kiss said. While the Springboks arrive off the back of a gruelling series, Kiss maintains the Wallabies are ready."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Eddie Jones backs experience as Japan prepares for Pacific Nations final",
          "body": "Eddie Jones has prioritised \"good experience and toughness\" for today’s Pacific Nations Cup final against Fiji in Tokyo. Making two changes to the starting XV that defeated the USA, Jones has recalled Faulua Makisi at No.8, pushing Jack Cornelsen to lock. Tomoki Osada also enters the backline on the wing. Jones noted, \"It’s our third final in a row so it’s a great opportunity for this team to grow,\" as Japan targets their first title since 2019."
        }
      ],
      "match": {
        "venue": "Prince Chichibu Memorial Stadium, Tokyo"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "465": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Selection analysis",
          "heading": "Jordie Barrett dominates physical exchanges as All Blacks evaluate touring squad",
          "body": "Statistical analysis following the recent South Africa series highlights Jordie Barrett’s immense workload, with the midfielder completing 55 tackles across the four Tests. While Will Jordan proved the most potent attacking threat, leading the side with four tries, the tour has prompted internal scrutiny regarding the team's set-piece development. Former Springbok captain John Smit suggested the All Blacks struggled to replicate their traditional front-five dominance, noting that the squad frequently prioritised quick ball to avoid protracted set-piece battles against the world champions."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "WXV Global Series",
          "heading": "Wales dominate South Africa in emphatic eight-try WXV Global Series victory",
          "body": "South Africa suffered a heavy 50-19 defeat to Wales at Cardiff Arms Park in their WXV Global Series opener. Despite a try from Felicia Jacobs following a strong scrum, the visitors struggled to contain an inspired Welsh attack that secured six tries by half-time. South Africa’s discipline proved costly, with hooker Lindelwa Gwala sent to the sin bin during a difficult opening period. Tries from Tshiremba and Samboya were not enough to bridge the gap as Wales secured a commanding win."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    }
  }
}