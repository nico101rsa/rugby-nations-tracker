  "digests": {
    "28": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Fijian forward Saimoni Vunilagi passes away in Japan after suspected heatstroke",
          "body": "The Fijian rugby community is mourning back-row forward Saimoni Vunilagi, who passed away on Friday 7 August in Fukuoka after showing severe symptoms of heatstroke following a Kyushu KV training session. The 26-year-old, who stood 196cm and weighed 117kg, began his professional career in Japan in 2023. His second-division club expressed deep devastation, stating that the player's 'generous spirit and powerful style of play had raised high hopes' for his future contributions."
        }
      ]
    },
    "386": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Ollie Lawrence and Elliot Daly lose England central contracts in Borthwick reshuffle",
          "body": "Steve Borthwick has omitted Ollie Lawrence and Elliot Daly from England’s new 25-man central contract list, a significant move ahead of next year's World Cup. While Daly was nursing an arm injury during the Nations Championship, Lawrence’s exclusion comes as a surprise following his recent form against the All Blacks. In their place, the head coach has fast-tracked Alex Coles, Seb Atkinson and the versatile Asher Opoku-Fordjour. Borthwick now has greater control over this core group, who receive approximately £150,000 a season."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "387": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
        {
          "kicker": "Positional depth",
          "heading": "Maxime Lucu named world's most in-form scrum-half as Antoine Dupont finishes third",
          "body": "Planet Rugby has assessed Maxime Lucu as the most in-form scrum-half in world rugby, ranking him ahead of superstar teammate Antoine Dupont. The list highlights France’s exceptional depth at No. 9, with Nolann Le Garrec also securing ninth place despite his limited international starts. While Dupont remains the sport's premier name, Lucu’s current form for Les Bleus has seen him overtake his captain in the latest standings. Fabien Galthié’s side remains third in the Nations Championship after their 42-15 victory over Japan."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "388": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Tributes flow for Edmund Van Esbeck after former Irish Times correspondent dies",
          "body": "The Irish rugby community is mourning the death of Edmund ‘Ned’ Van Esbeck at the age of 94. The former Irish Times correspondent spent more than 30 years documenting the national team’s evolution, covering 18 overseas tours and the sport's transition into the professional era. IRFU chief executive Kevin Potts expressed ‘sincere condolences’ yesterday, acknowledging Van Esbeck’s status as an authoritative historian and a hugely influential voice. His 34-year tenure at the newspaper remains a definitive record of the game’s modern history."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
        {
          "kicker": "Tournament standings",
          "heading": "Italy suffer three consecutive defeats to start the Nations Championship campaign",
          "body": "Italy remain without a victory after three rounds of the Nations Championship. The side currently sits eleventh in the 12-team table, having scored 37 points in the competition so far. A total of 131 points has been conceded across the first three fixtures. In their most recent match, the Azzurri lost 10-57 to Australia. Italy were defeated 32-14 by South Africa at home in the most recent meeting between the sides in November 2025."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
        {
          "kicker": "Legal battle",
          "heading": "High Court ruling keeps Scotland players involved in brain injury litigation",
          "body": "Scotland’s involvement in the landmark High Court brain injury litigation remains unresolved following the court's earlier decision to allow the case to proceed. The legal action, which involves more than 500 former players across the sport, continues to loom over the governing bodies without a final judgment or settlement in sight. While the case has been cleared to continue, today’s press reports no further progress in the proceedings. The thread stays open until a definitive resolution is reached between the claimants and rugby's leadership."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
        {
          "kicker": "Board appointment",
          "heading": "Alun Wyn Jones returns to Ospreys as a new board director",
          "body": "Former Wales captain Alun Wyn Jones has joined the Ospreys board of directors with immediate effect. The 40-year-old returns to the club where he made 257 appearances during a turbulent period for the region, which currently faces an uncertain future amid Welsh Rugby Union plans to reduce the professional game to three sides. Chairman James Davies-Yandle stated the club was not looking for a mere figurehead, but a director who understands the organisation from the inside to help drive long-term stability."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
        {
          "kicker": "Currie Cup",
          "heading": "Pumas suffer heavy defeat to Griquas as home semi-final hopes fade",
          "body": "The Pumas were convincingly beaten 38-14 by the Griquas in Nelspruit on Friday, a result that complicates their position on the Currie Cup log. Despite tries from Clinton Swart and Junior Banda, the hosts struggled with discipline, ending the match with 14 men after a 20-minute red card for Jan-Henning Campher. While they remain third for now, the Pumas must now regroup for a crucial final-round clash against the second-placed Cheetahs in Nelspruit."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "461": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
        {
          "kicker": "Selection competition",
          "heading": "Fraser McReight discusses Wallabies depth as Les Kiss builds his squad",
          "body": "Fraser McReight has highlighted the intensifying competition for places in the Wallabies side as coach Les Kiss continues to refine his squad ahead of next year’s home World Cup. With Australia currently riding a three-match winning streak, McReight noted that Kiss is actively rotating personnel to identify his best options. The openside flanker recently acknowledged that the drive for depth means \"someone’s missing out\" during this experimental phase, as the coaching staff balances immediate results with long-term squad development."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "463": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Kyushu Electric Power Kyuden Voltex player Saimoni Vunilagi dies aged 26",
          "body": "The Japanese rugby community is mourning the loss of Saimoni Vunilagi, who has died at the age of 26 following a suspected heatstroke during a training session. His passing was officially confirmed on Saturday by his club, Kyushu Electric Power Kyuden Voltex. The tragic event has cast a sombre shadow over the domestic game, with the loss of the Fijian-born player marking a devastating moment for his teammates and the wider rugby public in Japan."
        }
      ]
    },
    "465": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Anton Segner ruled out as Simon Parker joins All Blacks bench",
          "body": "Coach Dave Rennie has been forced into a late change for today’s series opener at Ellis Park, with loose forward Anton Segner withdrawing due to a swollen ankle. Medical assessments have diagnosed the issue as acute inflammatory arthritis, with the player's return to play yet to be determined. Simon Parker has been called into the match-day 23 to replace him, joining a bench that also features Peter Lakai, Fletcher Newell, George Bower, and Asafo Aumua."
        }
      ],
