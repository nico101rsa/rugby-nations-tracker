  "digests": {
    "28": {
      "date": "2026-08-07",
      "edition": "Friday 7 August",
      "sections": [
        {
          "kicker": "Transfer News",
          "heading": "Newcastle Red Bulls sign Fiji hooker Zuriel Togiatama on one-year deal",
          "body": "Newcastle Red Bulls have secured the services of Fiji hooker Zuriel Togiatama on a one-year contract. The 27-year-old, who previously made 50 Super Rugby appearances for the Fijian Drua, makes the move to the Premiership ahead of the upcoming season. Newcastle head coach Dan McFarland praised the signing, noting that Togiatama is “strong in the set-piece” and will “add real quality and depth” to the club’s forward pack as they bolster their front-row options."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "386": {
      "date": "2026-08-07",
      "edition": "Friday 7 August",
      "sections": [
        {
          "kicker": "Career change",
          "heading": "Former England prop Joe Marler confirmed as BBC’s first celebrity Gladiator",
          "body": "Former England international Joe Marler is set to transition from the pitch to the studio as the first celebrity Gladiator. The 36-year-old, who previously competed in the inaugural series of Celebrity Traitors, will adopt the persona Mauler for the fourth series of the programme, which is scheduled to air in 2027. The BBC stated that the former prop will bring his characteristic \"uncompromising style of play\" and competitive spirit to the role when filming concludes in Sheffield."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-08-07",
      "edition": "Friday 7 August",
      "sections": [
        {
          "kicker": "Statistical review",
          "heading": "France demonstrate consistent attacking output across recent international test matches",
          "body": "Les Bleus have maintained a high-scoring profile in their recent fixtures, registering 426 points across their last 11 matches for an average of 38.7 points per game. While demonstrating consistent attacking threat, the side has also conceded 291 points, averaging 26.5 per fixture. This trend of high-scoring encounters includes a notable 54-12 victory over Wales away from home, which stands as the team’s biggest winning margin during this 11-game window."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-07",
      "edition": "Friday 7 August",
      "sections": [
        {
          "kicker": "Concussion litigation",
          "heading": "High Court brain injury claims remain uncertain amid ongoing legal pressure",
          "body": "The high-profile legal battle between former players and rugby's governing bodies remains in a state of flux as the High Court considers whether to dismiss the concussion lawsuits. Recent reports suggest the case faces potential collapse following challenges regarding the conduct of legal representation, with the court being told that hundreds of claims should be struck out. World Rugby and other governing bodies are actively seeking to have the proceedings thrown out as the legal process continues to navigate complex procedural hurdles."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-08-07",
      "edition": "Friday 7 August",
      "sections": [
        {
          "kicker": "Transfer news",
          "heading": "Ion Neculai leaves Zebre Parma to join Premiership champions Northampton Saints",
          "body": "Italian international tight-head prop Ion Neculai has signed for Northampton Saints, departing Zebre Parma after 5 seasons and 51 appearances. The 25-year-old, who earned his 4th senior cap during last month's Nations Championship test against Australia, arrives at Franklin’s Gardens alongside fellow Italian Danilo Fischetti. Saints director of rugby Phil Dowson welcomed the move, identifying Neculai as a \"very physical prop who enjoys the tough side of the game.\" Neculai officially joined his new teammates for pre-season training last week."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-08-07",
      "edition": "Friday 7 August",
      "sections": [
        {
          "kicker": "Coaching change",
          "heading": "Sione Fukofuka steps down as Scotland Women head coach citing stress",
          "body": "Sione Fukofuka has resigned as Scotland Women head coach to return to his family in Australia. Describing the move as the \"hardest professional decision\" of his life, Fukofuka cited the emotional strain of being separated from his family as the primary reason for his departure. Forwards coach Dave Butcher will assume interim control as the squad prepares for the upcoming WXV Global Series, with captain Rachel Malcolm returning to lead the 32-player group when training commences at Oriam this coming Monday."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-08-07",
      "edition": "Friday 7 August",
      "sections": [
        {
          "kicker": "Rankings boost",
          "heading": "Wales set to re-enter world top 10 following Japan-Australia Test",
          "body": "Wales are on the verge of returning to the world’s top 10 for the first time since July 2024. Despite a difficult period for the national side, Steve Tandy’s team stands to climb the rankings without playing this weekend. A defeat for Japan against Australia in Osaka would see the Brave Blossoms drop two places, moving Wales up one spot in the world standings. Just 0.04 points currently separate the two nations ahead of the upcoming fixtures."
        }
      ]
    },
    "460": {
      "date": "2026-08-07",
      "edition": "Friday 7 August",
      "sections": [
        {
          "kicker": "Disciplinary blow",
          "heading": "Tomás Albornoz receives four-match ban for intimidating referee Angus Gardner",
          "body": "Fly-half Tomás Albornoz has been suspended for four matches following a disciplinary hearing into his conduct after the defeat to England. Albornoz admitted to intimidating referee Angus Gardner after the final whistle, leading to his exclusion from this weekend’s fixture against the Springboks. The disciplinary committee acknowledged his early acceptance of the charge and a previously clear record when reducing the sanction from the six-match entry point. Santiago Carreras will start at fly-half for Argentina in his absence."
        }
      ],
      "match": {
        "venue": "Estadio José Amalfitani, Buenos Aires"
      },
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "461": {
      "date": "2026-08-07",
      "edition": "Friday 7 August",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Les Kiss backs inexperienced halves pair for first Wallabies Test outing",
          "body": "New head coach Les Kiss has retained the halves pairing of Ryan Lonergan and Declan Meredith for his maiden match in charge against Japan. Kiss, who succeeded Joe Schmidt, has made four alterations to his starting XV, including first career starts for prop Aidan Ross and second-rower Miles Amatosero. \"Every single player in the squad has pushed hard over the last fortnight to get us to this point, making selecting the matchday 23 a real challenge for the coaches,\" Kiss said."
        }
      ],
      "match": {
        "venue": "Hanazono Rugby Stadium, Osaka"
      },
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-08-07",
      "edition": "Friday 7 August",
      "sections": [
        {
          "kicker": "Challenge Cup",
          "heading": "Eddie Jones prepares Japan to face Australia at Hanazono Rugby Stadium",
          "body": "Japan host Australia in Higashiosaka City this Saturday for the Lipovitan D Challenge Cup. Eddie Jones leads the Brave Blossoms against a Wallabies side beginning a new era under head coach Les Kiss. Conditions are expected to be testing, with Osaka under an excessive heat warning and potential rain forecasted. Japan, currently ranked 10th, aim to secure their first victory over the 8th-ranked Wallabies, who narrowly edged out a win in their previous meeting last October in wet conditions."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-08-07",
      "edition": "Friday 7 August",
      "sections": [
        {
          "kicker": "Late reshuffle",
          "heading": "Wallace Sititi ruled out as Anton Segner starts against the Stormers",
          "body": "Dave Rennie has been forced into a late change ahead of the tour opener in Cape Town, with back-rower Wallace Sititi withdrawing from the squad due to illness. Anton Segner comes directly into the starting XV at openside flanker, causing Peter Lakai to shift to number eight. While the rest of the side remains as previously named, the late disruption adds to the challenge of facing a Stormers outfit explicitly motivated to test the tourists’ physical resolve."
        }
      ],
      "match": {
        "venue": "DHL Stadium, Cape Town",
        "referee": "Karl Dickson"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-07",
      "edition": "Friday 7 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Rassie Erasmus insists Springboks must avoid Argentina slap in the face",
          "body": "Rassie Erasmus has warned that focusing on the upcoming 'Greatest Rivalry' series against the All Blacks before facing Argentina would be a “slap in the face” to his opponents. The head coach has named a side featuring returning stars Eben Etzebeth, Lood de Jager, and Sacha Feinberg-Mngomezulu for the encounter in Buenos Aires. Erasmus maintains that while he is balancing player fitness for the longer tour ahead, his squad remains fully committed to overcoming a team that previously defeated them by one point."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
}