    "389": {
      "date": "2026-11-15",
      "edition": "Sunday 15 November",
      "sections": [
        {
          "kicker": "Captain's review",
          "heading": "Giacomo Nicotera admits Italy's performance against South Africa was not enough",
          "body": "Italy captain Giacomo Nicotera, speaking at the pre-Argentina press conference, said the squad had been strongly self-critical after the heavy defeat to South Africa in Turin. He pointed to aerial play, defence, organisation and discipline, with too many penalties conceded under South Africa's breakdown pressure, and described a hard Monday review that demanded a more intense response in training. Italy then lost 14-19 to Argentina in Genoa on Saturday."
        },
        {
          "kicker": "Around the world",
          "heading": "France beat South Africa 21-19, ending home losing streak to Springboks",
          "body": "Borthwick overhauls England for Japan, Ojomoh and Pollock start. Wallabies recall Carter Gordon and Rob Valetini for Scotland."
        }
