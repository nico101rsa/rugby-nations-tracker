    "28": {
      "date": "2026-11-17",
      "edition": "Tuesday 17 November",
      "sections": [
        {
          "kicker": "Udine test",
          "heading": "Fiji, winless in five, face an Italy side beaten twice this month",
          "body": "Saturday's Round 6 test takes Fiji to the Bluenergy Stadium in Udine, where Italy close out their run of three November home matches in the Nations Championship. The Azzurri have lost both so far, 7-66 to South Africa in Turin and 14-19 to Argentina in Genoa. Fiji head coach Jake White's side go into the weekend bottom of the log, winless in five, after a 15-43 defeat by Ireland. Italy head coach Gonzalo Quesada names his team on Thursday."
        },
        {
          "kicker": "Around the world",
          "heading": "New Zealand's Quinn Tupaea needs thumb surgery, out 10 weeks",
          "body": "Ireland's Jamie Osborne ruled out with pectoral injury."
        }
      ],
      "match": {
        "venue": "Bluenergy Stadium, Udine"
      },
      "source": {
        "name": "Federazione Italiana Rugby"
      }
    },
    "386": {
      "date": "2026-11-17",
      "edition": "Tuesday 17 November",
      "sections": [
        {
          "kicker": "Opposition form",
          "heading": "England's next opponents New Zealand beaten 35-28 by Wales in Cardiff",
          "body": "Wales centre Eddie James made 25 tackles and scored one of his side's five tries in the win, including a stop that held the All Blacks' Anton Lienert-Brown just short of the line. New Zealand were without Cam Roigard, Damian McKenzie, Will Jordan and Jordie Barrett at the Principality Stadium. Head coach Steve Borthwick's side beat Japan 78-15 in Round 5; of the 194 fans in the app who answered, 93% were buzzing."
        },
        {
          "kicker": "Around the world",
          "heading": "New Zealand's Quinn Tupaea needs thumb surgery, out 10 weeks",
          "body": "Ireland's Jamie Osborne ruled out with pectoral injury."
        }
