  "digests": {
    "28": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Historical Benchmarks",
          "heading": "Fiji Reached Best World Ranking of No. 7 in 2023 Season",
          "body": "As the team reflects on their recent form, historical data highlights their peak standing in the global game. Fiji reached their best world ranking of No. 7 in 2023. This performance remains the highest point the nation has achieved in the official world rankings since their introduction. The squad will look to build upon their foundations as they continue through the current international cycle."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Selection strategy",
          "heading": "Maro Itoje explains his decision to sit out summer Test matches",
          "body": "England captain Maro Itoje has defended his decision to take a mini-sabbatical during the recent Nations Championship, describing the move as a \"wise and prudent decision.\" After a gruelling year, the 31-year-old missed the summer series against South Africa, Fiji, and Argentina to prioritise mental and physical recovery. While admitting it felt \"very weird\" watching from afar, Itoje believes that such proactive breaks are essential for leading players to prolong their careers ahead of the 2027 World Cup."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Team Form",
          "heading": "France Enters The Autumn International Window With Strong Recent Form",
          "body": "France heads into the upcoming international period maintaining a productive run of results, having secured victory in three of their last five matches. The team has demonstrated momentum with two consecutive wins, most recently concluding their July campaign with a decisive 42-15 triumph over Japan in the Nations Championship. Across this five-game sequence, the side has recorded a 3-2 win-loss record as they prepare for their next challenge."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Player Profile",
          "heading": "Former Ireland forward Ryan Caldwell reflects on his journey of recovery",
          "body": "Former Ireland second-row Ryan Caldwell has opened up about his transition from a professional career at Ulster, Bath and Exeter to a new life focused on meditation and breathwork. In a candid interview, the 41-year-old discussed his challenging battles with injury, addiction and mental health following his retirement from the sport. Caldwell, who is soon set to release his autobiography, now credits his recovery and inner peace to his work helping others manage similar struggles."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Coaching suspension",
          "heading": "World Rugby bans Gonzalo Quesada following critical match official abuse comments",
          "body": "Gonzalo Quesada has become the first head coach sanctioned under the new Match Official Abuse Sanctioning Process introduced by World Rugby in July. The governing body issued a two-test suspension after determining that the Italy coach made unacceptable comments regarding the performance of referee Luc Ramos during the July meeting with New Zealand. The new disciplinary framework was agreed upon during the Shape of the Game forum to address increasing concerns regarding public criticism directed at match officials."
        }
      ]
    },
    "390": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Pathway Development",
          "heading": "Scottish Rugby pathway talent features in Edinburgh and Glasgow squads",
          "body": "Edinburgh and Glasgow Warriors are integrating a host of Scottish Rugby pathway graduates into their matchday squads as the 2026/27 season preparations accelerate. Following a successful season for the U20s, standouts including Jamie Stewart, Geordie Gwynn, and Fin Doyle are set for action at the club level. Glasgow’s inclusion of Kerr Yule, the most-capped U20s player in history, alongside recent academy signees reflects a clear strategy to blood emerging talent as the professional campaign commences this weekend."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Legal battle",
          "heading": "High Court allows concussion claims against rugby governing bodies to continue",
          "body": "The ongoing legal challenge involving hundreds of former players seeking damages for neurological injuries remains unresolved. The High Court has recently permitted the class action lawsuits to proceed, rejecting attempts by World Rugby and other governing bodies to have the claims thrown out. The litigation, which focuses on alleged failures to protect players from the long-term risks of concussion, is expected to continue as the parties prepare for trial. No final judgment or settlement has yet been reached."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Selection Change",
          "heading": "Les Kiss makes nine alterations as Australia target historic series sweep",
          "body": "Australia head coach Les Kiss has overhauled his starting side for the rematch against Argentina in Mendoza, making nine changes to the team that won last weekend. Harry Wilson returns to lead the side at number eight, while Joseph-Aukuso Suaalii and Len Ikitau reunite in the midfield. Seeking a first-ever two-Test series sweep on Argentine soil, Kiss noted the challenge ahead: “We’re expecting a strong response from Argentina on Saturday, and we know we will need to keep stepping up our game.”"
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Selection Update",
          "heading": "Les Kiss recalls Joseph-Aukuso Suaalii as Tom Wright reaches 50 caps",
          "body": "Les Kiss has made 9 alterations to his starting XV for the rematch with Argentina. The headline inclusion is Joseph-Aukuso Suaalii, who reunites with Len Ikitau in the midfield, while full-back Tom Wright reaches his 50th international appearance. Ben Donaldson earns a start at flyhalf, partnering Ryan Lonergan, as Harry Wilson returns to captain the side from number eight. Kiss noted the team is \"bringing in some fresh bodies\" to build experience across the squad while expecting a physical response from the hosts."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Centenary fixture",
          "heading": "Japan faces Canada in Niigata to celebrate the JRFU centenary",
          "body": "The Brave Blossoms take on Canada today at Denka Big Swan Stadium, marking the JRFU’s 100th anniversary with their first international test in Niigata for 18 years. Eddie Jones has rung the changes, with Inoke Burua set to earn his debut. Japan enters the clash aiming to snap a four-match losing streak, bolstered by a strong historical record against the Canadians. While captain Warner Dearns is notably absent, the squad remains familiar as they seek a morale-boosting result."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Tactical Assault",
          "heading": "New Zealand prioritise attacking DNA ahead of the third series Test",
          "body": "The Springboks are preparing for an expansive assault from New Zealand this weekend, with assistant coach Mzwandile Stick confirming they expect the All Blacks to maintain their high-tempo game. Dave Rennie has prioritised mobile, ball-playing forwards throughout this series to ensure the ball stays in play. Stick noted, “The message is clear: they don’t play hide and seek. They talk about how they want to play and, when they get to the field, they play exactly that way.”"
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Historic Ground",
          "heading": "Siya Kolisi urges Springboks to channel Soweto spirit against All Blacks",
          "body": "Captain Siya Kolisi has challenged his side to embrace the significance of the FNB Stadium as they face New Zealand in the pivotal third Test of their series. Referencing the area's history and the 1976 Soweto Uprising, Kolisi noted that the venue carries profound meaning for the nation. Assistant coach Mzwandile Stick echoed the need for victory, emphasising that South Africa must remain clinical at the breakdown to protect their standing on home soil with the series currently locked at 1-1."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    }
  }
