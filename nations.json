      },
      "source": {
        "name": "OnRugby"
      }
    },
    "386": {
      "date": "2026-11-24",
      "edition": "Tuesday 24 November",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Borthwick calls Saracens wing Noah Caluori into England training squad for rematch",
          "body": "The only change to the 37-man group gathered at Pennyhill Park, Caluori faces a fight with Cadan Murley and Will Joseph for a matchday spot in Saturday's third-place play-off against New Zealand at Twickenham. Tommy Freeman pulled up with a niggle before last weekend's 37-12 win over the same opponents but remains in the squad. The rematch came about when France's victory over Argentina knocked England down to second on the table, one step short of the final."
        },
        {
          "kicker": "Around the world",
          "heading": "Ireland captain Dan Sheehan's yellow upgraded to red card",
          "body": "Wallabies beat Wales 29-26, ending losing run. South Africa make seven changes, starting Libbok and Reinach for final. All Blacks lose Luke Jacobson to Bayonne."
        }
      ],
      "match": {
