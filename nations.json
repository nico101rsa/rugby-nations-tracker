  "digests": {
    "28": {
      "date": "2026-09-16",
      "edition": "Wednesday 16 September",
      "sections": [
        {
          "kicker": "Pathway appointment",
          "heading": "Andrew Durutalo appointed Fiji Rugby Head of Men’s High Performance",
          "body": "The Fiji Rugby Union has appointed former international Andrew Durutalo as Head of Men’s High Performance to strengthen developmental pathways. Durutalo, a former Fiji age-grade captain who represented the United States at the 2015 Rugby World Cup, will oversee structures from the under-18s to the senior national team. High Performance General Manager Naca Cawanibuka said Durutalo will play a key role in \"ensuring greater alignment from our U18 and U20 programmes through to Fiji 7s, professional rugby and ultimately the Flying Fijians.\""
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "386": {
      "date": "2026-09-16",
      "edition": "Wednesday 16 September",
      "sections": [
        {
          "kicker": "Coaching scrutiny",
          "heading": "Stuart Barnes slams the RFU for extending Steve Borthwick's England contract",
          "body": "Former England fly-half Stuart Barnes has heavily criticised the RFU's \"ostrich policy\" after they handed head coach Steve Borthwick a contract extension until 2028. Despite a disappointing season that featured a first-ever Six Nations defeat to Italy, the governing body chose to stretch Borthwick's deal to avoid World Cup distractions. Barnes dismissed the decision, labelling Borthwick's overall tenure a \"failure\" and arguing that the team has slipped into becoming a second-tier Six Nations side."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-09-16",
      "edition": "Wednesday 16 September",
      "sections": [
        {
          "kicker": "Form tracker",
          "heading": "France register back-to-back victories to establish momentum in Nations Championship",
          "body": "France have recorded three victories in their last five matches. Within that same five-game window, they suffered two defeats. Les Bleus are now on a run of two straight wins. Their most recent result was a 42-15 away victory against Japan in the group stage of the Nations Championship in July. This run keeps the team third in the tournament standings."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-16",
      "edition": "Wednesday 16 September",
      "sections": [
        {
          "kicker": "Recall warning",
          "heading": "Andy Farrell issued X-rated warning to Jimmy O'Brien during recent tour",
          "body": "Leinster winger Jimmy O'Brien has revealed the frank message head coach Andy Farrell delivered on the training ground before his international return during the summer tour. With Robert Baloucoune ruled out in Sydney, Farrell approached the 29-year-old and said: 'You’re in, don’t f*** it up.' Having spent months in the Test wilderness, O'Brien seized the opportunity, starting all three matches in the series. The versatile back admitted he was nervous before kick-off but backed himself to make the most of his unexpected Ireland recall."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-09-16",
      "edition": "Wednesday 16 September",
      "sections": [
        {
          "kicker": "Stateside expansion",
          "heading": "IRFU dismisses plan to move Ireland against Italy fixture to United States",
          "body": "World Rugby's ambitious proposal, reported on Monday, to move a Six Nations match to the United States remains stalled after the Irish Rugby Football Union rejected the concept. The governing body had floated relocating a future fixture—with Ireland's home match against the Azzurri mooted as a candidate—to help grow the game. However, the IRFU clarified they have no plans to shift matches, while England are also unlikely to participate, leaving the project without crucial host union backing."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-16",
      "edition": "Wednesday 16 September",
      "sections": [
        {
          "kicker": "Equipment trial",
          "heading": "Scotland navigate controversial smaller ball trial during demanding WXV campaign",
          "body": "As Scotland continue their WXV campaign under interim head coach Dave Butcher, they must navigate World Rugby’s controversial smaller ball trial. The initiative, designed to potentially boost handling and kicking, has split opinion across the tournament. While prominent players have criticised the change, the trial remains open until WXV concludes in October, when a decision on permanent adoption is expected. For Butcher’s side, adapting to the ball is a key challenge following Saturday’s heavy 64-26 defeat against Canada."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-16",
      "edition": "Wednesday 16 September",
      "sections": [
        {
          "kicker": "INJURY BLOW",
          "heading": "Full-back Kayleigh Powell ruled out of WXV campaign with hamstring injury",
          "body": "The 27-year-old Olympian Kayleigh Powell will miss Wales’ entire WXV campaign after suffering a hamstring injury during training. Powell was a standout performer throughout the Six Nations, with head coach Sean Lynn describing her absence as a “big loss” for the side’s attacking dimension. With the full-back sidelined and prop Donna Rose already ruled out, Lynn suggested scrum-half Keira Bevan could provide cover at fly-half. The injury comes as a significant setback for a squad currently ranked 13th in the world."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-16",
      "edition": "Wednesday 16 September",
      "sections": [
        {
          "kicker": "Form guide",
          "heading": "Argentina draw 28-28 with Australia as Los Pumas' difficult form continues",
          "body": "Argentina recorded a 28-28 draw against Australia in their most recent fixture at home this September. In their last five matches, the side has registered one win, three losses and one draw. Following the 24-31 loss to England in Round Three, the team occupies eighth place in the table. They have secured one victory and two defeats across their three tournament fixtures, scoring 97 points and conceding 99 to leave them with a points difference of minus two."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-16",
      "edition": "Wednesday 16 September",
      "sections": [
        {
          "kicker": "RETURN FROM EXILE",
          "heading": "Les Kiss recalls Jordan Petaia and Harry McLaughlin-Phillips for Springboks clash",
          "body": "Wallabies head coach Les Kiss has handed a surprise recall to utility back Jordan Petaia for this month's one-off Test against South Africa in Perth. Petaia, who last featured at the 2023 World Cup, returns to the fold following an unsuccessful NFL attempt and a season with Perpignan. He is joined by uncapped Western Force playmaker Harry McLaughlin-Phillips, who replaces the injured Carter Gordon. Kiss acknowledged the world champions remain the \"benchmark\" but insisted his squad are \"up for the fight\" in their own backyard."
        }
      ],
      "match": {
        "venue": "Optus Stadium, Perth"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-16",
      "edition": "Wednesday 16 September",
      "sections": [
        {
          "kicker": "Eligibility reform",
          "heading": "Timothy Lafaele and fellow litigants await final JRLO eligibility framework",
          "body": "There has been no further movement regarding the restructuring of Japan Rugby League One player categories following the settlement reported late last month. The agreement ensures that foreign-born players holding Japanese passports, such as 2019 World Cup star Timothy Lafaele, are treated on a par with native-born players for the 2026-27 season. While the league confirmed that a \"settlement had been reached\" in the court case involving 24 litigants, the final regulatory details remain unconfirmed. No additional updates on coaching appointments or structural changes have surfaced in today’s coverage."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      },
      "rung": "storyline"
    },
    "465": {
      "date": "2026-09-16",
      "edition": "Wednesday 16 September",
      "sections": [
        {
          "kicker": "REFEREE ROW",
          "heading": "Neil Barnes slams referee Karl Dickson for giving penalties for 'bugger all'",
          "body": "All Blacks senior assistant coach Neil Barnes has criticised the officiating in Saturday’s 43-28 defeat to South Africa, claiming referee Karl Dickson cost New Zealand momentum in Baltimore. Barnes suggested the world champions received the \"rub of the green\" regarding technical scrum infringements, specifically citing \"brake foot\" penalties. \"Every time they keep getting penalties for bugger all and get to slow the game down, it brings them back into it,\" Barnes told Newstalk ZB, as the squad digests a 3-1 series loss to the Springboks."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-09-16",
      "edition": "Wednesday 16 September",
      "sections": [
        {
          "kicker": "Series triumph",
          "heading": "Rassie Erasmus secures series victory as Springboks overpower New Zealand in Baltimore",
          "body": "South Africa secured a 3-1 series victory over New Zealand on Saturday, concluding their tour with a 43-28 win at Baltimore’s M&T Bank Stadium. In front of a record American rugby crowd of 68,173, the Springboks utilised their forward dominance as Damian de Allende and Morne van den Berg crossed for first-half tries. While New Zealand rallied, the world champions’ bench depth ensured they finished the series with three consecutive wins. Following recent Nations Championship success against Wales, Rassie’s side remains top of the live table."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    }
  }
}