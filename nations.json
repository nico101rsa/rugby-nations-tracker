  "digests": {
    "28": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "Campaign reset",
          "heading": "Fiji chase first Nations Championship points after third consecutive defeat in Scotland",
          "body": "Fiji go into the weekend sitting twelfth on the 12-team log after failing to secure a victory in their first three Nations Championship fixtures. The Flying Fijians lost 17-33 to Scotland in the third round, leaving them with only 49 points scored in the tournament. The squad have also conceded 145 points across those three opening matches. Fiji will face France next, aiming to improve on the 34-21 away defeat they suffered against the French team during an international friendly in November 2025."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "Captain's rest",
          "heading": "Maro Itoje praises Steve Borthwick’s surprise sabbatical decision after summer rest",
          "body": "England captain Maro Itoje has defended his decision to skip the July Tests against South Africa, Fiji and Argentina, admitting the surprise proposal from head coach Steve Borthwick caught him off guard. Having breached player-load thresholds after a demanding year on and off the field, the 31-year-old lock sat out the Nations Championship tour for a much-needed mental and physical break. \"I don't regret it at all,\" Itoje said, believing the proactive rest will help him \"come back better\" for club and country this season."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "Attack metrics",
          "heading": "France average 38.7 points per game over their last 11 matches",
          "body": "France have shown formidable attacking efficiency over their last 11 fixtures, amassing 426 points in that period. The defence has allowed 291 points across the same 11-match window. This run translates to an average of 38.7 points scored per game, alongside 26.5 points conceded per match. The biggest win of this 11-game stretch came during the Six Nations in February 2026, when they registered a 54-12 away victory over Wales."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "FLY-HALF COVER",
          "heading": "George Skivington rules out Ross Byrne move to Munster after Crowley injury",
          "body": "Gloucester head coach George Skivington has dismissed suggestions that fly-half Ross Byrne could return to Ireland with Munster. Speculation linked the 31-year-old with a move to Limerick following the news that Jack Crowley is sidelined with a vascular injury until the new year. Despite Byrne slipping down the Kingsholm pecking order last season, Skivington confirmed the playmaker is central to his plans. \"Ross is still with us,\" Skivington insisted, adding that Gloucester's packed schedule across three tournaments will provide ample opportunities."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "Injury update",
          "heading": "Andrea Zambonin recovery timeline remains unconfirmed following Exeter Chiefs medical assessment",
          "body": "There have been no fresh updates in today's press regarding the recovery timeline for Andrea Zambonin's shoulder injury. The Exeter Chiefs lock was ruled out of the start of the Premiership season earlier this week, but his club has not released any new details on his progress. With Italy's next international test against South Africa on the horizon, the national coaching staff face an anxious wait for clearance from the Premiership side's medical team."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "Concussion litigation",
          "heading": "High Court allows rugby concussion case to proceed as Scotland watches",
          "body": "A landmark brain injury lawsuit brought by former players against rugby's governing bodies will proceed, following a critical High Court ruling reported this week. The legal battle, which was previously described as on the brink of collapse, remains in the balance but has been given permission to continue. While today's coverage does not specify the involvement of Scottish Rugby or any active Scotland internationals, the ongoing litigation continues to cast a long shadow over the sport as governing bodies prepare for further legal scrutiny."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "Campaign outlook",
          "heading": "Steve Tandy prepares Wales for Nations Championship games after ending losing streak",
          "body": "Head coach Steve Tandy is preparing Wales for a challenging Nations Championship campaign at the Principality Stadium, with fixtures against Japan, New Zealand and Australia. Having recently banished their record-breaking 18-test losing streak with victories over Japan, Italy and Fiji, Tandy's men must build momentum to avoid another Wooden Spoon in the subsequent Six Nations. While press coverage remains quiet on squad selection, the WRU is counting on Tandy to achieve sustainable success with this young squad."
        }
      ],
      "match": {
        "venue": "Principality Stadium, Cardiff"
      }
    },
    "460": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "AMERICAS CHAMPIONSHIP",
          "heading": "Luciano Avaca scores hat-trick as Argentina XV crush Uruguay XV 58-10",
          "body": "The Argentina XV took another giant step in the Americas Rugby Championship on Wednesday, routing a suspension-hit Uruguay XV 58-10 in their second-round clash. Luciano Avaca stole the show with a brilliant hat-trick, while fullback Franco Rossetto also crossed twice to secure a 10-try bonus-point victory. Led by captain Rodrigo Fernández Criado, the selection showed clinical improvement following their opening win over Paraguay. The side now prepares for a final-round decider against Chile."
        }
      ]
    },
    "461": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "World Cup push",
          "heading": "James O'Connor rejoins Western Force to launch late Wallabies World Cup bid",
          "body": "Veteran playmaker James O'Connor has rejoined the Western Force for the 2027 season, launching a late bid to force his way back into national contention ahead of next year's home World Cup. The 36-year-old utility back, who has 68 caps, returns to Perth after a stint with Leicester Tigers. O'Connor hopes the move will capture the attention of head coach Les Kiss. \"He knows I'm hungry for it. He knows I want to be involved. So I'll let my rugby do the talking,\" O'Connor said."
        }
      ]
    },
    "463": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "ELIGIBILITY U-TURN",
          "heading": "Timothy Lafaele and Brave Blossoms stars win league eligibility legal battle",
          "body": "Japan Rugby League One has reached a court settlement to reverse proposed eligibility restrictions that targeted foreign-born naturalised players. A group of 24 players, including Brave Blossoms internationals Timothy Lafaele and Jiwon Gu, filed for a provisional injunction against rules that would have limited their matchday involvement. Under the revised criteria, naturalised citizens who held citizenship by May 2025 will be treated as native-born players. The league admitted \"prior explanations and communication with all relevant parties were insufficient\" and will reclassify all players with 30 or more caps."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "SELECTION CALL",
          "heading": "Dave Rennie rotates All Blacks pack as Codie Taylor misses Soweto Test",
          "body": "New Zealand head coach Dave Rennie has overhauled his forward pack for Saturday’s third Test against South Africa, resting vice-captain Codie Taylor. Asafo Aumua starts at hooker while Peter Lakai and Sam Darry earn promotions to the starting fifteen, replacing Simon Parker and Fabian Holland. As lock Tupou Vaa'i prepares for his 50th Test, the series remains locked at 1-1. A victory in Soweto would see the All Blacks reclaim the world No. 1 ranking and trigger a third consecutive week of changes at the summit."
        }
      ],
      "match": {
        "venue": "FNB Stadium, Soweto"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-09-04",
      "edition": "Friday 4 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Rassie Erasmus moves Cheslin Kolbe to full-back for New Zealand Test",
          "body": "Cheslin Kolbe will start at full-back in Saturday’s third Test against New Zealand at FNB Stadium, a tactical shift intended to counter the All Blacks' expansive game. With Kolbe moving to No. 15, Ethan Hooker earns a start on the wing alongside Kurt-Lee Arendse, who makes his 34th appearance. Arendse dismissed concerns over the reshuffled backline, insisting the \"tools are pretty much the same\" as the world champions look to build momentum in Soweto following Kolbe’s 18-point performance during the 33-26 victory in Cape Town."
        }
      ],
      "match": {
        "venue": "FNB Stadium, Johannesburg"
      },
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
