  "digests": {
    "28": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Cup final defeat",
          "heading": "Virimi Vakatawa scores but Fiji lose Pacific Nations Cup final to Japan",
          "body": "Fiji surrendered their hold on the Pacific Nations Cup on Saturday as a late Samisoni Tua try snatched a 20-15 victory for Japan in Tokyo. Despite first-half tries from Virimi Vakatawa and hooker Tevita Ikanivere, the defending champions struggled with discipline after Mesake Doge's yellow card. Isaiah Armstrong-Ravula drew Fiji level with a late penalty, but the Flying Fijians could not withstand the late Japanese onslaught, falling just short of securing a third successive tournament title."
        }
      ],
      "match": {
        "venue": "Tokyo"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "386": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Winning streak ends",
          "heading": "England and Canada share the spoils as historic winning run concludes",
          "body": "England’s remarkable run of 39 successive victories has come to an end following a 26-26 draw against Canada at Sandy Park. Despite two first-half tries from Claudia Moloney-MacDonald, the Red Roses were unable to secure a win against a committed Canadian side who dominated the opening exchanges. Although England remain undefeated in 40 Tests, the result marks the first time since 2022 that they have failed to emerge victorious from an international fixture."
        }
      ]
    },
    "387": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Psychological hurdle",
          "heading": "Ben Youngs claims France must defeat South Africa before World Cup",
          "body": "Former England scrum-half Ben Youngs has challenged France to overcome their mental barrier against South Africa in their upcoming November meeting. Writing on the For the Love of Rugby podcast, Youngs argued that failing to beat the world champions would leave a lasting psychological scar ahead of next year's World Cup. Fabien Galthié’s side are looking to address recent losses to the Springboks, including the narrow 29-28 defeat in the 2023 World Cup quarter-final."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "388": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Jemima Adams Verling handed senior Ireland debut for WXV tournament opener",
          "body": "Connacht back-rower Jemima Adams Verling makes her senior debut this afternoon as Ireland face the United States at Tallaght Stadium. Head coach Scott Bemand has opted for an experienced pack surrounding the 20-year-old, with captain Erin King and Aoife Wafer joining her in the back row. This WXV Global Series opener serves as the first international rugby test held at the stadium. Ireland enters the contest aiming to maintain their recent winning record against the American side."
        }
      ],
      "match": {
        "venue": "Tallaght Stadium, Dublin"
      },
      "source": {
        "name": "SA Rugby Magazine"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Tournament expansion",
          "heading": "World Rugby pushes USA proposal despite Six Nations stakeholder resistance reports",
          "body": "World Rugby continues to advocate for moving a Six Nations fixture to the United States to broaden the sport's commercial reach, though the proposal faces significant internal hurdles. While reports from earlier this week indicate ongoing formal talks, the initiative remains in flux with stakeholders divided. The Irish Rugby Football Union has publicly registered its response to the plans, and other unions have expressed scepticism regarding the logistics. For now, the prospect of a championship match across the Atlantic remains unconfirmed."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Ceitidh Ainsworth earns first start as Sarah Bonar returns to squad",
          "body": "Ceitidh Ainsworth makes her first start for Scotland Women against New Zealand following her debut off the bench in last weekend’s defeat by Canada. Interim head coach Dave Butcher has confirmed four changes for the WXV Global Series encounter at Hive Stadium, including the return of experienced lock Sarah Bonar. Returning from injury, the Harlequins forward is set to earn her 52nd cap from the bench as Scotland look to bounce back against the world-ranked opposition."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Stunning victory",
          "heading": "Wales beat South Africa as Sean Lynn hails side's new DNA",
          "body": "Wales ended a nine-test winless run with a comprehensive 50-19 victory over South Africa at Cardiff Arms Park. A clinical attacking display saw the hosts cross for eight tries, including a double from Sisilia Tuipulotu, as Sean Lynn’s side flourished under the Friday night lights. The head coach praised his team’s execution, stating, “This is just the start for us, this is going to be our new DNA.” Co-captain Alex Callender was named player of the match in the emphatic win."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Historical standing",
          "heading": "Argentina reflects on proud history as team eyes future tournament success",
          "body": "As the squad prepares for upcoming international challenges, it is worth noting that Los Pumas have achieved significant milestones throughout their history. The national team reached its highest-ever world ranking of No. 3 during the 2007–08 period. Furthermore, the side has consistently demonstrated competitiveness on the global stage, having reached the semi-finals of the Men's Rugby World Cup in 2007, 2015, and 2023."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Coaching challenge",
          "heading": "Les Kiss insists Australia can challenge the world champion Springboks side",
          "body": "Wallabies coach Les Kiss has issued a defiant message ahead of next weekend's clash with South Africa, rejecting the notion that the world’s top-ranked side is untouchable. Kiss emphasised the importance of creative, unconventional rugby, suggesting his team is ready to embrace a fresh strategic approach. “It’s a massive opportunity to challenge a fantastic team that is second to none in the world,” said the coach. Australia head into this pivotal fixture looking to maintain momentum during their current unbeaten run."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Pacific Nations Cup",
          "heading": "Eddie Jones leads Japan to historic Pacific Nations Cup final victory",
          "body": "Japan secured a hard-fought 20-15 victory over Fiji in Tokyo on Saturday to claim the Pacific Nations Cup title for the first time since 2019. After trailing at half-time, the Brave Blossoms rallied in the second period, with Mamoru Harada, Ben Gunter, and Samisoni Tua crossing for crucial tries. Eddie Jones hailed the result as a significant milestone, noting, “Our aim this weekend is to win the final and we’re 100 per cent concentrated on that.”"
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "465": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Scrum scrutiny",
          "heading": "John Smit claims All Blacks must prioritise set-piece to compete globally",
          "body": "Former Springboks captain John Smit has identified New Zealand’s scrum as a primary concern following their 3-1 series loss. Smit noted the All Blacks frequently opted for quick ball to avoid set-piece engagements, a trend he attributes to the differing priorities of Super Rugby compared to northern hemisphere competitions. Addressing the physical requirements of the modern game, Smit stated, “scrumming is like a UFC fighter. You can train in the gym as much as you want, but if you don’t put enough time in the ring.”"
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Rassie Erasmus releases Pieter-Steph du Toit and Damian de Allende early",
          "body": "Coach Rassie Erasmus has confirmed that Pieter-Steph du Toit and Damian de Allende have been released from the Springbok squad ahead of the upcoming Test in Perth. Following a demanding series against the All Blacks, the pair will return to South Africa to spend time with their families. Erasmus stated that there is sufficient cover within the current travelling group to manage the squad's workload as the team shifts focus to their next assignment at the Optus Stadium."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
}