  "digests": {
    "28": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Cup progress",
          "heading": "Defending champions Fiji defeat Canada to reach Pacific Nations Cup final",
          "body": "Defending champions Fiji have booked their place in the Pacific Nations Cup final after defeating Canada. The Flying Fijians will face Japan in the tournament's deciding match, presenting a vital opportunity to secure silverware. This regional success offers a timely boost for Fiji, who sit bottom of the log after three consecutive defeats, ahead of their next test against France."
        }
      ]
    },
    "386": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "COACHING SCRUTINY",
          "heading": "Ben Youngs accuses RFU of having blinkers on after backing Steve Borthwick",
          "body": "Ben Youngs has criticised the RFU for handing Steve Borthwick a contract extension following England's worst-ever Six Nations campaign. The former scrum-half claimed performance director Conor O'Shea and CEO Bill Sweeney have \"blinkers on\" after the board backed the head coach despite five Test losses in 2026, including a historic defeat to Italy. While Sweeney described the process as a \"thorough and honest review,\" Youngs argued on his podcast that a long-term deal lacks accountability given Borthwick's current 59.6% win rate."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Tournament expansion",
          "heading": "Six Nations tournament organisers remain in talks regarding United States fixture",
          "body": "Discussions surrounding the potential move of a Six Nations fixture to the United States remain ongoing, with tournament organisers yet to confirm if a match will be hosted on American soil. While reports indicate World Rugby is exploring the concept to grow the game internationally, there has been no formal agreement. Scottish Rugby recently confirmed there have been no talks regarding their participation in a US-based game, following earlier reports suggesting England were also unlikely to support the proposal."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "388": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Six Nations",
          "heading": "IRFU confirms there are no plans for Six Nations US fixtures",
          "body": "The IRFU has dismissed speculation regarding the potential relocation of Six Nations matches to the United States. While World Rugby chief executive Alan Gilpin recently suggested that high-profile fixtures like Ireland versus Italy could help grow the sport stateside, the governing body clarified that no such discussions are taking place. An IRFU spokesperson stated that the union believes the competition holds a special place for supporters, noting that playing matches at home remains a central part of the tournament's enduring appeal."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Tournament expansion",
          "heading": "Six Nations tournament organisers remain silent on potential United States fixture",
          "body": "Speculation regarding a Six Nations match being moved to the United States continues, despite a lack of formal confirmation from tournament organisers. While World Rugby has floated the concept to grow the game, recent reports indicate significant internal resistance; specifically, England are considered unlikely to participate due to financial concerns, and Scotland have confirmed they are not in talks. As of today, no definitive plans have been established to take the championship to American soil."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "WXV Global Series",
          "heading": "Scotland women suffer heavy opening defeat against clinical World Cup finalists",
          "body": "Scotland faced a difficult start to their WXV Global Series campaign on Saturday, falling to a 64-26 defeat against Canada at Hive Stadium. Despite tries from Evie Gallagher, Shona Campbell, Lana Skeldon and Rhona Lloyd, the visitors proved clinical, running in 10 tries to secure a dominant victory. While the result was a disappointment, interim head coach Dave Butcher’s side now shifts focus to their next challenge, where they will host New Zealand at the same venue."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Broadcast news",
          "heading": "BBC Wales confirms free-to-air coverage for the WXV Global Series",
          "body": "Wales fans will have free-to-air access to the WXV Global Series after the BBC confirmed coverage of the upcoming campaign. Matches against South Africa and the USA, held at Cardiff Arms Park, will be available on BBC One Wales, iPlayer, and radio. WRU Chief Commercial Officer Tomos Grace noted that the women’s game is the \"fastest growing part of the game\" and remains central to the union’s strategy as the team looks to build on recent development."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Team History",
          "heading": "Argentina maintain established global standing within the top international rankings",
          "body": "Argentina have built a competitive record throughout their modern era, having achieved their best world ranking of No. 3 during the 2007–08 period. As the squad prepares for upcoming challenges in the international calendar, they continue to rely on the experience of a core group that has remained a fixture of their recent lineups. Consistent participation in the top tier of the sport has kept Los Pumas as a recognised presence among the world's elite rugby nations."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Selection focus",
          "heading": "Joseph-Aukuso Suaalii keeps an open mindset regarding his Wallabies position",
          "body": "Joseph-Aukuso Suaalii has rejected calls to specialise in a single position as he navigates his development toward the 2027 World Cup. The 23-year-old, who has primarily featured at centre, insisted he maintains an \"open mindset\" regarding his role in the back line. While veteran James Slipper recently noted that the priority remains getting the ball into Suaalii’s hands in space, coach Les Kiss faces ongoing selection conundrums as he works to finalise a consistent starting XV for next year’s tournament."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Pacific Nations Cup",
          "heading": "Japan targets cup glory against USA at Hanazono Rugby Stadium",
          "body": "Eddie Jones prepares his side for a pivotal clash against the USA at Hanazono Rugby Stadium. While Japan enters the fixture as favourites—backed by a superior world ranking and a dominant record of nine wins in the last ten encounters—the USA arrives in Japan boasting an undefeated streak from their recent Nations Cup pool matches. Jones is targeting home success in the tournament after finishing behind Fiji for two consecutive seasons."
        }
      ],
      "match": {
        "venue": "Hanazono Rugby Stadium, Osaka"
      },
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "465": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Richie Mo’unga returns as All Blacks seek bolder approach in Baltimore",
          "body": "Dave Rennie has reshuffled his side for the series finale in Baltimore, installing Richie Mo’unga at fly-half in a bid to revitalise the All Blacks' attack. With the series currently 2-1 to the Springboks, the visitors are prioritising a high-tempo game to counter South Africa’s forward-driven power. Springbok assistant coach Mzwandile Stick confirmed the tourists are expected to be \"even more bold\" in wider channels, as New Zealand aim to level the four-match series and secure bragging rights."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "RGR series finale",
          "heading": "Rassie Erasmus targets series victory in Baltimore against the All Blacks",
          "body": "South Africa conclude their Rugby’s Greatest Rivalry series in the United States, carrying a 2-1 lead into the final showdown. Rassie Erasmus has made two changes to his side, with Damian Willemse returning to start at full-back following Cheslin Kolbe’s broken jaw. Morne van den Berg also moves into the starting line-up at scrum-half. Having secured consecutive victories in Cape Town and Soweto, the Springboks look to maintain their physical dominance to close out the series."
        }
      ],
      "match": {
        "venue": "M&T Bank Stadium, Baltimore"
      },
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
