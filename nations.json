  "digests": {
    "28": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "PNC final",
          "heading": "Fiji surrender Pacific Nations Cup title following tight Tokyo final defeat",
          "body": "The Flying Fijians surrendered their Pacific Nations Cup crown in Tokyo on Saturday, falling 20-15 to Japan in a tense final. Former France international Virimi Vakatawa and hooker Tevita Ikanivere both crossed in the first half to establish a 12-10 interval lead, despite Mesake Doge receiving a yellow card. Although Isaiah Armstrong-Ravula slotted a penalty to level the scores with a quarter of the match remaining, Samisoni Tua's late try sealed the victory for the hosts."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "386": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "Streak ends",
          "heading": "Red Roses surrender historic winning streak in dramatic draw against Canada",
          "body": "England's historic 39-game winning streak came to an end on Saturday as the Red Roses were held to a 26-26 draw by Canada at Sandy Park. John Mitchell's side scored four tries, including a double from Claudia Moloney-MacDonald, but were frustrated by a relentless Canadian performance that also shattered England's perfect home record against them. Despite missing out on another victory, the hosts remain unbeaten in 40 matches, with a clash against New Zealand at Twickenham awaiting them this weekend."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "TEST DRAMA",
          "heading": "France overcome six cards and a burning bus to defeat Australia",
          "body": "In an extraordinary Test in Aix-en-Provence, France overcame a 19-point deficit and six cards to secure a miraculous 29-26 victory over Australia. The hosts were reduced to 11 players in the first half following a red card and three yellows, allowing the Wallaroos to build a 19-0 lead. After a burning bus outside the stadium delayed the second half, France rallied with 17 unanswered points in the final 25 minutes. Pauline Bourdon Sansus crossed for a crucial try as the depleted home side snatched an unlikely win."
        }
      ],
      "match": {
        "venue": "Stade Maurice David, Aix-en-Provence"
      },
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "388": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "WXV collapse",
          "heading": "Scott Bemand laments errors as Ireland throw away lead against USA",
          "body": "Ireland surrendered a 19-point second-half lead in Sunday's WXV Global Series opener, falling 40-36 to the United States at Tallaght Stadium. Scott Bemand's side looked comfortable at 31-12 following tries from Vicky Elmes Kinlan, Cliodhna Moloney-MacDonald, Aoife Wafer, Eve Higgins, and Erin King. However, a yellow card for Elmes Kinlan sparked a collapse as the visitors ran in four consecutive tries. A disappointed Bemand admitted it was \"a game we should have won\" due to costly discipline errors."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "WXV OPENER",
          "heading": "Italy thrash Japan 55-21 in dominant WXV Global Series opener",
          "body": "Le Azzurre opened their WXV Global Series campaign with a resounding 55-21 victory over Japan at Stadio Omero Tognon. Despite briefly falling behind 14-12 after early scores from Aura Muzzo and Alessandra Frangipani, the hosts took control with three tries in seven minutes from Alyssa D'Inca, Vittoria Vecchini and Giordana Duca. Captain Ostuni Minuzzi marked her 50th cap with a second-half try as Italy secured their highest points tally against the Sakura XV."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "390": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "US expansion",
          "heading": "Jim Hamilton warns 'sacred' Six Nations does not need US move",
          "body": "Former Scotland international Jim Hamilton has criticised World Rugby's proposal to transplant a Six Nations fixture to the United States, insisting the 'sacred' tournament does not need the move. The governing body recently floated the US plan to grow the game globally, opening exploratory talks. While chiefs remain keen on staging flagship matches across the Atlantic, Hamilton's resistance highlights the growing scepticism over disrupting the championship."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "Regional overhaul",
          "heading": "WRU confirms plan to cut professional regions as star players depart Wales",
          "body": "The Welsh Rugby Union has committed to reducing the number of professional regions from four to three as part of a major domestic restructure. This overhaul coincides with the departure of key internationals Jac Morgan, Dewi Lake and Aaron Wainwright from the regional system. Despite the uncertainty, Ospreys coach Mark Jones praised new signing Tom Rogers as a \"Swiss Army Knife\" for his versatility in the back three. These changes arrive as Wales look to reset following their 0-43 defeat to South Africa ahead of facing Japan in Round 4."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "Statistical review",
          "heading": "Los Pumas record consistent scoring trends across their recent international fixtures",
          "body": "In their last 11 matches, Argentina have recorded 321 points scored and 346 points conceded. These figures equate to an average of 29.2 points scored and 31.5 points conceded per match. Within this same 11-game window, the side’s most significant victory occurred in November 2025 when they defeated Wales 52-28 away from home."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "Squad return",
          "heading": "Jordan Petaia reveals misdiagnosed hamstring injury ended his NFL dream",
          "body": "Jordan Petaia has rejoined the Wallabies squad following his return from the United States, where a misdiagnosed injury derailed his brief NFL stint with the Los Angeles Chargers. The 26-year-old utility back, who was recently named in Les Kiss’s 34-man squad for the upcoming Test against the Springboks, explained that persistent tendonitis was initially misidentified. Petaia admitted, \"I was kind of misdiagnosed over there,\" adding that the setback prompted his departure and subsequent move to Japan’s Urayasu D-Rocks."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "PNC CHAMPIONS",
          "heading": "Eddie Jones guides Japan to historic Pacific Nations Cup final victory",
          "body": "Japan claimed their first Pacific Nations Cup title since 2019, overcoming Fiji 20-15 in a physical encounter at Prince Chichibu Memorial Stadium. Tries from Mamoru Harada, Ben Gunter, and a late decider from Samisoni Tua secured the result, which lifts the team back into the World Rugby top 10. Captain Naoto Saito described the breakthrough as a vital confidence boost for the young squad, stating, \"It's a great breakthrough to create history for Japan. It gives this young team great confidence.\""
        }
      ],
      "match": {
        "venue": "Prince Chichibu Memorial Stadium, Tokyo"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "465": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "Selection policy",
          "heading": "Shane Howarth backs overseas eligibility to solve All Blacks scrum struggles",
          "body": "Former All Black Shane Howarth has reignited the debate over New Zealand’s selection policy, suggesting the team must consider picking overseas-based players to address recent set-piece vulnerabilities. Following a difficult series against South Africa, where the scrum was repeatedly exposed, Howarth argued that the departure of South African teams from Super Rugby left New Zealand forwards lacking regular, high-level physical conditioning. He noted that while internal adjustments are being made, the current policy may require a rethink to remain competitive."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "Squad rotation",
          "heading": "Rassie Erasmus releases Pieter-Steph du Toit and Damian de Allende",
          "body": "Coach Rassie Erasmus has confirmed that Pieter-Steph du Toit and Damian de Allende have been released from the Springbok squad ahead of the upcoming one-off Test against the Wallabies in Perth. The pair will return home to spend time with their families following a heavy workload during the recent Rugby’s Greatest Rivalry series against the All Blacks. Erasmus stated that he is confident in the depth of the travelling squad to cover the departures at Optus Stadium."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
}