  "digests": {
    "28": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Championship struggle",
          "heading": "Fiji sink to twelfth place after suffering third consecutive Nations Championship defeat",
          "body": "The Flying Fijians sit twelfth in the standings after failing to secure a victory in their opening three Nations Championship fixtures. A 17-33 loss against Scotland in the third round left the side with three defeats from those three matches. Fiji have struggled defensively during this tournament window, conceding 145 points while scoring only 49. The squad must now prepare for a round-four clash against France, hoping to eventually recapture the form that took them to their highest world ranking of No. 7 back in 2023."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Player exit",
          "heading": "Beno Obano agrees Pau transfer to put England career on hold",
          "body": "The 31-year-old Bath prop Beno Obano has agreed a move to French Top 14 side Pau at the end of the upcoming season. The decision will put his international career on hold due to Steve Borthwick's restriction to domestic-based players. Obano, who won his fifth cap as a replacement in July's defeat by South Africa, joins a growing list of exiled English talent playing in France. Although eligible for selection this term, he will be ineligible once he moves across the Channel."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "FORM GUIDE",
          "heading": "France sit third in the standings after recording two consecutive victories",
          "body": "France maintain their competitive momentum having won three of their last five matches. Following a narrow defeat to New Zealand in July, the side responded with two straight wins, including a comprehensive 42-15 away victory over Japan in their most recent fixture. Les Bleus have scored 116 points across their first three matches in the Nations Championship while conceding 75, leaving the squad third in the overall standings with a positive points difference of 41."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Rugby life",
          "heading": "Ryan Caldwell details harrowing battle with addiction and prison in new autobiography",
          "body": "Former Ireland lock Ryan Caldwell has detailed his recovery from a spiral of addiction, depression, and imprisonment following his retirement from the sport. The 41-year-old, who played for Ulster, Bath, and Exeter, describes his journey from the \"edge\" to finding peace as a meditation teacher in his new book, White Lines. Caldwell credits breathwork and plant-based therapy for his rehabilitation after chronic hip injuries and a final, career-ending concussion at Exeter sent him into a period of deep suicidal depression."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Disciplinary blow",
          "heading": "Gonzalo Quesada banned from South Africa clash after World Rugby disciplinary ruling",
          "body": "Italy head coach Gonzalo Quesada has become the first person sanctioned under World Rugby’s new Match Official Abuse Sanctioning Process, receiving a two-test suspension. The ruling follows Quesada’s public criticism of referee Luc Ramos after the July defeat to New Zealand. Having served the first match of the ban during the loss in Perth, the Argentine is now prohibited from match-day proceedings for the November fixture against South Africa. World Rugby stated the process is \"targeted at reducing comments which often are the basis of the unacceptable increase in abuse\"."
        }
      ]
    },
    "390": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "PATHWAY GRADUATES",
          "heading": "Kerr Yule and pathway graduates feature in Glasgow and Edinburgh season openers",
          "body": "Scottish Rugby’s next generation takes centre stage this weekend as Edinburgh and Glasgow Warriors begin their pre-season preparations. Following Edinburgh’s clash with Ulster, Glasgow travel to Newcastle today with a squad featuring Kerr Yule. The hard-running centre, Scotland Under-20s’ most capped player, recently signed his first professional contract alongside pathway graduates like Matt Urwin and Fergus Watson. With 11 academy products in Edinburgh’s 30-man squad, including 18-year-old Melrose back-row James Dalrymple, Gregor Townsend will be monitoring this influx of youth closely before November."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "SELECTION CALL",
          "heading": "Tom Rogers targets Wales recall following summer move to the Ospreys",
          "body": "Tom Rogers has revealed his move from Scarlets to Ospreys was driven by a desire to play at full-back. Despite becoming the first player from the British Isles to score a Test hat-trick against New Zealand last November, he has not played a Test for Wales since. Rogers admitted he moved to satisfy a \"scratch I needed to itch\" at No. 15 as he seeks to break back into the national squad for upcoming Nations Championship fixtures against Japan, New Zealand and Australia."
        }
      ],
      "match": {
        "venue": "Principality Stadium, Cardiff"
      },
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "SERIES DECIDER",
          "heading": "Los Pumas seek Mendoza redemption as Australia chase historic series sweep",
          "body": "Argentina enter Saturday's second Test in Mendoza desperate to avoid a home series whitewash following last weekend's 21-27 defeat in San Salvador de Jujuy. While the Wallabies have never swept a two-match tour on Argentine soil, coach Les Kiss has signalled his intent by making nine changes, including the return of captain Harry Wilson and fly-half Ben Donaldson. Los Pumas must sharpen their execution after a \"messy\" opening loss to prevent Australia from securing a fourth consecutive victory."
        }
      ],
      "match": {
        "venue": "Estadio Malvinas Argentinas, Mendoza"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Les Kiss makes nine changes as Tom Wright hits 50 caps",
          "body": "Les Kiss has overhauled his side for the rematch against Argentina, making 9 alterations to the starting XV that secured last week’s victory. Full-back Tom Wright reaches his 50th Test appearance, while Joseph-Aukuso Suaalii and Len Ikitau return to reunite their midfield partnership. Harry Wilson resumes the captaincy at number eight as the side looks to build further experience. Reflecting on the rotation, Kiss noted: “We’ve brought in some fresh bodies alongside some existing combinations as we continue to look to build Test experience.”"
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Centenary Test",
          "heading": "Eddie Jones names familiar side for Brave Blossoms' anniversary clash",
          "body": "Japan host Canada at Denka Big Swan Stadium today to mark the JRFU’s 100th anniversary. Head coach Eddie Jones has retained a familiar core, though five changes follow the recent defeat against Australia. Jack Cornelsen and Harry Hockings partner in the locks, while Kanji Shimokawa returns to the back row. Notably, Inoke Burua makes his international debut. Japan have won 17 of their 27 previous encounters with Canada and are currently on an undefeated streak against them spanning the last decade."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Tactical intent",
          "heading": "Mzwandile Stick claims All Blacks refuse to play hide and seek",
          "body": "The Springboks are bracing for an expansive, high-tempo onslaught in Saturday's third Test, with assistant coach Mzwandile Stick noting that Dave Rennie’s side has abandoned caution in favour of keeping the ball in play. The All Blacks have prioritised ball-in-hand time throughout this series, a tactical evolution that Stick acknowledges makes them direct and predictable in their intent. By selecting a dynamic bench, the visitors have signalled their commitment to maintaining intensity against the world champions throughout the final quarter."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Historical resonance",
          "heading": "Siya Kolisi urges Springboks to channel Soweto spirit against All Blacks",
          "body": "Captain Siya Kolisi has challenged the Springboks to draw inspiration from the significance of the FNB Stadium as they face New Zealand in today’s third Test. Noting the stadium's location on the edge of Soweto, Kolisi linked the team’s mission to the legacy of the 1976 student protests. “So many things that happened in Soweto helped shape the South Africa we have today,” he said. The series is currently locked at 1-1, with both sides desperate for a critical victory."
        }
      ],
      "match": {
        "venue": "FNB Stadium, Johannesburg"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    }
  }
}