  "digests": {
    "28": {
      "date": "2026-08-26",
      "edition": "Wednesday 26 August",
      "sections": [
        {
          "kicker": "Sudden loss",
          "heading": "Saimoni Vunilagi dies in Japan after suspected heatstroke during club training",
          "body": "Fijian rugby is in mourning following the death of 26-year-old Saimoni Vunilagi after a suspected heatstroke incident in Japan. The former Fiji youth prospect collapsed during a training session with his club, Kyushu KV, in Fukuoka City where temperatures recently hit 35°C. His club described the squad as \"devastated\" by the sudden loss of the talented back. The tragedy occurs as the national side reflects on their 17-33 loss to Scotland in the Nations Championship, where they remain winless at the bottom of the table."
        }
      ]
    },
    "386": {
      "date": "2026-08-26",
      "edition": "Wednesday 26 August",
      "sections": [
        {
          "kicker": "INJURY BLOW",
          "heading": "Ben Spencer undergoes shoulder surgery as Steve Borthwick faces autumn selection sweat",
          "body": "Steve Borthwick’s autumn plans have been disrupted by news that Ben Spencer will miss the start of the domestic season following shoulder surgery. The Bath captain underwent the procedure to address a long-standing issue after England’s summer tour and is not expected to return until later in the autumn. With the Nations Championship resuming in October, the 34-year-old’s availability for the November visit of Australia is now in doubt, placing significant pressure on Borthwick’s specialist scrum-half depth."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-26",
      "edition": "Wednesday 26 August",
      "sections": [
        {
          "kicker": "Form guide",
          "heading": "France hold third place in Nations Championship after beating Japan 42-15",
          "body": "France sit third in the Nations Championship table following their 42-15 victory against Japan. That result in July marks a second consecutive win for Fabien Galthié’s side. In their last five matches, France have recorded three wins and two losses. This sequence includes a narrow 34-32 defeat to New Zealand in the opening round of the tournament. The squad currently holds a positive points difference of 41 after three rounds of the inaugural global competition."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-26",
      "edition": "Wednesday 26 August",
      "sections": [
        {
          "kicker": "Legal update",
          "heading": "High Court permits former players to proceed with brain injury litigation",
          "body": "The High Court has ruled that a collective legal action brought by hundreds of former rugby players over brain injuries can proceed to a full trial. The decision allows the litigation against governing bodies to continue after a procedural hearing. Claimants allege that authorities failed to provide sufficient protection against permanent neurological damage. This ruling marks a significant development in the long-running case, which remains open until a final judgment or settlement is reached between the players and the sport."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-08-26",
      "edition": "Wednesday 26 August",
      "sections": [
        {
          "kicker": "Coaching blow",
          "heading": "Gonzalo Quesada banned for South Africa clash after referee abuse charge",
          "body": "Italy head coach Gonzalo Quesada will be absent from the touchline for the November Test against South Africa after receiving a two-match ban. The Argentine is the first coach sanctioned under World Rugby’s new Match Official Abuse Sanctioning Process, introduced in July. The suspension follows Quesada's criticism of referee Luc Ramos after the defeat to New Zealand on 11 July. Having already missed the 10-57 loss to Australia, Quesada remains prohibited from stadium proceedings for the upcoming Round 4 fixture."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-26",
      "edition": "Wednesday 26 August",
      "sections": [
        {
          "kicker": "FLY-HALF ELITE",
          "heading": "Finn Russell labelled the most accomplished fly-half in new global rankings",
          "body": "Finn Russell has been hailed as Scotland’s most accomplished fly-half in a new assessment of the world’s top 10 playmakers. The Planet Rugby rankings placed the Bath star among the elite, ahead of double World Cup winner Handré Pollard and Italy’s Paolo Garbisi. While the list was topped by a single \"greatest\" rival, Russell’s inclusion underscores his value as Scotland sit fifth in the Nations Championship table. Following the 33-17 win against Fiji, his creativity remains central to Gregor Townsend's plans."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "391": {
      "date": "2026-08-26",
      "edition": "Wednesday 26 August",
      "sections": [
        {
          "kicker": "Training intensity",
          "heading": "Wales push through physical pain barrier to improve match performance",
          "body": "Wales are entering the final stages of a gruelling three-week pre-season block as the squad strives to address the fitness shortcomings that have hindered their recent competitive outings. With the team winless in their last nine fixtures, strength and conditioning coach Gareth Harris is prioritising higher-intensity interval work to ensure the side can sustain performance levels for 80 minutes. Players have been training in extreme heat, with Harris noting that the group is demonstrating \"exceptional\" commitment to elevating their standards."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-08-26",
      "edition": "Wednesday 26 August",
      "sections": [
        {
          "kicker": "Transfer news",
          "heading": "Francisco Moreno joins Newcastle Red Bulls after making international debut",
          "body": "Argentina tighthead Francisco Moreno has confirmed his move to the English Premiership, signing a one-year deal with Newcastle Red Bulls. The 24-year-old, who made his Test debut against South Africa earlier this month, is currently preparing for the upcoming series against the Wallabies. Newcastle head coach Dan McFarland praised the signing, stating: “Francisco is a relatively young tighthead who has already taken his first steps in international rugby, and shows a lot of promise.”"
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "461": {
      "date": "2026-08-26",
      "edition": "Wednesday 26 August",
      "sections": [
        {
          "kicker": "Selection strategy",
          "heading": "Les Kiss confirms Joseph-Aukuso Suaalii will remain at outside centre",
          "body": "Wallabies coach Les Kiss has reaffirmed that Joseph-Aukuso Suaalii will continue to settle at outside centre, ending speculation regarding his immediate role. While Suaalii filled in on the wing against Japan in Osaka due to injury-related squad flexibility, Kiss stated it is right to persist in the midfield for now. The coach noted that he is asking all players in the back five to learn multiple roles, but he maintains a focus on building stability in his primary centre partnership."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "463": {
      "date": "2026-08-26",
      "edition": "Wednesday 26 August",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Japanese rugby community mourns following the death of Saimoni Vunilagi",
          "body": "The Japanese rugby community is in mourning following the death of Saimoni Vunilagi, who passed away on Friday after falling ill during a training session with second-division side Kyushu Kyuden Voltex. The 26-year-old back-rower, who previously played for Suntory Sungoliath, had displayed symptoms consistent with severe heatstroke. A minute's silence was observed in his honour prior to Japan’s recent fixture against Australia, as players and staff across the league express their deep condolences to the Vunilagi family."
        }
      ]
    },
    "465": {
      "date": "2026-08-26",
      "edition": "Wednesday 26 August",
      "sections": [
        {
          "kicker": "Coaching scrutiny",
          "heading": "Sir Steve Hansen warns All Blacks to embrace desperation in Cape Town",
          "body": "Sir Steve Hansen has urged the All Blacks to maintain their intensity as they prepare to face a vengeful Springboks side this weekend. Following last week’s 33-16 victory at Ellis Park, the former head coach stressed that New Zealand must match the hosts' expected desperation to secure the series. \"They've got to get desperate too,\" Hansen told the Shaun O'Neill Podcast. \"You've only got to have a 5% shift in mental attitude, and the other team have 5%, so that's a 10% shift.\""
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-26",
      "edition": "Wednesday 26 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Rassie Erasmus confirms Siya Kolisi returns as captain for second Test",
          "body": "Siya Kolisi is set to return for Saturday’s second Test in Cape Town after recovering from a hamstring injury. Head coach Rassie Erasmus confirmed the skipper is \"100 per cent\" fit and will lead the side, allowing Pieter-Steph du Toit to focus solely on his performance during his 100th Test match. Erasmus accepted responsibility for last week's defeat, admitting he was \"maybe too clever\" with his tactical planning following an early injury to Kurt-Lee Arendse that disrupted the backline."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
