    "465": {
      "date": "2026-11-15",
      "edition": "Sunday 15 November",
      "sections": [
        {
          "kicker": "Upset loss",
          "heading": "Dave Rennie's All Blacks beaten 35-28 by Wales at Principality Stadium",
          "body": "New Zealand's 34-match winning run over Wales ended on Saturday, when Steve Tandy's side scored five tries to win 35-28. Wales led by 14 points three times, with Tomos Williams, Dewi Lake and Archie Griffin among their try-scorers, and James Botham was named man of the match. Cortez Ratima, Wallace Sititi and Fehi Fineanganofo crossed for New Zealand, who clawed back to 21-21 before the Welsh defence repelled wave after wave of black jerseys. Dave Rennie had made eight changes from the side that beat Scotland."
        },
        {
          "kicker": "Around the world",
          "heading": "England thrash Australia 45-22",
          "body": ""
        }
      ],
      "match": {
        "venue": "Principality Stadium, Cardiff"
      }
    },
    "467": {
      "date": "2026-11-15",
      "edition": "Sunday 15 November",
      "sections": [
        {
