      }
    },
    "391": {
      "date": "2026-11-15",
      "edition": "Sunday 15 November",
      "sections": [
        {
          "kicker": "Historic win",
          "heading": "Wales stun All Blacks 35-28 in Cardiff, first win since 1953",
          "body": "Wales held firm through the final 25 minutes at the Principality Stadium on Saturday, after Peter Lakai's try had cut the lead to seven points. New Zealand were repeatedly held up over the Welsh line as the hosts ground out the finish, ending a 34-match losing run against the three-time Rugby World Cup winners. Tomos Williams had a hand in every Welsh try, scoring one himself, and Steve Tandy's side made five changes from the win over Japan."
        },
        {
          "kicker": "Around the world",
          "heading": "France beat South Africa 21-19",
          "body": "Ireland beat Fiji 43-15."
        }
      ],
      "source": {
