  "digests": {
    "28": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "Form guide",
          "heading": "Fiji drop to 12th on the table after third consecutive defeat",
          "body": "Fiji have recorded only one victory in their last five matches. Over that same five-game stretch, the team suffered four losses to slip down the standings. The Flying Fijians are currently on a run of three straight defeats. Their most recent outing in July 2026 ended in a 17-33 loss to Scotland at home during the Nations Championship group stage."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "SQUAD SELECTION",
          "heading": "Maro Itoje returns to England squad as Steve Borthwick omits Courtney Lawes",
          "body": "Maro Itoje has returned to a 36-man England training squad following a summer sabbatical as Steve Borthwick’s side prepares for the Nations Championship. The 102-cap second row, who missed July's matches against South Africa, Fiji and Argentina, is expected to reclaim the captaincy from Jamie George for the November opener against Australia. While George and Ollie Chessum join the camp despite carrying injuries, the head coach has omitted Courtney Lawes and Joe Marchant, stating the pair must prove their form in the Premiership before earning a recall."
        }
      ],
      "match": {
        "venue": "Allianz Stadium, Twickenham"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "Legal update",
          "heading": "High Court allows concussion lawsuits against rugby authorities to continue",
          "body": "The high-stakes legal battle regarding concussion in rugby union remains active, following a recent ruling that allows neurological injury lawsuits to proceed in the High Court. The ongoing litigation, which our coverage has tracked since yesterday, continues to scrutinise the sport's management of player safety and head injuries. While the case remains unresolved, the court's latest decision ensures the claims will advance, keeping the focus firmly on the long-term implications for international rugby governance and player welfare protocols."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "388": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "Player feature",
          "heading": "Former Ireland Lock Ryan Caldwell Details His Recovery From Personal Turmoil",
          "body": "Former Ireland international Ryan Caldwell has opened up about his difficult post-rugby career, reflecting on a journey through addiction, depression, and incarceration. The former Ulster, Bath, and Exeter second-row, who is set to celebrate his 42nd birthday this week, has transitioned into a new life as a meditation teacher and breathwork coach. Caldwell details this harrowing period and his subsequent path to finding peace in his new book, 'White Lines: a Rugby Life Broken and Rebuilt'."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "Injury update",
          "heading": "Exeter Chiefs lock Andrea Zambonin remains sidelined following shoulder surgery recovery",
          "body": "Andrea Zambonin continues his recovery from shoulder surgery, with the Italy lock confirmed to miss the start of the new season for Exeter Chiefs. While the forward recently signed a new contract with the club, he remains unavailable for selection as he completes his rehabilitation programme. There is currently no confirmed date for his return to full training or competitive action, leaving the lock's availability for the upcoming international fixtures still to be determined by his ongoing medical progress."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "Legal proceedings",
          "heading": "World Rugby and UK unions fail to dismiss concussion lawsuit claims",
          "body": "The ongoing legal battle concerning concussion in rugby union continues after World Rugby and several UK-based governing bodies lost their bid to have high-profile brain injury lawsuits thrown out. The court's decision ensures that the litigation will proceed, maintaining significant scrutiny on how the sport manages player welfare and long-term head injury risks. As the case advances, the sport’s authorities face continued pressure to address historical safety protocols and the long-term health implications for former players involved in the action."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "Structural Reform",
          "heading": "WRU Outlines Potential Plans for Future Professional Regional Rugby Clubs",
          "body": "The future of the professional game in Wales faces a critical period, with the WRU set to conduct workshops in December to determine licensing criteria for clubs. Under current proposals, the union is weighing a landscape of two, three, or even four professional sides. While the Ospreys and Scarlets face potential consolidation, the governing body has not ruled out the creation of an entirely new entity in west Wales. WRU chief Abi Tierney has defended these necessary, albeit difficult, structural deliberations."
        }
      ]
    },
    "460": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "Series conclusion",
          "heading": "Argentina draws 28-28 with Australia as series slips away in Mendoza",
          "body": "Los Pumas concluded their home series against Australia with a 28-28 stalemate in Mendoza, falling short of a series-leveling result. Despite a spirited second-half comeback—highlighted by two tries from Pablo Matera and one from Ignacio Ruiz—Argentina could not capitalise on a late two-man advantage. Australia secured the series win, with Wallabies captain Harry Wilson noting his side was hurt by the final result, reflecting on the missed opportunity to close out the match after levelling the score in the 70th minute."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "461": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "Series secured",
          "heading": "Australia claim historic Argentina series victory despite frustrating final test draw",
          "body": "The Wallabies secured their first-ever series victory on Argentine soil with a 28-28 draw in Mendoza on Saturday, keeping Les Kiss unbeaten as head coach. Despite leading 14-0 early, Australia failed to capitalise on a two-man advantage in the final 10 minutes. Captain Harry Wilson admitted the squad was hurting, noting, “The boys were hurting with the result. We really wanted to win that, and there’s a lot of disappointment.” The team now turns its attention to facing the Springboks."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "Test victory",
          "heading": "Mamoru Harada scores brace as Japan overcome Canada 57-12 in Niigata",
          "body": "Japan secured a morale-boosting 57-12 win over Canada at Denka Big Swan Stadium on Saturday, running in nine tries to two. Hooker Mamoru Harada claimed a brace, while debutant Takumi Inaba and winger Inoke Burua also made their mark in a clinical performance. Head coach Eddie Jones now turns his attention to the upcoming Pacific Nations Cup opener. Jones stated, \"The next game is the U.S.A., and we'll start thinking about that tomorrow. They've been improving, so we'll deal with them first.\""
        }
      ]
    },
    "465": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "Selection blow",
          "heading": "Dave Rennie loses nine players as injury crisis hits All Blacks",
          "body": "The All Blacks head to Baltimore for the final test against the Springboks without nine players, including three first-choice starters. Captain Ardie Savea is sidelined with a dislocated shoulder, while Quinn Tupaea and Luke Jacobson have returned home with knee and elbow injuries respectively. Coach Dave Rennie praised the impact of replacement Wallace Sititi, noting, “Wallace came on and played well, so we’re certainly not going to use that as an excuse.” Six other squad members are also departing the touring party."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "Series lead",
          "heading": "South Africa overcome New Zealand 29-24 to take series lead",
          "body": "South Africa secured a 29-24 victory over the All Blacks at the FNB Stadium in Soweto, moving into a 2-1 series lead. After falling behind to a Will Jordan try, the Springboks responded through Jesse Kriel and Malcolm Marx, whose late scores proved decisive. Rassie Erasmus’ side now travels to Baltimore for the final Test, having effectively neutralised New Zealand despite losing Cheslin Kolbe to a broken jaw. Erasmus has since apologised for his recent media conduct, praising counterpart Dave Rennie as a \"gentleman.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    }
  }
