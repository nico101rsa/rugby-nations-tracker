  "digests": {
    "28": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Fijian rugby player Saimoni Vunilagi dies in Japan of suspected heatstroke",
          "body": "The rugby community is mourning the loss of Saimoni Vunilagi after the 26-year-old Fijian back-row forward passed away in Japan. Vunilagi, who played for second-division side Kyushu KV, was hospitalised in Fukuoka on Monday 3 August after displaying severe symptoms of heatstroke following a team practice. Despite medical efforts, he died on Friday 7 August. Kyushu KV released a statement expressing that players and staff are \"devastated by this sudden news\" as temperatures in Fukuoka reached 35 degrees Celsius."
        }
      ]
    },
    "386": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
        {
          "kicker": "Contract cuts",
          "heading": "Ollie Lawrence and Elliot Daly lose England central contracts in squad reshuffle",
          "body": "Steve Borthwick has dropped centre Ollie Lawrence and versatile back Elliot Daly from England's 25-man central contract list. The omission comes as Borthwick reshapes his squad ahead of next year's World Cup in Australia, making five changes to the group who receive around £150,000 a season. While Borthwick handed contracts to Northampton forward Alex Coles and Sale prop Asher Opoku-Fordjour, Lawrence and Daly must now fight back from the margins."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "387": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
        {
          "kicker": "Form guide",
          "heading": "France secure consecutive victories to build momentum in Nations Championship",
          "body": "France have established a current run of two straight wins in their global campaign. In their most recent game, Les Bleus beat Japan 42-15 away during the Nations Championship group stage. Looking at their broader form, France have won three games in their last five matches. They have recorded two losses in that same five-fixture block. The team currently sit third in the table of 12 nations."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Ireland mourns as legendary Irish Times writer Edmund Van Esbeck dies",
          "body": "The Irish rugby community is mourning legendary journalist Edmund 'Ned' Van Esbeck, who has died aged 94. Van Esbeck spent more than 30 years covering the sport for The Irish Times, writing his weekly column from 1968 until 2002. He chronicled 18 overseas tours with Ireland and the Lions, and wrote several authoritative books, including Irish Rugby 1874-1999. IRFU CEO Kevin Potts paid tribute to Van Esbeck, who was a respected voice during the sport's amateur and professional eras."
        }
      ]
    },
    "389": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
        {
          "kicker": "Springbok challenge",
          "heading": "Italy aim to rebuild against South Africa following heavy Australia defeat",
          "body": "Italy return to action against South Africa following a heavy 10-57 defeat to Australia in Round 3. That result leaves the Azzurri eleventh in the tournament standings after three matches. They have recorded three defeats from their three opening fixtures. Additionally, Italy have conceded 131 points across those three games. In the most recent meeting between the sides, Italy suffered a 32-14 home defeat in November 2025."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
        {
          "kicker": "Legal battle",
          "heading": "Scottish rugby remains on alert as landmark concussion lawsuit proceeds in court",
          "body": "The wider game, including Scottish rugby's governing body, is monitoring developments closely after a UK court delivered a landmark decision allowing the rugby concussion lawsuits to proceed. The group litigation had previously faced a critical period of uncertainty, with reports last week suggesting the legal action was at risk of being dismissed following a change of legal representation by the claimants. With the court now allowing the case to move forward, the governing bodies face a prolonged legal battle over player brain injuries."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
        {
          "kicker": "Boardroom return",
          "heading": "Wales legend Alun Wyn Jones joins Ospreys board during survival fight",
          "body": "Former Wales captain Alun Wyn Jones has joined the Ospreys board of directors with immediate effect. The 40-year-old former lock, who won 158 caps for Wales, returns at a turbulent time for his former club. Under Welsh Rugby Union plans to cut professional men's teams to three, either the Swansea-based Ospreys or the Scarlets will be axed by 2028. Jones wants to bring his experience 'to help drive long-term growth and stability for the organisation.'"
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
        {
          "kicker": "Touring squad",
          "heading": "Les Kiss names bolstered Wallabies squad for two Tests in Argentina",
          "body": "Australia head coach Les Kiss has handed Los Pumas a warning by naming fit-again midfielders Len Ikitau and Joseph-Aukuso Suaalii in a 34-man touring squad. The Wallabies, who recently registered back-to-back victories over Japan, will travel to Argentina for two Tests, starting in San Salvador de Jujuy before heading to Mendoza. While the visitors welcome back their star backline duo, they will be without injured prop Zane Nonggorr and the suspended Miles Amatosero."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
        {
          "kicker": "Squad selection",
          "heading": "Len Ikitau and Joseph-Aukuso Suaalii return to Wallabies squad for Argentina",
          "body": "The Wallabies assemble in Sydney today before flying to Argentina, bolstered by the return of midfielders Len Ikitau and Joseph-Aukuso Suaalii. Ikitau has recovered from the ankle injury sustained during the 57-10 win over Italy, while Suaalii is fit after a hamstring strain. Coach Les Kiss selected a 34-man squad, rewarding the group that secured back-to-back victories against Japan. The team departs on Sunday for the two-Test tour, with full-back Tom Wright in line to earn his 50th cap."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "463": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Fijian player Saimoni Vunilagi dies from suspected heatstroke during training in Japan",
          "body": "The Japanese rugby community is in mourning following the death of 26-year-old Fijian player Saimoni Vunilagi. Vunilagi passed away after suffering suspected heatstroke during a training session in Japan. The incident underscores the extreme environmental challenges facing athletes during the current summer heat. While the Brave Blossoms remain 10th in the standings, this tragedy has overshadowed tactical reviews following their recent loss to France. Player welfare and safety protocols have now become the primary focus for both domestic clubs and the international setup."
        }
      ]
    },
    "465": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
        {
          "kicker": "Selection Call",
          "heading": "Dave Rennie names Fabian Holland to start against South Africa in Johannesburg",
          "body": "Head coach Dave Rennie has made just one change to the starting XV that defeated Ireland, handing fit-again lock Fabian Holland a start for today’s series opener in Johannesburg. Holland replaces Patrick Tuipulotu in the second row, while Josh Moorby retains his place on the wing. Rennie noted there is \"massive competition for places\" in a squad that sees Damian McKenzie fit to start at full-back. A win today would see New Zealand leapfrog the Springboks to reclaim the world No. 1 ranking."
        }
      ],
      "match": {
        "venue": "Ellis Park, Johannesburg",
        "referee": "Matthew Carley"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-22",
      "edition": "Saturday 22 August",
      "sections": [
