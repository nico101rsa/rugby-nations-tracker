    "387": {
      "date": "2026-11-15",
      "edition": "Sunday 15 November",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Julien Marchand ruled out for rest of Nations Championship as Jalibert nears return",
          "body": "Julien Marchand has been ruled out for the rest of the Nations Championship, Planet Rugby reports, after thigh tightness during the warm-up before Friday's win over South Africa. Peato Mauvaka started in his place, and Guillaume Cramont will be reserve hooker for the Argentina match and the finals. The news is partly offset by Matthieu Jalibert, who has not played since September with a quadriceps injury and is expected at the Marcoussis camp early next week."
        },
        {
          "kicker": "Around the world",
          "heading": "England beat Japan 78-15 with Will Joseph among the tries",
