  "digests": {
    "28": {
      "date": "2026-11-22",
      "edition": "Sunday 22 November",
      "sections": [
        {
          "kicker": "Twickenham stakes",
          "heading": "Winless Fiji met Italy in Udine with a Twickenham rematch at stake",
          "body": "Fiji head coach Jake White's side went into Saturday's Nations Championship test against Italy at Udine's Bluenergy Stadium with both teams still chasing a first win in the competition, OnRugby reported. Fiji arrived bottom of Pool Sud without a point after the 15-43 defeat by Ireland in Dublin. The Federazione Italiana Rugby noted that a loss — or a win without a bonus point — would send them into a sixth-place final against Italy at Twickenham's Allianz Stadium on finals weekend."
        },
        {
          "kicker": "Around the world",
          "heading": "All Blacks lose 37-12 to England",
          "body": "Scotland beat Japan 67-5 as Darcy Graham and Liam McConnell score hat-tricks. Argentina captain Julián Montoya returns at hooker for France test. Ireland U20 lose 31-29 to Scotland in opening match."
        }
      ],
      "source": {
        "name": "OnRugby"
      }
    },
    "386": {
      "date": "2026-11-22",
      "edition": "Sunday 22 November",
      "sections": [
        {
          "kicker": "Twickenham win",
          "heading": "Itoje's England hammer New Zealand 37-12 to sit top of the log",
          "body": "Saturday's Round 6 win at Allianz Stadium, Twickenham, sends captain Maro Itoje's England into Sunday top of the 12-team Nations Championship log, with five wins from six and a points difference of +159. Under head coach Steve Borthwick they had won only four of their previous 20 Tests against South Africa, New Zealand, France, Ireland and Scotland, the Guardian noted. The All Blacks arrived off a 35-28 defeat to Wales, with NZ Rugby chair David Kirk warning of a \"serious examination\" if they played poorly at Twickenham."
        },
        {
          "kicker": "Around the world",
          "heading": "Scotland beat Japan 67-5 as Darcy Graham and Liam McConnell score hat-tricks",
          "body": "Argentina captain Julián Montoya returns at hooker for France test. Ireland U20 lose 31-29 to Scotland in opening match."
        }
      ]
    },
    "387": {
      "date": "2026-11-22",
      "edition": "Sunday 22 November",
      "sections": [
        {
          "kicker": "Half-back return",
          "heading": "Matthieu Jalibert returns at fly-half to partner Antoine Dupont against Argentina",
          "body": "Jalibert's recall alongside France's Antoine Dupont came as head coach Fabien Galthié tested squad depth amid a series of injuries, according to Americas Rugby News' guide to Saturday's Round 6 test against the Pumas at the Stade de France. Galthié's side, ranked third in the world, went in having lost just twice in 10 Tests this year. Argentina head coach Felipe Contepomi's eighth-ranked team had two wins and a draw from eight matches, the latest a 19-14 win over Italy in Genoa."
        },
        {
          "kicker": "Around the world",
          "heading": "All Blacks lose 37-12 to England",
          "body": "Scotland beat Japan 67-5 as Darcy Graham and Liam McConnell score hat-tricks. Ireland U20 lose 31-29 to Scotland in opening match."
        }
      ],
      "match": {
        "venue": "Stade de France, Saint-Denis",
        "referee": "Hollie Davidson"
      },
      "source": {
        "name": "Americas Rugby News"
      }
    },
    "388": {
      "date": "2026-11-22",
      "edition": "Sunday 22 November",
      "sections": [
        {
          "kicker": "U20 defeat",
          "heading": "Ireland U20 edged 31-29 by Scotland as Paul Neary's conversion drifts wide",
          "body": "Ireland U20 began their campaign with a 31-29 defeat at Musgrave Park on Friday, five tries built on a dominant scrum and maul undone by Scotland's sharper goal-kicking, The42 reported. St Mary's out-half Paul Neary had the chance to level at the death, but his conversion slid wide. Full-back Fionn Rowsome opened the scoring, gathering Frankie Óg Sheehan's kick, before first-half yellow cards for lock Jonny Ginnety and UCD's Bernard White let Scotland back in through tries from wing Rory Caldwell and second row James Dalrymple."
        },
        {
          "kicker": "Around the world",
          "heading": "All Blacks lose 37-12 to England",
          "body": "Scotland beat Japan 67-5 as Darcy Graham and Liam McConnell score hat-tricks. Argentina captain Julián Montoya returns at hooker for France test."
        }
      ],
      "source": {
        "name": "The42"
      }
    },
    "389": {
      "date": "2026-11-22",
      "edition": "Sunday 22 November",
      "sections": [
        {
          "kicker": "Fly-half call",
          "heading": "Quesada handed Domingo Miotti his Italy debut at fly-half against Fiji",
          "body": "Italy head coach Gonzalo Quesada said the Montpellier No. 10's place in Saturday's test in Udine had been planned from the start, with Paolo Garbisi and Tommy Allan both told. He weighed starting Garbisi or Allan at 10 with Miotti on the bench. Injuries to wings Lynagh, Faissal, Pani and Trulla instead pushed Ange Capuozzo to the wing and Allan to full-back. The only other change from the Argentina defeat was Alessandro Ortombina starting in place of Federico Ruzza, with Quesada naming him lineout leader."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa's Rassie Erasmus handed six-match ban over match-fixing comments",
          "body": "Argentina's Justo Piccardo misses France test with fatigue."
        }
      ],
      "match": {
        "venue": "Bluenergy Stadium, Udine"
      },
      "source": {
        "name": "OnRugby"
      }
    },
    "390": {
      "date": "2026-11-22",
      "edition": "Sunday 22 November",
      "sections": [
        {
          "kicker": "Murrayfield rout",
          "heading": "Darcy Graham and Liam McConnell hat-tricks power Scotland past Japan 67-5",
          "body": "Saturday's Nations Championship round-six win at Murrayfield ran to 11 tries. A largely second-string Scotland side led 29-0 at the break in front of a 67,000 sell-out. Wing Darcy Graham's treble took his Scotland try tally to 41. Rookie back-rower Liam McConnell completed his hat-trick three minutes after Japan's Takuro Matsunaga scored a 53rd-minute consolation. Planet Rugby rated four wins from six in the group stage a solid return but noted plenty of grumbles remain about head coach Gregor Townsend."
        },
        {
          "kicker": "Around the world",
          "heading": "All Blacks lose 37-12 to England",
          "body": "Argentina captain Julián Montoya returns at hooker for France test. Ireland U20 lose 31-29 to Scotland in opening match."
        }
      ]
    },
    "391": {
      "date": "2026-11-22",
      "edition": "Sunday 22 November",
      "sections": [
        {
          "kicker": "Rotation call",
          "heading": "Steve Tandy rings changes for Australia after 300 tackles against All Blacks",
          "body": "Wales head coach Steve Tandy explained the reshuffle for Saturday's Test against Australia on workload grounds after the All Blacks win: \"When you make 300 tackles and the ball-in-play time was high, we were always going to make changes.\" His side was captained by Dewi Lake, with Sam Costelow and scrum-half Tomos Williams in the halves. Exeter's Kane James was among the replacements, in line for his first home Test appearance. Luc Ramos of the French federation was named referee."
        },
        {
          "kicker": "Around the world",
          "heading": "All Blacks lose 37-12 to England",
          "body": "Scotland beat Japan 67-5 as Darcy Graham and Liam McConnell score hat-tricks. Argentina captain Julián Montoya returns at hooker for France test. Ireland U20 lose 31-29 to Scotland in opening match."
        }
      ],
