  "digests": {
    "28": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "Disciplinary blow",
          "heading": "Fiji scrumhalf Kuruvoli receives four-week ban for Rugby Nations Championship incident",
          "body": "Fiji's difficult campaign has hit another roadblock with scrumhalf Kuruvoli handed a four-week ban. The suspension follows an incident of physical abuse during a Rugby Nations Championship match, ruling the half-back out of crucial upcoming fixtures. The disciplinary blow compounds a tough run for the Flying Fijians, who sit bottom of the log after suffering three consecutive defeats, most recently a 17-33 loss to Scotland. The team must now prepare for their next match against France without the penalised scrumhalf."
        }
      ]
    },
    "386": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "CROSS-SPORT CLASH",
          "heading": "Jamie George recruits England stars for charity cricket clash against Somerset",
          "body": "England captain Jamie George will swap his rugby boots for a cricket bat later this month, skippering a star-studded 'Team Rugby' against county professionals Somerset in Taunton. The T20 fixture, raising funds for the Motor Neurone Disease Association, features a host of elite England talent including Owen Farrell, Elliot Daly, Ben Earl, and Max Malins. George joked that Daly and Earl — who both played high-level youth cricket — will need to carry the batting, while the rest of the squad scrambles to contain Somerset captain Lewis Gregory's side."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "Fiji focus",
          "heading": "France eye physical Fiji test after downing Japan in Round three",
          "body": "France look ahead to their next fixture against Fiji in Round four. In their last match, Les Bleus beat Japan 42-15 in Round three. That result leaves France third in the standings. After three matches, the team have recorded two wins and one defeat. Across those three tournament fixtures, France scored 116 points. They conceded 75 points over the same period. When the sides last met in November 2025, France beat Fiji 34-21 at home in an international friendly."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "COACHING RETURN",
          "heading": "Former Ireland boss Joe Schmidt joins Ulster on a consultancy basis",
          "body": "Former Ireland head coach Joe Schmidt has returned to Irish rugby, signing a 12-month consultancy deal with United Rugby Championship side Ulster. The former Wallabies boss, who guided Ireland to three Six Nations titles, will provide strategic mentorship and guidance to Ulster's coaching staff at all levels. Head coach Richie Murphy welcomed the appointment, stating he knows \"first-hand the value he brings to an organisation.\" Schmidt will conduct a mix of in-person and remote sessions."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "Club finances",
          "heading": "Gloucester CEO Alex Brown confirms new club investment talks remain ongoing",
          "body": "Gloucester Chief Executive Alex Brown has confirmed that negotiations regarding fresh external investment into the club remain ongoing. The search, initiated to safeguard the Premiership side's long-term financial stability, continues alongside planning for on-field targets ahead of the domestic season. Although Brown acknowledged ongoing frustrations on the pitch, the club has not finalised any terms with potential external partners. Discussions will continue behind closed doors until the club formalises a partnership to secure its future."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "Executive dismissed",
          "heading": "Chairman John McGuigan dismisses Scottish Rugby chief executive Alex Williamson after inquiry",
          "body": "The board of Scottish Rugby has dismissed chief executive Alex Williamson with immediate effect, concluding a months-long independent investigation into his conduct. Williamson, who took office in early 2025, had been on extended leave since May. Chairman John McGuigan stated that Williamson's conduct \"had fallen significantly below the standards we set as an organisation.\" Chief financial officer David White will step in as interim chief executive while the governing body begins the process of replacing him."
        }
      ],
      "match": {
        "venue": "Murrayfield, Edinburgh"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "Regional licensing",
          "heading": "Scarlets vow survival fight after WRU grants Cardiff and Dragons licences",
          "body": "The WRU has guaranteed future professional licences to Cardiff and Dragons, plunging Scarlets and Ospreys into a straight fight for the sole remaining western berth by 2028. Facing a battle for survival or a potential merger, Scarlets chiefs released a statement insisting they will remain \"at the heart of west Wales.\" Meanwhile, Swansea Council is prepared to resume legal action against the governing body, arguing that reducing the country to three regions lacks adequate justification."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "Opposition squad",
          "heading": "Siya Kolisi leads five returning Springboks for Buenos Aires Test",
          "body": "Rassie Erasmus has recalled captain Siya Kolisi and lock Eben Etzebeth to a 26-man South Africa squad for next Saturday’s clash in Buenos Aires. The touring party includes fit-again fly-half Sacha Feinberg-Mngomezulu, though Erasmus has opted to leave 18 frontline players in Johannesburg to prepare for the All Blacks. Los Pumas face a physical test despite the absences of Ox Nché and Franco Mostert, with Erasmus warning that \"Argentina are a quality outfit and we know we will be in for a massive challenge\"."
        }
      ],
      "match": {
        "venue": "Buenos Aires"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "SELECTION CALL",
          "heading": "Les Kiss confirms Zac Lomax remains in Wallabies contention despite league deal",
          "body": "Wallabies head coach Les Kiss has used his first week in camp to confirm that cross-code star Zac Lomax remains in the frame for a gold jersey. Despite Lomax signing a three-year deal with the PNG Chiefs league side for 2028, Kiss insists \"competitive pressure in the right way makes everyone better\" as he assesses his squad depth. The Western Force winger is currently recovering from a pelvis injury but is expected to be \"unleashed\" in the domestic season to prove his fitness."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "Log update",
          "heading": "Eddie Jones' Japan drop to 10th place following consecutive Nations Championship defeats",
          "body": "Japan have recorded two victories and three defeats in their last five fixtures. This run includes a current streak of two straight losses following the conclusion of the July test window. In their most recent outing, the Brave Blossoms suffered a 15-42 defeat against France on home soil during the Nations Championship group stage. The result leaves the side sitting 10th in the overall standings. They currently hold a points difference of minus 26 after three matches."
        }
      ],
      "rung": "data"
    },
    "465": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "TOUR ARRIVAL",
          "heading": "Dave Rennie confirms Ardie Savea will miss the tour's opening matches",
          "body": "Head coach Dave Rennie confirmed the All Blacks have arrived in Cape Town without Ardie Savea, who is being rested until mid-August. Savea is scheduled to join the 44-man squad after the clash with the Sharks, missing the first two tour fixtures to manage a heavy workload. “He’s been playing and training since January 2025,” Rennie said. “We just wanted him to take some time out.” Stand-in captain Codie Taylor will lead the side against the Stormers on Friday."
        }
      ],
      "match": {
        "venue": "DHL Stadium, Cape Town"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "Squad selection",
          "heading": "Rassie Erasmus recalls Siya Kolisi among five key returnees for Argentina Test",
          "body": "Head coach Rassie Erasmus has named a 26-man touring squad for next Saturday’s Test in Buenos Aires, headlined by the return of captain Siya Kolisi. Having missed the Nations Championship through injury, Kolisi is joined by Eben Etzebeth, Lood de Jager, Sacha Feinberg-Mngomezulu and Morné van den Berg in a refreshed group. Rassie intends to give those returning from injury a \"valuable run\" against Los Pumas, viewing the match as a vital rehearsal before the Springboks face New Zealand later this month."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
}