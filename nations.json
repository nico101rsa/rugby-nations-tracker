  "digests": {
    "28": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Suspension watch",
          "heading": "Fiji's neighbours Samoa see their threatened international ban remain unresolved",
          "body": "There have been no fresh updates in today's press regarding the potential four-year international rugby ban facing Pacific neighbours Samoa, following the government's withdrawal of financial support reported last week. The threat of a World Rugby suspension, which first emerged on 2 August, remains unresolved as the funding dispute between the union and local authorities continues. Fiji fans monitoring the regional landscape must wait for any official confirmation on how this crisis will impact the Pacific nations."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      },
      "rung": "storyline"
    },
    "386": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Financial blow",
          "heading": "RFU expects 10 million pound loss after England's worst Six Nations campaign",
          "body": "The Rugby Football Union is forecasting a 10 million pound net loss for the financial year, hit hard by England's worst ever Six Nations performance. Steve Borthwick's side finished second bottom after losing four of their five matches, severely reducing the union's prize money. Despite the slump, RFU chief executive Bill Sweeney insisted the governing body has \"continued to perform in line with our plans despite significant headwinds,\" with rising sponsorship revenues expected to soften the blow."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "387": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Toulouse exit",
          "heading": "Thomas Ramos confirms Toulouse exit to join Top 14 rivals Racing 92",
          "body": "France fullback Thomas Ramos has confirmed his departure from Toulouse, agreeing to join Top 14 rivals Racing 92 at the end of the 2026-27 season. The announcement resolves speculation surrounding the international's long-term future. Reflecting on his decision, Ramos admitted, \"This decision was particularly difficult to make\" after his long tenure with the club. The fullback remains committed to Toulouse for the upcoming campaign before completing his move to Paris."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "388": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Age-grade defeat",
          "heading": "Herbie Doyle scores brace but Ireland youth side loses to South Africa",
          "body": "Ireland Under-18s opened their International Series campaign with a narrow 32-31 defeat to South Africa U18 A in Durbanville. Despite trailing 17-7 at the interval, the visitors launched a spirited second-half comeback. Hooker Herbie Doyle crossed twice, while Micheal Smyth and Matthew McCarthy also touched down to help Ireland seize a late 29-28 lead. However, replacement fly-half Travis Pheiffer slotted a late penalty to snatch victory for the hosts, leaving the Irish development squad empty-handed."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "389": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Investment talks",
          "heading": "Gloucester Rugby investment negotiations remain stalled with no new updates reported",
          "body": "Gloucester Rugby's search for new investment remains unresolved, with no further updates reported since club-led negotiations were first disclosed on 26 July. The Premiership side's ongoing talks with potential new financial backers have yielded no fresh announcements or concrete developments in today's press. While the initial discussions generated considerable speculation, the current silence indicates that negotiations remain ongoing behind closed doors with no resolution yet reached."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-08-07",
      "edition": "Friday 7 August",
      "sections": [
        {
          "kicker": "Coaching change",
          "heading": "Sione Fukofuka steps down as Scotland Women head coach citing stress",
          "body": "Sione Fukofuka has resigned as Scotland Women head coach to return to his family in Australia. Describing the move as the \"hardest professional decision\" of his life, Fukofuka cited the emotional strain of being separated from his family as the primary reason for his departure. Forwards coach Dave Butcher will assume interim control as the squad prepares for the upcoming WXV Global Series, with captain Rachel Malcolm returning to lead the 32-player group when training commences at Oriam this coming Monday."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Next generation",
          "heading": "Sons of Ryan Jones and James Hook named in Ospreys squad",
          "body": "The next generation of Welsh rugby has arrived at the Ospreys, with the sons of four Grand Slam winners named in the region's Under-18 squad for the upcoming Regional Age Grade competition. Playmaker Harisson Hook, son of James Hook, joins second-row Jacob Jones—son of former national captain Ryan Jones—in the pathway side. Prop Mason James and hooker Bobbie Bennett, sons of Paul James and Huw Bennett respectively, also feature. Both Jones and Bennett have also earned selection for the Wales Under-18 development squad."
        }
      ]
    },
    "460": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Disciplinary ban",
          "heading": "Tomás Albornoz banned for four matches for intimidating referee Angus Gardner",
          "body": "Tomás Albornoz has received a four-match suspension after accepting a misconduct charge for intimidating referee Angus Gardner following the 31-24 defeat by England. The Pumas fly-half had to be restrained by teammates in Santiago del Estero after being denied a late try. Albornoz denied his actions were abusive or threatening, but his ban sidelines him against South Africa. Santiago Carreras consequently shifts from full-back to fly-half, while Pablo Matera captains a side missing several European-based regulars."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "461": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Les Kiss selects Ryan Lonergan and Declan Meredith to start against Japan",
          "body": "New Wallabies head coach Les Kiss begins his tenure in Osaka today, persisting with the inexperienced halves pairing of Ryan Lonergan and Declan Meredith. Despite the return to fitness of Carter Gordon, Kiss has opted for continuity for the Nations Championship clash. Prop Aidan Ross and lock Miles Amatosero earn their first Test starts, while Isaac Henry is poised for a debut. Kiss noted that selecting the matchday 23 was a \"real challenge\" after the squad \"pushed hard over the last fortnight.\""
        }
      ],
      "match": {
        "venue": "Hanazono Rugby Stadium, Osaka"
      },
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Test clash",
          "heading": "Eddie Jones leads Japan against Wallabies in sweltering 36C Osaka heat",
          "body": "Japan pursue a historic first victory over Australia as the Brave Blossoms host the Wallabies in Hanazono today. With temperatures in Osaka forecast to reach 36C, Eddie Jones faces his former side in a Test marked by extreme humidity and the potential arrival of Typhoon Dolphin. The visitors, under new head coach Les Kiss, previously edged a narrow 19-15 win in 2025. Jones looks to exploit the conditions, while Wallabies' defensive coach Scott McLeod noted Japan \"hold onto the ball really well.\""
        }
      ],
      "match": {
        "venue": "Hanazono Rugby Stadium, Osaka"
      },
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Tour launch",
          "heading": "Dave Rennie launches throwback South Africa tour with opening Stormers fixture",
          "body": "The All Blacks have commenced their first full-scale tour of South Africa in 30 years, opening an eight-match itinerary with a provincial clash against the Stormers. Dave Rennie’s side carries significant momentum into the Republic following three straight Nations Championship wins, most recently accounting for Ireland 40-21. While legal disputes over the tour's commercial branding continue, the schedule features four matches against provincial outfits before the four-Test series against the world champion Springboks begins later this month."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "467": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Rankings risk",
          "heading": "Eben Etzebeth returns for Argentina clash with South Africa’s top ranking at stake",
          "body": "Eben Etzebeth makes his injury comeback in Saturday’s test against Argentina in Buenos Aires, a fixture where the Springboks risk losing their world No. 1 status. While victory at the Estadio José Amalfitani offers zero rankings points, defeat could see New Zealand leapfrog South Africa before their upcoming series. Assistant coach Mzwandile Stick dismissed suggestions of a weakened Pumas side, noting \"nothing changes when it comes to our standard\" as the world champions brace for a collision against an emotional home crowd."
        }
      ],
      "match": {
        "venue": "Estadio José Amalfitani, Buenos Aires"
      },
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
}