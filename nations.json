  "digests": {
    "28": {
      "date": "2026-08-10",
      "edition": "Monday 10 August",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Fijian forward Saimoni Vunilagi dies in Japan after suspected training heatstroke",
          "body": "The Fijian rugby community is mourning the tragic passing of back-rower Saimoni Vunilagi, who died in Japan on Friday aged 26. Vunilagi, who recently joined second-division club Kyuden Voltex, was hospitalised after showing severe symptoms of heatstroke following a practice session last Monday in Fukuoka, where temperatures reached 35C. The 6ft 5in forward previously played for Tokyo Sungoliath. His devastated club released a statement saying: \"We humbly pray for the repose of his soul and extend our heartfelt condolences to his bereaved family.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "386": {
      "date": "2026-08-10",
      "edition": "Monday 10 August",
      "sections": [
        {
          "kicker": "LEGAL BATTLE",
          "heading": "England's former players await ruling as High Court concussion case remains stalled",
          "body": "There are no fresh updates in the landmark concussion litigation involving former England players and rugby's governing bodies. Following recent High Court proceedings, which left the brain injury case in the balance as players sought new legal representation, the situation remains unchanged. The legal battle remains stalled with no further rulings or announcements made today, leaving claimants waiting for a definitive path forward."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "387": {
      "date": "2026-08-10",
      "edition": "Monday 10 August",
      "sections": [
        {
          "kicker": "Attacking metrics",
          "heading": "Fabien Galthié's France scored 426 points across their last 11 tests",
          "body": "France have established a formidable scoring rate in their recent outings, accumulating 426 points over their last 11 matches. This clinical run translates to an impressive average of 38.7 points scored per game, whilst Fabien Galthié's defence conceded an average of 26.5 points per match by shipping 291 points in total. The peak of this high-scoring window arrived in February 2026 during the Six Nations, when Les Bleus dismantled Wales 54-12 away from home."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-10",
      "edition": "Monday 10 August",
      "sections": [
        {
          "kicker": "Legal battle",
          "heading": "Ireland players await ruling as landmark rugby concussion case remains unresolved",
          "body": "There are no fresh developments in the High Court today regarding the landmark rugby-related brain injury litigation, with the legal battle still unresolved. The case, which entered a crucial week as reported yesterday by the Guardian and BBC, remains in the balance as former players seek a final verdict on their claims against the governing bodies. Some claimants are reportedly seeking new lawyers to represent them, but we await further updates on whether any definitive ruling has been reached."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Transfer news",
          "heading": "Ion Neculai joins Northampton Saints after departing Italian club Zebre Parma",
          "body": "Italian international tight-head prop Ion Neculai has signed for Northampton Saints. The 25-year-old makes the move to the Premiership champions following a five-season stint at Zebre Parma, where he totalled 51 appearances. Neculai, who holds four senior Italy caps, featured for the Azzurri as recently as last month’s Nations Championship fixture against Australia. Saints director of rugby Phil Dowson described the forward as a \"very physical prop who enjoys the tough side of the game.\""
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-10",
      "edition": "Monday 10 August",
      "sections": [
        {
          "kicker": "Legal battle",
          "heading": "Scotland watch from afar as landmark High Court concussion case remains stalled",
          "body": "The landmark High Court legal battle concerning rugby-related brain injuries remains unresolved, with no further developments reported in the press this week. The litigation, first seen last week, remains in the balance as the High Court has yet to reach a final verdict. No new updates have been published regarding the former players' claims against rugby governing bodies, and the legal teams have not announced any further actions. The timeline for a final decision remains indefinite."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-10",
      "edition": "Monday 10 August",
      "sections": [
        {
          "kicker": "Eligibility debate",
          "heading": "Joe Jenkins keeps Wales options open following Leicester Tigers switch",
          "body": "Dual-qualified centre Joe Jenkins has admitted he is keeping an open mind about his international future following his summer move to Leicester Tigers. The 22-year-old, who left Bristol Bears after four years, is eligible for Wales through his father. While Jenkins represented England at under-20s level, former Wales age-grade coach Byron Hayward previously claimed the midfielder wanted to wear the red jersey. However, Jenkins insists his immediate focus remains on earning a starting spot with his new Premiership club."
        }
      ]
    },
    "460": {
      "date": "2026-08-10",
      "edition": "Monday 10 August",
      "sections": [
        {
          "kicker": "Test defeat",
          "heading": "Felipe Contepomi's makeshift Argentina side suffer narrow defeat to South Africa",
          "body": "A makeshift Argentina line-up pushed world champions South Africa to the limit on Saturday, ultimately falling to a narrow 17-10 defeat in Buenos Aires. Despite missing suspended fly-half Tomás Albornoz and captain Julián Montoya, Los Pumas led early through a Benjamín Grondona try. An inexperienced front row featuring debutant Francisco Moreno and loosehead Boris Wenger excelled, while wings Rodrigo Isgro and Ignacio Mendy constantly threatened. However, South Africa's powerful bench eventually overwhelmed the hosts, denying Felipe Contepomi's side a famous victory."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-08-10",
      "edition": "Monday 10 August",
      "sections": [
        {
          "kicker": "Kiss era begins",
          "heading": "Les Kiss guides Wallabies to tense debut victory over Japan",
          "body": "Les Kiss began his tenure as Wallabies head coach with a gritty 35-32 victory over Japan in Osaka on Saturday. Despite playing in sweltering 32C heat and losing lock Miles Amatosero to a 20-minute red card just before half-time, Australia held off a fierce fightback. Tries from Harry Potter, Tom Wright, Max Jorgensen, Fraser McReight and Taniela Tupou secured the win. 'When we had to find a way, we did find a way,' Kiss said."
        }
      ],
      "match": {
        "venue": "Hanazono Rugby Stadium, Osaka"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-10",
      "edition": "Monday 10 August",
      "sections": [
        {
          "kicker": "Narrow defeat",
          "heading": "Warner Dearns scores late but Brave Blossoms fall to Australia",
          "body": "Japan pushed Australia all the way in sweltering Osaka conditions on Saturday, ultimately falling to a 35-32 defeat. Despite the Wallabies playing with 14 men following Miles Amatosero's red card, the hosts struggled to capitalise, though they stayed in touch with tries from Ryunosuke Ito, Faulua Makisi, and Ueda. A late converted try from Warner Dearns in the 78th minute brought the Brave Blossoms within three points, but the visitors held on to deny Japan their first Test victory over the Wallabies."
        }
      ],
      "match": {
        "venue": "Hanazono Rugby Stadium, Osaka"
      },
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-08-10",
      "edition": "Monday 10 August",
      "sections": [
        {
          "kicker": "Tour spectacle",
          "heading": "Patrick Tuipulotu admits shock as Ma'a Nonu named for Sharks clash",
          "body": "All Blacks lock Patrick Tuipulotu admitted surprise following the selection of 44-year-old legend Ma'a Nonu for Tuesday's tour match in Durban. Nonu, a double World Cup winner, was named on the Sharks bench to face his former side at Kings Park, a move Tuipulotu described as a spectacle for the game. Skipper Luke Jacobson leads a power-packed New Zealand side featuring Damian McKenzie and Jordie Barrett, as Dave Rennie's men look to build on Friday's 38-21 victory over the Stormers."
        }
      ],
      "match": {
        "venue": "Kings Park, Durban"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-10",
      "edition": "Monday 10 August",
      "sections": [
        {
          "kicker": "SQUAD RECALL",
          "heading": "Rassie Erasmus recalls 39-year-old Deon Fourie for upcoming All Blacks series",
          "body": "The Springboks have handed a shock recall to veteran utility forward Deon Fourie following his standout performance for the Stormers against New Zealand on Friday. Fourie, who turns 40 next month, was drafted into the squad after captain Siya Kolisi suffered a hamstring injury during Saturday’s 17-10 win over Argentina. While Erasmus confirmed the skipper’s setback \"doesn't look too bad,\" the inclusion of \"Brannas\" provides experienced cover for a gruelling schedule. André Esterhuizen also remains a doubt following a late head injury assessment in Buenos Aires."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
