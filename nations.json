    "461": {
      "date": "2026-11-06",
      "edition": "Friday 6 November",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Kurtley Beale recalled to Wallabies squad at 37 for England Test",
          "body": "Kurtley Beale, 37, is back in the Wallabies squad for Sunday's Test against England at Twickenham. \"I just kept believing, I felt like there was some unfinished business,\" he said. He was last recalled at 35, then ruptured an Achilles playing club rugby, an injury that can end careers. Les Kiss has backed him to compete for a World Cup place, and Beale is closing on a first Wallabies Test in five years."
        },
        {
          "kicker": "Around the world",
          "heading": "Scotland omit top try scorers Darcy Graham, Duhan van der Merwe",
          "body": "South Africa: Springbok Malcolm Marx returns home to Bulls on long-term deal. Argentina lose Santiago Carreras and Thomas Gallo to injury."
        }
      ],
      "match": {
        "venue": "Allianz Stadium, London"
      },
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-11-06",
      "edition": "Friday 6 November",
      "sections": [
        {
          "kicker": "Historic target",
          "heading": "Eddie Jones challenges Japan to create history by beating Wales in Cardiff",
          "body": "Japan have never won at the Principality Stadium, and Eddie Jones wants Saturday's Nations Championship match to end that. He calls the ground \"one of the most iconic rugby stadiums in the world\" and says his side have a chance to get right at kick-off. The margin was tight: Japan lost there 24-23 in November 2025, beaten by a last-gasp Jarrod Evans penalty. Jones also expects a noisy Cardiff despite the thousands of empty seats forecast, saying the crowd will still be a Welsh cauldron."
        },
        {
          "kicker": "Around the world",
          "heading": "Scotland omit top try scorers Darcy Graham, Duhan van der Merwe",
          "body": "South Africa: Springbok Malcolm Marx returns home to Bulls on long-term deal. Argentina lose Santiago Carreras and Thomas Gallo to injury. Kurtley Beale recalled to Wallabies squad at 37."
        }
