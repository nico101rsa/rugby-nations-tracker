  "digests": {
    "28": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "PACIFIC NATIONS CUP",
          "heading": "Fiji surrender Pacific Nations Cup title following defeat to Japan in Tokyo",
          "body": "Fiji surrendered their Pacific Nations Cup crown in Tokyo on Saturday, falling 20-15 to Japan in a tense final. Despite leading 12-10 at half-time through tries from Virimi Vakatawa and captain Tevita Ikanivere, the Flying Fijians struggled after the break. Halfback Frank Lomani lamented second-half mistakes and a defensive drop-off that allowed Samisoni Tua to score the winning try for the hosts. Fiji were starved of the ball, managing just 36 per cent possession and conceding 14 penalties as their title defence unravelled in the final 10 minutes."
        },
        {
          "kicker": "Around the world",
          "heading": "Japan beat Fiji 20-15 to claim Pacific Nations Cup",
          "body": ""
        }
      ],
      "match": {
        "venue": "Prince Chichibu Memorial Rugby Ground, Tokyo"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "386": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "Winning streak ends",
          "heading": "Canada hold England women to draw as 39-match winning streak ends",
          "body": "The Red Roses’ record-breaking run of 39 consecutive victories concluded on Saturday following a dramatic 26-26 draw against Canada at Sandy Park. John Mitchell’s side twice recovered from behind in the first half through a Claudia Moloney-MacDonald brace, but they were eventually pegged back by a late Olivia Apps try. While England remain unbeaten in 40 Tests, the result marks the first time they have failed to win since the 2022 World Cup final. The two sides meet again for two Tests in Canada next month."
        },
        {
          "kicker": "Around the world",
          "heading": "Japan beat Fiji 20-15 to claim Pacific Nations Cup",
          "body": ""
        }
      ],
      "match": {
        "venue": "Sandy Park, Exeter"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "Test comeback",
          "heading": "France women stage miraculous comeback win after trailing Australia by nineteen points",
          "body": "France women orchestrated an extraordinary 29-26 victory over the Wallaroos in Aix-en-Provence on Saturday after overcoming a 19-point deficit and being reduced to just 11 players during a chaotic first half. On a bizarre afternoon featuring a second-half delay due to a burning bus adjacent to the Stade Maurice David, the fourth-ranked hosts reeled off 17 unanswered points in the final 25 minutes. Wallaroos coach Tim Walsh admitted post-match that his side failed to execute after putting themselves in a winning position."
        },
        {
          "kicker": "Around the world",
          "heading": "Japan beat Fiji 20-15 to claim Pacific Nations Cup",
          "body": ""
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "388": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "WXV opener",
          "heading": "Scott Bemand laments missed opportunity as Ireland surrender 19-point lead against USA",
          "body": "Ireland head coach Scott Bemand admitted Sunday's 40-36 defeat against USA in their WXV Global Series opener at Tallaght Stadium was \"a game we should have won.\" His side raced into a 31-12 advantage following tries from Vicky Elmes Kinlan, Cliodhna Moloney-MacDonald, Aoife Wafer, Eve Higgins and Erin King. However, a second-half loss of discipline—compounded by Elmes Kinlan's yellow card—allowed Jack Hanratty's Eagles to storm back with four successive tries, leaving Ireland scrambling in vain when Dorothy Wall crossed in the red."
        },
        {
          "kicker": "Around the world",
          "heading": "Japan beat Fiji 20-15 to claim Pacific Nations Cup",
          "body": ""
        }
      ],
      "match": {
        "venue": "Tallaght Stadium, Dublin"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "WXV Global Series",
          "heading": "Italy women dominate Japan with a fifty-five to twenty-one victory",
          "body": "The Italy women's team opened their WXV Global Series campaign in style on Sunday, defeating Japan 55-21 at Stadio Omero Tognon. Emma Stevanin set the tone early with a cross-kick for Aura Muzzo to score, before tries from Alessandra Frangipani, Alyssa D'Inca, Vittoria Vecchini and Giordana Duca built a commanding lead. Captain Vittoria Ostuni Minuzzi marked her 50th cap by crossing for a score, sealing a convincing victory in their tournament opener."
        },
        {
          "kicker": "Around the world",
          "heading": "Japan beat Fiji 20-15 to claim Pacific Nations Cup",
          "body": ""
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "390": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "WXV Series",
          "heading": "Scotland women suffer heavy defeat against rampant New Zealand at Hive Stadium",
          "body": "Scotland endured a difficult afternoon at Hive Stadium as New Zealand ran in 10 tries to secure a comfortable victory in the WXV Global Series. Evie Gallagher crossed twice in the first half to provide some resistance for the hosts, but the Black Ferns' relentless tempo and superior finishing exposed defensive frailties before the break. Despite keeping the visitors scoreless for a long spell in the second half, the Scots ultimately slipped to a second successive defeat in the tournament."
        },
        {
          "kicker": "Around the world",
          "heading": "Japan beat Fiji 20-15 to claim Pacific Nations Cup",
          "body": ""
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "WXV opener",
          "heading": "Sean Lynn guides Wales women to stunning victory over South Africa",
          "body": "Wales delivered an eight-try masterclass to crush South Africa 50-19 in their WXV Global Series opener at Cardiff Arms Park. Sean Lynn's side raced into a 38-5 half-time lead, shaking off years of criticism with a fearless display of attacking rugby. Sisilia Tuipulotu bagged a dominant double, while co-captain Alex Callender capped a player-of-the-match performance with a late score in the corner. \"This is just the start for us, this is going to be our new DNA,\" Lynn said."
        },
        {
          "kicker": "Around the world",
          "heading": "Japan beat Fiji 20-15 to claim Pacific Nations Cup",
          "body": ""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "Depth report",
          "heading": "Americas Rugby News assesses Los Pumas squad depth for World Cup",
          "body": "Americas Rugby News published a comprehensive squad depth evaluation examining player options across all positions as Los Pumas build towards the 2027 Rugby World Cup in Australia. The assessment details incumbent starters, regular matchday 23 selections, and emerging Argentina XV prospects across the roster. Thomas Gallo and Julián Montoya anchor positions with strong continuity from prior campaigns, while younger talents like Tomás Rapetti make significant progress in contention for places."
        },
        {
          "kicker": "Around the world",
          "heading": "Japan beat Fiji 20-15 to claim Pacific Nations Cup",
          "body": ""
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "461": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "Springboks test",
          "heading": "Carlo Tizzano targets South Africa scalp as Perth embraces sporting fever",
          "body": "Wallabies flanker Carlo Tizzano has set his sights on defeating world champions South Africa in Perth, calling it the ultimate test of the team's recent growth under Les Kiss. Australia enter the fixture following a five-match unbeaten run, bolstered by a 34-man squad that includes uncapped recruit Harry McLaughlin-Phillips and the return of utility back Jordan Petaia. Tizzano noted that \"South Africa are the best team in the world, so what better way to test what we've been doing and everything we've been working on than doing it against the best?\"."
        },
        {
          "kicker": "Around the world",
          "heading": "Japan beat Fiji 20-15 to claim Pacific Nations Cup",
          "body": ""
        }
      ]
    },
    "463": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "Pacific Nations Cup",
          "heading": "Naoto Saito and Eddie Jones inspire Japan to historic Pacific Nations Cup final victory",
          "body": "Japan secured a historic 20-15 victory over Fiji at Prince Chichibu Memorial Stadium to claim their first Pacific Nations Cup title since 2019. Having fallen short against the Flying Fijians in the previous two finals, Eddie Jones' side overturned a half-time deficit thanks to tries from Mamoru Harada, Ben Gunter and tournament player of the tournament Samisoni Tua. The triumph lifts the Brave Blossoms into the world's top 10 rankings as they build toward the 2027 Rugby World Cup."
        }
      ],
      "source": {
        "name": "Planet Rugby"
