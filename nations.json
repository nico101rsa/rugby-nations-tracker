    "388": {
      "date": "2026-11-25",
      "edition": "Wednesday 25 November",
      "sections": [
        {
          "kicker": "Talent drain",
          "heading": "Former Ireland U20 Noah Byrne rejects Leinster, signs AFL deal with Brisbane",
          "body": "Former Ireland U20 international Noah Byrne is heading for Australian Rules. The 20-year-old has signed a Category B contract with three-time AFL champions Brisbane Lions, sealing a move that looked likely once he turned down a professional deal with Leinster in the summer. Byrne came through Gonzaga College and Trinity College and started every one of Ireland's games in this year's U20 Six Nations. The42 calls the switch a blow to a province that rated him a serious prospect."
        },
        {
          "kicker": "Around the world",
          "heading": "England beat All Blacks 37-12 in Nations Championship",
          "body": "Scotland beat Japan 67-5. France's Philippe Sella wins Jauréguy-Dominici prize."
