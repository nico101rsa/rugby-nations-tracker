    "390": {
      "date": "2026-11-24",
      "edition": "Tuesday 24 November",
      "sections": [
        {
          "kicker": "Rotation call",
          "heading": "Gregor Townsend's 10 changes pay off as Scotland rout Japan 67-5",
          "body": "Scotland's 67-5 win over Japan at Murrayfield on Saturday came from a heavily rotated side. Townsend made 10 changes after the narrow 15-12 victory over Australia, resting much of his first-choice team with, in Rugby World's reading, one eye on finals weekend. Tom Jordan started at 10 in place of Finn Russell, and the reshaped XV led 29-0 at half-time before running in 11 tries against Eddie Jones' weakened Brave Blossoms."
        },
        {
          "kicker": "Around the world",
          "heading": "Ireland beat Springboks 20-17 to set up Australia finals clash",
          "body": "Argentina lose 45-17 to France after Mayco Vivas red card. France recall Thomas Ramos for Springboks final. South Africa's Marco van Staden likely banned for France final."
        }
      ],
