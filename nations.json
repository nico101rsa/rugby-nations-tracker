  "digests": {
    "28": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Cup final",
          "heading": "Fiji defeat Canada to secure Pacific Nations Cup final place against Japan",
          "body": "The defending champions secured their place in the Pacific Nations Cup final against Japan after defeating Canada in Osaka. Before the match, Canada head coach Stephen Meehan noted that many of Fiji's top players were absent due to professional club commitments, but warned his side of the \"free-spirited challenge\" posed by the Flying Fijians' physical and expansive play. Fiji's victory sets up a Tokyo final as they look to defend their crown."
        }
      ]
    },
    "386": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "COACHING DEBATE",
          "heading": "Ben Youngs accuses RFU of having 'blinkers on' over Steve Borthwick backing",
          "body": "Ben Youngs has criticised RFU chief executive Bill Sweeney and performance director Conor O’Shea for their \"blinkers on\" approach in awarding Steve Borthwick a contract extension. Despite what O’Shea termed a \"horrendous\" 2026 Six Nations campaign—where England finished with just one win—the board have extended Borthwick’s terms until after the 2028 championship. Youngs questioned the accountability of the RFU hierarchy on the For The Love Of Rugby podcast, suggesting both Sweeney and O’Shea must also depart if Borthwick fails at next year's World Cup."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "LOG STANDINGS",
          "heading": "France secure third place in the standings after three Nations Championship rounds.",
          "body": "France hold third place in the Nations Championship table following their 42-15 victory against Japan. Les Bleus have secured two wins from three fixtures in the current tournament. They have recorded 116 points across their opening matches. The defence has conceded 75 points during the same period. France currently maintain a positive 41-point difference in the standings. In their last meeting with Fiji in November 2025, France recorded a 34-21 home victory."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Six Nations",
          "heading": "IRFU rules out staging upcoming Six Nations matches in America",
          "body": "The IRFU has confirmed there are “currently no plans or discussions” regarding the possibility of moving Six Nations fixtures to the United States. While World Rugby chief executive Alan Gilpin had previously highlighted the commercial potential of hosting an Ireland-Italy encounter stateside to engage expatriate fans, the Irish governing body dismissed the proposal. The IRFU reiterated its commitment to the traditional championship structure, maintaining that home fixtures remain a central part of the tournament's unique appeal to local supporters."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Historical Context",
          "heading": "Italy maintains focus on building during challenging Nations Championship campaign",
          "body": "As Italy look to improve their standing in the Nations Championship, the squad reflects on a proud history of growth. The Azzurri’s best world ranking remains No. 8, a position they previously reached in 2007 and again in 2024. Following their recent result against Australia, the team currently sits 11th on the log with 37 points scored across their three fixtures. The side will look to build on these foundations when they face South Africa in their next tournament encounter."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Rhea Clarke and Evie Gallagher start for Scotland against Canada",
          "body": "Scrum-half Rhea Clarke makes her first start for Scotland in Saturday’s WXV Series opener against Canada at Hive Stadium. Evie Gallagher also returns to the starting line-up on the openside flank for her first international appearance since last year’s World Cup. Interim head coach Dave Butcher has named a side captained by Rachel Malcolm, with Helen Nelson providing leadership in the backs. The transition under Butcher has been described as \"pretty seamless\" by the players following the coaching staff changes."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "WXV ball trial",
          "heading": "Debate continues over smaller ball trial as WXV global series nears",
          "body": "As the Wales women’s team prepares for their upcoming WXV Global Series opener, the international debate surrounding the trial of a smaller rugby ball remains unresolved. Players have expressed a wide range of emotions regarding the ball, with some reporting that the change makes it harder to perform their roles effectively. While World Rugby has signalled an intent to expand the trial, critics remain vocal, describing the implementation as a significant challenge for the women's game ahead of competitive fixtures."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Team History",
          "heading": "Argentina reached a best world ranking of No. 3 overall",
          "body": "Los Pumas have established a competitive legacy on the international stage, achieving their highest-ever world ranking of No. 3 during the 2007–08 period. As the squad prepares for their upcoming fixtures, they continue to build on a heritage that has seen them become a consistent force in global rugby. The side has demonstrated notable depth throughout their recent campaigns, balancing tactical discipline with a physical approach that remains central to their identity in the modern international era."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Coaching transition",
          "heading": "James Slipper puts playing career on pause for new Brumbies position",
          "body": "Veteran Wallabies prop James Slipper has paused his playing career to take up a temporary role as scrum coach for the Brumbies during the upcoming Super Rugby AUS competition. The 154-Test veteran, who remains an emergency option for the Wallabies, confirmed he will focus on developing the next generation of forwards under head coach Stephen Larkham. Slipper, who recently signed a contract extension, aims to share lessons from his extensive career as he transitions into the coaching group."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "League update",
          "heading": "Japan Rugby League One grants naturalised players equal roster status",
          "body": "The ongoing discussions surrounding Japan Rugby League One eligibility rules have reached a significant milestone. Recent reports indicate that the league has moved to grant long-term naturalised players equal status within team rosters, resolving a key point of contention that was open earlier this month. This shift marks a major adjustment to the proposed 2026-2027 season regulations, aiming to provide greater clarity for clubs and players regarding squad composition as the league prioritises consistency in its participation criteria."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      },
      "rung": "storyline"
    },
    "465": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Dave Rennie recalls Richie Mo’unga for decisive Baltimore series finale",
          "body": "Dave Rennie has reshuffled his side for Saturday’s fourth Test in Baltimore, recalling Richie Mo’unga to the starting fly-half berth. The tourists are aiming to level the Greatest Rivalry series 2-2, with Josh Moorby returning on the wing and Anton Lienert-Brown selected at outside centre. Springbok assistant coach Mzwandile Stick acknowledged the threat posed by the selection, noting that New Zealand will look to be even bolder in keeping the ball alive and exploiting space in the wider channels."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Series finale",
          "heading": "Rassie Erasmus reaches 100th Test as Springboks hunt series victory",
          "body": "The Springboks arrive in Baltimore for the fourth and final Test of Rugby’s Greatest Rivalry leading the series 2-1. Rassie Erasmus celebrates his 100th Test at the helm of the national side, fielding a side featuring two changes to the group that won in Soweto. Damian Willemse returns at full-back to replace the injured Cheslin Kolbe, while Morne van den Berg earns a start at scrum-half. South Africa look to maintain their momentum following successive home victories over New Zealand."
        }
      ],
      "match": {
        "venue": "M&T Bank Stadium, Baltimore"
      },
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
}