  "digests": {
    "28": {
      "date": "2026-08-14",
      "edition": "Friday 14 August",
      "sections": [
        {
          "kicker": "Tragic news",
          "heading": "Fijian forward Saimoni Vunilagi dies in Japan from suspected heatstroke",
          "body": "Saimoni Vunilagi, a 26-year-old Fijian back-rower, has died in Japan from suspected heatstroke following a training session. His club, Kyuden Voltex, confirmed he developed severe symptoms after practice in Fukuoka, where temperatures reached 35 degrees Celsius. Vunilagi, who previously played for Tokyo Sungoliath, had only recently joined the second-division side. The club expressed deep devastation, whilst Japan Rugby League One offered its condolences to the family of the rising forward."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "386": {
      "date": "2026-08-14",
      "edition": "Friday 14 August",
      "sections": [
        {
          "kicker": "Contract shake-up",
          "heading": "Elliot Daly dropped as Steve Borthwick hands out five new England contracts",
          "body": "Steve Borthwick has shaken up his squad with just over a year to go before the World Cup, handing enhanced contracts to five rising stars. Asher Opoku-Fordjour, Alex Coles, Guy Pepper, Jack van Poortvliet and Seb Atkinson have been rewarded for their recent Nations Championship form. However, British and Irish Lion Elliot Daly, Ben Curry, Ollie Lawrence and Tom Roebuck have all been axed from the 25-player list. Tom Willis also loses his deal after moving to France."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-14",
      "edition": "Friday 14 August",
      "sections": [
        {
          "kicker": "By the numbers",
          "heading": "France maintain prolific scoring rates across their last 11 matches",
          "body": "Les Bleus have shown formidable attacking power over their last 11 matches, amassing a total of 426 points during this period. France also conceded 291 points across that same 11-game stretch. This leaves Fabien Galthié's side with a prolific scoring average of 38.7 points per fixture, while letting in an average of 26.5 points per match. The peak of this attacking run came in February 2026 during the Six Nations, when the team secured their biggest victory of the window by defeating Wales 54-12 away."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-14",
      "edition": "Friday 14 August",
      "sections": [
        {
          "kicker": "Obituary",
          "heading": "Former Ireland out-half Brian Smith has passed away aged 59",
          "body": "The Irish Rugby Football Union led tributes to former Ireland out-half Brian Smith, who has passed away at the age of 59 following a short illness. After winning six Test caps for Australia, the Queensland native moved to Oxford University, qualifying to represent Ireland, where he earned nine caps. Smith later transitioned into coaching, leading London Irish and serving as England's attack coach under Martin Johnson."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-08-14",
      "edition": "Friday 14 August",
      "sections": [
        {
          "kicker": "Form tracker",
          "heading": "Italy slump to fourth consecutive loss after heavy defeat in Australia",
          "body": "Italy face a difficult rebuilding period following a tough run of international fixtures. The Azzurri have slumped to four straight defeats under the current schedule. Looking back at their last five matches, the team has managed only one victory. Over that same five-game window, they have suffered four defeats. That run includes their most recent fixture in July 2026, which ended in a 57-10 away defeat against Australia in the Nations Championship group stage. The side now sits 11th in the tournament standings."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-14",
      "edition": "Friday 14 August",
      "sections": [
        {
          "kicker": "Legal battle",
          "heading": "Scottish Rugby joins legal bid to dismiss former players' concussion lawsuits",
          "body": "In the ongoing High Court battle, Scottish Rugby and other UK governing bodies petitioned in July to dismiss concussion lawsuits brought by more than 200 former players. The defendants, including World Rugby, argue that brain injuries represent an inherent risk of the sport. The landmark legal proceedings remain finely balanced, especially after it was reported last week that the lead solicitor representing the claimants was forced out of the case."
        }
      ],
      "match": {
        "venue": "Murrayfield, Edinburgh"
      },
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-14",
      "edition": "Friday 14 August",
      "sections": [
        {
          "kicker": "Boardroom tension",
          "heading": "WRU tells potential new chair candidates to accept cutting Ospreys or Scarlets",
          "body": "The search for a new Welsh Rugby Union chair to replace Richard Collier-Keywood has been hit by controversy, with candidates reportedly told they must accept the reduction of Wales's professional teams as a fait accompli. Prospective applicants have raised concerns that the incoming chair will have little power to challenge the WRU board's plan to axe either the Ospreys or Scarlets. With first-stage interviews due to begin on 24 August, the governing body is under pressure as both west Wales regions resist any merger."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-08-14",
      "edition": "Friday 14 August",
      "sections": [
        {
          "kicker": "Disciplinary blow",
          "heading": "Tomás Albornoz hit with four-match ban for intimidating referee Angus Gardner",
          "body": "Argentina fly-half Tomás Albornoz has been suspended for four matches after accepting a charge of misconduct for intimidating referee Angus Gardner. The incident occurred following the full-time whistle of the Pumas' controversial 31-24 defeat against England, after the team were denied a last-gasp try. Albornoz approached the Australian official twice and had to be restrained by teammates. The playmaker's suspension began against South Africa and covers Los Pumas' subsequent double-header against Australia."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "461": {
      "date": "2026-08-14",
      "edition": "Friday 14 August",
      "sections": [
        {
          "kicker": "Playmaker puzzle",
          "heading": "Les Kiss names Carter Gordon at fly-half among eight Wallabies changes",
          "body": "Wallabies coach Les Kiss has made eight starting changes for Saturday's second Test against Japan in Townsville, headlined by Carter Gordon's return at fly-half. Gordon, who overcame a calf injury, replaces Declan Meredith in the No. 10 jersey as Kiss continues to audit his playmaking options before next year's home World Cup. Isaac Henry also earns his first Test start in midfield, replacing the injured Joseph-Aukuso Suaalii. After a physical 35-32 victory in Osaka, Kiss is seeking to build domestic momentum on home soil."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-08-14",
      "edition": "Friday 14 August",
      "sections": [
        {
          "kicker": "Tactical Inspiration",
          "heading": "Eddie Jones turns to migratory geese to fix Japan's support play",
          "body": "Following last weekend's narrow 35-32 defeat in Osaka, head coach Eddie Jones has turned to nature to prepare his side for Saturday's second Test against Australia in Townsville. The veteran boss revealed he is showing the squad videos of migrating geese to improve their support play. \"The head of the flock is like the ball-carrier,\" he explained. Waseda University student Yoshitaka Yazaki will make his Test debut on the right wing as one of five changes to the starting XV."
        }
      ],
      "match": {
        "venue": "Queensland Country Bank Stadium, Townsville"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "465": {
      "date": "2026-08-14",
      "edition": "Friday 14 August",
      "sections": [
        {
          "kicker": "SELECTION CALL",
          "heading": "Codie Taylor returns to captain the All Blacks against the Bulls",
          "body": "Head coach Dave Rennie has handed veteran hooker Codie Taylor the captaincy for Saturday’s tour match in Pretoria after he recovered from a calf injury. Taylor’s return headlines wholesale changes, including Beauden Barrett starting at fullback. While Damian McKenzie (ankle) and Will Jordan (back) miss the Loftus Versfeld trip, Rennie expects both to be available for the first Test against the Springboks. \"We're expecting him to be OK for the Test,\" Rennie said, after calling up Richie Mo’unga as fly-half cover."
        }
      ],
      "match": {
        "venue": "Loftus Versfeld, Pretoria"
      },
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-08-14",
      "edition": "Friday 14 August",
      "sections": [
        {
          "kicker": "Depth praise",
          "heading": "Murray Mexted claims Rassie Erasmus has built 150 Test-ready Springbok players",
          "body": "Former All Blacks loose forward Murray Mexted has lauded the staggering depth of South African rugby, suggesting the world champions boast nearly four times the Test-ready talent of New Zealand. Speaking as the All Blacks continue their tour of the Republic, Mexted credited Rassie Erasmus’s eight-year project for fostering the \"ambition\" to blood new talent. While Dave Rennie’s tourists prepare for Saturday’s match against the Bulls in Pretoria, Mexted believes the Springboks’ relentless rotation has created a pool of 150 players capable of elite international performance."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
}