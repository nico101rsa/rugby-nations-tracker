  "digests": {
    "28": {
      "date": "2026-07-29",
      "edition": "Wednesday 29 July",
      "sections": [
        {
          "kicker": "Disciplinary blow",
          "heading": "Simione Kuruvoli handed four-week ban following Nations Championship physical abuse incident",
          "body": "Fiji's difficult Nations Championship campaign has suffered a further setback after scrum-half Simione Kuruvoli was handed a four-week suspension. The ban, issued for physical abuse during the tournament, leaves the Flying Fijians without their primary playmaker as they navigate a winless start to the season. Currently bottom of the log with three defeats, the side must now manage the fallout of Kuruvoli’s absence as they look to rectify their form before facing France later this year."
        }
      ]
    },
    "386": {
      "date": "2026-07-29",
      "edition": "Wednesday 29 July",
      "sections": [
        {
          "kicker": "Disciplinary fallout",
          "heading": "Argentina’s Julián Montoya and Tomás Albornoz banned after chaotic England tour finale",
          "body": "England’s 31-24 win in Santiago del Estero has triggered significant disciplinary fallout, with Pumas captain Julián Montoya and fly-half Tomás Albornoz issued with bans. The sanctions follow a fractious encounter that saw former England scrum-half Ben Youngs label the hosts' conduct \"totally disgraceful\" after they surrounded the referee. Argentina coach Felipe Contepomi has subsequently named 10 uncapped players in his latest squad. While Steve Borthwick’s side looks ahead to November, the repercussions of their feisty July tour continue to dominate the South American narrative."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-07-29",
      "edition": "Wednesday 29 July",
      "sections": [
        {
          "kicker": "CHAMPIONSHIP DEBATE",
          "heading": "Fabien Galthié awaits decision on 'brutal' Nations Championship travel demands",
          "body": "France occupy third place in the standings as debate continues over the effectiveness of the inaugural Nations Championship. Following recent criticisms from rival players regarding 'brutal' travel demands, World Rugby is yet to confirm if the current competition structure or its complex finals weekend will be modified. For the national side, securing a top-two spot remains the priority under existing tiebreaker rules, though officials have provided no new updates on whether the tournament’s scheduling will be reviewed before the November window."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "388": {
      "date": "2026-07-29",
      "edition": "Wednesday 29 July",
      "sections": [
        {
          "kicker": "COACHING RETURN",
          "heading": "Joe Schmidt reportedly set for shock Irish return in Ulster consultancy role",
          "body": "Reports suggest Joe Schmidt is poised for a surprise return to Irish rugby via a consultancy role with Ulster. The former Ireland head coach, who recently vacated his position with Australia for family reasons, is expected to assist Richie Murphy’s side during pre-season. Having previously guided Leinster to European glory and Ireland to three Six Nations titles, Schmidt’s short-term involvement provides a significant boost for the province following their ninth-place finish. He remains slated to assist Australia A later this year."
        }
      ]
    },
    "389": {
      "date": "2026-07-29",
      "edition": "Wednesday 29 July",
      "sections": [
        {
          "kicker": "TOURNAMENT STRUCTURE",
          "heading": "Michele Lamaro’s Italy face 'brutal' travel as Nations Championship format undergoes scrutiny",
          "body": "Discussions continue regarding the sustainability of the Nations Championship format following reports that senior players find the current travel demands \"brutal\". Ben Earl led calls for World Rugby to reconsider the tournament structure after a gruelling schedule that saw the Azzurri follow their loss in New Zealand with a trip to Perth. While no official modifications have yet been confirmed, the governing body remains under pressure to address the physical toll on squads as the competition enters a rest period before November."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-07-29",
      "edition": "Wednesday 29 July",
      "sections": [
        {
          "kicker": "ELITE AMBITIONS",
          "heading": "Pierre Schoeman claims Scotland are a top-five side after Murrayfield comeback",
          "body": "Following a second-half resurgence against Fiji at Murrayfield, Pierre Schoeman believes Scotland have proved they belong among the world’s elite. Despite trailing at half-time, the bench-led recovery secured a 33-17 win, leaving Gregor Townsend's side near the top of the Northern Hemisphere standings. Schoeman claimed the squad are now a \"top-three, top-five team in the world\" after targeting wins against \"top dogs\" like England and France. However, he admitted a full 80-minute performance is still required to finally topple the All Blacks, Ireland, or South Africa."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-07-29",
      "edition": "Wednesday 29 July",
      "sections": [
        {
          "kicker": "Regional signing",
          "heading": "Gareth Anscombe returns to Wales after signing for Scarlets from Bayonne",
          "body": "Fly-half Gareth Anscombe has returned to Wales, signing for Scarlets for the 2026-27 season following a stint in France with Bayonne. The 42-times capped playmaker, who last featured for the national side during the 2025 Six Nations, joins to provide experienced cover and competition for Sam Costelow. Director of rugby Nigel Davies noted that the 35-year-old remains \"hungry to compete\" and will help push standards in Llanelli. Anscombe’s arrival follows a difficult domestic campaign where centre Joe Hawkins was frequently forced to deputise at No. 10."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-07-29",
      "edition": "Wednesday 29 July",
      "sections": [
        {
          "kicker": "Squad fallout",
          "heading": "Contepomi names 10 rookies as bans sideline Julián Montoya and Tomás Albornoz",
          "body": "Felipe Contepomi has named 10 uncapped players in a 34-man squad for next month’s Tests against South Africa and Australia. The overhaul follows a disciplinary fallout from the England defeat, with captain Julián Montoya and fly-half Tomás Albornoz both issued bans for their conduct. Senior regulars like Bautista Delguy and Joaquin Oviedo are also absent due to European club commitments. \"The goal is to have excellent preparation,\" Contepomi said, opting to rest several stars to \"broaden the squad\" ahead of the Springboks' visit."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-07-29",
      "edition": "Wednesday 29 July",
      "sections": [
        {
          "kicker": "New era",
          "heading": "Allan Alaalatoa backs Les Kiss to deliver seamless Wallabies coaching transition",
          "body": "The Les Kiss era has officially begun in Sydney as the Wallabies assemble to prepare for next month's Test against Japan. Senior prop Allan Alaalatoa praised the \"well planned\" handover from Joe Schmidt, noting the new coach has been a \"fly on the wall\" at recent camps to ensure continuity. Kiss intends to prioritise attacking width but has promised \"evolution rather than revolution\" to maintain the foundations built over the last two years. Harry Wilson remains captain as the squad prepares to travel to Osaka this Saturday."
        }
      ],
      "match": {
        "venue": "Osaka"
      },
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "463": {
      "date": "2026-07-29",
      "edition": "Wednesday 29 July",
      "sections": [
        {
          "kicker": "Transfer news",
          "heading": "James Lowe signs two-year deal with Japanese side Suntory Sungoliath",
          "body": "Ireland and British and Irish Lions winger James Lowe will join Suntory Sungoliath on a two-year contract, replacing Springbok Cheslin Kolbe at the League One side. The 45-cap international brings extensive experience from his time at Leinster, where he secured one Investec Champions Cup and six domestic titles. Looking ahead to the move, Lowe expressed his enthusiasm for the Japanese game, stating: “I want to bring energy, physicality and a positive attacking mindset to the team.”"
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "465": {
      "date": "2026-07-29",
      "edition": "Wednesday 29 July",
      "sections": [
        {
          "kicker": "Selection strategy",
          "heading": "Dave Rennie plans tactical 6-2 bench split for South African tour",
          "body": "Head coach Dave Rennie has confirmed the All Blacks will trial a 6-2 bench split during their upcoming eight-match tour of South Africa. The tactical shift, which hasn't been used since a heavy defeat to the Springboks in 2023, is designed to test squad versatility against United Rugby Championship franchises. Rennie noted that Chiefs winger Leroy Carter may cover scrum-half duties in this formation, allowing for a more robust forward presence as the team builds towards the 2027 Rugby World Cup."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-07-29",
      "edition": "Wednesday 29 July",
      "sections": [
        {
          "kicker": "Selection focus",
          "heading": "Rassie Erasmus insists Springboks must overcome Argentina before facing All Blacks",
          "body": "Springbok head coach Rassie Erasmus has moved to focus his squad's attention entirely on the upcoming clash against Los Pumas in Buenos Aires. While anticipation for the four-Test series against New Zealand continues to build, Erasmus remains determined to secure a victory in South America first. “It's difficult to not look past Argentina, but we have to beat Argentina first,” he told reporters. The squad will split shortly after, with 26 players travelling to Argentina while others remain in Johannesburg."
        }
      ],
      "match": {
        "venue": "Buenos Aires"
      },
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
}