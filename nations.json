  "digests": {
    "28": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Form tracker",
          "heading": "Fiji seek defensive reset after conceding 326 points across 11 matches",
          "body": "The Flying Fijians have shown significant scoring threat but fragile defence across their last 11 games. In that 11-match window, Fiji scored 315 points, averaging 28.6 points a game. However, they also conceded 326 points in those same fixtures, an average of 29.6 per match. The highlight of this recent run was a convincing home performance in September 2025 during the Pacific Nations Cup knockout stage, where they beat Canada 63-10."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Beno Obano to exit Premiership as England career faces uncertainty",
          "body": "Beno Obano has confirmed he will join French side Pau at the end of the upcoming season, casting doubt on his future within Steve Borthwick's setup. Due to the RFU’s strict policy prioritising domestic-based players, the 31-year-old prop faces a likely international exile. While Borthwick has occasionally accommodated players bound for France, he has increasingly focused on developing younger loose-head options, including Fin Baxter and Emmanuel Iyogun, to ensure long-term squad stability ahead of the 2027 World Cup."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "387": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Match preview",
          "heading": "France prepare for November encounter with visitors Fiji in Round 4",
          "body": "France turn their attention to Fiji for their upcoming Round 4 fixture later this year. Les Bleus enter the match following a recent 42-15 victory over Japan, which leaves them with a record of two wins and one defeat in the current competition. The two nations last met in November 2025, when France secured a 34-21 win against the visitors in an international friendly. France currently sit third on the competition log with a points difference of plus 41."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Player welfare",
          "heading": "Ryan Caldwell details his harrowing journey of recovery and mental health",
          "body": "Former Ireland second-row Ryan Caldwell has opened up about his difficult transition to life after professional rugby, reflecting on a career marred by chronic injury and a subsequent struggle with addiction and depression. In a candid interview, the former Ulster, Bath, and Exeter forward—who turns 42 on Tuesday—discussed his path to finding peace through meditation and breathwork. Caldwell is set to release his autobiography, which offers a stark and compelling insight into the realities of life in the professional game."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Discipline",
          "heading": "Gonzalo Quesada suspended following World Rugby match official abuse ruling",
          "body": "Italy head coach Gonzalo Quesada has become the first coach banned under World Rugby’s new Match Official Abuse Sanctioning Process. The governing body handed the Argentine a two-Test suspension following his public criticism of referee Luc Ramos after the meeting with the All Blacks. As a result of this ruling, Quesada is prohibited from all match-day proceedings for the upcoming Test against South Africa. He retains the right to appeal the decision, though his status remains uncertain for the November campaign."
        }
      ]
    },
    "390": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Pathways progress",
          "heading": "Scottish pathway stars feature as domestic squads prepare for new season",
          "body": "Edinburgh and Glasgow Warriors are integrating a fresh wave of talent into their squads as the 2026/27 campaign begins. Several graduates of the Scottish Rugby pathway, including recent U20s World Rugby Trophy winners and key contributors from this summer's Junior World Championship, are set for involvement this weekend. Young talents like James Dalrymple and Kerr Yule are among the prospects stepping into professional environments, marking a significant transition for players aiming to push for future senior international opportunities."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Selection ambition",
          "heading": "Tom Rogers eyes international return after switching to the Ospreys",
          "body": "Following his move from the Scarlets to the Ospreys this summer, Tom Rogers is prioritising a return to the Wales squad. The back, who made history last November by scoring the first Test hat-trick against New Zealand by a player from the British Isles, has not featured for his country since that match. Admitting his recent uncapped appearance against the Barbarians was underwhelming, Rogers remains focused on his club form: \"I just need to play well with the Ospreys.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Mendoza Test",
          "heading": "Argentina and Australia locked in intense battle at Estadio Malvinas Argentinas",
          "body": "Los Pumas are level with Australia at 14-14 in an attritional second Test in Mendoza. After falling behind to early Wallabies scores, captain Pablo Matera powered over for a crucial try following a dominant scrum, before Ignacio Mendy finished a brilliant set-play to equalise just before the interval. The match has been defined by high stakes and volatility, with both Franco Molina and Jeremy Williams spending time in the sin-bin as both sides fight to gain control of the contest."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "461": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Les Kiss makes nine changes as Tom Wright hits 50th cap",
          "body": "Les Kiss has overhauled his side for the rematch against Argentina, making nine changes to the starting XV that won in Jujuy. Full-back Tom Wright reaches his 50th appearance for Australia, anchoring a back three alongside Max Jorgensen and Filipo Daugunu. Captain Harry Wilson returns at number eight, while Joseph-Aukuso Suaalii and Len Ikitau reunite in the midfield. “We’ve brought in some fresh bodies alongside some existing combinations as we continue to look to build Test experience across the group,” said Kiss."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Centenary Test",
          "heading": "Brave Blossoms face Canada as Japan marks 100 years of Tests",
          "body": "Japan commemorates its rugby centenary at Denka Big Swan Stadium, hosting Canada in a Challenge Cup fixture. Eddie Jones enters the match looking to snap a four-match losing streak, with five changes made to the side that faced Australia. Notable inclusions see Jack Cornelsen and Harry Hockings packing down in the second row, while Inoke Burua earns a debut start. Japan has dominated this fixture historically, remaining unbeaten against the Canadians across their past 10 meetings."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Ardie Savea ruled out of fourth Test following shoulder injury",
          "body": "All Blacks captain Ardie Savea will miss the final Test of the series in the United States after sustaining a shoulder injury in Saturday’s clash at FNB Stadium. Head coach Dave Rennie confirmed Savea will not travel with the squad to Baltimore, stating, “He certainly won’t be travelling to the States.” Rennie acknowledged the loss of his skipper but backed Wallace Sititi to provide cover, noting that the team is “not going to use that as an excuse” for the narrow 29-24 defeat."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Cheslin Kolbe ruled out as Springboks defeat All Blacks in Soweto",
          "body": "The Springboks secured a 29-24 win over the All Blacks on Saturday, moving into a 2-1 series lead, but the triumph was marred by a significant injury to Cheslin Kolbe. Rassie Erasmus confirmed post-match that the fullback suffered a broken jaw. With the series finale scheduled for Baltimore, the coach has confirmed that Damian Willemse and Canan Moodie are ready to step in, while Herschel Jantjes will join the travelling squad to bolster the backline options."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
}