  "digests": {
    "28": {
      "date": "2026-09-03",
      "edition": "Thursday 3 September",
      "sections": [
        {
          "kicker": "WINLESS RUN",
          "heading": "Fiji prop up the Nations Championship standings after third consecutive defeat",
          "body": "Fiji prop up the Nations Championship standings in bottom place after failing to secure a point from their opening three fixtures. The Flying Fijians have now suffered three straight defeats, including a 17-33 loss to Scotland at home in the previous round in July 2026. Across their last five international matches, the side has registered just one victory alongside four defeats. With a point difference of -96 from 49 points scored and 145 conceded, the squad faces a steep climb."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-03",
      "edition": "Thursday 3 September",
      "sections": [
        {
          "kicker": "Summer sabbatical",
          "heading": "Maro Itoje backs Steve Borthwick's surprise decision to grant summer sabbatical",
          "body": "England captain Maro Itoje has endorsed head coach Steve Borthwick's surprise decision to omit him from the July tour, admitting the mental recovery was far more significant than the physical benefit. Itoje rested during the Nations Championship fixtures against South Africa, Fiji and Argentina after exceeding recommended match limits in consecutive seasons. Having also dealt with the loss of his mother, the lock initially found the sabbatical proposal shocking but now feels revitalised. \"I don't regret it at all,\" Itoje said, targeting a strong run."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-03",
      "edition": "Thursday 3 September",
      "sections": [
        {
          "kicker": "RANKING HISTORY",
          "heading": "France beat Japan but remain far from their historic ranking peak",
          "body": "France currently sit third out of 12 teams in the standings after three fixtures. A convincing 42-15 victory against Japan in the third round secured their second win. Les Bleus have registered 116 points in those three games, whilst conceding 75 points. Although they boast a positive point difference of 41 from their fixtures, they remain far from their historical peak. The team's longest unbroken spell at number one in the world rankings lasted for just one week, back in July 2022."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-03",
      "edition": "Thursday 3 September",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Vascular injury rules fly-half Jack Crowley out of Ireland’s autumn internationals",
          "body": "Ireland’s fly-half options are depleted ahead of the November internationals, with Jack Crowley ruled out until the new year. The 26-year-old playmaker has been sidelined since April with a lower limb vascular injury, forcing him to miss July's Tests and the upcoming autumn fixtures. It is a major setback for Munster and the national side. Munster boss Clayton McMillan emphasised a cautious approach, stating that \"ensuring he gets back to 100% is the priority.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-03",
      "edition": "Thursday 3 September",
      "sections": [
        {
          "kicker": "Injury update",
          "heading": "Exeter Chiefs provide no fresh recovery update for injured Andrea Zambonin",
          "body": "There are no fresh updates in today's press regarding lock Andrea Zambonin's recovery from his shoulder injury, with Exeter Chiefs yet to confirm a return date. He was reported yesterday to be missing the start of the new Premiership season. The lock remains under the care of the Premiership club's medical staff, leaving his availability for Italy's upcoming autumn internationals unresolved."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-03",
      "edition": "Thursday 3 September",
      "sections": [
        {
          "kicker": "Governance vacancy",
          "heading": "Scottish Rugby continues search for new chief executive after Williamson sacking",
          "body": "Scottish Rugby remains without a permanent chief executive one month after sacking Alex Williamson. The former chief executive was dismissed in August following an internal inquiry into allegations of inappropriate conduct. While the governing body continues its search for a successor, today’s press reports no progress or newly named candidates for the vacancy. The ongoing leadership vacuum leaves the union's corporate structure in limbo as Scotland prepares for a challenging autumn test series."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-03",
      "edition": "Thursday 3 September",
      "sections": [
        {
          "kicker": "Midfield debate",
          "heading": "Graham Price urges Steve Tandy to abandon Wales midfield strategy",
          "body": "Graham Price has called on Wales to abandon their midfield strategy ahead of the upcoming Nations Championship campaign. While Steve Tandy's side recently broke a record losing streak with wins over Japan, Italy and Fiji, a heavy 43-0 defeat to South Africa in their last outing has reignited concerns. Price insisted that Wales must rethink their approach, keeping the debate open as pundits question if the coaching staff have got the midfield partnership right. No new selections have been confirmed in today's coverage."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-09-03",
      "edition": "Thursday 3 September",
      "sections": [
        {
          "kicker": "Wallabies selection",
          "heading": "Argentina face reshaped Wallabies as Les Kiss hands Suaalii a fresh role",
          "body": "Wallabies head coach Les Kiss has named a reshaped line-up for Saturday's rematch, handing rugby league recruit Joseph-Aukuso Suaalii a fresh role as Australia look to build on their 27-21 victory in Jujuy. Having debuted off the bench at outside centre, Suaalii's utility is set to be tested further as Kiss targets the 'clunky bits' from that opening Test. The changes also include a new captain to lead the visitors, presenting Los Pumas with a major tactical puzzle as they look to respond."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "461": {
      "date": "2026-09-03",
      "edition": "Thursday 3 September",
      "sections": [
        {
          "kicker": "Veteran return",
          "heading": "James O'Connor signs Western Force deal to launch Wallabies World Cup bid",
          "body": "Wallabies veteran James O'Connor has completed a full-circle return to the Western Force on a one-year deal, launching a final bid to secure a place in the national squad for next year's home World Cup. The 36-year-old, who made his Super Rugby debut for the Force as a 17-year-old in 2008, joins after leaving Leicester Tigers. With 68 Test caps, O'Connor intends to prove his worth to head coach Les Kiss during the upcoming season."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "463": {
      "date": "2026-09-03",
      "edition": "Thursday 3 September",
      "sections": [
        {
          "kicker": "ELIGIBILITY U-TURN",
          "heading": "Timothy Lafaele and naturalised players force League One eligibility rule U-turn",
          "body": "Japan Rugby League One has watered down its controversial player eligibility changes following a legal challenge from 25 foreign-born players, including Timothy Lafaele. The players had filed for a court injunction against rules that restricted matchday squad spots for naturalised citizens who lacked six years of Japanese schooling. Under the settled terms, naturalised players holding citizenship since May 2025 or earlier will avoid these limits. Additionally, any player with 30 or more caps for the Brave Blossoms will be reclassified to Category A-1."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-03",
      "edition": "Thursday 3 September",
      "sections": [
        {
          "kicker": "Scrum row",
          "heading": "Nick Mallett accuses All Blacks of deliberately collapsing scrums to cheat Springboks",
          "body": "Former Springboks coach Nick Mallett has accused the All Blacks of deliberately collapsing scrums to negate South Africa's powerful front row. Speaking after the Boks' 33-26 victory in Cape Town, he claimed New Zealand routinely take the set-piece to the ground because they lack the personnel to match the hosts' power. The accusation intensifies the war of words between Dave Rennie and Rassie Erasmus ahead of Saturday's third Test in Soweto, following earlier disputes over South Africa's scrumming angles."
        }
      ],
      "match": {
        "venue": "FNB Stadium, Soweto",
        "referee": "Nika Amashukeli"
      },
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-03",
      "edition": "Thursday 3 September",
      "sections": [
        {
          "kicker": "SCRUM DISPUTE",
          "heading": "Daan Human denies All Blacks scrum cheating accusations before Johannesburg rematch",
          "body": "Springboks assistant coach Daan Human has hit back at Dave Rennie’s claims that South Africa use illegal \"walking around\" tactics to dominate the scrum. Ahead of Saturday's third Test in Johannesburg, Human insisted the world champions strive for \"legal, straightforward dominance,\" adding: \"I can't ever cheat or tell the players to walk around – we never work like that.\" Nick Mallett supported the stance, suggesting referee Angus Gardner had preconceived notions in Cape Town. South Africa levelled the series with a 33-26 victory last weekend."
        }
      ],
      "match": {
        "venue": "FNB Stadium, Johannesburg",
        "referee": "Nika Amashukeli"
      },
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
