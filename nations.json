  "digests": {
    "28": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "STATISTICAL REVIEW",
          "heading": "Fiji drop to twelfth place following three consecutive Nations Championship defeats.",
          "body": "Fiji remain at the bottom of the table after three matches. Across their last 11 matches, the team scored 315 points. During this same 11-game window, they conceded 326 points. Those matches produced an average of 28.6 points scored per game. The team also averaged 29.6 points conceded per game in that same 11-match window. The high point came when they beat Canada 63-10 at home in September 2025 during the Pacific Nations Cup knockout stage."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Transfer saga",
          "heading": "Henry Pollock receives £1m Newcastle Red Bulls offer to spark transfer battle",
          "body": "Reports suggest Henry Pollock has received a stunning £1m offer to join Newcastle Red Bulls, moving the flanker closer to a high-profile exit from Northampton. The bid follows promoter Eddie Hearn’s public valuation of the England prospect as a seven-figure talent, a figure Saints boss Phil Dowson admits will require a \"happy medium\" to resolve under Premiership salary cap constraints. With domestic rivals now reportedly testing that stance, the battle for the back-row’s future has shifted from speculation to a formal transfer coup."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "387": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Fixture History",
          "heading": "France prepare to face Fiji following last year’s home victory",
          "body": "France welcome Fiji in their next fixture as they look to build on their recent form in the Nations Championship. The two sides last met in November 2025, when France secured a 34-21 victory on home soil. Les Bleus currently sit third in the log with two wins from their opening three matches, having scored 116 points and conceded 75. They head into the upcoming contest following a 42-15 victory over Japan in their most recent outing."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Jack Crowley remains sidelined as Munster confirm return in new year",
          "body": "Ireland fly-half Jack Crowley has been ruled out until the new year due to a lower limb vascular injury, confirming he will miss the Nations Championship fixtures this November. The 26-year-old, who has earned 35 caps for his country, has been sidelined since April. Munster head coach Clayton McMillan emphasised that “ensuring he gets back to 100% is the priority.” The news compounds a difficult start to the season for the province, with new signing Will Harrison also nursing a knee injury."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Disciplinary ban",
          "heading": "Gonzalo Quesada banned as World Rugby enforces new conduct protocols",
          "body": "Italy head coach Gonzalo Quesada has become the first coach suspended under World Rugby's new Match Official Abuse Sanctioning Process. The governing body handed the Argentine a two-Test ban following his criticism of referee Luc Ramos after the July meeting with the All Blacks. As a result, Quesada is excluded from all match-day proceedings, including stadium access, for the upcoming fixture against South Africa. While he retains the right to appeal, the sanction marks a significant escalation in officiating discipline."
        }
      ]
    },
    "390": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Pathway development",
          "heading": "Scottish Rugby pathway graduates feature in Edinburgh and Glasgow season openers",
          "body": "Edinburgh and Glasgow Warriors are incorporating several Scottish Rugby pathway graduates into their matchday squads for this weekend’s season-opening fixtures. Edinburgh host Ulster tonight, while Glasgow travel to face Newcastle Red Bulls tomorrow. Among the emerging talents are numerous members of the Scotland U20s side that secured a fifth-place finish at this summer’s Junior World Championship, as well as players from the squad that claimed the U20s World Rugby Trophy in 2024, as the professional clubs prioritise integrating local prospects."
        }
      ],
      "rung": "data"
    },
    "391": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Selection ambition",
          "heading": "Tom Rogers eyes international recall following move to the Ospreys squad",
          "body": "Tom Rogers is targeting a return to the Wales fold after completing his off-season transfer to the Ospreys. The back, who memorably scored a hat-trick against New Zealand last November, admitted that his desire to play for his country remains his primary motivation. Having struggled for opportunities to play at full-back at his previous club, Rogers hopes the move will provide the platform needed to earn a recall under Steve Tandy after being sidelined from the Test squad for much of this year."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Series conclusion",
          "heading": "Argentina and Australia draw in Mendoza as visitors clinch series win",
          "body": "Argentina fought to a 28-28 draw against Australia in their second Test in Mendoza on Saturday, but the result ensured the Wallabies secured a historic series victory on Argentine soil. Los Pumas mounted a spirited comeback in an eight-try slugfest, with Pablo Matera crossing twice and a late penalty try keeping the hosts in contention. Despite the valiant effort and a yellow card for Argentina late in the second half, the tourists held firm to claim their first-ever two-Test series win in Argentina."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "461": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Series triumph",
          "heading": "Australia secures historic maiden away series victory despite Argentina draw in Mendoza",
          "body": "The Wallabies have made history, claiming their first-ever away series win in Argentina after a 28-all draw in Mendoza. Despite a late push, Australia could not complete the series sweep as Los Pumas fought back to level the scores. Skipper Harry Wilson, Max Jorgensen, and Fraser McReight crossed for the visitors, but disciplinary issues late in the game allowed Argentina to salvage the result. The draw marks the fourth time the two nations have shared the spoils in their storied history."
        }
      ],
      "match": {
        "venue": "Estadio Malvinas Argentinas, Mendoza"
      }
    },
    "463": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Centenary Test",
          "heading": "Japan faces Canada in Niigata to mark historic JRFU anniversary match",
          "body": "The Brave Blossoms continue their Lipovitan D Challenge Cup campaign today, hosting Canada at Denka Big Swan Stadium to commemorate the JRFU’s 100th anniversary. Eddie Jones has named a familiar lineup for the fixture, introducing debutant Inoke Burua to the matchday squad. Looking to arrest a four-match losing streak, the hosts aim to build on a dominant historical record against the Canadians, having remained unbeaten in their previous 10 encounters. It marks the first international Test in Niigata in 18 years."
        }
      ],
      "match": {
        "venue": "Denka Big Swan Stadium, Niigata City"
      },
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Ardie Savea ruled out of fourth Test following shoulder injury setback",
          "body": "All Blacks captain Ardie Savea will miss the final Test of the series in the United States after sustaining a shoulder injury during Saturday’s match in Johannesburg. Head coach Dave Rennie confirmed the skipper will not travel with the squad to Baltimore, though he praised the contribution of his replacement, Wallace Sititi. Following the 29-24 defeat, Rennie remained optimistic about the series, insisting that despite the loss of his leader, the gap between the two teams is not significant."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Series lead",
          "heading": "Springboks beat All Blacks in Soweto to secure vital series advantage",
          "body": "South Africa moved into a 2-1 series lead in 'Rugby’s Greatest Rivalry' following a hard-fought 29-24 victory at FNB Stadium on Saturday. After falling behind 17-12 midway through the second half, the Springboks surged back with tries from Jesse Kriel and Malcolm Marx. Rassie Erasmus praised the All Blacks' attack and offered an apology for his previous conduct, stating: “I don't want to swear again because I got into trouble last time, and I really apologise for that last week.”"
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
