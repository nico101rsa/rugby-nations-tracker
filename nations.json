      }
    },
    "388": {
      "date": "2026-10-29",
      "edition": "Thursday 29 October",
      "sections": [
        {
          "kicker": "Contract news",
          "heading": "Ireland winger Robert Baloucoune commits Ulster future to at least summer 2029",
          "body": "Ulster have confirmed that Robert Baloucoune, James McNabney and Joe Hopes have all committed to the province until at least the summer of 2029, good news for Andy Farrell's squad planning. Baloucoune's form earned him an Ireland call-up in the Six Nations, and he scored three tries as Ireland secured the Triple Crown. The 29-year-old was also named BKT Rising Star player of the Championship. McNabney, 23, is a recent Nations Championship squad call-up who returned from an ACL injury that ruled him out of 2025/26."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa without Kolbe and Etzebeth through injury for Nations Championship",
          "body": "Italy have 17 players unavailable for Nations Championship. France's Hastoy, Gazzotti and Brau-Boirie sidelined by injury. New Zealand's Jordie Barrett withdraws from Bledisloe Cup Test with calf."
        }
      ],
