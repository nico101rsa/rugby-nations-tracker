  "digests": {
    "28": {
      "date": "2026-08-20",
      "edition": "Thursday 20 August",
      "sections": [
        {
          "kicker": "DRUA HOMECOMING",
          "heading": "Olympic gold medallist Leone Nakarawa signs with Fijian Drua for 2027",
          "body": "Veteran Fiji international Leone Nakarawa will return home after signing with the Fijian Drua for the 2027 Super Rugby Pacific campaign. The 38-year-old Olympic gold medallist, who has won 68 caps, joins from French Top 14 outfit Castres. Nakarawa's arrival represents a massive coup for incoming head coach Brad Mooar, who is spearheading a franchise rebuild alongside attack coach Mike Catt. The head coach praised the signing, stating, \"He will have a huge impact on and off the field for us every day.\""
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "386": {
      "date": "2026-08-20",
      "edition": "Thursday 20 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Steve Borthwick omits Ollie Lawrence and Elliot Daly from England contracts",
          "body": "Steve Borthwick has signalled a ruthless shift ahead of next year's World Cup by omitting Ollie Lawrence and Elliot Daly from England's new 25-man central contract list. The high-profile backs are the marquee casualties, while Ben Curry, Tom Roebuck and Tom Willis also lose their £150,000-a-season deals. Borthwick has instead prioritised youth, handing lucrative contracts to Asher Opoku-Fordjour, Seb Atkinson and Guy Pepper, with Alex Coles and Jack van Poortvliet also rewarded."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "387": {
      "date": "2026-08-20",
      "edition": "Thursday 20 August",
      "sections": [
        {
          "kicker": "World rankings",
          "heading": "France topped the world rankings for only one week in 2022",
          "body": "France achieved their longest unbroken spell at number one in the world rankings for just one week, a fleeting peak that lasted from July 2022 to July 2022. Les Bleus currently sit third out of 12 teams in the standings after their first three matches, having secured two victories and suffered one defeat. Their most recent result was a 42-15 win against Japan in the third round, ahead of their next fixture against Fiji."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-20",
      "edition": "Thursday 20 August",
      "sections": [
        {
          "kicker": "Legal battle",
          "heading": "Ireland's former players await ruling as brain injury case faces collapse",
          "body": "The landmark rugby concussion lawsuit remains in limbo for Ireland's former players, with no official updates or rulings delivered since the judge retired to consider strikeout applications. The brain injury court case is now reportedly at risk of collapse, though no formal judicial decision or settlement has been announced. The legal proceedings stay stalled until there is a ruling on whether to strike out 95 per cent of the claims."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-08-20",
      "edition": "Thursday 20 August",
      "sections": [
        {
          "kicker": "Form guide",
          "heading": "Italy face defensive hurdle after conceding 318 points in recent tests",
          "body": "Italy enter their next fixture looking to stabilise a defence that has struggled. Across their last 11 games, the Azzurri have scored 190 points. However, they have conceded 318 points in that same span, averaging 17.3 points scored and 28.9 conceded per match. Their biggest win in this window was a 34-19 victory against Chile at home in November 2025."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-20",
      "edition": "Thursday 20 August",
      "sections": [
        {
          "kicker": "COACHING VACANCY",
          "heading": "Scottish Rugby seeks new head coach after Sione Fukofuka steps down",
          "body": "Scottish Rugby's search for a permanent women's head coach remains unresolved following Sione Fukofuka's sudden departure, which was reported on Tuesday. The governing body has not yet named an interim successor or outlined a recruitment timeline after he stepped down due to family stress. No updates on the vacancy have emerged in today's press. The national team's coaching setup remains in transition, with the vacancy left open until a permanent successor is officially appointed."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-20",
      "edition": "Thursday 20 August",
      "sections": [
        {
          "kicker": "Regional crisis",
          "heading": "Sports minister Heledd Fychan meets WRU over fears of regional culling",
          "body": "Wales' sports minister Heledd Fychan has held talks with Welsh Rugby Union chief executive Abi Tierney following widespread supporter backlash over plans to cull a professional region. The governing body intends to cut either the Scarlets or Ospreys by 2028, sparking fears of a growing disconnect with the community game. While Fychan clarified that the Welsh government has no direct role in the independent union's decision-making, she \"conveyed the concerns raised by supporters\" during the meeting."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-08-20",
      "edition": "Thursday 20 August",
      "sections": [
        {
          "kicker": "Fly-half vacancy",
          "heading": "Tomás Albornoz ban leaves Argentina searching for a new starting fly-half",
          "body": "Following the four-match ban handed to Tomás Albornoz earlier this month for intimidating referee Angus Gardner, the question of who will wear the No. 10 shirt remains open. There is no coverage in today's press regarding who will fill the role or if a selection has been made. The suspension, triggered by Albornoz's actions after the 24-31 defeat to England, rules him out of upcoming fixtures, leaving a significant void in the Pumas backline."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "461": {
      "date": "2026-08-20",
      "edition": "Thursday 20 August",
      "sections": [
        {
          "kicker": "Selection boost",
          "heading": "Len Ikitau and Joseph-Aukuso Suaalii named in Wallabies squad for Argentina",
          "body": "Wallabies head coach Les Kiss has handed Australia a major midfield boost by naming Len Ikitau and Joseph-Aukuso Suaalii in his 34-man squad for the tour of Argentina. Both centres return after missing recent wins over Japan. However, fullback Jock Campbell has been dropped, while lock Miles Amatosero remains suspended. Kiss emphasised selection continuity, saying, \"As coaches, we've looked to maintain consistency in selection with the bulk of this squad having laid a solid foundation over the past few weeks.\""
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "463": {
      "date": "2026-08-20",
      "edition": "Thursday 20 August",
      "sections": [
        {
          "kicker": "Defensive woes",
          "heading": "Eddie Jones laments possession deficit as Japan collapse against clinical Australia",
          "body": "Japan conceded 35 unanswered second-half points during Saturday’s 56-17 defeat to Australia in Townsville. Despite tries from Harry Hockings, Naoto Saitō and Dylan Riley keeping the Brave Blossoms within four points at the interval, the Wallabies’ set-piece dominance eventually told. Eddie Jones highlighted the defensive strain caused by a lack of ball, stating: “In order for us to compete properly against such an opponent, we need to maintain more than 50 per cent possession; otherwise it will be difficult to win.”"
        }
      ],
      "match": {
        "venue": "Queensland Country Bank Stadium, Townsville"
      },
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-08-20",
      "edition": "Thursday 20 August",
      "sections": [
        {
          "kicker": "SERIES OPENER",
          "heading": "Dave Rennie leads All Blacks into South Africa for Greatest Rivalry tour",
          "body": "The All Blacks prepare for Saturday’s first Test at Ellis Park as they begin a rare three-match series in South Africa. Head coach Dave Rennie, just three games into his tenure, leads a squad aiming to reclaim dominance from the world-champion Springboks in a tour scheduled to replace the cancelled Rugby Championship. Former Bok coach Nick Mallett has already stoked tensions, accusing New Zealand of using \"dark arts\" in maul defence, while Israel Dagg admitted the team historically used \"KitKat\" injury-faking tactics to recalibrate."
        }
      ],
      "match": {
        "venue": "Ellis Park, Johannesburg",
        "referee": "Matthew Carley"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "467": {
      "date": "2026-08-20",
      "edition": "Thursday 20 August",
      "sections": [
        {
          "kicker": "TACTICAL SPARRING",
          "heading": "Hansen labels Rassie Erasmus a 'master of sabotage' before All Blacks Test",
          "body": "Sir Steve Hansen has warned New Zealand coach Dave Rennie that Rassie Erasmus is a \"master of sabotage\" who uses media diversions to mask his true tactics. The verbal sparring ahead of Saturday’s Greatest Rivalry series opener at Ellis Park intensified after Erasmus used a press conference to rebut claims of South African time-wasting. With match-day squads announced today, former All Black Stephen Donald expects Sacha Feinberg-Mngomezulu to start at fly-half ahead of Manie Libbok."
        }
      ],
      "match": {
        "venue": "Ellis Park, Johannesburg"
      },
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
