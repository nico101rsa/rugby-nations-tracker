    "386": {
      "date": "2026-09-27",
      "edition": "Sunday 27 September",
      "sections": [
        {
          "kicker": "WXV Global Series",
          "heading": "Zoe Harrison seals England Women victory over New Zealand with overtime try",
          "body": "Fly-half Zoe Harrison intercepted a pass in the 81st minute to secure a 26-19 victory for England Women over New Zealand at Allianz Stadium. Playing in front of a crowd of 59,871, the Red Roses bounced back from last weekend's draw with Canada. Tries from Claudia Moloney-MacDonald, Ellie Kildunne and Jess Breach kept John Mitchell's side in contention before Harrison's late intervention settled the contest. The result extends England's unbeaten run to 41 Tests ahead of their trip to Canada."
        }
      ],
      "match": {
        "venue": "Allianz Stadium"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-27",
      "edition": "Sunday 27 September",
      "sections": [
        {
          "kicker": "TOURNAMENT LOG",
          "heading": "France hold third place in Nations Championship after three opening rounds",
          "body": "France currently sit third in the 12-nation standings following the conclusion of the opening three rounds of the Nations Championship. The side has achieved two wins from their first three fixtures, scoring 116 points while conceding 75. This leaves the squad with a positive points difference of 41 heading into the next stage of the tournament. Their most recent result, a 42-15 victory against Japan, ensures the team remains firmly in the top quartile of the table."
        },
