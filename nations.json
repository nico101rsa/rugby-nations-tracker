  "digests": {
    "28": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "PNC FINAL DEFEAT",
          "heading": "Japan edge past Fiji to secure the Pacific Nations Cup title",
          "body": "Fiji narrowly missed out on the Pacific Nations Cup title on Saturday, falling 20-15 to Japan in a tense Tokyo final. Despite early scores from Virimi Vakatawa and Tevita Ikanivere, the visitors could not hold off a surging Brave Blossoms side. A late try from Samisoni Tua ultimately decided the contest, denying Fiji a third consecutive tournament crown. The result leaves Fiji reflecting on a physical encounter where discipline, including a yellow card for Mesake Doge, proved costly in a tight finish."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "386": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Winning run ends",
          "heading": "Canada hold England to draw as remarkable winning streak finally concludes",
          "body": "England’s 39-match winning run came to an end at Sandy Park as John Mitchell’s side were held to a 26-26 draw by Canada. Despite tries from Claudia Moloney-MacDonald, Hannah Botterman, and Bryony Field, the hosts could not overcome a resilient Canadian side who successfully navigated a chaotic final 10 minutes. While the result halts the historic streak, England remain unbeaten in 40 Tests and now turn their focus to next Saturday’s encounter against New Zealand at Allianz Stadium."
        }
      ],
      "match": {
        "venue": "Sandy Park, Exeter"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Psychological hurdle",
          "heading": "Ben Youngs urges France to overcome mental barrier against South Africa",
          "body": "Former England scrum-half Ben Youngs has challenged France to secure a victory against South Africa in their upcoming November meeting to dispel lingering psychological doubts. Speaking on the For the Love of Rugby podcast, Youngs argued that despite France’s undeniable quality and status as a top-tier contender, they must overcome the mental weight of recent defeats to the world champions before next year’s World Cup in Australia. Youngs believes this hurdle is the only thing currently preventing Les Bleus from reaching their potential."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "388": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Jemima Adams Verling handed Ireland debut for WXV Global Series opener",
          "body": "Connacht back row Jemima Adams Verling will make her senior Ireland debut in Sunday’s WXV Global Series opener against the United States. The 20-year-old lines out at blind-side flanker alongside captain Erin King and Aoife Wafer. With Sam Monaghan sidelined by an Achilles injury, head coach Scott Bemand has confirmed the matchday squad as he looks to develop depth for the next World Cup cycle. Bemand described the series as a \"turning of the page\" for his squad as they begin their preparation."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Six Nations",
          "heading": "World Rugby continues discussions regarding hosting Six Nations match in USA",
          "body": "World Rugby remains in talks concerning a proposal to stage a Six Nations fixture in the United States, an initiative aimed at expanding the game's global footprint. While recent reports indicate that discussions are ongoing, there is no formal agreement, and significant scepticism remains regarding England’s participation in such an event. The prospect of taking the historic tournament to North American soil continues to generate debate among stakeholders, though no definitive timeline for a potential match has been confirmed by organisers."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Ceitidh Ainsworth makes first Scotland start as Sarah Bonar returns",
          "body": "Interim head coach Dave Butcher has handed Ceitidh Ainsworth her first start at scrum-half for the meeting with New Zealand. Ainsworth, who debuted off the bench in the recent loss to Canada, replaces Rhea Clarke in one of 4 changes to the starting line-up. Furthermore, the squad is bolstered by the return of lock Sarah Bonar, who is set to earn her 52nd cap from the bench after recovering from an injury that has sidelined her since the 2025 Rugby World Cup."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "WXV statement win",
          "heading": "Wales thrash South Africa as eight tries spark new era optimism",
          "body": "Wales secured a stunning 50-19 victory over South Africa in their WXV Global Series opener, emphatically ending a nine-match winless streak. Sean Lynn’s side produced a clinical first half, running in six tries to build a 38-5 lead at Cardiff Arms Park. Sisilia Tuipulotu starred with a double, while co-captain Alex Callender earned player of the match honours. Reflecting on the dominant display, Lynn stated, “This is just the start for us, this is going to be our new DNA.”"
        }
      ],
      "match": {
        "venue": "Cardiff Arms Park"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Historical standing",
          "heading": "Los Pumas hold firm as they target future tournament success",
          "body": "Argentina continues to look toward the 2027 Rugby World Cup in Australia, building on a history that includes reaching the semi-finals in 2007, 2015, and 2023. The national side, which reached a best-ever world ranking of No. 3 during the 2007–08 period, remains focused on developing depth across the forward pack. Selection remains highly competitive as the squad continues to evaluate regular starters and emerging talent ahead of future international fixtures."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Coaching challenge",
          "heading": "Les Kiss backs Australia to bite back against world champion Springboks",
          "body": "Wallabies coach Les Kiss has urged his side to embrace their underdog status as they prepare for a monumental clash against the world No 1 Springboks. Kiss, who remains unbeaten since taking charge, insists his squad is focused on the tactical opportunity presented by the challenge. Meanwhile, Rassie Erasmus has acknowledged the rivalry is 'massive' as his team arrives in Australia following a gruelling four-Test series against the All Blacks, noting that the hosts will be a significantly different prospect."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Pacific Nations Cup",
          "heading": "Eddie Jones’ Japan overcome Fiji to clinch Pacific Nations Cup title",
          "body": "Japan secured a hard-fought 20-15 victory over Fiji in Tokyo on Saturday to claim the Pacific Nations Cup title for the first time since 2019. After trailing at half-time, the Brave Blossoms rallied through tries from Mamoru Harada, Ben Gunter and Samisoni Tua. Eddie Jones praised the resilience of his squad, stating, “Our aim this weekend is to win the final and we’re 100 per cent concentrated on that,” as the team now looks toward building momentum for the 2027 World Cup."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "465": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Player ratings",
          "heading": "Analysts evaluate All Blacks squad after intense Rugby’s Greatest Rivalry series",
          "body": "Following the 3-1 series loss to South Africa, assessments of the All Blacks’ backline have highlighted a mixed tour. While Will Jordan excelled as the team’s most potent threat with four tries, others faced significant hurdles; Damian McKenzie struggled for consistency, and Leroy Carter faced challenges after a difficult outing in Soweto. Dave Rennie now faces critical selection decisions, with Murray Mexted suggesting this testing series will prove to be the making of this developing side before next year’s global tournament."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Rassie Erasmus releases Pieter-Steph du Toit and Damian de Allende",
          "body": "Rassie Erasmus has released Pieter-Steph du Toit and Damian de Allende from the Springbok squad ahead of the upcoming Test against the Wallabies. The coach confirmed on Saturday that both players will return to South Africa to spend time with their families following the demanding workload of the recent series against the All Blacks. Erasmus stated that there is sufficient cover within the travelling squad to manage their absences for the clash in Perth."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
}