      }
    },
    "390": {
      "date": "2026-10-29",
      "edition": "Thursday 29 October",
      "sections": [
        {
          "kicker": "Belief test",
          "heading": "Townsend feels belief over All Blacks he never had as a player",
          "body": "Gregor Townsend says the belief against New Zealand that eluded him as a player is now in his squad. Recalling heavy defeats to the All Blacks in his playing days, including 62-31 and 69-20, he said, \"I feel it in the players.\" Scotland have never beaten New Zealand, who have won 31 of their meetings. As coach, Townsend has lost all three meetings, each in Edinburgh, by 25-17, 31-23 and 22-17."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa without Kolbe and Etzebeth through injury for Nations Championship",
          "body": "Italy have 17 players unavailable for Nations Championship. France's Hastoy, Gazzotti and Brau-Boirie sidelined by injury. New Zealand's Jordie Barrett withdraws from Bledisloe Cup Test with calf."
        }
      ],
