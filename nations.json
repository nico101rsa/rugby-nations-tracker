  "digests": {
    "28": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Scoring Trends",
          "heading": "Fiji register narrow points margin over their last 11 test matches",
          "body": "Fiji have accumulated 315 points across their last 11 international fixtures. Over that same 11-match period, they conceded 326 points. These returns represent a scoring average of 28.6 points per game and a defensive concession rate of 29.6 points per game during the same 11-fixture sequence. Their largest victory in this timeframe was a 63-10 home win against Canada in September 2025 during the Pacific Nations Cup knockout stage."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Eligibility Exile",
          "heading": "Beno Obano puts England career on ice after agreeing Pau transfer",
          "body": "Beno Obano will put his international career on ice after agreeing to join French Top 14 side Pau from Bath at the end of the season. The 31-year-old loose-head prop, who won his fifth cap against South Africa in July, will fall foul of England's domestic-only selection policy. While Obano remains eligible for this season's fixtures, head coach Steve Borthwick has previously shown a willingness to exile departing stars early to prioritise World Cup preparation."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Table standings",
          "heading": "France sit third in the table following their dominant Japan victory",
          "body": "France occupy third place in the Nations Championship table following their 42-15 victory over Japan in Round 3. Through three fixtures this season, Les Bleus have secured two wins and one defeat, accumulating 116 points while conceding 75 for a positive difference of 41. The squad now prepares for a meeting with Fiji, whom they beat 34-21 during a home international encounter in November 2025. That previous result remains the only recent benchmark between the two sides."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Player welfare",
          "heading": "Ryan Caldwell shares harrowing journey from professional rugby to recovery",
          "body": "Former Ireland second-row Ryan Caldwell has opened up about his transition from a physical, injury-plagued career to a new life in meditation and breathwork. The former Ulster, Bath, and Exeter forward, who turns 42 on Tuesday, details his struggle with addiction, depression, and incarceration in an upcoming autobiography, White Lines. Reflecting on the impact of his playing days, Caldwell describes the peace he has discovered since leaving the professional game and moving away from his previous internal battles."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Coaching sanction",
          "heading": "Gonzalo Quesada banned following criticism of match official performance in July",
          "body": "Italy head coach Gonzalo Quesada has become the first coach suspended under World Rugby’s new Match Official Abuse Sanctioning Process. Handed a two-Test ban following his public criticism of referee Luc Ramos after the July meeting with the All Blacks, Quesada is excluded from all match-day proceedings for Italy’s upcoming fixtures, including the Round 4 clash against South Africa. The governing body confirmed the independent panel decision, though the Argentine retains the right to appeal the disciplinary ruling."
        }
      ]
    },
    "390": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Statistical Snapshot",
          "heading": "Scotland demonstrate attacking potency across their recent run of matches",
          "body": "Scotland have maintained a high-scoring rhythm throughout their recent campaign. Across their last 11 matches, the team has registered 348 points, averaging 31.6 per game, while conceding 299 points for an average of 27.2. Within this period, the side achieved a standout performance in November 2025, recording their largest win with a 56-0 victory over Tonga on home soil. This attacking output remains a core feature of the team's statistical profile heading into the upcoming international block."
        }
      ],
      "rung": "data"
    },
    "391": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Structural Reform",
          "heading": "Abi Tierney Defends Three-Team Plan Despite Mounting Professional Rugby Criticism",
          "body": "The WRU continues to face significant opposition regarding its proposal to reduce the number of professional teams to three, a move the union insists is essential to prevent a long-term collapse. WRU chief Abi Tierney has recently hit back at the toxic level of abuse directed at the board, doubling down on the necessity of the cut. While the governing body maintains that the plan is vital for the sport's survival, a final decision confirming which region will be disbanded remains pending."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Selection Change",
          "heading": "Les Kiss recalls Joseph-Aukuso Suaalii as Australia reshuffles for Mendoza test",
          "body": "Wallabies head coach Les Kiss has made nine alterations to his starting XV for the rematch against Argentina in Mendoza. Midfielder Joseph-Aukuso Suaalii returns to the run-on side to partner Len Ikitau, while Ben Donaldson takes the flyhalf duties. Kiss stated he is looking to build depth, noting, \"After a physical Test last week, we’ve brought in some fresh bodies alongside some existing combinations as we continue to look to build Test experience across the group.\""
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Selection changes",
          "heading": "Les Kiss makes nine changes as Tom Wright hits 50th cap",
          "body": "Wallabies head coach Les Kiss has rung the changes for the rematch against Argentina in Mendoza, making nine alterations to his starting XV. The headline news is the inclusion of full-back Tom Wright, who earns his 50th appearance for Australia. Joseph-Aukuso Suaalii and Len Ikitau reunite in the midfield, while Ben Donaldson takes the flyhalf berth. Captain Harry Wilson returns at number eight, leading a pack that includes props Angus Bell and Taniela Tupou as the team seeks back-to-back wins."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Centenary Test",
          "heading": "Brave Blossoms mark JRFU’s 100th anniversary by hosting Canada in Niigata",
          "body": "Japan celebrated the 100th anniversary of the JRFU on Saturday with a test match against Canada at Denka Big Swan Stadium. Seeking to snap a four-match losing streak, Eddie Jones oversaw a selection that included a debut for Inoke Burua alongside a familiar core. The match marked the first international test held in Niigata in 18 years. Historically, the two nations have met 27 times, with Japan holding a dominant record against the Canadians, having remained unbeaten in their last 10 encounters."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Attacking intent",
          "heading": "New Zealand to maintain high-tempo assault against Springboks at FNB Stadium",
          "body": "The Springboks are bracing for a continued high-tempo approach from New Zealand in Saturday’s third Test. Assistant coach Mzwandile Stick dismissed any notion of the visitors opting for a conservative tactical shift, stating, “The message is clear: they don’t play hide and seek.” With Asafo Aumua promoted to start at hooker, the All Blacks look to leverage increased mobility and ball-in-play time, aiming to exploit the width of the field and force South Africa’s rush defence into repeated, high-pressure defensive scrambles."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Series momentum",
          "heading": "Eben Etzebeth roars back into form as South Africa levels series",
          "body": "Eben Etzebeth was central to the physical resurgence that saw South Africa overcome New Zealand in the second test, successfully levelling the four-match series. Following a difficult opening defeat, the Springboks managed to tighten their discipline and reduce errors to secure a 33-26 victory. While the team remains focused on protecting their home record, legends like Jean de Villiers have challenged the squad to fire more shots offensively as the sides prepare for the pivotal third test in Soweto."
        }
      ]
    }
  }
}