  "digests": {
    "28": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "PATHWAY REFORM",
          "heading": "Talemo Waqa launches Na Soko tournament to bolster Fiji’s high-performance pathway",
          "body": "Fiji Rugby Union interim chief operations officer Talemo Waqa has confirmed the launch of the Na Soko age-grade competition, designed to streamline talent identification for the national High Performance Unit. Following the Deans competition, the tournament will feature Under-16 and Under-18 divisions in Nadi, with World Rugby and DFAT providing funding. \"This is to enhance best selection of our teams,\" Waqa said, noting that selectors will identify players for HPU scholarships and assemble elite squads for future international tours."
        }
      ]
    },
    "386": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "CHARITY FIXTURE",
          "heading": "Jamie George recruits Owen Farrell and Ben Earl for charity cricket match",
          "body": "England captain Jamie George has confirmed he will skipper a team of rugby stars, including Owen Farrell and Ben Earl, in a T20 cricket match against Somerset on 19 August. The fixture at the County Ground aims to raise funds for the Motor Neurone Disease Association. Following the conclusion of the Nations Championship southern leg, George noted that his team-mates \"love it because they're mad-keen cricket fans\", with Elliot Daly and Earl identified as the squad’s most capable cricketers."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "CAMPAIGN PROGRESS",
          "heading": "France defeat Japan to consolidate third place in the competition standings",
          "body": "France currently sit third in the standings after recording two wins and one defeat in their first three matches. The side secured a 42-15 victory in their most recent fixture. Fabien Galthié’s squad has scored 116 points and conceded 75 points across those three opening games. For the upcoming fixture against Fiji, Les Bleus look to repeat the result of their last meeting, a 34-21 home win recorded in November 2025."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "COACHING RETURN",
          "heading": "Joe Schmidt joins Ulster as a consultant following his Wallabies exit",
          "body": "Former Ireland head coach Joe Schmidt has made a surprise return to the Irish system, signing a 12-month consultancy deal with Ulster. Following his departure from the Wallabies, the New Zealander will provide mentorship and strategic support to Richie Murphy’s coaching staff in Belfast. Schmidt, who led Ireland to three Six Nations titles, is expected to combine remote work with in-person visits. Murphy welcomed the move, stating he knows \"first-hand the value he brings to an organisation\" from their previous time together."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "Investment talks",
          "heading": "Alex Brown confirms Gloucester investment talks continue as club losses reach £2.91m",
          "body": "Gloucester CEO Alex Brown confirmed last week that negotiations for new external investment remain ongoing following the announcement of a £2.91m annual loss. The club is currently seeking £300,000 from supporters via a crowdfunding initiative to meet specific financial targets. Brown acknowledged the current on-field frustration but remains focused on securing the club’s long-term stability. This financial uncertainty across the Premiership continues to draw attention as Italy’s professional interests abroad remain tied to the league’s economic health."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "Executive turmoil",
          "heading": "Scottish Rugby sacks chief executive Alex Williamson following investigation into his conduct",
          "body": "The board of Scottish Rugby has dismissed chief executive Alex Williamson with immediate effect following an inquiry into his conduct. John McGuigan, chairman of Scottish Rugby Limited, confirmed the decision after an independent investigation found Williamson’s behaviour had fallen \"significantly below the standards we set as an organisation.\" Chief financial officer David White steps in as interim chief executive while the search for a permanent successor begins. The move leaves Murrayfield seeking new leadership just months before November’s Nations Championship fixture against New Zealand."
        }
      ],
      "match": {
        "venue": "Murrayfield, Edinburgh"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "LICENCE BATTLE",
          "heading": "WRU confirms Cardiff and Dragons licences leaving Scarlets and Ospreys fighting",
          "body": "The Welsh Rugby Union has intensified the battle for regional survival by guaranteeing future licences to Cardiff and the Dragons. With the professional circuit shrinking to three teams by 2028, the Ospreys and Scarlets must now compete for a single \"west\" licence or consider a merger. Nigel Davies, the Scarlets’ director of rugby, remains defiant despite the December deadline, stating: \"Every recruitment decision starts with one simple question — does this make us better?\" This existential threat follows the recent 43-0 loss in Durban and a 14th-place URC finish."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "Opponent recall",
          "heading": "Rassie Erasmus recalls captain Siya Kolisi for physical battle in Buenos Aires",
          "body": "Springboks coach Rassie Erasmus has recalled captain Siya Kolisi and fly-half Sacha Feinberg-Mngomezulu to a 26-man squad for the upcoming Test in Buenos Aires. Kolisi, who missed the Nations Championship through injury, joins fit-again locks Eben Etzebeth and Lood de Jager in a group the coach expects will face a \"physical and gruelling battle\" against Los Pumas. While 18 players remain in South Africa to prepare for New Zealand, Rassie warned that Argentina are a \"quality outfit\" who have tested his side recently."
        }
      ],
      "match": {
        "venue": "Buenos Aires"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "CROSS-CODE FUTURE",
          "heading": "Les Kiss confirms Zac Lomax remains in Wallabies contention despite league return",
          "body": "Wallabies coach Les Kiss insists winger Zac Lomax is still \"in the system\" for Test selection, despite confirming a 2028 return to rugby league with the Papua New Guinea Chiefs. Currently sidelined with a pelvis injury, Lomax is expected to feature in Super Rugby AUS later this year to put himself in contention for a Test recall. Kiss, who prioritised a \"focus on defence\" during his first week in charge, welcomed the competition for spots, noting that \"competitive pressure in the right way makes everyone better.\""
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Japan Rugby League One faces legal action over player eligibility rules",
          "body": "Twenty-four players have initiated legal action against Japan Rugby League One concerning new eligibility rules. The players argue that the updated regulations discriminate against foreign-born athletes, including naturalised citizens who have previously represented Japan on the international stage. This development creates uncertainty regarding the long-term career pathways for overseas players who have historically utilised the Japanese professional competition as a major destination for their professional rugby careers."
        }
      ],
      "rung": "data"
    },
    "465": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "Selection sentiment",
          "heading": "Codie Taylor laments Super Rugby absence as All Blacks tour begins",
          "body": "Stand-in captain Codie Taylor has admitted he misses facing South African opposition in Super Rugby, ahead of the All Blacks’ six-week tour. Arriving in Cape Town this week, Taylor expressed his desire to re-engage with the physical intensity of South African club rugby. While head coach Dave Rennie remains focused on the upcoming series against the Springboks, the squad will first test themselves against the four United Rugby Championship franchises, starting with the Stormers next week."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-01",
      "edition": "Saturday 1 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Siya Kolisi returns as Rassie Erasmus names squad for Argentina",
          "body": "Rassie Erasmus has confirmed a 26-man squad for the upcoming Test against Argentina, featuring the return of captain Siya Kolisi after his injury layoff. Joining the skipper are fellow returnees Eben Etzebeth, Lood de Jager, Sacha Feinberg-Mngomezulu, and Morne van den Berg. Erasmus noted the importance of this fixture as a final audition, stating, \"We tried to get the balance right between giving some guys who are returning from injury a valuable run while at the same time managing the players who have played a lot.\""
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
