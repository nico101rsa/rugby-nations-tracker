  "digests": {
    "28": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Tournament log",
          "heading": "Fiji drop to twelfth in the tournament standings after Scotland defeat",
          "body": "Fiji sit bottom of the tournament log after three defeats in their opening three matches. The team scored 49 points in those first three fixtures. They conceded 145 points during the same three-game span, leaving them with a point difference of minus 96. Their latest result was a 17-33 defeat against Scotland in Round three. This difficult run contrasts with the peak of 2023, when Fiji reached their highest ever world ranking of No. 7. The Flying Fijians next face France in Round four."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "ELIGIBILITY BLOW",
          "heading": "Beno Obano puts his England career on ice with Pau transfer",
          "body": "Bath loose-head prop Beno Obano has agreed to join Top 14 side Pau at the end of the forthcoming season, effectively putting his international career on hold. The 31-year-old, who won his fifth cap against South Africa in July, is not on an RFU central contract, meaning Steve Borthwick's restriction to a domestic talent pool will rule him ineligible once he moves. However, Obano is expected to remain available for England selection throughout this campaign before departing."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Concussion litigation",
          "heading": "World Rugby loses landmark bid to dismiss concussion lawsuits by players",
          "body": "The High Court has rejected a bid by World Rugby and British governing bodies to dismiss lawsuits brought by hundreds of former players over brain injuries. The ruling, delivered in August, means the landmark class action will proceed, creating significant legal and financial uncertainty across the global game, including France. Meanwhile, recent reports indicate the lead lawyer representing the players has been forced out, leaving the future direction of the litigation in the balance."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "388": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Transfer talk",
          "heading": "George Skivington rules out Ross Byrne Munster move after Jack Crowley injury",
          "body": "Gloucester head coach George Skivington has dismissed speculation linking fly-half Ross Byrne with a move to Munster following an injury to Jack Crowley. The 31-year-old playmaker, who was also linked with Top 14 side Perpignan, lost his starting place to Charlie Atkinson last season, making just one appearance in the final nine weeks. Despite rumours of an early exit, Skivington confirmed Byrne remains key to his Premiership plans, stating: 'Ross is still with us.'"
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Coaching ban",
          "heading": "World Rugby bans Italy head coach Gonzalo Quesada from Springboks clash",
          "body": "Italy head coach Gonzalo Quesada will be barred from all match-day proceedings, including stadium entry, for the upcoming Test against South Africa. Quesada became the first coach suspended under World Rugby's new Match Official Abuse Sanctioning Process after criticising referee Luc Ramos following July's defeat to the All Blacks. Having already missed the loss to Australia, the Argentine's ban concludes with the Springboks fixture, though he can still appeal."
        }
      ]
    },
    "390": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Concussion Lawsuit",
          "heading": "Ousted concussion lawsuit lawyer reshapes legal battle facing Scottish Rugby",
          "body": "The lawyer leading the landmark brain injury lawsuit against rugby’s governing bodies has been forced out. This follows a High Court ruling last month that rejected bids by World Rugby and UK unions to throw out the cases. While today's press coverage provides no new details on the departure, the ongoing litigation continues to loom over Scottish Rugby as the national side prepares for the upcoming autumn test series."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "SQUAD AMBITION",
          "heading": "Tom Rogers swaps Scarlets for Ospreys to reignite stalled Wales career",
          "body": "Tom Rogers has completed a cross-Loughor move to the Ospreys after nine years with the Scarlets. The winger, who scored a historic Test hat-trick against New Zealand last November, has not played for his country since. Driven by a desire to play full-back, Rogers made the switch to reignite his international ambitions. After a disappointing summer appearance against the Barbarians, he must now excel to force his way back into Wales contention."
        }
      ],
      "match": {
        "venue": "Principality Stadium, Cardiff"
      },
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Mendoza rematch",
          "heading": "Los Pumas hunt Mendoza redemption to deny Australia a historic sweep",
          "body": "Los Pumas host Australia in Mendoza for Saturday's second Test, determined to bounce back from last weekend's 27-21 defeat in San Salvador de Jujuy. A victory is essential to prevent a historic first, as the Wallabies have never swept a two-Test series on Argentine soil. The visitors have made nine alterations to their starting line-up, but Australia’s head coach Les Kiss expects a fierce backlash, warning: \"We’re expecting a strong response from Argentina on Saturday.\""
        }
      ],
      "match": {
        "venue": "Estadio Malvinas Argentinas, Mendoza"
      }
    },
    "461": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Les Kiss selects Ben Donaldson at fly-half for Wallabies' Argentina Test",
          "body": "Wallabies head coach Les Kiss has handed Ben Donaldson a surprise start at fly-half for Saturday's second Test in Mendoza, relegating Carter Gordon to the bench. Despite recovering from a facial injury sustained during last weekend's 27-21 win in Jujuy, Gordon drops out as Kiss makes nine changes. Donaldson, making his first Test start in two years, partners scrum-half Ryan Lonergan. Kiss explained the selection, stating, \"we felt it was just an opportunity to make sure he just feels Test rugby again.\""
        }
      ],
      "match": {
        "venue": "Estadio Malvinas Argentinas, Mendoza"
      },
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Anniversary Test",
          "heading": "Eddie Jones hands Inoke Burua debut as Japan host anniversary Test",
          "body": "Japan mark the JRFU’s 100th anniversary in Niigata today, seeking to snap a four-match losing streak against a touring Canada side. Eddie Jones has made five changes to the XV that fell to Australia, most notably losing captain Warner Dearns to injury. Jack Cornelsen and Harry Hockings form a fresh second-row pairing, while Kanji Shimokawa returns to the back row. All eyes are on debutant Inoke Burua, who starts in a backline hoping to maintain Japan’s 10-match unbeaten run against the Canadians."
        }
      ],
      "match": {
        "venue": "Denka Big Swan Stadium, Niigata"
      },
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "SELECTION CALL",
          "heading": "Dave Rennie hands Asafo Aumua surprise start against South Africa’s Malcolm Marx",
          "body": "Dave Rennie has handed hooker Asafo Aumua a starting role for Saturday’s Test against South Africa, opting to rest veteran Codie Taylor. All Blacks great Murray Mexted backed the abrasive Hurricanes powerhouse to confront World Rugby Player of the Year Malcolm Marx, citing Aumua’s physical development. With Peter Lakai starting and Wallace Sititi providing cover, Rennie is prioritising mobility to exploit a Springbok defence that former Sharks coach John Plumtree believes is vulnerable to high-tempo, wide-channel attacks."
        }
      ],
      "match": {
        "venue": "FNB Stadium, Johannesburg"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Historic motivation",
          "heading": "Siya Kolisi urges Springboks to channel Soweto history against New Zealand",
          "body": "Ahead of Saturday’s third Test against New Zealand, captain Siya Kolisi has urged the Springboks to channel the history of Soweto and the FNB Stadium. With the series level at 1-1, tactical shifts see Cheslin Kolbe start at full-back following Damian Willemse’s injury, while Kurt-Lee Arendse returns to the wing. Assistant coach Mzwandile Stick described the encounter as a World Cup-style knockout, prioritising set-piece dominance over New Zealand’s expansive play. Legends Jean de Villiers and Schalk Burger have also called for more attacking intent."
        }
      ],
      "match": {
        "venue": "FNB Stadium, Johannesburg"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    }
  }
}