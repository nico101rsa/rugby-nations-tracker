  "digests": {
    "28": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "PACIFIC RUGBY",
          "heading": "World Rugby denies issuing suspension ultimatum as Samoa funding dispute continues",
          "body": "The threat of a four-year international suspension hanging over Pacific neighbours Samoa has taken a fresh turn, with World Rugby denying they issued an ultimatum to the nation. While local media previously reported that the governing body threatened a ban following the Samoan government withdrawing its financial support, the global authority has moved to clarify their position. Despite the denial, the country's political blame game continues to roll on, leaving the long-term status of Samoan rugby unresolved as regional partners watch on."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      },
      "rung": "storyline"
    },
    "386": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Financial blow",
          "heading": "RFU expects £10m loss after Steve Borthwick's England finished fifth",
          "body": "The Rugby Football Union is forecasting a £10m net loss for the 2025/26 financial year, driven by England's worst Six Nations campaign under Steve Borthwick. Finishing second bottom after losing four matches severely dented prize money, highlighting Twickenham's financial reliance on the men's senior side. Despite chief executive Bill Sweeney insisting the union 'continued to perform in line with our plans', the deficit would have been wider without a lucrative extra autumn Test against Australia. Meanwhile, sponsorship revenues rose by 50% since 2024."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "387": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Club Future",
          "heading": "Thomas Ramos confirms shock Toulouse departure to sign for Racing 92",
          "body": "France full-back Thomas Ramos has confirmed his shock decision to leave Toulouse and join rivals Racing 92. The bombshell transfer, which will see the international star depart at the end of the 2026-27 season, has stunned French rugby. Ramos admitted, 'This decision was particularly difficult to make', following his long association with Toulouse. His move marks a major domestic shake-up as France build towards their autumn campaign."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "388": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "U18 international",
          "heading": "Herbie Doyle brace not enough as Ireland fall to South Africa A",
          "body": "Ireland's U18 squad suffered a 32-31 defeat against South Africa A in Durbanville on Friday. Trailing 17-7 at the break, the visitors rallied with three second-half tries. Hooker Herbie Doyle scored a brace, while Micheal Smyth and Matthew McCarthy also crossed. David Nolan and Luke Coffey kicked two conversions each, with Coffey adding a penalty. That put Ireland 29-28 ahead, but a late penalty from replacement Travis Pheiffer snatched victory for the hosts."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "389": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Investment talks",
          "heading": "Gloucester Rugby secure no fresh breakthroughs in search for new investment",
          "body": "Today's rugby press provides no new updates or verifiable details regarding Gloucester Rugby's ongoing investment talks. While negotiations with potential new backers remain open, neither the club nor today's search results have confirmed any fresh progress or resolved the discussions first reported on 26 July. We will continue to monitor the situation for any confirmed developments that could impact the club's financial outlook."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Coaching exit",
          "heading": "Sione Fukofuka steps down as Scotland Women head coach over family strain",
          "body": "Scotland Women head coach Sione Fukofuka has unexpectedly stepped down from his post, citing the personal toll of being separated from his Australia-based family. The former United States boss, who took charge late last year, requested a release on compassionate grounds after his wife's parents fell ill. Forwards coach Dave Butcher takes over on an interim basis ahead of the upcoming WXV Global Series. Fukofuka explained that \"the stress and the strain on my family, who are back in Australia away from me, proved too much\" to continue."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Rankings update",
          "heading": "Steve Tandy's Wales will reclaim 10th spot if Australia beat Japan",
          "body": "Steve Tandy's men could return to the world's top 10 today for the first time in more than two years without even taking the field. A Wallabies victory over Japan in Osaka would see the Brave Blossoms slip two places, elevating Wales to 10th. Tandy's side currently sit 11th, trailing Japan by a mere 0.04 points. It would represent a welcome climb for Wales, who plummeted as low as 14th last summer following a defeat in Kitakyushu."
        }
      ]
    },
    "460": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Disciplinary blow",
          "heading": "Tomás Albornoz banned for four matches after intimidating referee Angus Gardner",
          "body": "The Pumas will be without Tomás Albornoz for Saturday's clash with South Africa after the fly-half received a four-match ban for misconduct. Albornoz accepted that his behaviour towards referee Angus Gardner after the 31-24 loss to England was intimidatory, having made contact with the official. Santiago Carreras shifts from fullback to fly-half for the fixture at Vélez, as the hosts look to move past the post-match controversies."
        }
      ],
      "match": {
        "venue": "Vélez, Buenos Aires"
      },
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "461": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Les Kiss names Ryan Lonergan and Declan Meredith to face Japan",
          "body": "New head coach Les Kiss has backed the inexperienced halves pairing of Ryan Lonergan and Declan Meredith to start Saturday's Test against Japan in Osaka. It marks Kiss's first match in charge, with first starts handed to Aidan Ross and Miles Amatosero, while Hunter Paisami replaces the injured Len Ikitau. \"Every single player in the squad has pushed hard over the last fortnight to get us to this point, making selecting the matchday 23 a real challenge for the coaches,\" Kiss said."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Wallabies clash",
          "heading": "Eddie Jones targets historic first Japan victory over Wallabies in Osaka",
          "body": "Eddie Jones leads a refreshed Brave Blossoms side into Saturday's clash against Australia in Osaka, chasing Japan's first-ever victory over the Wallabies. Amid forecast temperatures of 36C at Hanazono Rugby Stadium and the looming threat of Typhoon Dolphin, Japan field a vastly altered squad from their narrow 19-15 defeat to Australia in Tokyo last year, with only 11 players retained in the matchday 23. Wallabies coach Les Kiss, taking charge of his first Test, has resisted major changes despite the extreme humidity."
        }
      ],
      "match": {
        "venue": "Hanazono Rugby Stadium, Higashiosaka"
      },
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Tour opener",
          "heading": "Dave Rennie praises All Blacks character after victory over the Stormers",
          "body": "Head coach Dave Rennie praised New Zealand's character after the All Blacks overcame two yellow cards to defeat the Stormers 38-21 in Cape Town. Despite playing with 13 men at times, the visitors scored six tries to open their tour. Rennie noted that surviving the pressure highlights \"a lot of the character that the boys showed under a bit of pressure.\" Although outside centre Billy Proctor suffered a suspected shoulder injury, the squad now heads to Durban to face the Sharks."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "CAPTAIN'S RETURN",
          "heading": "Eben Etzebeth and Siya Kolisi return for the Springboks against Argentina",
          "body": "Siya Kolisi returns to lead South Africa in tonight's test against Argentina at Vélez Sarsfield, marking his first appearance of the year following injury. The captain is among 13 changes made by Rassie Erasmus, who also welcomes back record cap-holder Eben Etzebeth and fly-half Sacha Feinberg-Mngomezulu to the starting XV. Assistant coach Mzwandile Stick expects an emotional challenge from Los Pumas, noting they are \"playing in the right areas\" and \"more disciplined than before.\" Only Aphelele Fassi and Cobus Reinach retain their spots from the Wales win."
        }
      ],
      "match": {
        "venue": "Vélez Sarsfield, Buenos Aires"
      },
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
}