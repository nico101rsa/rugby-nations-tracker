    "463": {
      "date": "2026-11-15",
      "edition": "Sunday 15 November",
      "sections": [
        {
          "kicker": "Twickenham rout",
          "heading": "Warner Dearns and Opeti Helu score as Japan lose 78-15 at Twickenham",
          "body": "England ran in 13 tries in a 78-15 win, leading 32-3 inside 20 minutes. Will Joseph, back after four years out of the Test game, scored five of them, a record-equalling haul, with Max Ojomoh's midfield running setting up two. Japan's tries came through co-captain Warner Dearns and Opeti Helu, but they could not match England's ball movement or the quick rucks that have troubled bigger sides. Their next assignment is in Scotland."
        },
        {
          "kicker": "Around the world",
          "heading": "Wales stun All Blacks for first win since 1953",
          "body": "France beat South Africa 21-19. Ireland beat Fiji 43-15."
