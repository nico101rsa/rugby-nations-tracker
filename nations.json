  "digests": {
    "28": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Tournament form",
          "heading": "Fiji suffer third straight Nations Championship loss after falling to Scotland",
          "body": "Fiji are seeking a reset after a 17-33 defeat against Scotland in round three of the Nations Championship. That result leaves Fiji bottom of the table, sitting twelfth of 12 teams after three matches. Their next opponents are France, who defeated Fiji 34-21 in their last meeting in November 2025. Across their first three tournament fixtures, the team have conceded 145 points. Meanwhile, Fiji have managed to score only 49 points in those same three matches."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Contract talk",
          "heading": "Eddie Hearn faces reality check over Henry Pollock’s million pound demand",
          "body": "Boxing promoter Eddie Hearn is seeking a £1 million annual contract for Northampton Saints and England back-rower Henry Pollock. The 21-year-old, who toured with the British and Irish Lions after earning 13 senior caps, is currently on a deal worth roughly £150,000. While Pollock is among the 25 players recently awarded enhanced elite player contracts by Steve Borthwick, England veterans Ben Youngs and Dan Cole warned Hearn that rugby lacks the \"Riyadh\" riches of boxing to meet such a valuation."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Form guide",
          "heading": "Fabien Galthié's France bolster scoring average following 42-15 Japan win",
          "body": "France go into the Nations Championship break third in the standings, having maintained a prolific scoring rate of 38.7 points per game across their last 11 matches. During this period, the national side has scored 426 points and conceded 291, an average of 26.5 per fixture. This clinical streak includes a 54-12 victory away to Wales in February, the largest winning margin of the window. Following the 42-15 win against Japan, the squad sits behind only the top two on points difference."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Fly-half setback",
          "heading": "Jack Crowley ruled out of Ireland’s November tests with vascular injury",
          "body": "Ireland fly-half Jack Crowley will miss the November international window as he continues to recover from a vascular injury. Munster head coach Clayton McMillan confirmed the 35-cap playmaker is unlikely to feature until the new year, ruling him out of the upcoming test against Argentina and subsequent clashes with Fiji and South Africa. Crowley previously missed the July series after playing every minute of Ireland’s 2024 Triple Crown-winning campaign. McMillan noted that \"ensuring he gets back to 100% is the priority\" for the 26-year-old."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Form guide",
          "heading": "Italy drop to 11th place after suffering a heavy defeat to Australia",
          "body": "Italy have recorded one win and four losses across their last five games. The side is currently on a run of four straight defeats. In their most recent fixture, the Azzurri lost 10-57 against Australia in an away Nations Championship match. This difficult run leaves the team 11th in the log, having scored 37 points while conceding 131 across three matches played in the current competition."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Legal battle",
          "heading": "Scottish Rugby faces legal battle as High Court allows brain injury claims",
          "body": "The legal proceedings brought by roughly 500 former players over neurological injuries remain active following a High Court ruling earlier this month. The court rejected a bid by World Rugby and the British governing bodies—including Scottish Rugby—to have the concussion-related lawsuits dismissed. While the decision ensures the cases proceed toward trial, the litigation remains unresolved. The sport continues to navigate the long-term implications of these historical claims as the governing bodies prepare their next steps in the landmark case."
        }
      ],
      "match": {
        "venue": "Scottish Gas Murrayfield, Edinburgh"
      },
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Rugby legend",
          "heading": "Wales mourns iconic sporting figure Sir Billy Boston aged 92",
          "body": "Sir Billy Boston has died at the age of 92, just days after the funeral of his wife, Lady Joan. A Cardiff-born icon who represented Neath and Pontypridd in the early 1950s, he later became a titan of rugby league during his 15-year tenure at Wigan. The Welsh Rugby Union paid tribute to the former Great Britain star, describing him as \"one of the best loved and most iconic figures in the history of Welsh sport\" following his passing in Wigan."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Felipe Contepomi names unchanged Argentina XV to face visiting Wallabies side",
          "body": "Felipe Contepomi has kept faith with the starting side that pushed the Springboks close in their recent encounter, opting for an unchanged XV for the opening Test against Australia. While the run-on group remains static, the head coach has adjusted his matchday 23 by shifting to a 5:3 bench split. Captain Pablo Matera continues to lead the pack in the ongoing absence of Julián Montoya, who remains unavailable for this fixture alongside several other senior squad members."
        }
      ],
      "match": {
        "venue": "Estadio 23 de Agosto, San Salvador de Jujuy",
        "referee": "Ben O'Keeffe (NZR)"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Les Kiss rotates forward pack and omits Harry Wilson for Argentina",
          "body": "Coach Les Kiss has overhauled his forward pack for the upcoming test against Argentina, omitting captain Harry Wilson entirely as part of a strategic push to build squad depth ahead of next year’s World Cup. Allan Alaalatoa takes over the captaincy, while Joseph-Aukuso Suaalii begins on the bench. Kiss noted that the reshaped pack is “worthwhile exploring” to ensure the team can “raise that competitive dial” and eventually field two competitive starting XVs as the 2027 tournament approaches."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "League rule change",
          "heading": "Japan Rugby League One settles legal dispute over player registration rules",
          "body": "Japan Rugby League One has revised its controversial eligibility criteria following a legal challenge from 24 players. The league confirmed it will allow naturalised players who held citizenship by May 2025 to retain their registration status, averting potential exclusion from domestic squads. Additionally, the JRLO introduced a special measure reclassifying Brave Blossoms with 30 or more caps from Category A-2 to A-1. The governing body admitted that previous communication regarding these system changes was insufficient, prompting the settlement."
        }
      ]
    },
    "465": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Selection twist",
          "heading": "Sacha Feinberg-Mngomezulu replaces Handré Pollard for South Africa against New Zealand",
          "body": "New Zealand prepare for a shifted tactical challenge in Cape Town after South Africa confirmed a late change at fly-half. Handré Pollard has been ruled out of the second Test after failing a fitness test on a training injury. Sacha Feinberg-Mngomezulu, who started in the Springboks’ 33-16 defeat at Ellis Park, moves into the starting side. While Pollard offered set-piece reliability, Rassie Erasmus now turns to the more adventurous Feinberg-Mngomezulu as the hosts look to level the series."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "467": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Sacha Feinberg-Mngomezulu replaces Handré Pollard for crucial All Blacks second Test",
          "body": "Rassie Erasmus has been forced into a late change for today’s must-win encounter after Handré Pollard was ruled out following a training ground injury on Wednesday. Sacha Feinberg-Mngomezulu will step into the No 10 jersey, marking a shift in approach for the Springboks. While Erasmus had initially targeted a set-piece focus with the experienced Pollard, the pivot to Feinberg-Mngomezulu offers a more adventurous skill set as South Africa look to bounce back from last week’s 33-16 defeat in Johannesburg."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    }
  }
}