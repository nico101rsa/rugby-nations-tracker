  "digests": {
    "28": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "By the numbers",
          "heading": "Fiji score 331 points and concede 341 across their last 11 matches",
          "body": "Fiji have scored 331 points and conceded 341 across their last 11 games. This overall run averages out to 30.1 points scored and 31 points conceded per match. Within this same 11-game window, the team's biggest victory was recorded in the Pacific Nations Cup knockout stage in September 2025. In that particular home fixture, Fiji defeated Canada 63-10."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "WXV Global Series",
          "heading": "England Women Crush Australia With Resurgent Seven-Try Second-Half Performance Display",
          "body": "England launched their WXV Global Series campaign with a resounding 48-15 victory over Australia in Salford. Despite trailing 10-5 at half-time—a rarity for the side—John Mitchell’s squad produced a clinical second-half display, crossing for seven tries to extend their winning streak to 39 matches. Mitchell dismissed early concerns, noting, \"It is an absolute joke if you are worried about being down 10-5,\" instead praising the group’s ability to solve problems after a competitive opening period of pre-season rugby."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Match preview",
          "heading": "France prepares for Fiji following their recent victory over Japan",
          "body": "France returns to action in Round 4 looking to build on their 42-15 victory against Japan. The side currently sits third in the log with two wins from three matches. Looking ahead to the next fixture, the two nations last met in November 2025. In that encounter, France secured a 34-21 win at home. With 116 points scored and 75 conceded across the opening rounds, the team holds a points difference of +41 as they prepare for the challenge."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Six Nations",
          "heading": "IRFU Confirms There Are No Plans For Six Nations US Games",
          "body": "The IRFU has officially dismissed suggestions that Ireland could play a Six Nations fixture in the United States. Following comments from World Rugby chief executive Alan Gilpin regarding the potential for matches to be hosted stateside to drive growth, the union clarified that there are \"currently no plans or discussions\" regarding such a move. The IRFU stated that the competition holds a unique place for supporters, and the chance to play at home remains central to the tournament's enduring appeal."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Tournament expansion",
          "heading": "Six Nations USA venue proposal remains a long-term strategic uncertainty",
          "body": "The proposal to stage a Six Nations match in the United States remains an open question, with recent reports highlighting significant scepticism regarding its feasibility. While World Rugby continues to promote the concept as a method for international growth, analysts suggest the logistics for such a fixture remain a 'long shot.' As of this weekend, no formal agreement has been reached between the unions, and industry coverage indicates that major participants, particularly England, are unlikely to support the transition."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "WXV campaign",
          "heading": "Scotland overpowered by ruthless Canada in challenging WXV tournament series opener",
          "body": "Scotland suffered a heavy 64-26 defeat to Canada in their WXV Series opener at Hive Stadium. Despite tries from Evie Gallagher, Shona Campbell, Lana Skeldon, and Rhona Lloyd, the visitors’ attacking pace proved too difficult to contain as Canada crossed for 10 tries. Interim head coach Dave Butcher faces a significant challenge to bolster the team's defensive physicality ahead of the upcoming fixtures against New Zealand and Australia, as the squad looks to move past a difficult start to the tournament."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "WXV Broadcast News",
          "heading": "BBC Wales confirms live coverage for upcoming WXV Global Series fixtures",
          "body": "Welsh rugby fans will have free-to-air access to the upcoming WXV Global Series, with BBC Wales confirmed as the host broadcaster. Wales begin their campaign against South Africa before hosting the USA in Cardiff, with both matches available on BBC One Wales, iPlayer, and BBC Radio. Tomos Grace, Chief Commercial Officer at the Welsh Rugby Union, hailed the partnership, noting that women's rugby remains \"the fastest growing part of the game\" and is essential to the future of the sport in Wales."
        }
      ]
    },
    "460": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Historical context",
          "heading": "Argentina maintain pursuit of previous No. 3 world ranking peak heights",
          "body": "While looking ahead to the upcoming challenges, Los Pumas continue to measure their modern progress against their most successful era in the international game. Argentina’s best world ranking ever reached remains the No. 3 spot, a position they previously held during the 2007–08 window. As the side navigates the current international calendar, they remain focused on climbing back toward those historical heights from their current standing in the world game."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "WXV Global Series",
          "heading": "Wallaroos fall to dominant second-half performance from world champions England",
          "body": "The Wallaroos led 10-5 at half-time in their WXV Global Series opener at Salford, but ultimately succumbed to a clinical second-half display from England. Despite tries from Faliki Pohiva and Asoiva Karpani, John Mitchell’s side pulled away to secure a 48-15 victory. England’s head coach described the fixture as a good pre-season test, noting his side had to solve problems during an error-strewn opening half before dominating the final 40 minutes to extend their winning streak to 39 matches."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "463": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Tournament progress",
          "heading": "Japan advances to Pacific Nations Cup final after defeating USA side",
          "body": "Following the conclusion of Saturday's Pacific Nations Cup semifinal at Hanazono Rugby Stadium, Japan has secured their place in the tournament final. The Brave Blossoms overcame the USA to progress, setting up a decisive encounter against defending champions Fiji, who advanced to the final by beating Canada. Head coach Eddie Jones is targeting cup glory on home soil, seeking to claim the title for the first time since 2019 after finishing behind Fiji for two consecutive years."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      },
      "rung": "storyline"
    },
    "465": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Dave Rennie names Richie Mo’unga for decisive Baltimore Test match start",
          "body": "Dave Rennie has reshuffled his side for the series finale in Baltimore, with Richie Mo’unga returning to the starting XV at fly-half to inject attacking impetus. The tourists, currently trailing 2-1 in the series, have also recalled Josh Moorby on the wing and Anton Lienert-Brown at outside centre. Springbok assistant Mzwandile Stick acknowledged the threat, noting that the All Blacks are expected to be “even more bold” in their attempt to level the series at two-all."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Series finale",
          "heading": "Rassie Erasmus targets series victory as Springboks face All Blacks finale",
          "body": "The Springboks head into the series finale against New Zealand in Baltimore holding a 2-1 lead after back-to-back victories in Cape Town and Soweto. Rassie Erasmus has made two changes to his side, with Damian Willemse returning at full-back to replace the injured Cheslin Kolbe and Morne van den Berg earning a start at scrum-half. While the test is a commercial venture aimed at financial stability, the squad remains focused on sealing a series win against their fiercest rivals."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
}