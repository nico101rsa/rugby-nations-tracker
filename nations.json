  "digests": {
    "28": {
      "date": "2026-11-27",
      "edition": "Friday 27 November",
      "sections": [
        {
          "kicker": "Opposition view",
          "heading": "Niccolò Cannone warns Italy cannot gift Fiji anything in Twickenham rematch",
          "body": "Italy's captain for the day named the breakdown and discipline as the areas to fix for the 11th-place final. He insisted that if Fiji score, it must be on merit rather than through Italian concessions. He also noted that Fiji have changed a lot since their 21-16 win over Italy in Udine. Jake White made nine changes, naming lock Nasilasila captain, starting a new front row of Ravuiwasa, Narisia and Nairau, and pairing Tamani and Muntz at half-back."
        },
        {
          "kicker": "Around the world",
          "heading": "France go into final without starting locks Meafou and Flament",
          "body": "New Zealand list Will Jordan and Codie Taylor as injured for England. Argentina's Benjamin Urdapilleta retires, returns home from Perpignan. Springboks faced no post-match drugs tests in New Zealand series."
        }
      ],
      "match": {
        "venue": "Allianz Stadium, Twickenham"
      },
      "source": {
        "name": "OnRugby"
      }
    },
    "386": {
      "date": "2026-11-27",
      "edition": "Friday 27 November",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Borthwick hands Greg Fisilau first Test start at openside against All Blacks",
          "body": "The Exeter back-rower is among five changes from last week's 37-12 win and wears No. 7 for Saturday's third-place play-off, with Ben Earl staying at the base of the scrum. Fisilau's three England appearances, all off the bench, have brought a try against Japan and 19 carries for 85 metres in 81 minutes. Borthwick said the split \"could easily be both (seven and eight)\", adding that he expects New Zealand to challenge the breakdown hard and that Fisilau has a big job there."
        },
        {
          "kicker": "Around the world",
          "heading": "France go into final without starting locks Meafou and Flament",
          "body": "Argentina's Benjamin Urdapilleta retires, returns home from Perpignan. Springboks faced no post-match drugs tests in New Zealand series."
        }
      ],
      "match": {
        "venue": "Allianz Stadium, Twickenham"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-11-27",
      "edition": "Friday 27 November",
      "sections": [
        {
          "kicker": "Final word",
          "heading": "Fabien Galthié vows France will go 'all in' against Springboks in Twickenham final",
          "body": "Galthié told reporters on Wednesday that France would try everything to beat the side he called the best in the world again, after the 21-19 win over the Springboks in Paris two weeks ago. France reach Sunday's final without starting locks Emmanuel Meafou and Thibaud Flament, and the coach was blunt about the toll: \"There's at least one team's worth of players missing, maybe even two.\" He put the 2025 and 2026 Six Nations titles, and this final, down to work and method rather than luck."
        },
        {
          "kicker": "Around the world",
          "heading": "New Zealand list Will Jordan and Codie Taylor as injured for England",
          "body": "Argentina's Benjamin Urdapilleta retires, returns home from Perpignan. Springboks faced no post-match drugs tests in New Zealand series."
        }
      ],
      "match": {
        "venue": "Twickenham, London"
      },
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "388": {
      "date": "2026-11-27",
      "edition": "Friday 27 November",
      "sections": [
        {
          "kicker": "Captain's run",
          "heading": "Ireland hold captain's run at Richmond Rugby Club, not at Twickenham",
          "body": "Andy Farrell's squad held their final session on Thursday at Richmond Rugby Club's Athletic Ground. It broke from their usual eve-of-match sessions in the stadium itself, because Twickenham is being readied to host six games in three days. Spirits were high: Jamison Gibson-Park soundtracked the walk from the bus on his portable speaker, and Robbie Henshaw arrived already wearing his new head guard. Assistants Simon Easterby and Andrew Goodman launched spiral kicks before Ciaran Ruddock led a brisk warm-up."
        },
        {
          "kicker": "Around the world",
          "heading": "France go into final without starting locks Meafou and Flament",
          "body": "New Zealand list Will Jordan and Codie Taylor as injured for England. Argentina's Benjamin Urdapilleta retires, returns home from Perpignan. Springboks faced no post-match drugs tests in New Zealand series."
        }
      ],
      "match": {
        "venue": "Twickenham, London"
      },
      "source": {
        "name": "The42"
      }
    },
    "389": {
      "date": "2026-11-27",
      "edition": "Friday 27 November",
      "sections": [
        {
          "kicker": "Captain's call",
          "heading": "Niccolò Cannone tells Italy to stop gifting Fiji anything in Twickenham rematch",
          "body": "Speaking after Thursday's captain's run at St Mary's University, Cannone named the breakdown and discipline as the areas to fix. If Fiji score, he said, it must be because they are good, not because Italy concede it. He called the 11th-place final at Twickenham the last chance to show who this side really is, and described the nerves as positive tension. He also warned that Fiji have changed a lot since the first meeting. Jake White has made nine changes, including the entire front row and half-back pairing."
        },
