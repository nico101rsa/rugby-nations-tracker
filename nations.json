  "digests": {
    "28": {
      "date": "2026-07-27",
      "edition": "Monday 27 July",
      "sections": [
        {
          "kicker": "Campaign review",
          "heading": "Senirusi Seruvakula's Fiji finished winless after second-half collapse against Scotland",
          "body": "A promising first-half performance crumbled as the Flying Fijians conceded four unanswered second-half tries, falling 17-33 to Scotland. The defeat leaves Senirusi Seruvakula's side bottom of the table with three defeats from three. Heavy discipline issues, including a red card for Simione Kuruvoli in an earlier 8-73 thrashing by England, plagued the campaign. However, the powerhouse performances of Josua Tuisova and tireless flanker Elia Canakaivata have provided vital positives for Fiji as they look to rebuild."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "386": {
      "date": "2026-07-27",
      "edition": "Monday 27 July",
      "sections": [
        {
          "kicker": "Discipline warning",
          "heading": "Sam Warburton urges Steve Borthwick to use tough love on England",
          "body": "Former British and Irish Lions captain Sam Warburton has urged England head coach Steve Borthwick to adopt a 'tough love' approach to address the team’s worsening discipline. Writing in The Times, Warburton highlighted England's worrying record of 14 yellow cards and one red card across their eight internationals in 2026. Following their chaotic 31-24 victory over Argentina, where Borthwick's side survived four second-half sin-bins, Warburton recommended replicating Warren Gatland’s ruthless selection penalties to finally force players to clean up their act."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-07-27",
      "edition": "Monday 27 July",
      "sections": [
        {
          "kicker": "Positional evolution",
          "heading": "Fabien Galthié treats France jersey numbers as an 'administrative convenience'",
          "body": "France head coach Fabien Galthié has joined a select group of international masterminds redefining team selection by ignoring rigid positional templates. Alongside South Africa and New Zealand, Les Bleus are prioritising \"skill-set fusion\" over traditional jersey numbers, which are now viewed as an \"administrative convenience rather than a job specification.\" Galthié builds his team based on what an afternoon requires — such as a jackal threat or a distributor at first receiver — rather than sticking to conventional player roles."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "388": {
      "date": "2026-07-27",
      "edition": "Monday 27 July",
      "sections": [
        {
          "kicker": "Pundit analysis",
          "heading": "Matt Williams condemns Ireland's defensive standards after wasteful Auckland defeat",
          "body": "Former Leinster boss Matt Williams has delivered a scathing assessment of Ireland's final Nations Championship performance, arguing Andy Farrell’s side was completely outplayed by New Zealand. Writing in the Irish Times, Williams rejected excuses regarding refereeing decisions, pointing instead to a mountain of errors during the 40-21 loss at Eden Park. He highlighted a staggering 18 turnovers and 35 missed tackles, warning that Ireland's defensive intensity fell well below elite standards during their tour."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-07-27",
      "edition": "Monday 27 July",
      "sections": [
        {
          "kicker": "Stark numbers",
          "heading": "Italy concede 318 points over 11 fixtures to highlight defensive struggles",
          "body": "Italy have conceded 318 points across their last 11 matches, underlining the defensive challenges facing the side. In that same window, the Azzurri scored just 190 points, resulting in an average of 17.3 points scored and 28.9 points conceded per game. The most successful performance in this 11-game sequence was a 34-19 victory against Chile on home soil during the International Friendlies in November 2025."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-07-27",
      "edition": "Monday 27 July",
      "sections": [
        {
          "kicker": "Bold claim",
          "heading": "Pierre Schoeman insists Scotland are a top five team in the world",
          "body": "Following Scotland's 33-17 victory over Fiji, Pierre Schoeman made a bold claim about the team's global standing. While acknowledging that Gregor Townsend's side still struggle for \"love\" against the All Blacks, Ireland, and South Africa, Schoeman rejected the idea that Scotland are merely closing the gap on the elite. \"I feel we are a top-three, top-five team in the world,\" he asserted, pointing to recent wins over France, England, and Argentina. With Scotland currently second in the northern table, Schoeman wants to go toe-to-toe with the best."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-07-27",
      "edition": "Monday 27 July",
      "sections": [
        {
          "kicker": "Concussion lawsuit",
          "heading": "Alix Popham defends legal team switch in landmark rugby concussion lawsuit",
          "body": "Former Wales international Alix Popham has defended the decision to replace the claimants' lead lawyer, Richard Boardman, in the landmark concussion lawsuit against governing bodies including the Welsh Rugby Union. Popham clarified that the switch in representation was a \"positive step\" necessitated by the \"scale and complexity\" of the multi-million-pound case, which involves 561 former players. The announcement followed two days of High Court proceedings, with the judge having previously criticised Boardman's reaction to court orders."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "460": {
      "date": "2026-07-27",
      "edition": "Monday 27 July",
      "sections": [
        {
          "kicker": "Misconduct charge",
          "heading": "Tomás Albornoz faces World Rugby misconduct charges after bumping referee Angus Gardner",
          "body": "Following Argentina's dramatic 31-24 defeat to England in the Nations Championship, fly-half Tomás Albornoz has been hit with misconduct charges by World Rugby. He remonstrated with and bumped into referee Angus Gardner after a controversial disallowed try on the final whistle in Santiago. Former referee Nigel Owens condemned the behaviour of the Pumas players and fans, who also threw objects at the officials as they left the pitch, calling the actions \"totally, totally unacceptable.\" World Rugby has acted strictly following the chaotic end to the test match."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-07-27",
      "edition": "Monday 27 July",
      "sections": [
        {
          "kicker": "Suaalii's role",
          "heading": "Coach Les Kiss confirms Joseph-Aukuso Suaalii will play outside centre",
          "body": "New Wallabies head coach Les Kiss has confirmed he will persist with Joseph-Aukuso Suaalii at outside centre for the upcoming series against Japan, despite the star's stellar Super Rugby Pacific campaign at full-back for the Waratahs. Suaalii, who played at No. 13 during the 2024 end-of-year tour, remains Kiss's preferred midfield option. Kiss noted: 'I will be persisting at 13 with him at this stage, but I know that he can go to [full-back] and wing, and that’s important to acknowledge as well.'"
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-07-27",
      "edition": "Monday 27 July",
      "sections": [
        {
          "kicker": "Wales rematch",
          "heading": "Japan prepare to face Wales after narrow one-point November friendly loss",
          "body": "Japan will face Wales next in round four of the Nations Championship. The team currently sit 10th out of 12 sides in the standings. In their opening three fixtures, they secured one victory and suffered two defeats. They scored 62 points across those three games. They also conceded 88 points during that same period. That sequence includes a 15-42 loss to France in round three. In their last meeting with Wales in November 2025, Japan suffered a narrow 24-23 away defeat."
        }
      ],
      "rung": "data"
    },
    "465": {
      "date": "2026-07-27",
      "edition": "Monday 27 July",
      "sections": [
        {
          "kicker": "Shock Move",
          "heading": "All Blacks icon Ma'a Nonu signs short-term deal with Durban's Sharks",
          "body": "Former All Blacks midfielder Ma'a Nonu has completed a surprise move to South Africa, signing a short-term contract with Durban club the Sharks. The 44-year-old double World Cup winner, who recently became the oldest player to feature in the Top 14 with Toulon, reportedly weighed up the offer in New Zealand before agreeing to a modest salary. Nonu will primarily serve in a mentorship and leadership capacity to help develop the Sharks' young centres, Jurenzo Julius and Ethan Hooker."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-07-27",
      "edition": "Monday 27 July",
      "sections": [
        {
          "kicker": "TACTICAL EVOLUTION",
          "heading": "Pieter-Steph du Toit and Damian Willemse spearhead Rassie Erasmus’ 'fusion' tactical shift",
          "body": "Following a 43-0 victory over Wales in Durban, South Africa’s 'positionless' evolution is dominating the Nations Championship conversation. Pieter-Steph du Toit and Damian Willemse personified this tactical shift, with the former performing three distinct roles across the July tests. Rassie Erasmus made 20 changes throughout the series while maintaining a +81 points difference. Erasmus \"decides who his best players are and then works out where the rugby happens,\" prioritising versatile skill-sets over traditional jersey numbers to keep the world champions top of the log."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
