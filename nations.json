  "digests": {
    "28": {
      "date": "2026-07-26",
      "edition": "Sunday 26 July",
      "sections": [
        {
          "kicker": "Grand Final defeat",
          "heading": "Fijian Drua fall short as Waratahs claim Super Rugby Women’s title",
          "body": "The Fijian Drua’s hopes of lifting the Super Rugby Women’s trophy on home soil ended in disappointment on Saturday. Despite the passionate support at Four R Stadium in Ba, the hosts were defeated 34-17 by the NSW Waratahs. The Drua struggled to contain the visitors in the opening hour, ultimately conceding six tries in the championship decider. While the loss denies the Drua a maiden title, the historic hosting of the final marks a significant milestone for rugby in the region."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "386": {
      "date": "2026-07-26",
      "edition": "Sunday 26 July",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Steve Borthwick urged to show tough love following England disciplinary struggles",
          "body": "Sam Warburton has called on Steve Borthwick to adopt a stricter approach with his squad to address England’s alarming disciplinary record. After accumulating 14 yellow cards and one red in 8 matches this year, the former Wales captain suggested Borthwick must replicate the tough love once employed by Warren Gatland. This follows a fractious outing against Argentina, where an expletive-laden pep talk from Ellis Genge failed to prevent four yellow cards from repeatedly reducing the side to 13 players."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-07-26",
      "edition": "Sunday 26 July",
      "sections": [
        {
          "kicker": "Power Rankings",
          "heading": "Fabien Galthié faces scrutiny as France trends downwards in latest rankings",
          "body": "Following the conclusion of the Southern Hemisphere leg of the Nations Championship, France has seen its standing questioned by analysts. While Fabien Galthié continues to focus on a fluid, skill-set-based selection policy—treating jersey numbers as administrative conveniences rather than rigid job specifications—recent performances have caused unease. Planet Rugby’s latest power rankings placed Les Bleus under a microscope, noting that the team’s current form has set alarm bells ringing despite a successful result against Japan in the third round."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "388": {
      "date": "2026-07-26",
      "edition": "Sunday 26 July",
      "sections": [
        {
          "kicker": "Coaching scrutiny",
          "heading": "Matt Williams claims Andy Farrell's side are below elite international standards",
          "body": "Former coach Matt Williams has launched a stinging critique of Ireland’s recent Nations Championship campaign, labelling the performances \"highly inaccurate\" and \"well below elite standards.\" Following the 40-21 defeat to New Zealand, Williams highlighted a concerning lack of defensive intensity and significant discipline issues. Across the match, Ireland missed 35 tackles and conceded 18 turnovers. Andy Farrell conceded his side were \"inaccurate\" during the loss, admitting that Ireland struggled to handle the All Blacks’ speed and movement throughout the final test."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-07-26",
      "edition": "Sunday 26 July",
      "sections": [
        {
          "kicker": "Legal proceedings",
          "heading": "High Court hears arguments to dismiss rugby brain injury legal claims",
          "body": "The High Court has been urged to throw out hundreds of brain injury claims brought against rugby’s governing bodies. As these proceedings continue, the court is currently evaluating applications to dismiss the litigation entirely. The status of these cases remains the primary unresolved issue following shifts in legal representation for the claimants. Until the High Court delivers a formal ruling on these dismissal applications, the future of the litigation against the various unions remains uncertain."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-07-26",
      "edition": "Sunday 26 July",
      "sections": [
        {
          "kicker": "Tournament Accolades",
          "heading": "Gregor Townsend and Scotland earn praise following Nations Championship campaign success",
          "body": "Following the conclusion of the Southern Hemisphere leg, Scotland have received widespread recognition for their tournament performance. Gregor Townsend’s side finished the series with two wins from three, a return that has seen them praised alongside the Springboks. While the wait for a definitive statement win against the game's elite remains, the collective belief in the squad is clear. Pierre Schoeman recently stated, \"I feel we are a top-three, top-five team in the world. We've proven that.\""
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "391": {
      "date": "2026-07-26",
      "edition": "Sunday 26 July",
      "sections": [
        {
          "kicker": "Squad Development",
          "heading": "Jac Morgan insists Wales are closing the gap to world’s best",
          "body": "Despite a chastening 43-0 defeat to South Africa, Jac Morgan maintains that Wales are making genuine progress. Reflecting on the squad's development throughout the season, the flanker pointed to the victory over Fiji and improved performances against Scotland and Ireland as evidence of growth. While acknowledging that there are still plenty of lessons to learn, Morgan remains confident in the group's direction. \"I think we are – or at least we hope we are,\" he said, assessing the squad's closing margin."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-07-26",
      "edition": "Sunday 26 July",
      "sections": [
        {
          "kicker": "Disciplinary action",
          "heading": "Tomas Albornoz faces misconduct charges following referee abuse after England defeat",
          "body": "Fly-half Tomas Albornoz has been issued with misconduct charges by World Rugby following his confrontational reaction to official Angus Gardner after the loss to England. The drama, which centred on a disallowed last-minute try, also saw abuse directed at officials by spectators. Former referee Nigel Owens has criticised the behaviour, describing the scenes as \"totally, totally unacceptable\" and calling for strict action. The incident has cast a shadow over the side’s performance as they look ahead to upcoming fixtures."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-07-26",
      "edition": "Sunday 26 July",
      "sections": [
        {
          "kicker": "Tactical Pivot",
          "heading": "Les Kiss confirms Joseph-Aukuso Suaalii will remain at outside centre",
          "body": "New head coach Les Kiss has clarified his immediate plans for Joseph-Aukuso Suaalii, confirming the cross-code convert will continue to feature in the midfield. Despite Suaalii’s success at full-back for the Waratahs during the 2025 season, Kiss intends to persist with him at 13. “I will be persisting at 13 with him at this stage, but I know that he can go to full-back and wing, and that’s important to acknowledge as well,” the coach said."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-07-26",
      "edition": "Sunday 26 July",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Les Kiss names 34-man Wallabies squad for Japan test series",
          "body": "New Wallabies head coach Les Kiss has confirmed his first squad for the upcoming two-test series against Japan, headlined by the inclusion of uncapped Reds centre Isaac Henry. The 34-man group will be without star centre Len Ikitau, who has been ruled out due to an ankle injury. Kiss stated that the squad was selected based on \"form, cohesion and how we want to play the game,\" adding that the focus is for the group to \"find a new level of consistency.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "465": {
      "date": "2026-07-26",
      "edition": "Sunday 26 July",
      "sections": [
        {
          "kicker": "Transfer News",
          "heading": "Ma’a Nonu Signs Short-Term Deal With The Sharks In Durban",
          "body": "All Blacks legend Ma’a Nonu is set for a South African chapter in his illustrious career after confirming a short-term move to the Sharks. The 44-year-old double World Cup winner joins the Durban franchise following his departure from RC Toulon. Nonu will take on a mentorship role, with the club looking for his experience to aid the development of young centres such as Jurenzo Julius and Ethan Hooker within the newly restructured High Performance System."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-07-26",
      "edition": "Sunday 26 July",
      "sections": [
        {
          "kicker": "Tactical Evolution",
          "heading": "Pieter-Steph du Toit exemplifies Springboks' shift away from fixed positional roles",
          "body": "South Africa have moved toward selecting players based on skill-set fusion rather than traditional positions, according to recent analysis. Pieter-Steph du Toit, who occupied three different roles across the July international window, serves as the primary example of this administrative approach to jersey numbers. By focusing on the specific demands of each match, Rassie Erasmus has successfully rotated his squad while maintaining consistent standards, with the Springboks claiming top honours in the Nations Championship after an unbeaten three-match run."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
}