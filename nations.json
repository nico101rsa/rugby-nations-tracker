  "digests": {
    "28": {
      "date": "2026-07-31",
      "edition": "Friday 31 July",
      "sections": [
        {
          "kicker": "Disciplinary blow",
          "heading": "Fiji scrum-half Kuruvoli handed four-week ban after citing in Scotland defeat",
          "body": "Fiji scrum-half Kuruvoli has been handed a four-week suspension for physical abuse during the Round 3 defeat to Scotland. The disciplinary ruling follows the 17-33 loss in Edinburgh, further thinning the Flying Fijians' options as they sit bottom of the Nations Championship log. With three losses from three and a points difference of -96, the side must now manage the absence of a primary playmaker. No other players were cited following the match as the squad looks toward the November window."
        }
      ]
    },
    "386": {
      "date": "2026-07-31",
      "edition": "Friday 31 July",
      "sections": [
        {
          "kicker": "SQUAD MANAGEMENT",
          "heading": "George Kruis praises Steve Borthwick for resting Maro Itoje this summer",
          "body": "Former England lock George Kruis has supported Steve Borthwick’s decision to excuse Maro Itoje from the Southern Hemisphere leg of the Nations Championship. Following England’s 31-24 victory over Argentina, Kruis highlighted the heavy mental and physical burden on the captain, who has balanced leadership duties with personal bereavement. Kruis, who recently completed a world-record sevens match for charity, insisted the rest is vital for the lock's longevity. \"You can’t keep going to the well,\" Kruis said, applauding the decision to prioritise player well-being ahead of next year’s World Cup."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-07-31",
      "edition": "Friday 31 July",
      "sections": [
        {
          "kicker": "SCORING TRENDS",
          "heading": "France maintain high scoring average across 11 matches following Japan victory",
          "body": "France have averaged 38.7 points per game across their last 11 matches. During this window, the national side recorded 426 points while shipping 291 in return. The side secured their biggest win of the period by beating Wales 54-12 in February 2026. This equates to a defensive average of 26.5 points conceded per fixture across the same timeframe."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-07-31",
      "edition": "Friday 31 July",
      "sections": [
        {
          "kicker": "SCHMIDT RETURNS",
          "heading": "Joe Schmidt joins Ulster as coaching consultant after leaving Wallabies post",
          "body": "Former Ireland head coach Joe Schmidt has made a surprise return to the Irish system, joining Ulster on a 12-month consultancy basis. Following his departure from the Wallabies, the New Zealander will provide mentorship and strategic support across the province's coaching pathway. Ulster head coach Richie Murphy, who worked with Schmidt during his tenure in Dublin, welcomed the appointment. Murphy noted: \"We're delighted to have someone of Joe's calibre involved with Ulster Rugby,\" as the province looks to prioritise long-term coaching development."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-07-31",
      "edition": "Friday 31 July",
      "sections": [
        {
          "kicker": "Club investment",
          "heading": "Gloucester CEO Alex Brown confirms ongoing investment talks amid Premiership targets",
          "body": "Alex Brown confirmed that negotiations for new external investment remain ongoing as the club seeks to solidify its financial outlook. The Gloucester CEO addressed \"on-field frustration\" following recent results but maintained that the search for a strategic partner is progressing. While no deal has been finalised, the outcome is considered vital for the club to achieve its stated Premiership targets. These talks must conclude before the club can provide certainty regarding its long-term professional setup and future squad development."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-07-31",
      "edition": "Friday 31 July",
      "sections": [
        {
          "kicker": "Murrayfield sacking",
          "heading": "John McGuigan sacks Scottish Rugby chief executive Alex Williamson after conduct inquiry",
          "body": "Scottish Rugby has dismissed chief executive Alex Williamson with immediate effect following an independent investigation into his conduct. Chairman John McGuigan confirmed the board’s decision, stating Williamson’s behaviour had fallen “significantly below the standards we set as an organisation.” Williamson had been on extended leave since May, having only started the role in early 2025 following Mark Dodson’s exit. Chief financial officer David White is set to become interim chief executive while the union searches for its third permanent leader in two years."
        }
      ],
      "match": {
        "venue": "Murrayfield, Edinburgh"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-07-31",
      "edition": "Friday 31 July",
      "sections": [
        {
          "kicker": "WESTERN LICENCE",
          "heading": "The WRU confirms Ospreys and Scarlets will fight for one licence",
          "body": "The Welsh Rugby Union has intensified the battle for survival by confirming only one professional licence will be granted to west Wales from the 2028-29 season. While Cardiff and the Dragons have effectively secured their futures as the capital and eastern representatives, the Ospreys and Scarlets must now compete for the remaining slot or consider a merger. Professional Rugby Board chair Marianne Okland admitted there will be \"ongoing uncertainty\" until the final western decision is reached before the end of the upcoming campaign."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "460": {
      "date": "2026-07-31",
      "edition": "Friday 31 July",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Felipe Contepomi drafts 10 rookies as Argentina reshapes squad for Tests",
          "body": "Felipe Contepomi has overhauled his 34-man squad, naming 10 uncapped players to face South Africa and Australia. The selection follows disciplinary fallout from the recent loss to England, which left key figures such as captain Julián Montoya and fly-half Tomás Albornoz unavailable for the upcoming series due to bans. Contepomi emphasised the necessity of broadening the squad while prioritising physical and mental health. “The goal is to have excellent preparation and be ready for these matches,” the head coach stated."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-07-31",
      "edition": "Friday 31 July",
      "sections": [
        {
          "kicker": "Coaching move",
          "heading": "Joe Schmidt accepts new coach development role with Irish club Ulster",
          "body": "Former Wallabies boss Joe Schmidt has returned to Ireland, signing a 12-month consultancy deal as coach development adviser for Ulster. The newly created position focuses on strengthening the coaching pathway across the province, spanning schools, clubs and the academy, rather than the senior professional team. Schmidt, who concluded his tenure with Australia after the recent victory against Italy, will work with staff both in-person and remotely. He remains slated to assist Australia A during their two-match tour of the USA in October."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-07-31",
      "edition": "Friday 31 July",
      "sections": [
        {
          "kicker": "League controversy",
          "heading": "Japan Rugby League One faces legal action over new eligibility rules",
          "body": "Japan’s professional rugby landscape is facing significant upheaval after 24 players launched legal action against Japan Rugby League One. The dispute centres on new eligibility rules that critics argue discriminate against foreign-born players, including those who have obtained Japanese citizenship and represented the national team internationally. With the pathway for overseas talent now under scrutiny, the implications for the future development and selection of the Brave Blossoms remain a point of serious concern across the game."
        }
      ]
    },
    "465": {
      "date": "2026-07-31",
      "edition": "Friday 31 July",
      "sections": [
        {
          "kicker": "Coaching strategy",
          "heading": "Kieran Read urges Dave Rennie to match Springboks' proven formula",
          "body": "Former captain Kieran Read has suggested that Dave Rennie must ensure the All Blacks bench provides significant impact to compete with the South African approach. Read noted that while New Zealand has traditionally favoured a 5-3 split, the team needs to match the influence of the Springboks' replacements. He specifically highlighted Anton Segner and Asafo Aumua as players who could provide the necessary energy to challenge the Springboks throughout the final stages of the upcoming test matches."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-07-31",
      "edition": "Friday 31 July",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Rassie Erasmus to rotate Springboks squad for final Argentina test match",
          "body": "Rassie Erasmus is set to shuffle his side for the upcoming test in Buenos Aires, using the final outing before the Rugby's Greatest Rivalry series to manage player workloads. The head coach admitted it is “not ideal” to require a test match for fitness conditioning, yet remains eager to field players returning from injury. Midfielder Ethan Hooker and playmaker Sacha Feinberg-Mngomezulu are among those in contention for minutes as the Boks aim to finalise their combinations ahead of the All Blacks."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
