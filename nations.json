      }
    },
    "387": {
      "date": "2026-11-26",
      "edition": "Thursday 26 November",
      "sections": [
        {
          "kicker": "Selection boost",
          "heading": "Thomas Ramos and Jean-Baptiste Gros expected back for Springboks final at Twickenham",
          "body": "Rugbyrama reports that Ramos, finally clear of the thigh injury that kept him out of France's first three November Tests, should start at full-back in Sunday's Nations Championship final at Twickenham. His return eases a back-three reshuffle forced by Aaron Grandidier-Nkanang's ankle injury against Argentina, with Théo Attissogbe moving back to the wing. Kalvin Gourgues is expected to hand the goal-kicking to his Toulouse teammate. Fit-again Gros should reclaim the No. 1 jersey, which is timely after France conceded nine scrum penalties to the Boks in Paris."
        },
        {
          "kicker": "Around the world",
          "heading": "Ireland's Dan Sheehan handed two-game suspension",
          "body": "Italy lose Domingo Miotti to thigh injury."
        }
      ],
      "match": {
        "venue": "Twickenham, London"
      },
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "388": {
      "date": "2026-11-26",
      "edition": "Thursday 26 November",
      "sections": [
        {
          "kicker": "Captaincy call",
          "heading": "Beirne leads Ireland against Australia in Nations Championship fifth-place final",
          "body": "Beirne takes the armband for the fifth-place final against Australia at Twickenham. Dan Sheehan, sent off late in the 20-17 win over South Africa, has picked up a two-game suspension. For Australia, Alaalatoa reaches his 100th Test, and Beale's five-year Wallaby exile is set to end. Ireland already have the better of these Wallabies this year. They won 33-31 in July's Southern Series opener, then went three from three in the autumn against Argentina, Fiji and the Springboks."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa's Pieter-Steph du Toit ruled out of France final",
          "body": "Italy lose Domingo Miotti to thigh injury."
        }
      ],
      "match": {
        "venue": "Allianz Stadium, Twickenham"
      }
    },
    "389": {
      "date": "2026-11-26",
      "edition": "Thursday 26 November",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Italy lose Domingo Miotti and Simone Ferrari to injury before Fiji rematch",
          "body": "Domingo Miotti went off after 48 minutes of the 16-21 defeat to Fiji in Udine with an injury to the flexor muscles of his left thigh, according to the Italy medical bulletin. Simone Ferrari, named in the matchday squad, withdrew an hour before kick-off with a left upper-limb injury and was replaced by Marco Riccioni. Both were to undergo scans in camp before returning to Montpellier and Treviso respectively to rehabilitate alongside national-team staff. Paolo Garbisi returns at fly-half for Friday's 11th-place final at Twickenham."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa's Pieter-Steph du Toit ruled out of France final",
          "body": "Ireland's Dan Sheehan handed two-game suspension."
        }
