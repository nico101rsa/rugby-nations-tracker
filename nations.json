      }
    },
    "390": {
      "date": "2026-11-19",
      "edition": "Thursday 19 November",
      "sections": [
        {
          "kicker": "Injury quartet",
          "heading": "Scotland lose Tuipulotu, White, Dempsey and Cummings to injury before Japan test",
          "body": "Captain Sione Tuipulotu, a late withdrawal from Sunday's 15-12 win over Australia with a knee injury, returns to his club with three men hurt in that game: Toulon scrum-half Ben White (knee), number eight Jack Dempsey (foot) and Glasgow lock Scott Cummings (leg). Head coach Gregor Townsend has called up Edinburgh forwards Grant Gilchrist and Magnus Bradbury plus Leicester lock Cam Henderson. Uncapped Glasgow back Josh McKay qualifies on residency this week and could debut against Japan at Murrayfield."
        },
        {
          "kicker": "Around the world",
          "heading": "Springboks coach Rassie Erasmus banned for six matches",
          "body": "Ireland's Sam Prendergast cleared of hip-drop citation before Springboks test. Argentina casualty list grows as Gallo, Kremer, Grondona hurt."
        }
      ],
      "match": {
        "venue": "Murrayfield, Edinburgh"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-11-19",
      "edition": "Thursday 19 November",
      "sections": [
        {
          "kicker": "Half-time talk",
          "heading": "Steve Tandy credits Dewi Lake's half-time words for Wales' second-half blitz",
          "body": "Wales head coach Steve Tandy says he still feels emotional and proud after last Saturday's 35-28 win over New Zealand. The All Blacks scored with the last move of the first half after a Wales attack, yet Tandy said nobody in the changing room felt it had to be the turning point: Dewi Lake's words were electrifying, and two tries followed in the first nine minutes after the restart. He also hailed the defence under coaches Dan Lydiate and Peter Murchie ahead of another very tough test against Australia this weekend."
        },
        {
          "kicker": "Around the world",
          "heading": "Springboks coach Rassie Erasmus banned for six matches",
          "body": "Ireland's Sam Prendergast cleared of hip-drop citation before Springboks test. Scotland captain Tuipulotu out with knee injury, White also hurt. Argentina casualty list grows as Gallo, Kremer, Grondona hurt."
