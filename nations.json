    "463": {
      "date": "2026-11-19",
      "edition": "Thursday 19 November",
      "sections": [
        {
          "kicker": "Red card fallout",
          "heading": "Eddie Jones shoulders blame after Hockings' first-minute red card at Twickenham",
          "body": "Japan lock Hockings was shown yellow for a dangerous tackle in the passage of play that produced England's opening try in the first minute. The card was later upgraded to red. Japan then conceded five tries in roughly 20 minutes on the way to a 15-78 defeat to England, 13 tries in all. Head coach Eddie Jones said in his post-match interview that he takes full responsibility for the result. Writing in the Guardian, Gerard Meagher noted that Japan were a man down before they had touched the ball."
        },
        {
          "kicker": "Around the world",
          "heading": "Wales beat All Blacks 35-28",
          "body": "Scotland beat Australia 15-12 in Nations Championship. England name Furbank, Chessum, Atkinson for All Blacks test."
        }
