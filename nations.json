  "digests": {
    "28": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Ranking peak",
          "heading": "Fiji slide to bottom of the table after three consecutive defeats",
          "body": "Fiji currently sit bottom of the 12-team standings after failing to secure a victory in their opening three fixtures of the tournament. The team have suffered three consecutive defeats during this run, culminating in a 17-33 loss against Scotland in the third round. Across those three matches, the squad scored 49 points. They also conceded 145 points during this period. This difficult spell is a sharp contrast to their historical peak in 2023, when they reached their highest world ranking of No. 7."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "French exodus",
          "heading": "Beno Obano puts England career on hold by agreeing Pau transfer",
          "body": "Bath loosehead prop Beno Obano will put his international career on hold after agreeing a move to French Top 14 side Pau at the end of the upcoming season. The 31-year-old, who won his fifth cap off the bench against South Africa in July, will become ineligible for national selection under the Rugby Football Union’s domestic-only policy. While Obano is unlikely to be immediately ruled out by Steve Borthwick this term, his departure will eventually add him to a growing list of exiled English talent playing across the Channel."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Nations Championship",
          "heading": "France receive no fresh tournament updates as global championship debate remains open",
          "body": "There is no coverage in today's press regarding the future of the World Rugby Nations Championship format, leaving the debate between the hemispheres unresolved. France, currently third in the table with two wins from three matches, remain without official updates on how the tournament structure might evolve. This storyline stays open until official feedback is provided on the inaugural competition, meaning supporters must wait for clarity on the long-term calendar."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "388": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Transfer stance",
          "heading": "George Skivington insists Ross Byrne remains at Gloucester despite Munster links",
          "body": "Gloucester head coach George Skivington has shut down speculation linking Ross Byrne with a move to Munster as emergency fly-half cover. The southern province are searching for options after Ireland playmaker Jack Crowley was ruled out until the new year with a vascular injury. Despite Byrne slipping down the pecking order behind Charlie Atkinson at Kingsholm last season, Skivington insists the 31-year-old remains central to his plans, stating that a backup position is 'not what we brought him in for.'"
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Touchline ban",
          "heading": "Prop Marco Riccioni receives two-match ban for touchline scrap against Australia",
          "body": "Italian prop Marco Riccioni has been handed a two-match suspension following his unusual red card from the dugout during the heavy 57-10 Nations Championship defeat against Australia. Although not in the match-day squad, the track-suited Perpignan front-rower ran into a second-half touchline scrap and appeared to throw a punch. SANZAAR's foul play review committee reduced the initial four-week ban to two after Riccioni admitted the offence. He will now miss upcoming club fixtures against Biarritz and Bath."
        }
      ],
      "match": {
        "venue": "Turin"
      }
    },
    "390": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Tournament format",
          "heading": "Scotland await final verdict on future Nations Championship format changes",
          "body": "The debate surrounding the future of the World Rugby Nations Championship format remains unresolved, with no new updates or official feedback in today's coverage. The tournament's structure has been under discussion since the competition was introduced, but the thread stays open until organisers deliver their final review. Scotland, currently fifth in the standings, await clarity on how future editions will look. For now, Gregor Townsend's squad must focus on the current format, which features a complex finals weekend."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Tournament format",
          "heading": "Steve Tandy faces static outlook as Nations Championship format debates stall",
          "body": "There is no fresh development in today's press regarding the future format of the World Rugby Nations Championship. The debate remains at a standstill following the tournament's inaugural run, with no new proposals or official feedback published this week. For Wales, currently sitting ninth in the table after a heavy 43-0 defeat to South Africa, the focus remains entirely on on-field improvement under Steve Tandy ahead of their next test against Japan."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Home defence",
          "heading": "Los Pumas fight to prevent historic Australian series sweep in Mendoza",
          "body": "Los Pumas must rebound in Mendoza to defend a proud home record and prevent a historic Australian series sweep. Following a 27-21 defeat in San Salvador de Jujuy, Argentina face a revamped Wallabies side featuring nine changes in the second Test. History is on the hosts' side at Estadio Malvinas Argentinas; the Wallabies have never managed a two-Test clean sweep on Argentine soil, with Los Pumas famously bouncing back to split previous series in both 2022 and 2024."
        }
      ],
      "match": {
        "venue": "Estadio Malvinas Argentinas, Mendoza"
      }
    },
    "461": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Les Kiss hands Ben Donaldson a rare Test start against Argentina",
          "body": "Wallabies head coach Les Kiss has handed Ben Donaldson his first start at fly-half in two years for Saturday's second Test against Argentina in Mendoza. Donaldson replaces Carter Gordon, who drops to the bench despite recovering from a facial injury. With Tom Wright earning his 50th cap and Joseph-Aukuso Suaalii returning to the midfield, Kiss is keen to test his depth. \"From the outset, we wanted to make sure we saw the 10s, all of them, in some form,\" Kiss said."
        }
      ],
      "match": {
        "venue": "Estadio Malvinas Argentinas, Mendoza"
      },
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Eddie Jones hands Inoke Burua debut for Japan’s clash against Canada",
          "body": "Head coach Eddie Jones has handed Inoke Burua a debut on the wing as Japan look to end a four-match losing streak against Canada in Niigata. Marking the JRFU’s centenary, the Brave Blossoms make five changes from their defeat to Australia. Most notable is the absence of captain Warner Dearns, with Jack Cornelsen and Harry Hockings starting at lock instead. Kanji Shimokawa returns to the back row, while Naoto Saito and Ryunosuke Ito resume their halfback partnership."
        }
      ],
      "match": {
        "venue": "Denka Big Swan Stadium, Niigata City"
      },
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "SELECTION BOMBSHELL",
          "heading": "Dave Rennie snubs Rieko Ioane as Peter Lakai starts Johannesburg test",
          "body": "Dave Rennie has opted for a high-tempo approach for Saturday’s third test against South Africa, handing Peter Lakai a starting role while Rieko Ioane is omitted. The All Blacks will reclaim the No. 1 world ranking with any victory at FNB Stadium, having scored nine tries in the series so far. Springboks assistant Mzwandile Stick expects an all-out assault, noting the New Zealanders “don’t play hide and seek” with their expansive DNA, despite Nick Mallett’s public complaints regarding tactical collapsing at the scrum."
        }
      ],
      "match": {
        "venue": "FNB Stadium, Johannesburg"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-09-05",
      "edition": "Saturday 5 September",
      "sections": [
        {
          "kicker": "Rule proposal",
          "heading": "Jean de Villiers proposes rule change to block Rassie Erasmus’s selection gamesmanship",
          "body": "Former captain Jean de Villiers has urged World Rugby to adopt football-style team announcements following Rassie Erasmus’s recent selection \"gamesmanship\". The Springboks head coach made five changes shortly before the 33-26 win in Cape Town, including swapping his entire starting front row an hour before kick-off. While South Africa sit top of the log, assistant Mzwandile Stick maintains the side will treat today's third Test in Soweto like a \"World Cup knockout campaign\", with Cheslin Kolbe shifting to full-back to cover for the injured Damian Willemse."
        }
      ],
      "match": {
        "venue": "FNB Stadium, Johannesburg"
      },
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
