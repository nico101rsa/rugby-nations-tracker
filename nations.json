  "digests": {
    "28": {
      "date": "2026-11-23",
      "edition": "Monday 23 November",
      "sections": [
        {
          "kicker": "Discipline collapse",
          "heading": "Fiji Latui reduced to 12 men in 62-12 defeat to Ireland XV",
          "body": "Fiji Latui, the Fijian development side, picked up four first-half yellow cards in Friday's 62-12 defeat to the Ireland XV at Virgin Media Park. Three came in five minutes and left them with 12 men for a spell. Isaia Lotawa's no-arms tackle conceded a penalty try, and Apisalome Kuruisaqila was binned for a deliberate knock-on. Mesake Doge, carded for a high tackle, received a 20-minute red for collapsing a third successive scrum 30 seconds after returning. Pita Lesivoukionoilau's seventh-minute interception try had given Fiji their only lead."
        },
        {
          "kicker": "Around the world",
          "heading": "Ireland beat South Africa, who still reach Nations Championship final",
          "body": "Wallabies beat Wales 29-26 to end losing streak. Mayco Vivas sent off as France beat Argentina 45-17. Scotland's Matt Fagerson injured, extent unknown."
        }
      ],
      "source": {
        "name": "RTÉ Sport Rugby"
      }
    },
    "386": {
      "date": "2026-11-23",
      "edition": "Monday 23 November",
      "sections": [
        {
          "kicker": "Freeman fitness",
          "heading": "Borthwick hopeful over Tommy Freeman's quad niggle after 37-12 All Blacks win",
          "body": "Tommy Freeman pulled out of the starting XV hours before Saturday's 37-12 win over New Zealand with a quad niggle and has no firm return date. Steve Borthwick said: “Maybe there’s a chance for next week, but it’s probably too early to say that right now.” Cadan Murley started in his place. Fin Smith, replaced after 55 minutes, had cramp in both legs, and Borthwick expects a quick recovery. Fans in the app took the result well: 39 answered, and 97% were buzzing."
        },
        {
          "kicker": "Around the world",
          "heading": "Ireland beat South Africa, who still reach Nations Championship final",
          "body": "Wallabies beat Wales 29-26 to end losing streak. Mayco Vivas sent off as France beat Argentina 45-17. Scotland's Matt Fagerson injured, extent unknown."
        }
      ],
      "match": {
        "venue": "Allianz Stadium, Twickenham"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-11-23",
      "edition": "Monday 23 November",
      "sections": [
        {
          "kicker": "Squad for the final",
          "heading": "Fabien Galthié recalls Thomas Ramos to France's 42 for Springboks final",
          "body": "Ramos is back after several weeks sidelined by a thigh injury, and Rugbyrama reckons his return would push Théo Attissogbe to the wing for the Twickenham final against South Africa. Grégory Alldritt misses out with a physical complaint, replaced by La Rochelle clubmate Oscar Jegou. Aaron Grandidier-Nkanang, hurt in the 45-17 win over Argentina, is absent with an ankle problem. Jean-Baptiste Gros, a late withdrawal against the Pumas, stays in the group, and the staff hope he can make the final."
        },
        {
          "kicker": "Around the world",
          "heading": "Ireland beat South Africa, who still reach Nations Championship final",
          "body": "Wallabies beat Wales 29-26 to end losing streak. Scotland's Matt Fagerson injured, extent unknown."
