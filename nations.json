  "digests": {
    "28": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Team statistics",
          "heading": "Fiji score 315 points and concede 326 over last 11 games",
          "body": "Across their last 11 games, Fiji scored a total of 315 points. During this same 11-game window, the team conceded 326 points to their opponents. These totals represent an average of 28.6 points scored per match, alongside an average of 29.6 points conceded per fixture in that same period. The most dominant performance in this sequence was their biggest win, where they beat Canada 63-10 at home in September 2025 during the Pacific Nations Cup knockout stage."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Injury update",
          "heading": "Steve Borthwick faces scrum-half headache as Ben Spencer undergoes shoulder surgery",
          "body": "England head coach Steve Borthwick faces a selection dilemma after Bath confirmed scrum-half Ben Spencer underwent shoulder surgery to correct a long-standing issue. The 34-year-old, who featured in the summer tour, will miss the opening weeks of the domestic season. Although expected to return later this autumn, Spencer is in a race against time to be fit for November's Tests. Borthwick will likely lean on Alex Mitchell and Jack van Poortvliet, though the former has recently battled hamstring issues, potentially opening the door for Archie McParland or Raffi Quirke."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "TRANSFER NEWS",
          "heading": "France back-rower François Cros set for three-year Lyon move from Toulouse",
          "body": "François Cros is reportedly departing Toulouse to join Top 14 rivals Lyon. According to Midi Olympique, the France back-rower has agreed a three-year contract, ending a career-long association with Les Rouge et Noir. Montpellier had also shown interest in the Test veteran, but Lyon reportedly won the race for his signature. The move comes as Fabien Galthié's squad sits third in the Nations Championship standings following their 42-15 victory over Japan."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Injury update",
          "heading": "Jack Crowley ruled out until new year following ongoing injury setback",
          "body": "Ireland and Munster fly-half Jack Crowley is not expected to return to action until the new year. Sidelined since April with a lower limb vascular injury, the 26-year-old will miss the upcoming November block of games against Argentina, Fiji, and South Africa. Munster head coach Clayton McMillan stated: \"Jack Crowley is a very important player for Munster and Ireland with a big future in the game and ensuring he gets back to 100% is the priority.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Coaching suspension",
          "heading": "Gonzalo Quesada faces stadium ban for upcoming clash against South Africa",
          "body": "Head coach Gonzalo Quesada has become the first person sanctioned under World Rugby's new Match Official Abuse Sanctioning Process. The governing body handed him a two-Test ban following his public criticism of referee Luc Ramos after the July defeat to New Zealand. This suspension prohibits Quesada from all match-day proceedings, including stadium presence, for the upcoming match against South Africa. While he retains the right to appeal the decision, his absence marks a significant challenge for the squad's technical preparations."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Legal update",
          "heading": "High Court ruling keeps concussion legal battle against rugby bodies active",
          "body": "The long-running concussion legal battle remains unresolved as the High Court continues to deliberate on the mass action brought by hundreds of players. Recent reports indicate the case remains in the balance following a high-level ruling that allowed proceedings to continue rather than being dismissed. The litigation, which seeks accountability from rugby governing bodies for alleged failures to manage brain injury risks, stays active as both sides await further judicial progression. There is no confirmed date for a final resolution."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Governance crisis",
          "heading": "WRU faces sustained pressure as calls for board resignation intensify",
          "body": "The governing body remains under intense scrutiny this week as the debate over the future of Wales' professional regions continues to polarise opinion. Despite the WRU doubling down on its contentious three-team plan, calls for a board overhaul have grown louder, with figures like Jonathan Davies publicly demanding leadership change. With fans and stakeholders divided, the union is struggling to manage the narrative surrounding these cuts, as the search for a sustainable, long-term revenue strategy for the professional setup remains unresolved."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Match result",
          "heading": "Argentina fall to defeat as Australia secure narrow victory in Jujuy",
          "body": "Los Pumas suffered a 21-27 defeat against Australia in San Salvador de Jujuy on Saturday. Despite crossing for tries through Prisciantelli and Moro, Argentina could not contain the Wallabies' momentum during a messy encounter. The result marks a difficult outcome for the hosts, as Australia extended their winning streak to 4 matches. The Pumas struggled to capitalise on their opportunities in the second half, ultimately failing to overcome the visitors’ disciplined defensive effort in front of a home crowd."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "461": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Selection news",
          "heading": "Allan Alaalatoa named captain as Les Kiss rotates Wallabies forward pack",
          "body": "Coach Les Kiss has overhauled his forward pack for the upcoming Argentina Test, naming Allan Alaalatoa as captain in the absence of Harry Wilson, who is rested. Isaac Kailea earns a start in the front row, while Rob Valetini moves to No 8. Kiss emphasised the need to manage a long season while testing squad depth, noting that while the changes may appear unconventional, they are \"making sense internally\" as the team continues its preparations for next year’s World Cup."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Selection news",
          "heading": "Japan League One revises registration rules after settling player legal challenge",
          "body": "Japan Rugby League One has updated its player eligibility framework following a settlement at the Tokyo District Court. The revised system includes \"special measures\" for registration, allowing players with 30 or more caps for the Brave Blossoms to be reclassified from the restricted Category A-2 to A-1. The league admitted that previous explanations regarding the 2026-2027 season changes were insufficient. These adjustments affect numerous international regulars who had challenged the proposed limits on foreign-born players via legal action."
        }
      ],
      "match": {
        "venue": "Denka Big Swan Stadium, Niigata City"
      },
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Series level",
          "heading": "New Zealand falls to South Africa as Springboks level series 1-1",
          "body": "The All Blacks saw their winning momentum halted in Cape Town, falling 33-26 to a clinical South African side. Despite a spirited second-half revival that included four tries—capped by Ardie Savea’s late effort—New Zealand could not bridge the gap established by the world champions. Rassie Erasmus’s squad dominated the early exchanges, forcing the visitors into a desperate scramble. With the series now locked at 1-1, the focus shifts to the deciding encounters as both nations prepare for next Saturday’s showdown."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "467": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Series levelled",
          "heading": "Siya Kolisi and Springboks defeat All Blacks to level series 1-1",
          "body": "South Africa kept their series hopes alive after a clinical 33-26 victory in Cape Town. Rassie Erasmus’s side relied on a powerful opening to secure their first win against New Zealand in the current series. Cheslin Kolbe starred with 18 points, while late tactical replacements, including Cameron Hanekom, proved decisive in halting a spirited All Black comeback. \"Don't come with that nonsense saying we're walking around,\" Erasmus remarked, dismissing claims from the opposition regarding his team's scrum legality following the intense clash."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    }
  }
