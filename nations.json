    "388": {
      "date": "2026-10-23",
      "edition": "Friday 23 October",
      "sections": [
        {
          "kicker": "Women's WXV",
          "heading": "Neve Jones to win 50th cap as Ireland women face South Africa",
          "body": "Ireland women's hooker Neve Jones will win her 50th cap on Saturday, the 17th Irish woman to reach the half-century, as head coach Scott Bemand makes just two changes for the first WXV Global Series Test against South Africa. Jones starts for the third game in a row, between props Linda Djougang and Eilís Cahill. Stacey Flood returns at full-back and Dorothy Wall comes back into the second row from the side that beat Japan 43-19 in Cork."
        },
        {
          "kicker": "Around the world",
          "heading": "France recall Gregory Alldritt for November Nations Championship matches",
