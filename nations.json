  "digests": {
    "28": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Cup final",
          "heading": "Fiji defeat Canada to secure Pacific Nations Cup final spot against Japan",
          "body": "Defending champions Fiji have advanced to the Pacific Nations Cup final after defeating Canada. This victory sets up a title-deciding clash against Japan, keeping the Flying Fijians on track to retain their regional crown. The result provides a timely boost for the squad as they build momentum towards their upcoming northern hemisphere fixtures, with the final against the Brave Blossoms now representing their immediate focus."
        }
      ]
    },
    "386": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "COACHING SCRUTINY",
          "heading": "Ben Youngs accuses Bill Sweeney of having 'blinkers on' over Steve Borthwick",
          "body": "Former England scrum-half Ben Youngs has criticised RFU chief executive Bill Sweeney and performance director Conor O’Shea for their continued support of Steve Borthwick. Despite what O’Shea described as a \"horrendous\" Six Nations campaign, Borthwick has been handed a contract extension through to the 2028 championship. Youngs claimed the governing body has \"blinkers on\" regarding the head coach’s 59.6% win rate. While Borthwick guided England to two wins from three during the summer, Youngs warned that the executive duo remain \"accountable\" if form dips before next year’s World Cup."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Fixture History",
          "heading": "France prepares for Fiji return following previous home victory success",
          "body": "As France builds towards their next encounter against Fiji, the squad can draw confidence from their recent history against the tourists. In their last meeting, France secured a 34-21 victory on home soil in November 2025. Les Bleus currently hold a strong position in the tournament log, having secured 2 wins from their opening 3 matches to sit 3rd in the standings with a points difference of +41 following their recent 42-15 success over Japan."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Six Nations",
          "heading": "IRFU Dismisses Plans to Host Six Nations Fixtures in United States",
          "body": "The Irish Rugby Football Union has ruled out moving any Six Nations matches to the United States. Following comments from World Rugby chief executive Alan Gilpin, who suggested that fixtures involving Ireland could resonate with American-based expatriate fans, the IRFU released a statement on Friday. The union confirmed there are \"currently no plans or discussions\" regarding such a move, reiterating that maintaining home matches in Ireland remains a central component of the competition’s appeal for their supporters."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Team statistics",
          "heading": "Italy currently 11th in tournament standings after three opening matches",
          "body": "Italy occupies 11th place in the current tournament standings after their opening three matches. The side has registered three defeats, recording a total of 37 points scored and 131 points conceded. This results in a current points difference of -94. Historically, the Azzurri reached their best world ranking of No. 8 on two previous occasions, first in 2007 and subsequently in 2024."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Selection news",
          "heading": "Rhea Clarke and Evie Gallagher return for Scotland’s Canada WXV opener",
          "body": "Scrum-half Rhea Clarke makes her first start for Scotland as the team opens their WXV Series campaign against Canada in Edinburgh. Interim head coach Dave Butcher has also recalled flanker Evie Gallagher, who joins captain Rachel Malcolm in the back row for her first appearance since last year’s World Cup. Despite the sudden departure of former head coach Sione Fukofuka, fly-half Helen Nelson insists the squad’s transition has been \"seamless\" as they look to improve upon last year’s World Cup performance."
        }
      ],
      "match": {
        "venue": "Hive Stadium, Edinburgh"
      },
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Injury update",
          "heading": "Ben Carter cleared to resume competitive rugby with the Dragons",
          "body": "Wales lock Ben Carter is fully recovered from the ankle injury that ruled him out of the mid-July defeat to South Africa. Having avoided surgery, the 25-year-old is now fit and training ahead of his club’s United Rugby Championship opener. Dragons defence coach Dale MacLeod noted that Carter is in excellent condition, stating: \"It's not an issue now. He is going really well and is probably in the best nick that I have seen him.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Team History",
          "heading": "Argentina Reflects On Past Rankings Milestone In Nations Championship Campaign",
          "body": "As the current campaign progresses, Argentina continues to build upon a long-standing tradition in international rugby. The side achieved their best world ranking of No. 3 during the 2007–08 period, a mark that remains the highest in their history. Currently sitting at 8 of 12 in the log after three matches, the team maintains a points difference of -2, having scored 97 points while conceding 99 across their opening fixtures."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Coaching transition",
          "heading": "Wallabies legend James Slipper pauses career for new Brumbies coaching role",
          "body": "Veteran front-rower James Slipper has been appointed as the Brumbies’ scrum coach on a temporary basis, marking a shift in his professional focus. The 154-Test veteran, who remains under contract with the club for another season, will step away from on-field duties during Super Rugby AUS to join Stephen Larkham’s coaching staff. Slipper aims to share lessons from his extensive career with the squad’s emerging forwards, filling the vacancy left by John Ulugia’s recent move to the national set-up."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Eligibility Dispute",
          "heading": "Naturalised Players Urge Fairness Over New Japan League One Criteria",
          "body": "The implementation of Japan Rugby League One’s new player eligibility categories remains a point of contention as the 2026-2027 season approaches. Recent reporting highlights that naturalised players have been actively urging the league to ensure fairness in how the updated nationality criteria are applied. While the league has formalised these new definitions, the dispute continues to centre on the balance between domestic development and the status of established foreign-born athletes, with further clarity expected before the competition season begins."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      },
      "rung": "storyline"
    },
    "465": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Dave Rennie names Richie Mo’unga to lead bolder All Blacks attack",
          "body": "Coach Dave Rennie has reshuffled the All Blacks lineup for the final Test in Baltimore, headlined by the return of Richie Mo’unga at fly-half. Seeking to level the series 2-2, New Zealand are expected to adopt a more expansive, high-tempo approach. Springbok assistant coach Mzwandile Stick confirmed the tourists’ intent, noting: “They will be even more bold tomorrow when it comes to keeping the ball alive and trying to use the space in the wider channels.”"
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Series lead",
          "heading": "South Africa hold series advantage over New Zealand after third Test",
          "body": "South Africa take a 2-1 lead into the final match of the four-Test series against New Zealand. Following a 29-24 victory in the third Test, the Springboks have secured wins in the second and third encounters. Rassie Erasmus has confirmed changes to the starting line-up for the fourth Test in Baltimore, with Damian Willemse replacing the injured Cheslin Kolbe and Morne van den Berg coming in at scrum-half to face the All Blacks."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    }
  }
