      }
    },
    "386": {
      "date": "2026-11-19",
      "edition": "Thursday 19 November",
      "sections": [
        {
          "kicker": "Injury return",
          "heading": "Steve Borthwick welcomes back Furbank, Chessum and Atkinson before All Blacks test",
          "body": "Full-back George Furbank, vice-captain Ollie Chessum and inside centre Seb Atkinson all missed the 78-15 win over Japan — Furbank and Atkinson with groin problems, Chessum with a shoulder injury — but were named in last Sunday's 36-man squad for Saturday's test against New Zealand. That is a boost for England head coach Steve Borthwick. Furbank had shone against Australia in his first England appearance in two years. England tighthead Joe Heyes says the side now have a taste for beating the All Blacks after last year's 33-19 win."
        },
        {
          "kicker": "Around the world",
          "heading": "Wales beat All Blacks 35-28",
          "body": "Scotland beat Australia 15-12 in Nations Championship."
        }
      ],
      "match": {
