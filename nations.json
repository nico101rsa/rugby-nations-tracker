    "388": {
      "date": "2026-11-19",
      "edition": "Thursday 19 November",
      "sections": [
        {
          "kicker": "Ireland XV",
          "heading": "Gus McCarthy to captain Ireland XV against Fijian Latui in Cork",
          "body": "Leinster hooker Gus McCarthy and Ulster back-row David McCann have returned from senior camp to start for the Ireland XV against Fijian Latui at Cork's Virgin Media Park on Friday. McCarthy, one of eight Ireland-capped players in the squad, packs down between Alex Usanov and Kieran Brookes. Joey Carbery partners Leinster scrum-half Fintan Gunne at half-back, and capped trio Jeremy Loughman, Jack Aungier and Paul Boyle are named among the replacements."
        },
        {
          "kicker": "Around the world",
          "heading": "Wales beat All Blacks 35-28",
