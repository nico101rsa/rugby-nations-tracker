        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-10-29",
      "edition": "Thursday 29 October",
      "sections": [
        {
          "kicker": "Squad changes",
          "heading": "Galthié replaces Brau-Boirie, Gazzotti and Hastoy with Depoortere, Jelonch and Le Brun",
          "body": "Fabien Galthié has had to reshape his extended squad for the Nations Championship, with centre Fabien Brau-Boirie, No. 8 Marko Gazzotti and flyhalf Antoine Hastoy all sidelined after Top 14 injuries, the French federation announced on Monday. Nicolas Depoortere, Anthony Jelonch and the uncapped Louis Le Brun are called up in their place. France already lack Matthieu Jalibert, Thomas Ramos and Julien Marchand, and open against Fiji before facing the Springboks and Argentina."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa without Kolbe and Etzebeth through injury for Nations Championship",
          "body": "Italy have 17 players unavailable for Nations Championship. New Zealand's Jordie Barrett withdraws from Bledisloe Cup Test with calf."
        }
      ],
