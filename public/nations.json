  "digests": {
    "28": {
      "date": "2026-08-05",
      "edition": "Wednesday 5 August",
      "sections": [
        {
          "kicker": "TRANSFER NEWS",
          "heading": "Zuriel Togiatama joins Newcastle Red Bulls on a one-year Premiership deal",
          "body": "The Newcastle Red Bulls have secured the signing of Fiji hooker Zuriel Togiatama on a one-year deal from Super Rugby’s Fijian Drua. Head coach Dan McFarland highlighted the 27-year-old’s physicality and set-piece strength, describing him as a “highly competitive player” who will add depth to the pack. Togiatama moves north with 50 Super Rugby appearances, joining a Newcastle side looking for reinforcement as Fiji struggles to find form during a winless start to the Nations Championship."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "386": {
      "date": "2026-08-05",
      "edition": "Wednesday 5 August",
      "sections": [
        {
          "kicker": "CONTRACT TALKS",
          "heading": "Eddie Hearn demands seven-figure Northampton deal for England prospect Henry Pollock",
          "body": "The Matchroom promoter has challenged Northampton Saints to make England flanker Henry Pollock a seven-figure player, warning that his commercial value will soon skyrocket. The 21-year-old, who recently earned a £150,000 enhanced Elite Player Squad contract from the RFU, is entering the final year of his current club deal. Hearn claims Pollock's marketability is in \"another stratosphere\" compared to his peers, as reported interest from rival Premiership and Top 14 sides puts pressure on the Saints to secure their breakout international star."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-05",
      "edition": "Wednesday 5 August",
      "sections": [
        {
          "kicker": "Transfer rumour",
          "heading": "France star Thomas Ramos linked with sensational Toulouse exit for Racing 92",
          "body": "France full-back Thomas Ramos is reportedly considering a departure from Toulouse to join Top 14 rivals Racing 92 after the 2027 Rugby World Cup. According to reports in L’Equipe, the Parisians view the club stalwart as a marquee signing who could transition to fly-half on a permanent basis. Ramos has occasionally featured at No. 10 for Les Bleus but made just two starts there for Toulouse last season. A move would end a decade of dominance in the Pink City for the four-time league winner."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "388": {
      "date": "2026-08-05",
      "edition": "Wednesday 5 August",
      "sections": [
        {
          "kicker": "LEGAL CHALLENGE",
          "heading": "High Court judge deliberates on concussion case strikeout applications involving Ireland players",
          "body": "A definitive ruling on applications to strike out the vast majority of concussion claims against World Rugby is still pending. Following the conclusion of last week’s hearings, the case remains in a state of flux as the court considers whether 95% of the individual lawsuits can proceed. For the Irish players involved in the litigation, the forthcoming decision will determine if their quest for damages moves toward a full trial."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-08-05",
      "edition": "Wednesday 5 August",
      "sections": [
        {
          "kicker": "Transfer news",
          "heading": "Italy international Ion Neculai joins Gallagher Premiership champions Northampton Saints",
          "body": "Tighthead prop Ion Neculai has signed with Northampton Saints ahead of the 2026/27 season, departing Zebre Parma after five years. The 25-year-old, who earned his 4th Italy cap against Australia last month, arrives at Franklin's Gardens having made 51 appearances for his former club. Saints director of rugby Phil Dowson praised the forward's physicality and potential. Italy have previously reached a best-ever world ranking of No. 8, a benchmark achieved in both 2007 and 2024."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-05",
      "edition": "Wednesday 5 August",
      "sections": [
        {
          "kicker": "Coaching change",
          "heading": "Sione Fukofuka steps down as Scotland Women head coach amid stress",
          "body": "Scotland Women head coach Sione Fukofuka has resigned from his position, citing the personal strain of being separated from his family in Australia. Fukofuka, who was appointed late last year, requested a release from his contract on compassionate grounds. Forwards coach Dave Butcher has been appointed to lead the side on an interim basis as the team prepares for the upcoming WXV Global Series. He described the exit as \"the hardest professional decision of my life\" to ensure he prioritises his family."
        }
      ],
      "match": {
        "venue": "Hive Stadium, Edinburgh"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-08-05",
      "edition": "Wednesday 5 August",
      "sections": [
        {
          "kicker": "Talent pipeline",
          "heading": "Teenage hooker Tom Howe prioritises Cardiff debut over international Wales hype",
          "body": "Cardiff academy hooker Tom Howe is focusing on his senior club breakthrough rather than immediate international recognition. Despite receiving high praise from former Wales hooker Scott Baldwin, who noted the 18-year-old possesses an exceptionally high ceiling, Howe remains grounded following his Junior World Championship campaign. While reports indicate he is already under consideration by Steve Tandy for the coming 12 to 18 months, the youngster insists there is no rush as he prepares to challenge established professionals for selection this season."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-08-05",
      "edition": "Wednesday 5 August",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Springboks arrive in Buenos Aires ahead of looming Test match showdown",
          "body": "South Africa have touched down in Argentina as they begin final preparations for their upcoming clash at the Estadio José Amalfitani. Head coach Rassie Erasmus, who travelled with a 26-man squad including stalwarts Siya Kolisi and Eben Etzebeth, confirmed the team will focus on rest and acclimatisation before returning to the training field. Erasmus stated, \"It's great to be back in Buenos Aires, and we're looking forward to the challenge of facing the Pumas here once again.\""
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-08-05",
      "edition": "Wednesday 5 August",
      "sections": [
        {
          "kicker": "World Cup ambition",
          "heading": "Quade Cooper eyes Wallabies return for home 2027 World Cup campaign",
          "body": "Fly-half Quade Cooper has declared his interest in representing the Wallabies at the 2027 World Cup, despite having not played professionally since May 2025. The 38-year-old, currently coaching in Japan, admitted he never formally retired and remains keen on a comeback. While former teammates like Drew Mitchell have backed his capability, significant hurdles remain regarding his lack of a current playing contract and the limited spots available within Australia’s four Super Rugby franchises for the coming season."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-05",
      "edition": "Wednesday 5 August",
      "sections": [
        {
          "kicker": "Form guide",
          "heading": "Japan look to arrest two-game losing streak following recent defeats",
          "body": "Japan currently hold a record of 2 wins and 3 losses from their last 5 fixtures. The team enters the current break following back-to-back defeats. Most recently, the side succumbed to a 42-15 loss against France during the July Nations Championship group stage. Prior to this pair of setbacks, the team had secured consecutive victories in earlier international outings."
        }
      ],
      "rung": "data"
    },
    "465": {
      "date": "2026-08-05",
      "edition": "Wednesday 5 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Richie Mo'unga remains coy on potential All Blacks South Africa recall",
          "body": "Richie Mo'unga has remained tight-lipped regarding the possibility of joining the squad for the current South Africa tour following his successful return to provincial rugby. After scoring a match-winning try for Canterbury against Auckland on Saturday, the fly-half told The Press, \"I’m not too sure – you know just as much as me. [I will] ‘be where my feet are’ and whatever happens, happens.\" Head coach Dave Rennie has previously noted that the playmaker remains an option should an injury occur."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-05",
      "edition": "Wednesday 5 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Rassie Erasmus recalls Springbok stalwarts for final hitout against Argentina",
          "body": "Coach Rassie Erasmus has named a heavily rotated side for the upcoming fixture in Buenos Aires, welcoming back captain Siya Kolisi, Eben Etzebeth, Lood de Jager, Sacha Feinberg-Mngomezulu and Morné van den Berg. The team shows 13 changes from the XV that beat Wales, with only Aphelele Fassi and Cobus Reinach retained. “This match is the perfect occasion for players like Siya, Eben, Lood, Sacha, Morné and the other players returning from injury to get a tough Test under the belt,” Erasmus said."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
}