  "digests": {
    "28": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Statistical trends",
          "heading": "Fiji search for defensive consistency after shipping 145 points this season",
          "body": "Fiji have conceded an average of 29.6 points per game across their last 11 fixtures, contributing to their current position at the bottom of the Nations Championship log. While the defence has struggled, conceding 145 points in three rounds, the attack remains productive with a scoring average of 28.6 points per game in that same window. The most clinical performance in this period remains the 63-10 home victory over Canada in September 2025."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Selection doubt",
          "heading": "Ben Spencer faces race to be fit for England's November Tests",
          "body": "Bath scrum-half Ben Spencer faces a critical window to regain fitness ahead of the autumn campaign after undergoing surgery to address a long-standing shoulder injury. While his club confirmed he will miss the opening rounds of the Gallagher Premiership, his availability for England's Tests against Australia, Japan, and New Zealand remains uncertain. With Alex Mitchell and Jack van Poortvliet already established as the primary options, Steve Borthwick must now assess his depth chart to ensure sufficient cover at the base of the ruck."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Historical Context",
          "heading": "France look back to previous home victory over visiting Fiji",
          "body": "As the side builds towards the November international window, the most recent meeting between these two nations remains a positive point of reference. France successfully hosted Fiji in November 2025, securing a 34-21 victory in that encounter. While that result serves as the singular recent marker between the teams, the squad continues its preparation for the upcoming fixture as they maintain their current position in the Nations Championship table."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Jack Crowley ruled out for Ireland until the new year",
          "body": "Fly-half Jack Crowley will miss the remainder of the year after being sidelined by a lower limb vascular injury. The 26-year-old, who has earned 35 caps for his country, will be unavailable for Ireland’s upcoming autumn series against Argentina, Fiji, and South Africa. Munster head coach Clayton McMillan confirmed the news, stating that “ensuring he gets back to 100% is the priority.” Crowley has been out of action since April, having also missed the summer Tests against Australia, Japan, and New Zealand."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Disciplinary update",
          "heading": "Marco Riccioni receives two-match suspension following red card against Australia",
          "body": "Prop Marco Riccioni will serve a two-match ban following his red card in the defeat to Australia. Though not named in the match-day squad, Riccioni was dismissed for entering the field of play during a second-half scuffle. The foul play review committee initially proposed a four-week suspension but reduced the term to two matches after Riccioni admitted to the act and displayed remorse. He is set to miss fixtures for Perpignan against Biarritz and Bath next month."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Legal update",
          "heading": "Rugby concussion lawsuits proceed as landmark UK court case continues",
          "body": "The landmark legal action concerning concussion-related injuries in rugby has moved forward following a recent decision in the UK courts. The litigation, which remains in a crucial phase, continues to draw significant attention as participants seek clarity on the responsibilities of governing bodies. While the case remains active, it enters a new stage of formal proceedings. There has been no final ruling as of today, and the process remains subject to ongoing judicial review."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Conditioning focus",
          "heading": "Sean Lynn pushes Wales squad through physical endurance training for WXV",
          "body": "Wales are entering the final stages of a three-week pre-season block aimed at addressing fitness concerns ahead of their upcoming WXV Global Series campaign. Strength and conditioning coach Gareth Harris reports an exceptional attitude within the 46-strong extended squad as they endure intense interval training to improve their 80-minute performance. According to Harris, the primary objective is to move their physical standards forward: \"We know where we are from a physical perspective and it is about moving that dial forward.\""
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Match result",
          "heading": "Argentina fall to narrow 27-21 defeat against clinical Australian side",
          "body": "Argentina suffered a frustrating 27-21 loss to Australia on home soil in Saturday’s Test match. Despite a resilient defensive effort that tested the Wallabies throughout, Australia capitalised on key moments to secure the victory. Los Pumas struggled to contain a mobile Australian pack, with Fraser McReight’s late turnover proving decisive in the closing stages. Australia coach Les Kiss acknowledged the intensity, stating, “That’s Test rugby, isn’t it? We weren’t perfect; neither were they.” Argentina will need to refine their defensive structures."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "461": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Les Kiss rotates Wallabies pack for away Test against Los Pumas",
          "body": "Coach Les Kiss has reshaped his forward pack for the upcoming clash with Argentina, resting captain Harry Wilson entirely as part of a deliberate effort to build squad depth. Allan Alaalatoa steps in to captain the side for the seventh time, leading a pack that features Isaac Kailea’s first Test start since 2024. Kiss defended the changes as a necessary long-term strategy, stating, “We’ve needed to consider how we manage a long season for players while also providing Test experience.”"
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "League rule change",
          "heading": "Japan Rugby League One settles legal dispute over player registration categories",
          "body": "Japan Rugby League One has revised its controversial player eligibility rules following a legal challenge from 25 high-profile players. The league admitted that communication regarding the shift was insufficient and will now reclassify players with 30 or more Brave Blossoms caps from Category A-2 to A-1. Furthermore, naturalised players holding citizenship since May 2025 or earlier will remain in the same registration category as Japan-born players, averting the immediate threat of widespread discrimination claims across the professional competition."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Series level",
          "heading": "New Zealand falls to South Africa as Springboks level the series",
          "body": "The All Blacks saw their pursuit of a historic series victory stalled in Cape Town, falling 33-26 to a clinical South African side. Despite a late rally featuring tries from Roigard, McKenzie, Carter, and captain Ardie Savea, the visitors could not overcome a powerful first-half display from the world champions. The result leaves the series squared at 1-1 with two matches remaining. With the next encounter set for Johannesburg, Dave Rennie’s side must now regroup after failing to maintain their momentum from the opening victory."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "467": {
      "date": "2026-08-30",
      "edition": "Sunday 30 August",
      "sections": [
        {
          "kicker": "Coaching scrutiny",
          "heading": "Rassie Erasmus slams Dave Rennie’s ‘nonsense’ accusations over Springboks scrum",
          "body": "Rassie Erasmus has hit back at All Blacks boss Dave Rennie following complaints regarding the legality of South Africa’s scrum. Erasmus dismissed the criticism as “nonsense” after New Zealand raised grievances with World Rugby ahead of Saturday’s victory in Cape Town. The Springboks head coach insisted his pack is “scrumming through” legally, claiming the visitors are “under pressure” if they feel the need to lobby via the media. South Africa secured a 33-26 win to level the series at 1-1."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
