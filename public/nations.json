      }
    },
    "389": {
      "date": "2026-11-26",
      "edition": "Thursday 26 November",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Quesada hands Enoch Opoku-Gyamfi first Test start, Niccolò Cannone to captain Italy",
          "body": "Gonzalo Quesada has made five changes to the XV that lost 16-21 to Fiji in Udine for Friday's 11th-place final rematch at Twickenham. Opoku-Gyamfi, the Bath lock with four caps, starts for the first time in a back row with Manuel Zuliani and Ross Vintcent, while Federico Ruzza partners Cannone, who leads the side, in the second row. Paolo Garbisi returns at fly-half alongside Stephen Varney, Leonardo Marin and Mori pair up in midfield, and Tommaso Allan, Ange Capuozzo and Monty Ioane are retained in the back three."
        },
        {
          "kicker": "Around the world",
          "heading": "Australia's Allan Alaalatoa named co-captain for 100th Test",
