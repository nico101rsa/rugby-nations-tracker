  "digests": {
    "28": {
      "date": "2026-11-26",
      "edition": "Thursday 26 November",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Jake White names Isoa Nasilasila captain for Italy rematch at Twickenham",
          "body": "The lock leads a side with Caleb Muntz at fly-half and Terio Tamani at scrum-half, Jiuta Wainiqolo and Peniasi Dakuwaqa on the wings and Ponipate Loganimasi at full-back. Iosefo Masi and Vinaya Habosi pair up in midfield, while Kitione Salawa packs down at No. 8 alongside Elia Canakaivata and Mesake Vocevoce. Friday's 11th-place final is a second meeting inside a week: Fiji beat Italy 21-16 in Round 6, their only win in six."
        },
        {
          "kicker": "Around the world",
          "heading": "Australia's Allan Alaalatoa named co-captain for 100th Test",
          "body": "Ireland recall Jacob Stockdale on left wing for Australia. England recall Freddie Steward for All Blacks rematch."
        }
      ],
      "match": {
        "venue": "Allianz Stadium Twickenham, London"
      },
      "source": {
        "name": "Federazione Italiana Rugby"
      }
    },
    "386": {
      "date": "2026-11-26",
      "edition": "Thursday 26 November",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Borthwick rests George Furbank and recalls Freddie Steward for All Blacks rematch",
          "body": "George Furbank picked up a knock in last weekend's 37-12 win over New Zealand and was available, but Borthwick has opted for the more defensively minded Leicester man for Saturday's rematch. Steward missed the 23 last time. Tommy Freeman, withdrawn last week with a thigh issue, returns on the right wing with Will Joseph switching left. Greg Fisilau makes his first England start, at seven, and Luke Cowan-Dickie starts ahead of Jamie George at hooker."
        },
        {
          "kicker": "Around the world",
          "heading": "Australia's Allan Alaalatoa named co-captain for 100th Test",
          "body": "Ireland recall Jacob Stockdale on left wing for Australia. Fiji name Isoa Nasilasila captain for Italy rematch."
