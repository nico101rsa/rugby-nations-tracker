  "digests": {
    "28": {
      "date": "2026-09-27",
      "edition": "Sunday 27 September",
      "sections": [
        {
          "kicker": "Stat watch",
          "heading": "Fiji slip to last in Nations Championship following third consecutive defeat",
          "body": "The Flying Fijians sit at the bottom of the Nations Championship table after the opening three rounds. Fiji have suffered three consecutive defeats in the competition, most recently losing 17-33 against Scotland in Round Three. In their three opening matches, the team scored 49 points. They also conceded 145 points during those same games, leaving them with a points difference of -96. This difficult run contrasts with 2023, when they reached a historic high of No. 7 in the world rankings."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-27",
      "edition": "Sunday 27 September",
      "sections": [
        {
          "kicker": "WOMEN'S TEST",
          "heading": "Zoe Harrison clinches dramatic England women win over New Zealand",
          "body": "England women secured a dramatic 26-19 victory over New Zealand at Allianz Stadium after Zoe Harrison scored an 81st-minute intercept try. The fly-half struck in overtime to settle a tense encounter before a crowd of 59,871, following last week’s draw against Canada. While Ellie Kildunne and Jess Breach also crossed, the Red Roses lost captain Marlie Packer to a concussion. Head coach John Mitchell noted the importance of the result, stating it is \"important to learn how to win tight test matches.\""
        }
      ],
      "match": {
        "venue": "Allianz Stadium, London"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-27",
      "edition": "Sunday 27 September",
      "sections": [
        {
          "kicker": "Recent form",
          "heading": "France demonstrate consistent winning momentum across their five most recent fixtures",
          "body": "France enter the upcoming international period showing positive form, having secured victories in three of their last five matches. The side is currently on a run of two consecutive wins, following a comprehensive 42-15 victory against Japan in July. With a record of three wins and two losses across these five appearances, Les Bleus maintain a stable position as they look ahead to their next test encounter in November."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-27",
      "edition": "Sunday 27 September",
      "sections": [
        {
          "kicker": "Women's test",
          "heading": "Ireland women target response against Japan in WXV Global Series fixture",
          "body": "Ireland look to rebound in Galway today following a narrow 40-36 defeat to the USA last weekend. Despite leading by 19 points in their series opener, the Irish side conceded four successive tries to lose momentum. Head coach Scott Bemand has made 6 changes for the encounter, including a first start for prop Eilís Cahill. Bemand remains focused on the long-term, noting: “It will be an ideal opportunity in terms of where we are in terms of this World Cup cycle.”"
        }
      ],
      "match": {
        "venue": "Dexcom Stadium, Galway"
      },
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-09-27",
      "edition": "Sunday 27 September",
      "sections": [
        {
          "kicker": "Transfer news",
          "heading": "Uruguayan Flanker Lucas Bianchi Joins Serie A Elite Side Viadana",
          "body": "Uruguayan international Lucas Bianchi has completed a move to Italy, joining Viadana in the Serie A Elite ahead of the new season. The 25-year-old flanker, who represented Los Teros at the 2023 Rugby World Cup, moves to the top-tier Italian competition after serving as a key member of the leadership team at Peñarol. Bianchi is among several Uruguayan players securing professional contracts in Europe as they prepare for the lead-up to the 2027 Rugby World Cup."
        }
      ]
    },
    "390": {
      "date": "2026-09-27",
      "edition": "Sunday 27 September",
      "sections": [
        {
          "kicker": "Women's test",
          "heading": "Scotland Women suffer heavy defeat as Australia dominate second-half surge",
          "body": "Scotland Women endured a frustrating 30-10 defeat against Australia in their latest WXV Global Series fixture at Hive Stadium. Despite heading into the interval with a 10-5 lead following an Evie Gallagher try and five points from the boot of Helen Nelson, the hosts were unable to withstand a clinical second-half comeback. Australia capitalised on a yellow card for Gallagher to cross for three tries in eight minutes, ultimately running in 25 unanswered points to secure the win."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-09-27",
      "edition": "Sunday 27 September",
      "sections": [
        {
          "kicker": "Premiership Rugby",
          "heading": "Dewi Lake scores brace as Gloucester defeat Exeter at Sandy Park",
          "body": "Wales hooker Dewi Lake crossed for two tries to help Gloucester secure a 45-24 victory over Exeter in the opening round of the Premiership season. The result marked Gloucester's biggest-ever win at Sandy Park and their first triumph at the venue in 12 years. Despite a dominant period from the hosts, Gloucester’s clinical finishing, including a 50-metre solo effort from Will Joseph, proved decisive in a performance that left the home side struggling with execution."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "460": {
      "date": "2026-09-27",
      "edition": "Sunday 27 September",
      "sections": [
        {
          "kicker": "Player update",
          "heading": "Santiago Carreras returns to Bath ahead of new club season",
          "body": "Santiago Carreras has returned to club duty with Bath for the opening of the 2026/27 Premiership season. Bath boss Johann van Graan highlighted the character of the Argentine international following his summer period with Los Pumas. Carreras, who arrived at the club from Gloucester in 2025, is currently competing for the full-back position within the squad as the team prepares for their upcoming fixtures. Argentina is next scheduled to face Ireland in Round 4 of the ongoing international competition."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-27",
      "edition": "Sunday 27 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Joseph-Aukuso Suaalii handed starting wing role for Springboks Test match",
          "body": "Joseph-Aukuso Suaalii will make his first start on the wing for the Wallabies in Sunday’s Test against the Springboks. Coach Les Kiss opted for the change to utilise the player’s aerial ability against a South African side expected to challenge Australia physically across the park. “This is a big, big Test team,” Kiss said of the visitors. The selection also sees Len Ikitau start at outside centre, providing the side with added tactical versatility as they target a major scalp in Perth."
        }
      ],
      "match": {
        "venue": "Optus Stadium, Perth"
      },
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-09-27",
      "edition": "Sunday 27 September",
      "sections": [
        {
          "kicker": "Team performance",
          "heading": "Japan maintains balanced points record across recent international fixture run",
          "body": "Japan’s senior men’s side has demonstrated a highly consistent scoring profile throughout their recent international campaign. Across their last 11 matches, the team has recorded 309 points scored and 308 points conceded, resulting in an average of 28.1 points for and 28 points against per game. Within this 11-match window, the side’s most significant margin of victory was a 63-14 home win over the USA, achieved during the knockout stage of the Pacific Nations Cup in September 2026."
        }
      ],
      "rung": "data"
    },
    "465": {
      "date": "2026-09-27",
      "edition": "Sunday 27 September",
      "sections": [
        {
          "kicker": "Women's test",
          "heading": "Black Ferns suffer late heartbreak in narrow defeat to England",
          "body": "The Black Ferns saw their unbeaten run under coach Whitney Hansen ended in dramatic fashion, falling 26-19 to England at the Allianz Stadium. Despite a promising first half that saw tries from Amy Du Plessis and Ayesha Leti-I’iga, New Zealand were undone by a late Zoe Harrison interception try in overtime. The result concludes a physical contest where New Zealand’s second-half discipline, including a yellow card for Veisinia Mahutariki-Fakalelu, proved costly against a clinical home side."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "467": {
      "date": "2026-09-27",
      "edition": "Sunday 27 September",
      "sections": [
        {
          "kicker": "Test match buildup",
          "heading": "Les Kiss expects massive challenge as Wallabies prepare for Springboks test",
          "body": "Wallabies coach Les Kiss has acknowledged the magnitude of the upcoming test match against South Africa in Perth. Kiss highlighted the depth of the touring squad, noting that the visitors possess talent that runs three or four deep in every position. With the match serving as a significant gauge for Australia one year out from their home World Cup, the Wallabies have reshuffled their backline to include Joseph-Aukuso Suaalii on the wing to combat the Springboks’ aerial threat."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    }
  }
}