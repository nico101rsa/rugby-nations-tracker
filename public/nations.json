  "digests": {
    "28": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "Form slide",
          "heading": "Fiji slump to three consecutive defeats after home loss to Scotland",
          "body": "Fiji are currently bottom of the table following three consecutive defeats. In their last five matches, the national side has registered just one victory alongside four losses. This run of form includes a 17-33 home defeat against Scotland in their most recent fixture. In the current tournament, the Flying Fijians have lost all three of their games, scoring 49 points and conceding 145 to leave them with a point difference of minus 96."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "Contract extension",
          "heading": "Steve Borthwick secures England contract extension past the 2028 Six Nations",
          "body": "The Rugby Football Union will extend head coach Steve Borthwick’s contract until the end of the 2028 Six Nations. Performance director Conor O’Shea confirmed the move, aiming to eliminate distractions before next year’s World Cup in Australia. Despite a \"horrendous\" Six Nations campaign where England won only one match, Borthwick retains the board's backing. However, O’Shea warned that his future remains conditional, stating, \"Everyone knows it will be judged on the World Cup.\""
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "Ball trial",
          "heading": "France Women adjust to smaller ball ahead of WXV campaign",
          "body": "France Women open their WXV campaign against New Zealand this weekend under the spotlight of World Rugby's controversial smaller ball trial. The initiative has sparked a mixed bag of emotions across the tournament, with some figures warning the change makes it \"harder to do my job\" during preparation. As Les Bleues fine-tune their tactics in Lyon, the squad must adapt to the new dimensions for the home-and-away series, which continues through October."
        }
      ],
      "match": {
        "venue": "Matmut Stadium de Gerland, Lyon"
      },
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "388": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "WXV ball trial",
          "heading": "World Rugby expands WXV ball trial while Ireland squad stays silent",
          "body": "World Rugby’s expanding trial of a smaller ball for the upcoming WXV tournament has triggered intense debate across the women’s game, though there is no coverage of the Irish squad’s response in today’s press. While other international figures report a \"mixed bag of emotions\" — with some players arguing it makes it \"harder to do my job\" — the global trial remains open. World Rugby continues to gather data before deciding on permanent implementation, leaving the Irish camp's reaction entirely unreported for now."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "Smaller ball trial",
          "heading": "Italy face controversial WXV trial as Harrison slams smaller ball decision",
          "body": "The global trial of a smaller rugby ball during the upcoming WXV tournament has faced fierce backlash, with England's Harrison branding the initiative the 'worst decision ever'. As Italy prepare to navigate the experimental rules, critics argue that female players do not require 'help' that would never be offered in the men's game. While World Rugby's trial remains unresolved, the Italian squad must adapt to the controversial changes amidst growing player frustration across the international landscape."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "Mental performance",
          "heading": "Scotland winger applies performance psychology study to improve his on-field results",
          "body": "A Scotland winger has revealed he is using himself as a \"guinea pig\" while pursuing a side hustle in performance psychology. The back-three specialist is applying academic research to the pressures of international rugby, aiming to optimise his mental approach before the November tests. This self-experimentation highlights a growing trend of psychological focus within the national squad. As the team prepares for the visit of New Zealand, such marginal gains could prove vital for a side currently sitting fifth in the standings."
        }
      ]
    },
    "391": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "Lock return",
          "heading": "Lock Ben Carter cleared for Dragons return after ankle injury with Wales",
          "body": "Lock Ben Carter is fit to start the domestic season with Dragons after recovering from the ankle injury that forced him out of the July defeat to South Africa. The 25-year-old, who started six consecutive Tests before the training-ground blow, was on crutches during the summer but avoided surgery. Defence coach Dale MacLeod confirmed the lock is \"keen, refreshed and ready\" to return, providing a boost for the national side ahead of November's meeting with Japan."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "Ball trial",
          "heading": "Argentina women’s team face ball size changes during global WXV trial",
          "body": "World Rugby is trialling a smaller ball throughout the upcoming WXV tournament. The change has produced mixed reactions, with some participants indicating the shift makes their specific on-field roles more difficult to perform. While the England coach has offered a stance on the controversial trial, these adjustments continue to affect the women's international game as officials monitor the trial before making a permanent decision."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "461": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Carter Gordon sidelined for two months following leg fracture in Argentina",
          "body": "The Wallabies face a challenging period without first-choice flyhalf Carter Gordon, who is expected to miss two months of action after sustaining a leg fracture during Sunday’s draw with Argentina. The 25-year-old playmaker, who had established himself as a focal point under Les Kiss, is set to sit out the upcoming Test against South Africa and the Bledisloe Cup series. Ben Donaldson, who started in Mendoza, is currently the internal frontrunner to cover the position during Gordon’s recovery."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "League One",
          "heading": "Japan Rugby League One confirms fixtures for upcoming 2026-27 season",
          "body": "The Japan Rugby League One has released the full fixture list for the 2026-27 Division One campaign, which commences on 12 December. The 12-team competition will see each side play 18 matches, culminating in the playoff final on 6 June 2027. Defending champions Kobelco Kobe Steelers are set to host Toyota Verblitz in the opening round. The league confirmed that the matchups were determined by the final standings from two seasons ago to ensure competitive balance across the competition."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "Selection news",
          "heading": "Dave Rennie prepares for final Test as injury list grows longer",
          "body": "Coach Dave Rennie has confirmed plans to rotate his squad for the series decider, an initiative he insists was planned regardless of the previous result. The task is now complicated by the loss of Ardie Savea, Luke Jacobson and Quinn Tupaea to injury. With the series currently 2-1 in South Africa’s favour, Rennie remains bullish about his side’s chances, stating: “We have definitely got one more in us.” The squad is currently recovering following a gruelling 26-hour journey to the United States."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-10",
      "edition": "Thursday 10 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Rassie Erasmus rewards Morné van den Berg with pivotal starting spot",
          "body": "Morné van den Berg has been promoted to the starting XV for the final Test against the All Blacks in Baltimore. Rassie Erasmus confirmed the move following the scrum-half’s impactful cameo in last weekend’s win, noting the player had to show significant resilience after injury struggles. While Cobus Reinach moves to the bench to provide experience, Erasmus insisted the change is based on merit, stating: \"Morne made a fantastic impact when he took the field last week. He deserves a chance to start.\""
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
