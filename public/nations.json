  "digests": {
    "28": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Fijian rugby player Saimoni Vunilagi dies of suspected heatstroke in Japan",
          "body": "The Fijian rugby community is mourning the tragic death of 26-year-old back-row forward Saimoni Vunilagi in Japan. Vunilagi, who played for second-division side Kyushu KV, was hospitalised in Fukuoka on Monday 3 August 2026 after displaying severe heatstroke symptoms following a team practice. His club confirmed he passed away on Friday 7 August 2026. Kyushu KV stated that players and staff are devastated by the sudden news, paying tribute to a player who began his professional career in Japan in 2023."
        }
      ]
    },
    "386": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Squad contracts",
          "heading": "Steve Borthwick cuts Elliot Daly and Ollie Lawrence from England contracts",
          "body": "England head coach Steve Borthwick has shaken up his squad by awarding enhanced Elite Player Squad contracts to five rising stars while axing several established internationals. Prop Asher Opoku-Fordjour, lock Alex Coles, flanker Guy Pepper, scrum-half Jack van Poortvliet and centre Seb Atkinson have all secured £150,000 hybrid deals for the upcoming season. However, there is no space for experienced back Elliot Daly, centre Ollie Lawrence, flanker Ben Curry or wing Tom Roebuck, while France-bound No. 8 Willis is also ineligible."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Coaching shake-up",
          "heading": "FFR confirms shock exits of Shaun Edwards and Bulls-bound Vlok Cilliers",
          "body": "The French Rugby Federation has confirmed the shock departures of defence specialist Shaun Edwards and kicking coach Vlok Cilliers from Fabien Galthié's staff. While Edwards' exit ends his celebrated stint with Les Bleus, Cilliers has already secured his next move, returning to South Africa to join the Bulls' backroom staff under Johan Ackermann. The former fly-half spent seven years sharpening France's tactical kicking and Thomas Ramos' goal-kicking before Galthié opted to shake up his coaching setup."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "388": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "SAD LOSS",
          "heading": "Former Ireland and Wallabies playmaker Brian Smith passes away aged 59",
          "body": "The Irish rugby community is mourning former out-half Brian Smith, who has passed away aged 59. The versatile playmaker won six Test caps for Australia before studying at Oxford University, a move that led to him representing Ireland nine times. Following his playing retirement, Smith transitioned into an illustrious coaching career, managing Bath and London Irish before working as England's attack coach. The IRFU paid tribute, stating they were \"saddened to hear of the passing\" of their former international."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "COACHING BAN",
          "heading": "Gonzalo Quesada will miss South Africa clash following two-match World Rugby ban",
          "body": "Italy head coach Gonzalo Quesada is set to miss the November opener against South Africa after receiving a two-test suspension. World Rugby issued the ban following Quesada’s criticism of referee Luc Ramos after the July defeat to New Zealand. The Argentine became the first coach sanctioned under the new Match Official Abuse Sanctioning Process, which targets comments that undermine public confidence in officials. Quesada, who was also absent for the recent loss to Australia, retains the right to appeal the decision."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "COACHING SHOCK",
          "heading": "Scotland express surprise as Fukofuka joins Australia days after 'family reasons' exit",
          "body": "Scotland officials have expressed surprise following the appointment of former staff member Fukofuka as the new Australia head coach. The move comes just days after he vacated his role within the Scottish setup, citing \"family reasons\" for his departure. The sudden pivot to join a major international rival has reportedly caught the governing body off guard. This coaching vacancy arrives while Scotland sit fifth in the standings following their 33-17 victory over Fiji."
        }
      ]
    },
    "391": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Regional crisis",
          "heading": "Ospreys and Scarlets refuse to sign WRU deal amid regional cuts",
          "body": "The future of professional rugby in west Wales remains at a standstill following last week's confirmation by the Welsh Rugby Union that either the Ospreys or the Scarlets will be cut. Despite the governing body outlining a formal timeline for the reduction to three professional teams, neither region has signed the new deal. The Ospreys have officially described the plan as \"wrong,\" while Scarlets leadership has called for greater transparency from the Union. No final decision has been reached, leaving both clubs in a state of high-stakes limbo."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Suspension progress",
          "heading": "Tomás Albornoz begins four-match suspension following 'intimidatory' referee confrontation in England Test",
          "body": "Tomás Albornoz has commenced a four-match suspension following a disciplinary hearing into his conduct after the defeat by England. Reported last week, the ban stems from Albornoz twice approaching referee Angus Gardner in an intimidatory manner, necessitating restraint by teammates. Having already sat out the recent loss to South Africa, the fly-half remains unavailable for Argentina’s upcoming double-header against Australia. Disciplinary officials reduced the sanction from six matches following his \"early acceptance of the charge\" and written apologies to Gardner."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "461": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Les Kiss recalls Carter Gordon at fly-half among eight Wallabies changes",
          "body": "Carter Gordon returns to the starting XV for Saturday’s second Test against Japan in Townsville as head coach Les Kiss searches for a solution to his \"playmaker puzzle.\" Gordon, recovered from a calf injury, replaces Declan Meredith in a side featuring eight changes following last week's narrow win in Osaka. Isaac Henry earns a first start at inside centre for the injured Joseph-Aukuso Suaalii, while prop Massimo De Lutiis is poised to become the 1,000th player capped from the bench. Kiss noted: \"I want to see Carter.\""
        }
      ],
      "match": {
        "venue": "Queensland Country Bank Stadium, Townsville"
      },
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "463": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Eddie Jones hands Yoshitaka Yazaki debut in youthful Brave Blossoms side",
          "body": "Eddie Jones has handed a Test debut to Waseda University student Yoshitaka Yazaki, naming the wing in a revamped starting XV featuring five changes. Yazaki will serve as an additional fullback as Jones continues to integrate youth, with fellow student Ryunosuke Ito also starting at fly-half. To improve support play, Jones revealed he has shown his squad videos of geese in flight, explaining that the \"ball carrier is king\" and the rest of the flock must respond instinctively to his movements."
        }
      ],
      "match": {
        "venue": "Townsville"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "465": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Caleb Clarke ruled out of South Africa tour after rupturing shoulder tendon",
          "body": "Caleb Clarke is flying home from his South Africa tour after rupturing a shoulder tendon during Tuesday's 54-0 win over the Sharks. He is the second backline regular lost this week following Billy Proctor’s departure with a similar injury. Head coach Dave Rennie confirmed no immediate replacement will be called up ahead of Saturday’s clash with the Bulls in Pretoria. \"An injury replacement will not be called in at this point,\" the coach stated, leaving the tourists to rely on existing back-three depth amid growing questions over squad resources."
        }
      ],
      "match": {
        "venue": "Loftus Versfeld, Pretoria"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "COACHING IMPACT",
          "heading": "Josh Kronfeld labels Tony Brown the 'danger factor' for the All Blacks",
          "body": "Former All Blacks flanker Josh Kronfeld has identified attack coach Tony Brown as South Africa’s primary threat ahead of the series opener at Ellis Park. Kronfeld believes Brown’s influence prevents the world champions from retreating into a conservative shell when under pressure. While the Springboks maintain their traditional focus on set-piece and physical confrontation, Kronfeld labels the New Zealander the \"biggest issue\" for the tourists, as he provides the tactical variety to sustain high-tempo pressure against the New Zealand defence."
        }
      ],
      "match": {
        "venue": "Ellis Park, Johannesburg"
      },
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
