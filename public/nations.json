  "digests": {
    "28": {
      "date": "2026-11-28",
      "edition": "Saturday 28 November",
      "sections": [
        {
          "kicker": "Press verdict",
          "heading": "L'Équipe and RugbyPass blame Fiji's indiscipline and execution for Italy defeat",
          "body": "Friday's 23-21 defeat to Italy in the 11th-place final at Twickenham drew pointed verdicts abroad. L'Équipe argued Italy owed their survival solely to Fijian indiscipline, punished by Tommaso Allan's 68th-minute penalty, and to a granite defence inside their own five metres that held to the final whistle. RugbyPass found Fiji's late push thrilling but judged imprecise execution decisive. TNT Sports called the fightback from 17-0 down to lead 21-20 remarkable, with Fiji outscoring Italy three tries to two."
        },
        {
          "kicker": "Around the world",
          "heading": "Ireland beat Australia 38-14 to finish November unbeaten",
          "body": "South Africa's Pieter-Steph du Toit withdraws with niggle before France final. Argentina drop Facundo Isa from matchday 23 for Scotland."
        }
      ],
      "source": {
        "name": "OnRugby"
      }
    },
    "386": {
      "date": "2026-11-28",
      "edition": "Saturday 28 November",
      "sections": [
        {
          "kicker": "Eddie's jibe",
          "heading": "Eddie Jones mocks England's 'mess' critics after record win over All Blacks",
          "body": "Japan's head coach used the I Love Rugby podcast to take a sarcastic swipe at journalist Owen Slot, whose pre-November piece claimed the environment around Borthwick's squad was worse than ever and that players complained in July about his man-management. \"You go back two weeks ago and England were a mess,\" Jones said, then credited a powerful carrying and clean-out display against New Zealand, said Itoje looks to have his spark back and rated Fin Smith's short kicking game probably the best in the world for a 10."
        },
        {
          "kicker": "Around the world",
          "heading": "Ireland beat Australia 38-14 to finish November unbeaten",
          "body": "Italy beat Fiji 23-21 to end losing run. South Africa's Pieter-Steph du Toit withdraws with niggle before France final. Argentina drop Facundo Isa from matchday 23 for Scotland."
        }
      ],
      "match": {
        "venue": "Allianz Stadium, Twickenham"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-11-28",
      "edition": "Saturday 28 November",
      "sections": [
        {
          "kicker": "Squad release",
          "heading": "Tani Vili and Gaël Dréan among 14 released by France staff",
          "body": "Toulon can pick Dréan and Mathis Ferté at Clermont on Sunday night. The pair are among 14 players released by the France staff before the Nations Championship final against South Africa at Twickenham. Stade Français regain Vili, Léo Barré and Louis Carbonel, while Nicolas Depoortère is free to face Montpellier with Bordeaux-Bègles. Five reservists stay with the squad: Moses Alo Emile, Esteban Capilla, Guillaume Cramont, Paul Graou and Thomas Laclayat. That leaves Bayonne without Capilla and Cramont against Castres."
        },
        {
          "kicker": "Around the world",
          "heading": "Ireland beat Australia 38-14 to finish November unbeaten",
          "body": "Italy beat Fiji 23-21 to end losing run. Argentina drop Facundo Isa from matchday 23 for Scotland."
        }
      ],
      "match": {
        "venue": "Twickenham, London"
      },
      "source": {
        "name": "Rugbyrama"
      }
    },
    "388": {
      "date": "2026-11-28",
      "edition": "Saturday 28 November",
      "sections": [
        {
          "kicker": "Bench impact",
          "heading": "James McNabney marks second Ireland cap with two tries against Australia",
          "body": "The Ulster back-row came off the bench in Friday's 38-14 win at Allianz Stadium, Twickenham, and crashed over twice in the closing minutes to put the fifth-place final beyond the Wallabies. Planet Rugby named him among its winners, arguing Andy Farrell has to keep giving him Test minutes on the strength of his size and gainline carrying. His brace completed a five-try night that sealed four wins from four in November, with Robbie Henshaw, Nick Timoney and Rob Baloucoune also crossing."
        },
        {
          "kicker": "Around the world",
          "heading": "Italy beat Fiji 23-21 to end losing run",
          "body": "South Africa's Pieter-Steph du Toit withdraws with niggle before France final. Argentina drop Facundo Isa from matchday 23 for Scotland."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-11-28",
      "edition": "Saturday 28 November",
      "sections": [
        {
          "kicker": "Streak snapped",
          "heading": "Tommaso Allan's boot carries Italy past Fiji 23-21 to end losing run",
          "body": "Friday's 11th-place final at Twickenham avenged last week's 21-16 defeat in Udine. Converted tries from Federico Mori and replacement Giacomo Nicotera had Italy 17-0 up early, but Fiji outscored them three tries to two and edged ahead 21-20 through Kitione Salawa. A scrum penalty on the edge of Fiji's 22 let Allan land his fifth kick from five with 13 minutes left, and defence on their own line did the rest. It is Italy's first win since beating England in March's Six Nations."
        },
