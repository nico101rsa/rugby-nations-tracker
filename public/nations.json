  "digests": {
    "28": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
          "kicker": "LOG STANDINGS",
          "heading": "Fiji sit bottom of the log following their third consecutive loss",
          "body": "Fiji remain at the bottom of the log in 12th place. In their opening three matches of this tournament, the side has suffered three consecutive defeats. They have conceded 145 points across those three fixtures. In contrast, they have scored 49 points of their own during this period, leaving them with a point differential of minus 96. This difficult run follows a 17-33 loss to Scotland in their last match. Historically, the highest-ever position the team has reached in the world rankings is No. 7, achieved in 2023."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
          "kicker": "Selection news",
          "heading": "Steve Borthwick keeps Ollie Lawrence and Elliot Daly waiting over England futures",
          "body": "There has been no fresh update on Ollie Lawrence and Elliot Daly since they lost their central contracts on 21 August, leaving their long-term international prospects unresolved. Head coach Steve Borthwick's shake-up awarded deals to five new players, but the veteran back-line pair must wait for the next squad announcement to learn their standing. With no further news in today's press, their international paths remain unclear until Borthwick confirms his plans for the upcoming Test window."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "387": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
          "kicker": "Form guide",
          "heading": "France secure two consecutive wins following away victory against Japan",
          "body": "In their last five international matches, France have recorded three victories. During this same five-game period, they also suffered two defeats. The team's current run of form now stands at two consecutive wins. Their most recent result was a comfortable 42-15 victory against Japan in July 2026. That fixture was played away from home in the Group Stage of the Nations Championship."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
          "kicker": "INJURY UPDATE",
          "heading": "Jack Crowley ruled out until new year after vascular injury setback",
          "body": "Munster confirmed last week that Ireland fly-half Jack Crowley will remain sidelined until the new year due to a vascular injury. The 26-year-old has been out of action since April, missing July's internationals. Crowley's prolonged absence rules him out of November's tests against Argentina, Fiji and South Africa. Munster head coach Clayton McMillan prioritised his long-term recovery, stating, \"ensuring he gets back to 100% is the priority.\""
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
          "kicker": "Injury update",
          "heading": "Italy lock Andrea Zambonin ruled out of Premiership start after surgery",
          "body": "Italy lock Andrea Zambonin is set to miss the start of the Premiership season with Exeter Chiefs following shoulder surgery, as reported yesterday. With no further updates emerging today, his rehabilitation timeline remains unclear. The lock's absence is a blow for Azzurri head coach Gonzalo Quesada, who is preparing for the autumn internationals. Zambonin faces a race against time to prove his fitness before Italy face South Africa."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
          "kicker": "Legal update",
          "heading": "Scottish Rugby response absent as High Court delivers landmark concussion ruling",
          "body": "A landmark High Court decision on rugby's group concussion litigation has left the long-running brain injury case in the balance. While UK headlines confirmed the legal battle will proceed, today's press provides only the headlines of the court's decision, with no coverage of the ruling's details or any response from Scottish Rugby. Whether the governing body faces direct exposure remains unclarified in the current reporting, as the sport awaits further legal analysis of the strike-out applications."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
          "kicker": "LEGAL BATTLE",
          "heading": "Hundreds of former players win High Court bid to continue injury claims",
          "body": "Hundreds of former rugby players have won a High Court battle allowing their brain injury claims to proceed to trial. While the headlines confirm the group action has been cleared to progress, today’s coverage does not provide further details on the specific defendants or the exact nature of the claims. This ruling ensures the landmark litigation continues, marking a pivotal moment for those seeking damages for neurological damage. The case remains the most significant legal challenge currently facing the professional game."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
          "kicker": "HOME SLUMP",
          "heading": "Gerónimo Prisciantelli and Joaquín Moro tries fail to prevent Australia loss",
          "body": "Los Pumas suffered a 21-27 defeat to Australia in San Salvador de Jujuy on Saturday, highlighting a troubling trend for the national side. Despite tries from Gerónimo Prisciantelli, Joaquín Moro and Boris Wenger—all converted by Santiago Carreras—Argentina failed to capitalise on a second-half yellow card for the Wallabies. The result means the team have won only once in their last five matches, all of which were played on home soil. A rematch in Mendoza offers an immediate opportunity to address the slump."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "461": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
          "kicker": "Selection news",
          "heading": "Les Kiss signals smart Wallabies changes despite securing victory against Argentina",
          "body": "The Wallabies are expected to make smart personnel changes for the series finale against Argentina after labouring to a 27-21 victory in San Salvador de Jujuy. Head coach Les Kiss admitted there were \"clunky bits\" in his side’s execution — specifically at the ruck — and requested more industry from his backline despite the hard-fought result. Rob Valetini impressed at No. 8 in place of the rested Harry Wilson, while Tom Hooper’s 56th-minute try proved the difference in a clinical second-half display that secured the first Test lead."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
          "kicker": "Eligibility U-turn",
          "heading": "JRLO officials roll back eligibility restrictions for Timothy Lafaele and teammates",
          "body": "Japan Rugby League One has abandoned contentious plans to reclassify naturalised citizens as foreign players following a legal challenge and widespread backlash. A settlement reached in the Tokyo District Court ensures that foreign-born players who acquired Japanese nationality by May 2025 remain in the top domestic eligibility category. Managing Executive Director Hajime Shoji admitted, \"We lacked communication with players who would be adversely affected by the changes.\" The U-turn protects the status of Brave Blossoms veterans including Timothy Lafaele and Jiwon Gu."
        }
      ]
    },
    "465": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
          "kicker": "COACHING SPAT",
          "heading": "Dave Rennie’s scrum tactics allegations drawing sharp protocol rebuke from Rassie Erasmus",
          "body": "Rassie Erasmus has hit back at Dave Rennie, accusing the New Zealand head coach of attempting to influence referees through the media rather than using official channels. Following Saturday’s 33-26 loss in the second Test in Cape Town, Rennie alleged the Springboks were “walking around” at the scrum. Erasmus, who initially responded with a series of expletives, today insisted that Rennie must follow World Rugby protocols, adding that “one can’t make opinion facts” in the media before Saturday’s third Test in Soweto."
        }
      ],
      "match": {
        "venue": "FNB Stadium, Johannesburg"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
