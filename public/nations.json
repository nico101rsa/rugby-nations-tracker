  "digests": {
    "28": {
      "date": "2026-08-28",
      "edition": "Friday 28 August",
      "sections": [
        {
          "kicker": "Form guide",
          "heading": "Fiji slip to three straight defeats following home loss against Scotland",
          "body": "In their last five matches, Fiji have registered only one victory. They have suffered four defeats across that same span. This slump has left the national side on a current run of three straight defeats. In their most recent fixture in July 2026, the Flying Fijians suffered a 33-17 home loss against Scotland during the Nations Championship group stage."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-08-28",
      "edition": "Friday 28 August",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Ben Spencer undergoes shoulder surgery to leave November availability in doubt",
          "body": "Bath have confirmed that scrum-half Ben Spencer has undergone shoulder surgery to resolve a long-standing issue, making him a major doubt for England's matches in November. The 34-year-old will miss the start of the Premiership season and face a tight race to prove his fitness before the Tests against Australia, Japan, and New Zealand. With Spencer sidelined, Steve Borthwick must look down his depth chart behind preferred playmakers Alex Mitchell and Jack van Poortvliet, potentially opening the door for Archie McParland or Raffi Quirke."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-28",
      "edition": "Friday 28 August",
      "sections": [
        {
          "kicker": "Ranking history",
          "heading": "France held the world number one ranking for only one week",
          "body": "France have historically struggled to maintain their position at the very peak of the World Rugby rankings. In the history of the global rankings, the longest unbroken spell France have spent at No. 1 is only one week. This brief stint at the top of the world standings occurred during the window of July 2022 to July 2022."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-28",
      "edition": "Friday 28 August",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Ireland playmaker Jack Crowley ruled out until new year with vascular injury",
          "body": "Ireland fly-half Jack Crowley has been ruled out until the new year, meaning he will miss November's block of international fixtures. The 26-year-old, who has earned 35 caps since his 2022 debut, has been sidelined since April with a lower limb vascular injury. After sitting out July's matches, Crowley's extended absence rules him out of upcoming Dublin tests against Argentina, Fiji, and South Africa. Munster head coach Clayton McMillan confirmed that \"ensuring he gets back to 100% is the priority\" as the playmaker continues his recovery."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-08-28",
      "edition": "Friday 28 August",
      "sections": [
        {
          "kicker": "Stat report",
          "heading": "Italy scored 190 points and conceded 318 across their last 11 matches",
          "body": "Across their last 11 matches, Italy scored a total of 190 points. The team conceded 318 points over those same 11 fixtures. These matches saw them average 17.3 points scored per game. The Azzurri also conceded an average of 28.9 points per match during that run. The biggest victory of this 11-game sequence came during the international friendlies in November 2025, when Italy secured a 34-19 home win against Chile."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-28",
      "edition": "Friday 28 August",
      "sections": [
        {
          "kicker": "Legal update",
          "heading": "Scotland players saw landmark rugby brain injury case proceed this month",
          "body": "There are no fresh updates in today's press regarding the landmark High Court legal action over rugby-related brain injuries. The multi-claimant case, which includes former Scotland internationals among its hundreds of litigants, remains open after a crucial ruling earlier this month prevented the action from collapsing. While the legal process enters a quiet phase with no new developments reported this morning, we continue to monitor the litigation as former players seek accountability over historical concussion management."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-28",
      "edition": "Friday 28 August",
      "sections": [
        {
          "kicker": "Regional future",
          "heading": "Welsh Rugby Union provided no further updates on professional team cuts",
          "body": "There are no fresh updates today from the Welsh Rugby Union regarding its contentious proposal to reduce the country's professional teams to three. The governing body has not released any new information since doubling down on the plan earlier this month, when it also condemned abuse directed at its staff. Opponents, including the Ospreys and former players calling for board resignations, must wait for further developments as the WRU's silence leaves the future of the regional game unresolved."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-08-28",
      "edition": "Friday 28 August",
      "sections": [
        {
          "kicker": "Club move",
          "heading": "Francisco Moreno signs for Newcastle Red Bulls after making Argentina debut",
          "body": "Argentina tight-head prop Francisco Moreno has signed a one-year contract with Premiership side Newcastle Red Bulls. The 24-year-old, who weighs 143kg, made his international debut against South Africa in Buenos Aires earlier this month. Moreno will join fellow Pumas Franco Molina and Simón Benítez Cruz on Tyneside after his international commitments. He is currently with Felipe Contepomi’s squad preparing for Saturday's opening Test against Australia in San Salvador de Jujuy."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "461": {
      "date": "2026-08-28",
      "edition": "Friday 28 August",
      "sections": [
        {
          "kicker": "Captaincy switch",
          "heading": "Allan Alaalatoa named Wallabies captain as Les Kiss rotates Harry Wilson",
          "body": "Allan Alaalatoa will captain Australia for the seventh time on Saturday in Salvador de Jujuy after head coach Les Kiss opted to rotate regular skipper Harry Wilson out of the matchday 23. Loosehead prop Isaac Kailea earns a starting spot in a brand-new front row alongside hooker Brandon Paenga-Amosa, while Fraser McReight returns at openside flanker. Kiss highlighted the need to manage a long season, balancing player workloads with the physical demands of facing Argentina on their home turf."
        }
      ],
      "match": {
        "venue": "Salvador de Jujuy"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-28",
      "edition": "Friday 28 August",
      "sections": [
        {
          "kicker": "Opponent watch",
          "heading": "Les Kiss makes eight changes to Wallabies side for Japan rematch",
          "body": "Australia head coach Les Kiss has overhauled his squad for the upcoming rematch against Japan, making eight changes to the starting line-up. Kiss has made a fresh fly-half selection as the Wallabies search for more direct play in the second meeting between the sides. The revamped Australian selection also features a historic milestone, with a player set to become Wallaby No. 1000. These sweeping adjustments present a complex new defensive challenge for Japan."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "465": {
      "date": "2026-08-28",
      "edition": "Friday 28 August",
      "sections": [
        {
          "kicker": "INJURY BLOW",
          "heading": "Anton Segner ruled out of South Africa tour following ankle surgery",
          "body": "Anton Segner will play no further part in the South African tour after undergoing keyhole surgery to treat an infected ankle. The German-born flanker, who impressed on his July debut, becomes the fifth All Black ruled out of the series, joining the likes of Caleb Clarke and Billy Proctor. While Segner will remain with the squad, coach Dave Rennie confirmed he will not summon a replacement for Saturday’s second test in Cape Town, citing sufficient depth in the loose forwards."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-08-28",
      "edition": "Friday 28 August",
      "sections": [
        {
          "kicker": "SELECTION CALL",
          "heading": "Rassie Erasmus recalls Handré Pollard to start as Springboks target All Blacks",
          "body": "Rassie Erasmus has recalled Handré Pollard to the starting XV for Saturday’s second Test in Cape Town, benching Sacha Feinberg-Mngomezulu following the 33-16 loss at Ellis Park. Former fly-half Joel Stransky expressed concern that the selection signals a retreat from the \"running game\" towards a more conservative approach. The Springboks surrendered their No. 1 world ranking with the Johannesburg defeat but can reclaim top spot with any victory this weekend. John Smit urged the camp to remain calm, noting the Boks \"haven’t become a s**t team in one day.\""
        }
      ],
      "match": {
        "venue": "Cape Town Stadium, Cape Town"
      },
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
