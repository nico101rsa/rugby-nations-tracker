  "digests": {
    "28": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "Form guide",
          "heading": "Fiji fall to three straight defeats following 17-33 Scotland loss",
          "body": "Fiji are enduring a challenging period, currently on a run of three straight defeats. In their last five games, the Flying Fijians have secured only one victory. Across those same five matches, the team suffered four defeats. Their most recent performance was a 17-33 home loss to Scotland during the Nations Championship group stage in July 2026. This run leaves them sitting 12th of 12 teams on the log."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Steve Borthwick recalls Maro Itoje to England squad for autumn preparations",
          "body": "Steve Borthwick has recalled lock Maro Itoje to a 36-man England training squad at Pennyhill Park after the second-rower was rested during the summer series. Itoje, who is expected to reclaim the captaincy from the injured Jamie George, missed the July fixtures against South Africa, Fiji and Argentina to take his first proper break in a decade. Prop Fin Baxter also returns following 10 months out with a foot injury, but Courtney Lawes and Joe Marchant must prove their form in the Premiership before earning selection."
        }
      ],
      "match": {
        "venue": "Allianz Stadium, Twickenham"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "Legal battle",
          "heading": "High Court allows landmark concussion lawsuits as France face global scrutiny",
          "body": "The UK High Court has allowed landmark lawsuits over neurological injuries to proceed, a decision with major ramifications across the global game. While the legal action primarily targets governing bodies in the UK, the ruling ensures that concussion protocols and long-term player welfare remain under intense scrutiny across all major rugby nations. As France prepare for the upcoming autumn internationals, the ongoing legal battle ensures the sport's safety standards will be a dominant talking point."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "388": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "Book release",
          "heading": "Former Ireland lock Ryan Caldwell publishes memoir detailing harrowing post-rugby spiral",
          "body": "Former Ireland second-row Ryan Caldwell has opened up about his harrowing descent into addiction, depression, and imprisonment following his retirement from professional rugby. In his upcoming autobiography, White Lines: a Rugby Life Broken and Rebuilt, the former Ulster, Bath, and Exeter enforcer details the physical toll of chronic hip injuries and a final concussion that precipitated his mental health spiral. Now teaching meditation and breathwork, Caldwell reflected on his recovery journey, noting: \"I had no love for myself … now I have peace.\""
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "Zambonin watch",
          "heading": "No fresh updates emerge regarding Andrea Zambonin recovery in today's press",
          "body": "There has been no coverage of Andrea Zambonin's shoulder recovery in today's press following last week's news that the Exeter Chiefs lock will miss the start of the domestic season. His rehabilitation progress remains unmonitored in current reports, leaving the second row's availability for Italy's upcoming clash against South Africa unclear. We will continue to track his fitness ahead of the international window."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "Player welfare",
          "heading": "Scotland squad faces uncertainty after High Court allows landmark brain injury case",
          "body": "There is no fresh update in today's press regarding the ongoing legal battle over concussion in rugby union. Following yesterday's report that the High Court is allowing the landmark brain injury litigation to proceed, the case remains unresolved. The legal battle stays open as both sides prepare for a full trial. Scottish rugby continues to monitor the situation, awaiting a final verdict that could reshape the sport's safety protocols and player welfare standards."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "CLUB RESTRUCTURE",
          "heading": "WRU officials propose radical restructure that could replace Ospreys and Scarlets",
          "body": "Wales face a pivotal six months as the WRU prepares a radical overhaul of the professional game. Workshops beginning in December will determine licensing for just three or four clubs, leaving the Ospreys and Scarlets at risk of extinction or a forced merger. Internal discussions include replacing both historic teams with an entirely new West Wales outfit. Although a final decision is expected by March, the governing body insists it is entering the process in good faith despite mounting pressure from fans."
        }
      ]
    },
    "460": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "STALEMATE",
          "heading": "Pablo Matera scores twice as Argentina draw 28-28 against Australia in Mendoza",
          "body": "Los Pumas recovered from a 14-point deficit to secure a 28-28 draw against Australia in Saturday's second test in Mendoza. Pablo Matera crossed for two tries, while Ignacio Mendy and Ignacio Ruiz also scored to help the home side take a late lead. Argentina played the final 10 minutes with 13 men after Lucio Cinti and a teammate received yellow cards, but they held on to avoid a defeat following the loss in Jujuy."
        }
      ],
      "match": {
        "venue": "Mendoza, Argentina"
      },
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "461": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "SERIES SUCCESS",
          "heading": "Les Kiss remains unbeaten as Wallabies clinch series with Argentina draw",
          "body": "Australia secured their first series victory on Argentinian soil despite a 28-28 draw against Los Pumas in Mendoza on Saturday. Les Kiss remains unbeaten after four Tests, though the Wallabies squandered a 14-0 lead and failed to capitalise on a two-man advantage during the final 10 minutes. A 70th-minute penalty try levelled the scores after Argentina suffered two yellow cards, but execution errors prevented a fifth straight win. Captain Harry Wilson admitted \"the boys were hurting with the result\" despite lifting the trophy."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "Test victory",
          "heading": "Japan beat Canada 57-12 as Mamoru Harada scores twice in Niigata",
          "body": "The Brave Blossoms ended a four-match losing streak on Saturday, overpowering Canada 57-12 at Niigata’s Denka Big Swan Stadium. Hooker Mamoru Harada crossed twice as Eddie Jones’s side ran in nine tries, including a debut score for replacement prop Takumi Inaba. Fly-half Ryunosuke Ito made his sixth consecutive start, guiding a clinical attack that established a 31-7 lead by the interval. After the clinical display, Jones turned his focus to the Pacific Nations Cup, stating: \"The next game is the U.S.A., and we'll start thinking about that tomorrow.\""
        }
      ],
      "match": {
        "venue": "Denka Big Swan Stadium, Niigata"
      }
    },
    "465": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "INJURY BLOW",
          "heading": "Injured Ardie Savea exits tour following New Zealand’s 29-24 defeat in Soweto",
          "body": "Captain Ardie Savea has been ruled out of Saturday's series finale in Baltimore after suffering a dislocated shoulder during the 29-24 defeat in Soweto. Savea, who scored two tries before exiting in the 30th minute, is one of nine players returning to New Zealand, with fellow injury casualties Quinn Tupaea and Luke Jacobson also departing. Coach Dave Rennie has named a 36-man squad for the American leg, insisting his side will not \"use that as an excuse\" despite losing their skipper."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-09-07",
      "edition": "Monday 7 September",
      "sections": [
        {
          "kicker": "INJURY BLOW",
          "heading": "Cheslin Kolbe suffers broken jaw in Springboks' 29-24 win over New Zealand",
          "body": "The Springboks secured a 2-1 series lead in Soweto on Saturday but lost Cheslin Kolbe to a broken jaw, ruling the wing out of the finale in Baltimore. Tries from Jesse Kriel and Malcolm Marx sparked a second-half comeback at FNB Stadium after the All Blacks led 17-12 following Will Jordan’s score. Rassie Erasmus apologised for his recent conduct after the five-point win, admitting his previous outburst was “not well-mannered” as he praised the tourists’ attacking threat. Damian Willemse is expected to return for the final Test."
        }
      ],
      "match": {
        "venue": "FNB Stadium, Soweto",
        "referee": "Nika Amashukeli"
      },
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
