  "digests": {
    "28": {
      "date": "2026-08-04",
      "edition": "Tuesday 4 August",
      "sections": [
        {
          "kicker": "SUPER W FINAL",
          "heading": "Fijian Drua fall to clinical Waratahs in historic Ba grand final",
          "body": "The minor premiers suffered a heavy 34-17 defeat at Ba's Four R Stadium as the visitors secured their third consecutive title. Despite the home side entering the grand final as favourites, six lost lineout throws and early errors saw them fall behind 24-0 shortly after half-time. While replacement Amelia Whitaker's late brace for the Australians ultimately sealed the result, the historic clash marked the first time the showpiece event has been hosted in Fiji, drawing prime minister Sitiveni Rabuka to present the trophy."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "386": {
      "date": "2026-08-04",
      "edition": "Tuesday 4 August",
      "sections": [
        {
          "kicker": "CONTRACT NEGOTIATIONS",
          "heading": "Eddie Hearn demands Northampton Saints pay Henry Pollock seven figures",
          "body": "Contract negotiations have become tense after the prominent sports promoter claimed his client is currently being significantly underpaid. The 21-year-old currently receives £150,000 annually from the Rugby Football Union as an enhanced elite squad member, but is in the final year of his club deal. Although the rising star wants to stay at Northampton, rival clubs in England and France have expressed interest. Hearn insisted Pollock's commercial value is on 'another stratosphere' and urged Saints to offer a much better contract."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-04",
      "edition": "Tuesday 4 August",
      "sections": [
        {
          "kicker": "SEVENS SUCCESS",
          "heading": "France Men’s 7s retain European title after crushing Italy in Split final",
          "body": "A clinical performance in Croatia secured France their fifth Rugby Europe 7s Championship Series title with a dominant 43-0 victory over Italy in the final tournament in Split. Despite finishing second to Germany in the opening Hamburg leg, Les Bleus navigated the knockout stages with ease, including a 22-0 semi-final win over Spain. This latest title reinforces the nation’s status as a powerhouse across both codes while the senior XVs side maintains third place in the Nations Championship following a recent 42-15 win over Japan."
        }
      ]
    },
    "388": {
      "date": "2026-08-04",
      "edition": "Tuesday 4 August",
      "sections": [
        {
          "kicker": "Legal volatility",
          "heading": "Andy Farrell’s Ireland face lawsuit collapse as lead concussion lawyer departs",
          "body": "Landmark brain injury litigation against rugby’s governing bodies entered a period of extreme volatility on Tuesday. The High Court heard arguments that the cases should be thrown out, while the lead lawyer representing the group of former players has reportedly been forced out. This crisis threatens the collapse of a case involving hundreds of claimants across the unions. For Ireland, the outcome remains critical as the judge retires to consider the strikeout application and whether the legal proceedings can continue."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-08-04",
      "edition": "Tuesday 4 August",
      "sections": [
        {
          "kicker": "TRANSFER NEWS",
          "heading": "Italy prop Ion Neculai joins Premiership champions Northampton Saints from Zebre Parma",
          "body": "Gallagher Premiership champions Northampton Saints have welcomed the Zebre Parma tighthead into pre-season training following his move from Italy. Neculai, who earned his fourth Test cap off the bench during last month’s 10-57 defeat to Australia in Perth, follows fellow Azzurri front-rowers Danilo Fischetti and Malik Faissal to Franklin’s Gardens. Saints director of rugby Phil Dowson confirmed he consulted Gonzalo Quesada regarding the move, describing the player as a \"very physical prop who enjoys the tough side of the game.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "390": {
      "date": "2026-08-04",
      "edition": "Tuesday 4 August",
      "sections": [
        {
          "kicker": "SQUAD EXCLUSION",
          "heading": "Jamie Bhatti reveals shock at SRU decision to end Glasgow career",
          "body": "A \"massive shock\" encounter with club officials has left Jamie Bhatti frustrated after being told he is no longer in Scotland’s international plans. The 32-year-old prop, who has since signed for Bath, claimed the SRU blocked his Glasgow Warriors contract extension because he was no longer part of Gregor Townsend’s squad. Bhatti had intended to retire at the end of next season but is now heading to the Premiership after being informed he was no longer \"in the Scotland picture anymore\"."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "391": {
      "date": "2026-08-04",
      "edition": "Tuesday 4 August",
      "sections": [
        {
          "kicker": "Regional reform",
          "heading": "Cardiff and Dragons secure licences as Scarlets and Ospreys fight for survival",
          "body": "The Welsh Rugby Union has confirmed it will reduce the nation's professional franchises from four to three by 2028, sparking a battle for survival in the west. While Cardiff and Dragons have already been granted future licences, Scarlets and Ospreys must now vie for the final spot. Swansea Council has threatened to resume legal proceedings against the governing body, while Scarlets released a statement vowing to remain \"at the heart of west Wales\" as they face a December deadline to finalise the regional framework."
        }
      ],
      "match": {
        "venue": "Durban"
      }
    },
    "460": {
      "date": "2026-08-04",
      "edition": "Tuesday 4 August",
      "sections": [
        {
          "kicker": "Disciplinary standards",
          "heading": "Federico Méndez demands improved Argentina discipline as Tomas Albornoz faces misconduct charge",
          "body": "The national team has been urged to improve its on-field behaviour following the disciplinary fallout from July's loss to England. Fly-half Tomas Albornoz is currently awaiting a World Rugby misconduct verdict after making physical contact with referee Angus Gardner in Santiago del Estero. Legend Federico Méndez stressed that 'what the referee says is the last word' as the side prepares for this weekend's clash in Buenos Aires. The warning follows a series of off-the-ball incidents that tarnished the recent 24-31 defeat."
        }
      ],
      "match": {
        "venue": "Estadio José Amalfitani, Buenos Aires"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-08-04",
      "edition": "Tuesday 4 August",
      "sections": [
        {
          "kicker": "VETERAN RETURN",
          "heading": "Quade Cooper targets 2027 World Cup return as fly-half depth persists",
          "body": "The 80-cap veteran has confirmed he \"never retired\" and is targeting a shock Wallabies return for the 2027 home World Cup. Cooper, currently coaching at Kintetsu Liners in Japan, cited mental fatigue for his recent hiatus but insists he is physically capable. While new head coach Les Kiss currently lacks a settled No. 10 — having inherited a squad that used nine fly-halves under Joe Schmidt — domestic Super Rugby interest in a short-term deal for the 38-year-old remains thin ahead of Saturday's opening Japan Test."
        }
      ],
      "match": {
        "venue": "Hanazono Rugby Stadium, Osaka"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-04",
      "edition": "Tuesday 4 August",
      "sections": [
        {
          "kicker": "DEFENSIVE RECORD",
          "heading": "Japan concede 334 points over 11 tests following heavy France loss",
          "body": "Aggregate totals for the last 11 fixtures show 334 points conceded, with Japan shipping an average of 30.4 per game. During this same window, the side scored 278 points at an average of 25.3 per match. While the defensive record remains a concern following the 15-42 loss to France, the period includes a high-scoring highlight. The team recorded their biggest win of the sequence in September 2025, beating Tonga 62-24 away in the Pacific Nations Cup knockout stage."
        }
      ],
      "rung": "data"
    },
    "465": {
      "date": "2026-08-04",
      "edition": "Tuesday 4 August",
      "sections": [
        {
          "kicker": "SQUAD MANAGEMENT",
          "heading": "Pundits back Dave Rennie’s decision to rest skipper Ardie Savea",
          "body": "Former All Blacks James Parsons and Bryn Hall have publicly backed Dave Rennie’s choice to delay Ardie Savea’s arrival on the South African tour. Savea, who has played consistently since early 2025, will miss the initial stages of the trip to manage his fatigue. \"I'd rather him rest up,\" Hall noted, emphasising the need for the captain to be fresh for the high-stakes encounters with the Springboks. Codie Taylor will lead the side until Savea rejoins the group in mid-August."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-04",
      "edition": "Tuesday 4 August",
      "sections": [
        {
          "kicker": "COACHING PHILOSOPHY",
          "heading": "Rassie Erasmus admits his greatest fear is losing team-to-public connection",
          "body": "While maintaining the Springboks’ competitive edge remains a daily obsession, Rassie Erasmus has confessed that his deepest professional anxiety involves losing the profound connection the squad currently enjoys with the South African public. The head coach described the prospect of that joy dissipating as his \"nightmare,\" prioritising the team's ability to inspire pride over individual match results. Siya Kolisi echoed this sentiment, reflecting on the painful period when those bonds were broken and stadium seats sat empty."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
}