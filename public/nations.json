  "digests": {
    "28": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Cup final defeat",
          "heading": "Fiji fall to late Samisoni Tua try in Pacific Nations Cup final",
          "body": "Fiji failed to secure a third consecutive Pacific Nations Cup title on Saturday, falling 20-15 to Japan in a tense final in Tokyo. Despite first-half tries from Virimi Vakatawa and Tevita Ikanivere giving the Flying Fijians a 12-10 lead at the interval, the side struggled after Mesake Doge received a yellow card. Isaiah Armstrong-Ravula kicked a penalty to level the scores at 15-15, but a late Samisoni Tua try sealed the victory for Eddie Jones’ men."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "386": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Winning streak ends",
          "heading": "England women draw with Canada to close 39-match unbeaten run",
          "body": "England’s remarkable 39-match winning streak concluded on Friday as the Red Roses were held to a 26-26 draw by Canada at Sandy Park. Despite the stalemate ending their perfect run, John Mitchell’s side extended their unbeaten sequence to 40 Tests in a physical encounter. England led through tries from Claudia Moloney-MacDonald, Hannah Botterman, and Bryony Field, but were unable to convert late pressure into a victory. Mitchell remained optimistic, stating, \"I'm a realist. There will be greater things come as a result of this.\""
        }
      ],
      "match": {
        "venue": "Sandy Park, Exeter"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Squad management",
          "heading": "France implements protected player list to target 2027 World Cup success",
          "body": "The French Rugby Federation has officially introduced a 'protected player list' of 33 individuals to manage workloads ahead of the 2027 World Cup. Under this new agreement with Top 14 clubs, these players will be granted a weekend off every 4 matches to mitigate injury risks. In exchange, these stars are restricted to a total of 9 Test matches during the upcoming international windows. The list reportedly features 13 players from Toulouse, including Antoine Dupont, Romain Ntamack, and Thomas Ramos."
        }
      ]
    },
    "388": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Jemima Adams Verling earns debut as Ireland faces United States today",
          "body": "Connacht back row Jemima Adams Verling will make her senior Ireland debut in the WXV Global Series opener. Head coach Scott Bemand has selected the 20-year-old at blind-side flanker alongside captain Erin King and Aoife Wafer in the back row. This fixture marks the start of a new three-year cycle as the squad builds toward the next World Cup. Bemand stated that the series represents a \"turning of the page\" for the team as they look to develop greater depth."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Historical context",
          "heading": "Italy maintains highest world ranking position reached in recent seasons",
          "body": "Italy’s progress in the international game is underscored by their historical world ranking trajectory, having reached No. 8 on two notable occasions. This peak was first recorded in 2007 and was matched again as recently as 2024. As the squad prepares for the upcoming round against South Africa, they look to improve upon a challenging run in their last three fixtures, which saw the side record 37 points while conceding 131."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "WXV series defeat",
          "heading": "Scotland struggle as New Zealand run in 10 tries at Hive",
          "body": "Scotland suffered a 66-14 defeat to New Zealand at Hive Stadium on Saturday, marking a second successive loss in the WXV Global Series. Despite Evie Gallagher scoring two first-half tries to keep the hosts in contention, the world’s second-ranked side proved too clinical, securing 10 tries in total. The Black Ferns dominated the contest, effectively ending the game as a competition by half-time. Scotland now turn their attention to facing Australia at the same venue next Saturday."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Statement win",
          "heading": "Wales Women destroy South Africa in stunning eight-try WXV opening victory",
          "body": "Wales secured a dominant 50-19 win over South Africa in their WXV Global Series opener at Cardiff Arms Park. Sean Lynn’s side raced to a 38-5 half-time lead, with Sisilia Tuipulotu scoring twice and co-captain Alex Callender earning player of the match honours. After a nine-test winless streak, the performance signalled a new direction for the squad. \"This is just the start for us, this is going to be our new DNA,\" said Lynn following the emphatic victory."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Historical standing",
          "heading": "Argentina reflects on proud history while targeting future international success",
          "body": "As Los Pumas look towards future fixtures, it is worth noting the side’s historical trajectory within the global game. Argentina achieved its highest-ever world ranking of No. 3 during the 2007–08 window. The team has demonstrated significant competitive pedigree on the biggest stage, having reached the semi-finals at the 2007, 2015, and 2023 Rugby World Cups. This legacy provides the foundation for the current squad as they prepare for upcoming challenges in the international calendar."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Coaching challenge",
          "heading": "Les Kiss warns Wallabies to embrace unconventional approach against South Africa",
          "body": "Wallabies coach Les Kiss has urged his side to embrace the 'Wallaby Way' as they prepare for a monumental challenge against world No. 1 South Africa. Despite the Springboks arriving with momentum following a series against the All Blacks, Kiss insists his players will not shy away from the contest. 'Take your eye off us, we’ll come back and bite you,' he said, emphasising that his side is ready to challenge themselves against the current world rugby benchmark."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "PNC CHAMPIONS",
          "heading": "Eddie Jones’ Japan defeat Fiji to secure Pacific Nations Cup title",
          "body": "Japan claimed the Pacific Nations Cup with a 20-15 victory over Fiji in Tokyo on Saturday. After previous final losses to the Flying Fijians, Eddie Jones’ side secured the win with a decisive 70th-minute try from Samisoni Tua. Flanker Ben Gunter also crossed, while Mamoru Harada provided an earlier score. Jones noted that the result offers a platform for the squad, stating: “It’s a great opportunity for this team to grow.” The victory concludes a successful campaign for the hosts."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "465": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "WXV dominance",
          "heading": "Black Ferns cruise past Scotland in comprehensive ten-try WXV victory",
          "body": "The Black Ferns delivered a commanding performance at Hive Stadium, running in 10 tries to secure a emphatic win against Scotland in the WXV global series. Despite the hosts fashioning two first-half tries through Evie Gallagher, New Zealand’s tempo and power proved too much to contain. Layla Sae and Amy Du Plessis struck before the interval to pull away, with Amarante Sititi, Tara Turner, and Alena Saili adding further scores after the break to underline a dominant display."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "467": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Rassie Erasmus releases Pieter-Steph du Toit and Damian de Allende",
          "body": "Coach Rassie Erasmus has released two first-choice starters, Pieter-Steph du Toit and Damian de Allende, from the squad ahead of the one-off Test against the Wallabies. Erasmus confirmed the pair will return home to their families following a demanding workload during the recent series against the All Blacks. The coach remains confident in his remaining options, noting that there is sufficient cover within the travelling party to manage the gap as the team prepares for the upcoming clash."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
}