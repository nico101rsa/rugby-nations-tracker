    "28": {
      "date": "2026-11-28",
      "edition": "Saturday 28 November",
      "sections": [
        {
          "kicker": "Wing spark",
          "heading": "Jiuta Wainiqolo creates all three Fiji tries in 23-21 loss to Italy",
          "body": "Italy won Friday's 11th-place final at Twickenham 23-21, but Fiji's attack ran through their right wing. Wainiqolo's long cut-out pass put Ponipate Loganimasi away for Fiji's first try. He sent fellow wing Peniasi Dakuwaqa over after the break, then released No. 8 Kitione Salawa on 55 minutes to edge Jake White's side 21-20 ahead. Fiji outscored Italy three tries to two, yet Tommaso Allan landed all five goal kicks, the last coming after Fiji conceded a scrum penalty on the edge of their own 22."
        },
        {
          "kicker": "Around the world",
          "heading": "Springboks' Marco van Staden banned three matches over Beirne cleanout",
          "body": "Ireland beat Wallabies 38-14 to finish fifth in Nations Championship. Wales start Sam Costelow at fly-half against Japan."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "386": {
      "date": "2026-11-28",
      "edition": "Saturday 28 November",
      "sections": [
        {
          "kicker": "Obituary",
          "heading": "England Rugby mourns former scrum-half Nigel Starmer-Smith, who has died aged 81",
          "body": "The Harlequins and Barbarians scrum-half made seven England appearances between 1969 and 1971. After retiring in 1976 he moved into broadcasting and commentated at the 2003 World Cup in Australia. He was diagnosed with dementia in 2015, and his son Charlie said he died peacefully on Thursday morning after a long battle with the condition, remembering him as “one of life’s great tourists.”"
        },
        {
          "kicker": "Around the world",
