  "digests": {
    "28": {
      "date": "2026-11-28",
      "edition": "Saturday 28 November",
      "sections": [
        {
          "kicker": "Result",
          "heading": "Italy beat Fiji 23-21 at Twickenham in Nations Championship 11th-place final",
          "body": "Jake White's side closed their Nations Championship with a 23-21 defeat by Italy at Twickenham, which leaves them 12th of 12. Their one win of the campaign came against the same side in Udine a week earlier, 21-16. Isoa Nasilasila captained an XV built around Caleb Muntz at fly-half and Terio Tamani at scrum-half, with Iosefo Masi and Vinaya Habosi in midfield. Italy's captain for the day, Niccolò Cannone, had said beforehand that Fiji had changed a lot since the sides met in Udine."
        },
        {
          "kicker": "Around the world",
          "heading": "Italy's Tommaso Menoncello needs shoulder surgery, Six Nations in doubt",
          "body": "Ireland's Dan Sheehan misses Wallabies Test through suspension. Springboks' Damian Willemse ruled out after injury against Ireland. Scotland's Rory Darge returns from injury to captain against Argentina."
        }
      ]
    },
    "386": {
      "date": "2026-11-28",
      "edition": "Saturday 28 November",
      "sections": [
        {
          "kicker": "Itoje revival",
          "heading": "Sam Warburton hails Borthwick's 'stroke of genius' in resting Maro Itoje",
          "body": "Itoje skipped July's Southern Series, missing South Africa in Johannesburg, Fiji in Liverpool and Argentina in Santiago del Estero, on a break the former Lions captain says Borthwick proposed. Writing in The Times, Warburton pointed to last Saturday's 37-12 win over New Zealand, where Itoje made 49 ruck entries to Ollie Chessum's 31: \"That is an absolutely monstrous effort.\" Against Japan the lock had the most tackles, 19, in 63 minutes. He captains the side again in today's third-place play-off rematch at Twickenham."
        },
        {
          "kicker": "Around the world",
          "heading": "Italy's Tommaso Menoncello needs shoulder surgery, Six Nations in doubt",
          "body": "Ireland's Dan Sheehan misses Wallabies Test through suspension. Springboks' Damian Willemse ruled out after injury against Ireland. Scotland's Rory Darge returns from injury to captain against Argentina."
        }
      ],
      "match": {
        "venue": "Allianz Stadium, Twickenham"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-11-28",
      "edition": "Saturday 28 November",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Galthié recalls Thomas Ramos and picks 6-2 bench for Springbok final",
          "body": "Ramos is back at No. 15 for the final against South Africa, recovered from injury, with Théo Attissogbe moving to the wing in place of the injured Aaron Grandidier-Nkanang. Matthieu Jalibert partners Antoine Dupont at half-back and Anthony Jelonch replaces Grégory Alldritt in the back row. Galthié's bench splits 6-2, with Jean-Baptiste Gros recovered from a week-long doubt to join Peato Mauvaka and Régis Montagne. Planet Rugby reads the choice as a possible reply to Rassie Erasmus holding his strongest scrummaging front row in reserve."
        },
        {
          "kicker": "Around the world",
          "heading": "Italy's Tommaso Menoncello needs shoulder surgery, Six Nations in doubt",
          "body": "Ireland's Dan Sheehan misses Wallabies Test through suspension. Springboks' Damian Willemse ruled out after injury against Ireland. Scotland's Rory Darge returns from injury to captain against Argentina."
        }
      ],
      "match": {
        "venue": "Allianz Stadium, Twickenham"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "388": {
      "date": "2026-11-28",
      "edition": "Saturday 28 November",
      "sections": [
        {
          "kicker": "Stand-in skipper",
          "heading": "Tadhg Beirne handed Ireland captaincy for Wallabies Test after Dan Sheehan suspension",
          "body": "Beirne took the armband for Friday's fifth-place final against Australia, with Sheehan sitting out a two-game ban and Nick Timoney restored at No. 8 — one of two enforced changes from the side that beat South Africa 20-17. Beforehand, the stand-in skipper was frank about the year, conceding the summer tour was not as strong as Ireland wanted and that July's 33-31 win over the Wallabies in Sydney came \"by the skin of our teeth.\""
        },
        {
          "kicker": "Around the world",
          "heading": "Italy's Tommaso Menoncello needs shoulder surgery, Six Nations in doubt",
          "body": "Scotland's Rory Darge returns from injury to captain against Argentina."
