  "digests": {
    "28": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "PACIFIC CRISIS",
          "heading": "Fiji's regional rivals Samoa face four-year international rugby ban",
          "body": "Fiji's closest regional rivals Samoa remain on the brink of a devastating four-year international ban, with the opposition warning of a World Rugby suspension over the Prime Minister's 'political madness.' The crisis, which began when the Samoan government withdrew its financial support, threatens to freeze the nation out of global competitions. While the dispute remains unresolved, the looming suspension would dismantle regional schedules and leave Fiji without their traditional Pacific partners."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      },
      "rung": "storyline"
    },
    "386": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "SELECTION CALL",
          "heading": "Steve Borthwick axes Elliot Daly as five newcomers earn enhanced England contracts",
          "body": "Steve Borthwick has reshaped his core group for the upcoming season, handing enhanced Elite Player Squad contracts to five rising stars while dropping several established names. Seb Atkinson, Alex Coles, Asher Opoku-Fordjour, Guy Pepper, and Jack van Poortvliet all receive the hybrid deals, which grant Borthwick increased control over their medical and sports science programmes. However, there is no place for British and Irish Lion Elliot Daly or centre Ollie Lawrence, as the head coach prioritises a fresh cohort ahead of November’s Tests against Australia, Japan, and New Zealand."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "COACHING SHAKE-UP",
          "heading": "Vlok Cilliers joins Bulls as Fabien Galthié overhauls France coaching staff",
          "body": "The departure of Vlok Cilliers from the France setup is official following his appointment as the Bulls’ new kicking coach. His exit, alongside defence coach Shaun Edwards, confirms a significant shake-up by Fabien Galthié as he prepares for the next World Cup cycle. Cilliers, who spent seven years with Les Bleus, was instrumental in developing Thomas Ramos’ world-class accuracy. \"Being with France for seven years was an amazing time, and I picked up so much experience,\" Cilliers said, following reports that Edwards was no longer \"universally liked.\""
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "388": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Sad loss",
          "heading": "Former Ireland and Wallabies out-half Brian Smith passes away aged 59",
          "body": "The Irish rugby community is mourning Brian Smith, the dual-international out-half who has passed away at 59 following a short illness. Smith earned nine caps for Ireland during his studies at Oxford University, having previously represented Australia six times, including at the inaugural 1987 World Cup. The IRFU praised his “illustrious career” across both hemispheres, which included a successful period as director of rugby at London Irish and a stint as England’s attack coach during the Martin Johnson era."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Previous encounter",
          "heading": "Italy lost 32-14 to South Africa in last home meeting",
          "body": "The Azzurri focus on their November return to action following a challenging start to the current campaign. Italy lost to South Africa 32-14 at home during the November 2025 international friendlies. In the current Nations Championship, the team has recorded three losses from their opening three fixtures. The squad has conceded 131 points across those first three matches. Gonzalo Quesada’s side currently sits 11th in the standings as they prepare to face the Springboks in Round 4."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Legal proceedings",
          "heading": "Rugby’s landmark concussion lawsuit remains at risk of judicial dismissal",
          "body": "The high-profile concussion litigation continues to face uncertainty as the case remains at risk of being struck out. Following a recent shift in legal representation for the claimants, the proceedings are currently awaiting a definitive judicial ruling on the application to dismiss the group litigation. With the judge having previously retired to consider the potential for a 95% strikeout, the status of these claims remains unresolved while the sport monitors the outcome of this significant legal challenge."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Squad update",
          "heading": "Lisa Neumann returns as Wales name extended training squad for WXV",
          "body": "Wing Lisa Neumann has been recalled to the Wales training squad as head coach Sean Lynn prepares his side for the upcoming four-match WXV Global Series. The 32-year-old, who has been without a club since leaving Harlequins in July, returns to the 46-player setup after missing nearly all of the 2026 Six Nations through injury. Lynn has also included 14 uncapped players in his preparations for the autumn campaign, which includes home Tests against South Africa and the USA."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Disciplinary update",
          "heading": "Tomás Albornoz serves second match of four-game suspension for intimidation",
          "body": "Fly-half Tomás Albornoz remains sidelined today as he serves the second match of his four-game suspension. The ban was issued by a disciplinary committee following the fly-half’s conduct toward referee Angus Gardner after the final whistle of the defeat against England last month. Having accepted the charges of intimidation, Albornoz is currently unavailable for selection, missing this weekend's action alongside forthcoming fixtures against Australia and Toulon. His absence leaves Felipe Contepomi to manage his playmaking options during this period."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "461": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Winning streak",
          "heading": "Australia crush Japan as Wallabies secure third consecutive Test victory",
          "body": "Australia surged to a 56-17 victory over Japan in Townsville, marking their third straight win. Despite trailing early, the Wallabies capitalised on a dominant second half, scoring 35 unanswered points to complete the rout. Prop Taniela Tupou scored twice, while debutant Massimo De Lutiis also crossed the whitewash. Head coach Les Kiss has now overseen a successful transition, with the team building on their previous wins against Italy and Japan to string together a consistent run of form."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "463": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Series defeat",
          "heading": "Japan suffer heavy 56-17 loss to Australia in Townsville test",
          "body": "Japan’s tour of Australia concluded with a comprehensive 56-17 defeat in Townsville, as the hosts dominated the second half to pull away from the visitors. Despite a competitive opening 40 minutes that saw Japan stay within reach through tries from Harry Hockings and Naoto Saito, Australia capitalised on gaps to pile on points after the interval. The result follows last weekend’s narrow 35-32 loss in Osaka, leaving Japan with a challenging return from the two-match series."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "465": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Caleb Clarke ruled out of remainder of All Blacks South Africa tour",
          "body": "The All Blacks have suffered a significant backline setback with wing Caleb Clarke ruled out for the remainder of the tour. Clarke will return home after suffering a ruptured shoulder tendon during Tuesday's victory over the Sharks, leaving head coach Dave Rennie to navigate further reshuffling. This follows the earlier departure of centre Billy Proctor, who returned to New Zealand with a serious shoulder injury. Rennie confirmed no immediate injury replacement will be called up at this stage of the campaign."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Series preparation",
          "heading": "Rassie Erasmus confirms refreshed Springboks are ready for All Blacks series",
          "body": "Rassie Erasmus has declared his squad recovered and aligned following their recent return from Argentina. After managing the travel fatigue of the touring party, the Springboks completed two days of collective training this weekend to sharpen their focus for the opening Test. Erasmus emphasised that the four-match series demands a mentality similar to knockout rugby, stating: “It’s a new and exciting challenge, and we have been putting in a lot of work behind the scenes.”"
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
