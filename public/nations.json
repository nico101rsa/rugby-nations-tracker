    "28": {
      "date": "2026-10-27",
      "edition": "Tuesday 27 October",
      "sections": [
        {
          "kicker": "Fixture block",
          "heading": "Jake White's Fiji face France, Ireland and Italy in November",
          "body": "Jake White's Fiji have a November block in Europe to plan around, with France, Ireland and Italy on the schedule and the Europe-based players available for those games. White picked no Europe-based players for the 34-28 win over Japan, handing out four new caps instead. Reflecting on that win, he said: \"We have a tough series in Europe with France, Ireland and Italy, but the win today will give us a lot of confidence.\""
        },
        {
          "kicker": "Around the world",
          "heading": "Shaun Edwards signs as Argentina defence coach",
          "body": "Ardie Savea left out of New Zealand's Nations Championship squad. Ireland wings Tommy and Jimmy O'Brien forced off in URC interpro."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "386": {
      "date": "2026-10-27",
      "edition": "Tuesday 27 October",
      "sections": [
        {
          "kicker": "Squad selection",
          "heading": "Joe Marchant recalled as Steve Borthwick names 36-man England training squad",
          "body": "Joe Marchant returns to England's frame for the first time since the 2023 World Cup, named in Steve Borthwick's 36-man training squad for the Nations Championship Tests against Australia, Japan and New Zealand. Will Joseph is rewarded for Gloucester's strong start, while uncapped Archie McParland and Kepu Tuipulotu fill the third scrum-half and third hooker spots. Chris Ashton, the former England wing, reads the group as built on Borthwick's relationships rather than form: \"If we look at this training squad, it's not picked on form, is it?\""
        },
        {
          "kicker": "Around the world",
          "heading": "Fiji beat Japan 34-28 in the centenary Test",
          "body": "Shaun Edwards signs as Argentina defence coach. Ardie Savea left out of New Zealand's Nations Championship squad. Ireland wings Tommy and Jimmy O'Brien forced off in URC interpro."
        }
      ],
      "source": {
