    "388": {
      "date": "2026-11-07",
      "edition": "Saturday 7 November",
      "sections": [
        {
          "kicker": "Round 4 result",
          "heading": "Hugo Keenan hat-trick as Ireland beat Argentina 42-12 at Aviva Stadium",
          "body": "Ireland led 21-5 at half-time on Friday night and pulled clear after the break, with Hugo Keenan scoring three tries in the Aviva Stadium win. Dan Sheehan crossed before the interval and Sam Prendergast added a try and five conversions, while Matteo Carreras scored both of Argentina's tries. Keenan's first came in the 15th minute and his third in the 50th, with Ireland finishing 42-12 ahead of Fiji's visit next Saturday."
        },
        {
          "kicker": "Around the world",
          "heading": "Italy lose Nacho Brex and Tommaso Menoncello to injury before Springboks",
          "body": "France's Oscar Jegou ruled out of Fiji clash with rib injury. Jake White named Fiji head coach ahead of 2027 World Cup."
        }
      ],
      "match": {
        "venue": "Aviva Stadium, Dublin"
      }
    },
    "389": {
      "date": "2026-11-07",
      "edition": "Saturday 7 November",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Quesada hands Leonardo Marin and Paolo Odogwu Italy's centre berths against Springboks",
          "body": "Italy coach Gonzalo Quesada has picked Leonardo Marin at inside centre and Paolo Odogwu outside him for Saturday's Test against South Africa in Turin, with Nacho Brex and Tommaso Menoncello both out. Brex has detached a bicep, expects surgery and faces a three-month recovery, while Menoncello is 12 weeks out after subluxing a shoulder for Toulouse against Exeter Chiefs in the Champions Cup. Marin, a former fly-half, was identified by Quesada in June 2025 as a potential successor to Brex's playmaking role."
        },
        {
          "kicker": "Around the world",
          "heading": "Ireland beat Argentina 42-12 as Hugo Keenan scores hat-trick",
          "body": "France's Oscar Jegou ruled out of Fiji clash with rib injury. Jake White named Fiji head coach ahead of 2027 World Cup."
