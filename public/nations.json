    "28": {
      "date": "2026-09-22",
      "edition": "Tuesday 22 September",
      "sections": [
        {
          "kicker": "Tournament defeat",
          "heading": "Fiji fall to Japan in Pacific Nations Cup final in Tokyo",
          "body": "Fiji fell 20-15 to Japan in a tense Pacific Nations Cup final on Saturday in Tokyo, failing to defend their crown. Despite a yellow card for Mesake Doge, the Flying Fijians led 12-10 at half-time following tries from Virimi Vakatawa and Tevita Ikanivere. After Ben Gunter put the hosts ahead, Isaiah Armstrong-Ravula levelled the score with a penalty. However, Samisoni Tua crossed the line with 10 minutes remaining to secure the title for Japan, ending Fiji's run of consecutive titles."
        },
        {
          "kicker": "Around the world",
          "heading": "All Blacks captain Ardie Savea sidelined indefinitely after surgery",
          "body": "South Africa: Rassie Erasmus releases Pieter-Steph du Toit and Damian de Allende."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "386": {
      "date": "2026-09-22",
      "edition": "Tuesday 22 September",
      "sections": [
        {
          "kicker": "COACHING COUP",
          "heading": "Shaun Edwards joins England Women as defence consultant for WXV campaign",
          "body": "The England women's team has pulled off a major coup by appointing Shaun Edwards as a defence consultant for the WXV campaign. The 59-year-old, who left France in June, will assist head coach John Mitchell, who described his credentials as \"exceptional\". Edwards is already in situ as the Red Roses prepare to face New Zealand this Saturday at Allianz Stadium, ahead of next month's fixtures in Canada and the United States."
        },
