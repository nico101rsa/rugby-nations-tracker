  "digests": {
    "28": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Caleb Muntz starts at fly-half as Fiji reshuffle for Japan final",
          "body": "Interim head coach Senirusi Seruvakula has made four changes to his starting XV for Saturday's Pacific Nations Cup final against Japan. Caleb Muntz starts at fly-half, shifting Isaiah Armstrong-Ravula to full-back, while Elia Canakaivata replaces Isoa Tuwai at No. 8. Seruvakula remains wary of the Tokyo hosts, noting, \"We know that Japan is going to be very strong on their home game\". Fiji hope to replicate their 33-27 victory over Japan in last year's final."
        }
      ],
      "match": {
        "venue": "Prince Chichibu Memorial Stadium, Tokyo"
      },
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "386": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Joe Marchant rejoins Sale Sharks to secure England recall under Steve Borthwick",
          "body": "Joe Marchant has returned to the Premiership with Sale Sharks and is prepared to resume his England career after three years in France. The 30-year-old centre, who moved to Stade Français in 2023, believes his spell in the Top 14 has improved his defensive communication and aerial ability. Sale director of rugby Alex Sanderson has been \"blown away\" by Marchant’s qualities, with Steve Borthwick now expected to consider the midfielder for selection ahead of the upcoming autumn test series."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "Mental hurdle",
          "heading": "Ben Youngs insists Fabien Galthié must overcome the Springboks' psychological barrier",
          "body": "Former England scrum-half Ben Youngs insists Fabien Galthié’s men must defeat South Africa this November to dismantle a growing \"psychological barrier\" before the next World Cup. Speaking on the For the Love of Rugby podcast, he argued that \"the French have to beat them\" to prevent the world champions from becoming an insurmountable hurdle. Following the one-point 2023 World Cup exit and last year's 32-17 loss in Paris, Les Bleus go into the Nations Championship's final rounds sitting third in the standings."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "388": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "Recall warning",
          "heading": "Andy Farrell gave Jimmy O'Brien a blunt 'don't f*** it up' warning",
          "body": "Jimmy O’Brien has revealed the blunt four-word ultimatum delivered by Andy Farrell that sparked his international redemption during the recent tour. Having spent significant time in the Test wilderness, the Leinster winger was a surprise inclusion for the Nations Championship fixtures against Australia, Japan and New Zealand. Farrell delivered the curt \"don't f*** it up\" message during a Sydney training session following squad injuries. O’Brien told Planet Rugby he responded by starting all three tour matches, moving himself back up the Irish pecking order."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "Tournament struggle",
          "heading": "Italy slump to eleventh as Gonzalo Quesada grapples with heavy Australia defeat",
          "body": "Italy’s inaugural Nations Championship campaign has stalled, with the side currently 11th in the log following three consecutive defeats. A 57-10 loss to Australia in Round 3 highlighted significant defensive concerns, as the Azzurri have now conceded 131 points in the tournament. While Japan's Eddie Jones previously described the team as 'the most improved team in the world,' Gonzalo Quesada must now use the break before November’s meeting with South Africa to address the physicality issues exposed during their Southern Hemisphere tour."
        }
      ]
    },
    "390": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Dave Butcher hands Ceitidh Ainsworth full debut for New Zealand clash",
          "body": "Interim head coach Dave Butcher has handed Glasgow Warriors scrum-half Ceitidh Ainsworth her first Scotland start for Saturday’s WXV encounter with New Zealand. Ainsworth replaces Rhea Clarke in one of four changes following a heavy 64-26 opening defeat to Canada. The squad is further bolstered by the return of experienced lock Sarah Bonar, who is poised to win her 52nd cap from the bench. It marks her first international appearance since the 2025 World Cup following a lengthy injury absence."
        }
      ],
      "match": {
        "venue": "Hive Stadium, Edinburgh"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "Award win",
          "heading": "Rhys Carre becomes first prop to win Welsh player of the year.",
          "body": "Loose-head Rhys Carre has been named the Welsh Rugby Writers’ Association player of the year, becoming the first prop to take the trophy since Gethin Jenkins. The 28-year-old was a near ever-present for Steve Tandy’s side over the last 12 months, scoring three tries in three successive Six Nations fixtures. Despite Wales sitting ninth in the standings after a heavy 0-43 loss to South Africa, Carre's solo score in Dublin helped him secure the award. \"It’s a bit surreal,\" Carre admitted, \"I just feel honoured.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "Scoring trends",
          "heading": "Felipe Contepomi’s Argentina side records high scoring average across 11 matches.",
          "body": "Argentina averages 29.2 points per game across their last 11 fixtures, despite shipping 346 points in total during the same window. The side has struggled for defensive consistency, conceding an average of 31.5 points per match, but remains a potent attacking threat. A standout result in this period remains the 52-28 away victory against Wales in November 2025, which stands as the team’s biggest win. Los Pumas currently sit eighth in the Nations Championship table heading into the next round."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Les Kiss omits Noah Lolesio and hands Harry McLaughlin-Phillips surprise call-up",
          "body": "Wallabies coach Les Kiss has prioritised youth for the upcoming Test against the Springboks in Perth, naming uncapped fly-half Harry McLaughlin-Phillips in his squad. The 22-year-old’s inclusion follows a leg injury to Carter Gordon and comes at the expense of Noah Lolesio, despite the latter’s 30 Tests of international experience. Kiss also handed a recall to utility back Jordan Petaia, who returns following a stint with Urayasu D-Rocks in Japan. Kiss defended the selection, stating his staff had conducted due diligence and the young playmaker had “earned this right.”"
        }
      ],
      "match": {
        "venue": "Optus Stadium, Perth"
      },
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "463": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "Title quest",
          "heading": "Eddie Jones demands consistency as Japan target first Pacific Nations Cup title",
          "body": "Japan hosts Fiji in Saturday's Pacific Nations Cup final at Tokyo's Prince Chichibu Memorial Stadium. Following a dominant 63-14 semi-final victory over the USA, hooker Mamoru Harada confirmed the squad's focus is on reclaiming the trophy. Despite the scoreline, head coach Eddie Jones warned against lapses in concentration, stating, \"Good players and good teams have that consistency, and that’s what we’re striving for.\" Fiji, seeking a fourth consecutive title, has recalled Caleb Muntz to start at fly-half for the Tokyo showpiece."
        }
      ],
      "match": {
        "venue": "Prince Chichibu Memorial Stadium, Tokyo"
      },
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "Scrum scrutiny",
          "heading": "John Smit questions All Blacks' reluctance to engage Springboks at scrum",
          "body": "Former Springboks captain John Smit has expressed surprise at the All Blacks' tactics during the recent four-test series, noting that Dave Rennie’s side frequently opted for 'channel one' ball to avoid engaging in set-piece battles. Smit argued that New Zealand’s lack of exposure to heavy scrummaging in Super Rugby has hindered their ability to compete physically. While the team showed improvements in the final match, analysts continue to debate whether the current squad requires more size to match the world champions."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-09-18",
      "edition": "Friday 18 September",
      "sections": [
        {
          "kicker": "Rivalry series",
          "heading": "Siya Kolisi earns legendary status after Springboks secure series trophy",
          "body": "Following the conclusion of Rugby’s Greatest Rivalry, South Africa’s 3-1 series victory has been hailed as a colossal success. After dropping the opening Test, the world champions rallied to win three consecutive matches against the All Blacks. Siya Kolisi was singled out for his transformative impact, with his leadership and physical edge proving decisive. Kolisi credited the collective, stating, “the team is bigger than any individual.” While debates persist over technical nuances, the Boks’ adaptability across different venues has set the international standard."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
}