  "digests": {
    "28": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "PNC HEARTBREAK",
          "heading": "Late Japan try denies Flying Fijians in Pacific Nations Cup final",
          "body": "The Flying Fijians missed out on the Pacific Nations Cup title after suffering a tight 20-15 defeat against Japan in Saturday's final in Tokyo. Despite an early try from Virimi Vakatawa and a Tevita Ikanivere score, a yellow card for Mesake Doge disrupted Fiji’s momentum. Isaiah Armstrong-Ravula levelled the scores with a second-half penalty, but Samisoni Tua’s late try snatched victory for the hosts."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "386": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "AUTUMN ULTIMATUM",
          "heading": "Fin Smith warns England must face fundamental questions if autumn results underwhelm",
          "body": "Fly-half Fin Smith has warned that England must face fundamental questions regarding their tactical direction if they fail to perform in the upcoming autumn series. Speaking after a summer that included a narrow 31-24 victory over Argentina, Smith rejected claims that the squad is merely 'building', insisting that momentum must be proven against New Zealand and Australia. The 24-year-old, who has started the last five Tests, admitted he must adapt his Northampton-honed attacking style to suit Steve Borthwick's more set-piece-heavy gameplan."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Mental hurdle",
          "heading": "Ben Youngs warns France must defeat South Africa before World Cup",
          "body": "Former England scrumhalf Ben Youngs has challenged France to overcome their recent struggles against South Africa when the two sides meet in November. Following narrow defeats to the Springboks in both the 2023 World Cup and last year's autumn series, Youngs argued that Fabien Galthié’s squad must break a damaging psychological barrier. He believes that securing a victory is essential for Les Bleus to prove they can genuinely challenge the world champions ahead of next year's tournament in Australia."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "388": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Jemima Adams Verling named in Ireland side for WXV series opener",
          "body": "Jemima Adams Verling will make her senior debut for Ireland in today’s WXV Global Series opener against the United States at Tallaght Stadium. The 20-year-old Connacht back row is the only uncapped player in Scott Bemand’s matchday 23, starting at blind-side flanker alongside captain Erin King and Aoife Wafer. Bemand has described this series as a “turning of the page” as the squad begins a new three-year cycle focused on developing depth in the lead-up to the next World Cup."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Tournament expansion",
          "heading": "World Rugby remains committed to staging Six Nations match in USA",
          "body": "World Rugby continues to pursue plans to host a Six Nations fixture in the United States, despite significant scepticism from the participating unions. Recent reports indicate that while governing bodies have opened talks, the prospect remains a \"long shot\" due to commercial concerns and opposition to losing lucrative home match-day revenues. Unions have largely downplayed the potential for near-term shifts, with various sources confirming no formal plans exist to relocate fixtures for the upcoming championship cycles."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "WXV SERIES DEFEAT",
          "heading": "Scotland Women suffer heavy loss as New Zealand cruise to victory",
          "body": "Scotland endured a difficult afternoon at Hive Stadium yesterday, falling 66-14 to a clinical New Zealand side in the WXV Global Series. Despite two spirited first-half tries from Evie Gallagher, the visitors’ pace proved too much for the hosts to contain. New Zealand ran in 10 tries throughout the contest, dominating both territory and possession. Scotland will now look to regroup before facing Australia at the same venue next Saturday, aiming to improve on their defensive consistency."
        }
      ],
      "match": {
        "venue": "Hive Stadium, Edinburgh"
      },
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Statement victory",
          "heading": "Wales women display new DNA in dominant eight-try victory over South Africa",
          "body": "Wales ended a nine-Test losing run in emphatic style on Friday, putting 50 points past South Africa in their WXV Global Series opener. Coach Sean Lynn hailed the performance as a new starting point for the squad, noting that the players' alignment and improved skill development underpinned the 50-19 victory. Sisilia Tuipulotu scored two tries while co-captain Alex Callender produced a player-of-the-match display, marking a sharp turnaround in form for a side that had struggled significantly throughout recent seasons."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Historical benchmark",
          "heading": "Los Pumas hold the record for reaching third world ranking position",
          "body": "Argentina reached the highest world ranking in their history during the 2007–08 period. The national team climbed to No. 3 in the standings during that window, marking their best performance on record. Following the recent 24-31 defeat to England, the squad currently sits 8th of 12 in the overall log. They hold a points difference of -2, having scored 97 points and conceded 99 points across their opening 3 matches of the competition."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Coaching challenge",
          "heading": "Les Kiss warns Wallabies to embrace unconventional tactics against the Springboks",
          "body": "As Australia prepares for next Sunday’s test against the world-leading Springboks, coach Les Kiss has urged his side to remain unpredictable. Acknowledging that South Africa are heavy favourites after their series against New Zealand, Kiss suggested that shunning convention, much like a fabled strategic play in the game of Go, could be the key. “Take your eye off us, we’ll come back and bite you,” the coach stated, emphasising that this 80 minutes will define where the team is currently."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "PNC CHAMPIONS",
          "heading": "Eddie Jones leads Japan to historic Pacific Nations Cup final win",
          "body": "Japan secured a hard-fought 20-15 victory over Fiji in Tokyo on Saturday to claim the Pacific Nations Cup. After losing the previous two finals, the Brave Blossoms broke their curse with a decisive 10-minute period late in the game. Mamoru Harada and Ben Gunter provided the platform, but it was Samisoni Tua who crashed over for the winning try. Eddie Jones noted the result provides a vital springboard for his squad as they continue to build towards the 2027 Rugby World Cup."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "465": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "WXV Dominance",
          "heading": "Black Ferns cruise past Scotland as ten tries seal emphatic victory",
          "body": "The Black Ferns kicked off their WXV campaign in style, dismantling Scotland 66-14 at Hive Stadium. New Zealand’s relentless tempo proved too much for the hosts, with the visitors crossing for 10 tries. Mo'omo'oga Palu opened the scoring, while Layla Sae and Amarante Sititi were among those to capitalise on defensive frailties. The victory sets the stage for a major showdown against England next Saturday, as the team looks to maintain this momentum against the world’s top-ranked side."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "467": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Rassie Erasmus releases Pieter-Steph du Toit and Damian de Allende early",
          "body": "Coach Rassie Erasmus has released flanker Pieter-Steph du Toit and centre Damian de Allende from the Springbok squad ahead of the upcoming one-off Test against the Wallabies. Erasmus confirmed the decision on Saturday, citing the demanding workload placed on the pair during the recent Rugby’s Greatest Rivalry series against the All Blacks. The coach stated there is sufficient cover within the travelling party to manage the fixture at Optus Stadium, ensuring the squad remains competitive despite the notable departures."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
}