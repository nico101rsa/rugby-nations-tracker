  "digests": {
    "28": {
      "date": "2026-10-02",
      "edition": "Friday 2 October",
      "sections": [
        {
          "kicker": "TOURNAMENT FORM",
          "heading": "Fiji seek tournament turnaround following their 17-33 defeat against Scotland",
          "body": "Fiji suffered a 17-33 defeat against Scotland in the third round of the tournament. This result leaves the Flying Fijians at the bottom of the standings, where they currently sit 12th out of 12 teams. Across their three matches in this campaign, the team has recorded three defeats with zero victories. The side has scored 49 points in these three games, while they have conceded 145 points. In their last meeting with France in November 2025, Fiji lost 34-21 away."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-10-02",
      "edition": "Friday 2 October",
      "sections": [
        {
          "kicker": "WORLD CUP DRAW",
          "heading": "England face Wales, Tonga and Zimbabwe in 2027 Rugby World Cup",
          "body": "England will face Wales, Tonga and Zimbabwe in Pool F of the 2027 Rugby World Cup following the confirmation of the tournament schedule in Australia. The draw sets up a historic first-ever meeting between the men’s senior side and Zimbabwe in Adelaide, with the African nation making their first tournament appearance since 1991. Steve Borthwick’s men open their campaign against Tonga in Brisbane exactly one year from today, followed by a high-stakes pool encounter with familiar rivals Wales."
        }
      ]
    },
    "387": {
      "date": "2026-10-02",
      "edition": "Friday 2 October",
      "sections": [
        {
          "kicker": "Transfer news",
          "heading": "Exeter Chiefs prop Josh Iosefa-Scott confirms impending move to France",
          "body": "Exeter Chiefs director of rugby Rob Baxter has confirmed that tight-head prop Josh Iosefa-Scott is set to depart for France when his current contract concludes next summer. The 30-year-old has reportedly attracted significant interest from French clubs, with recent coverage linking him to a move to Provence. Despite Exeter’s ongoing contract negotiations, Baxter acknowledged the forward’s intent to secure his future, stating, “I’m aware he’s got a very good offer in France,” as the player explores opportunities following six seasons at Sandy Park."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      },
      "rung": "storyline"
    },
    "388": {
      "date": "2026-10-02",
      "edition": "Friday 2 October",
      "sections": [
        {
          "kicker": "Domestic physicality",
          "heading": "JJ Hanrahan warns Munster of South African side’s intense physical challenge",
          "body": "Munster playmaker JJ Hanrahan believes the involvement of South African clubs in the United Rugby Championship has fundamentally altered the pace and physicality of the game. Ahead of this weekend’s meeting with the Bulls at Thomond Park, the 34-year-old described the four-team influx as \"unbelievably challenging\" but a \"great addition\" to the competition. Having debuted for Munster in a defeat to Glasgow, Hanrahan noted that his side must prioritise building on the \"green shoots\" identified by coach Clayton McMillan."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "389": {
      "date": "2026-10-02",
      "edition": "Friday 2 October",
      "sections": [
        {
          "kicker": "Form assessment",
          "heading": "Italy men’s XV reflect on challenging run of four consecutive defeats",
          "body": "Following a challenging run of four straight defeats, Italy look to find consistency as they head into the latter half of the season. The Azzurri have struggled to gain momentum, recording a solitary victory in their last five outings. Following the recent 57-10 loss to Australia in the Nations Championship, the squad will be aiming to reverse this form during their upcoming home series in November, which commences with a test against reigning world champions South Africa."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-10-02",
      "edition": "Friday 2 October",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Cameron Redpath claims starting inside centre jersey for Bath against Exeter",
          "body": "Cameron Redpath earns his first start of the season at inside centre for Bath as Johann van Graan’s side host Exeter Chiefs at the Rec on Friday. The Scotland star is named in the 12 channel alongside Ollie Lawrence at 13, while Finn Russell continues at fly-half in the half-back pairing alongside Bernard van der Linde."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "391": {
      "date": "2026-10-02",
      "edition": "Friday 2 October",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Steve Tandy integrates young prospects into Wales rugby pathway plans",
          "body": "Wales head coach Steve Tandy is looking beyond the immediate 2027 tournament cycle by casting his net toward the 2031 Rugby World Cup in the United States. Pathway investment has brought talented youngsters into senior alignment camps, including Ospreys full-back Lewis Edwards and Cardiff centre Steffan Emanuel, both of whom excelled during the under-20s World Championship this summer. While immediate preparations continue for next year's pool matches against Zimbabwe, Tonga and England, these rising prospects are being closely monitored for future Test honours."
        }
      ]
    },
    "460": {
      "date": "2026-10-02",
      "edition": "Friday 2 October",
      "sections": [
        {
          "kicker": "Form guide",
          "heading": "Argentina examine recent results across their last five matches",
          "body": "Argentina take stock of their recent form after recording one win, three defeats and one draw in their last five fixtures. The sequence most recently featured a 28-28 draw against Australia at home during September 2026 in international friendlies, giving the coaching staff a clear statistical baseline as preparations continue."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-10-02",
      "edition": "Friday 2 October",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Les Kiss names Toby Macpherson in shock Bledisloe Cup squad",
          "body": "Wallabies head coach Les Kiss has handed uncapped Brumbies utility forward Toby Macpherson a shock call-up in his 34-man squad for the upcoming Bledisloe Cup series against New Zealand. The 22-year-old former Australia under-20 captain earns his selection as a replacement for Tom Hooper, who has returned to Exeter Chiefs. Kiss has retained the bulk of his matchday group from the recent victory over South Africa, alongside welcoming back front-rower Massimo De Lutiis and utility back Filipo Daugunu."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-10-02",
      "edition": "Friday 2 October",
      "sections": [
        {
          "kicker": "Historical rank",
          "heading": "Japan men reflect on reaching best world ranking of No. 7",
          "body": "Japan reached their highest-ever world ranking of No. 7 in 2019. The milestone remains a benchmark for the men's national side as they compete on the international stage."
        }
      ],
      "rung": "data"
    },
    "465": {
      "date": "2026-10-02",
      "edition": "Friday 2 October",
      "sections": [
        {
          "kicker": "Domestic structure",
          "heading": "Dave Rennie defends vital NPC role amid domestic competition overhaul",
          "body": "All Blacks head coach Dave Rennie has thrown his weight behind the National Provincial Championship, describing the competition as a vital part of the country's rugby fabric that feeds directly into Super Rugby. Speaking on Newstalk ZB's Mike Hosking Breakfast, Rennie stressed that the provincial tournament must be maintained amidst New Zealand Rugby's ongoing discussions regarding three major domestic proposals. \"I watched a huge amount of footy on the weekend, so I think it's a great comp,\" he said."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-10-02",
      "edition": "Friday 2 October",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "JP Pietersen names returning Springboks for Sharks against Leinster clash",
          "body": "The Sharks have been bolstered by the return of several Springboks for Saturday's United Rugby Championship fixture against Leinster in Durban. Head coach JP Pietersen has handed a start to Andre Esterhuizen, who will captain the side, alongside Thomas du Toit and Edwill van der Merwe. Ox Nché, Eben Etzebeth and Ethan Hooker are named among the replacements in a 5-3 split. Pietersen told the media that it was quite easy to pick them, adding that the players immediately put their hands up when asked about their availability."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
