  "digests": {
    "28": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "FORM TRACKER",
          "heading": "Fiji slide to three straight defeats after dropping home match against Scotland",
          "body": "Fiji sit at the bottom of the Nations Championship table after suffering three straight defeats in their recent run of form. Across their last five fixtures, the Flying Fijians have secured one victory and suffered four defeats. This sequence includes a 17-33 loss to Scotland on home soil during the July group-stage matches. The team remains without a win in the competition ahead of their next test against France."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "CONTRACT NEWS",
          "heading": "Dan Cole warns Eddie Hearn over Henry Pollock contract demands",
          "body": "England centurion Dan Cole has warned promoter Eddie Hearn that he must lower his standards after demanding a million-pound playing contract for rising back-rower Henry Pollock. Hearn, who recently took on the Northampton Saints prospect as a client, wants his club to fork out megabucks to retain him. However, speaking on their podcast, Cole told co-host Ben Youngs that the boxing promoter will quickly realise rugby is not like Riyadh, as the sport's salary cap offers little room for Saudi-style millions."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "Transfer news",
          "heading": "François Cros reportedly set for move from Toulouse to Lyon side",
          "body": "Toulouse back-rower François Cros is being linked with a departure from the club according to reports from Midi Olympique. While Montpellier reportedly showed interest in the France international, it appears Lyon has secured the forward's signature on a three-year deal. Cros has spent his entire professional career with Les Rouge et Noir to date, making this potential move a significant shift in the Top 14 landscape as the domestic season approaches."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "388": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "Injury update",
          "heading": "Jack Crowley ruled out as Ireland face significant fly-half selection challenge",
          "body": "Ireland have been dealt a major blow with confirmation that fly-half Jack Crowley will not return to action until the new year. Sidelined since April due to a lower limb vascular injury, the 26-year-old will miss the upcoming November block of fixtures. Munster head coach Clayton McMillan stated that \"ensuring he gets back to 100% is the priority.\" Crowley’s continued absence, compounded by a knee injury to new signing Will Harrison, leaves a notable gap at 10 for the autumn tests."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "Transfer news",
          "heading": "Benetton confirms Tommaso Menoncello departure as clubs reload for season",
          "body": "Benetton Rugby has confirmed the departure of centre Tommaso Menoncello ahead of the 2026-27 campaign. The move is part of a broader summer transition for Italy’s flagship club, which has prioritised recruiting international talent from Australia, South Africa, and Argentina to bolster its spine. While Benetton seeks immediate URC playoff contention, the loss of young prospects like Menoncello highlights the ongoing challenge of balancing short-term competitive goals with the long-term development of the domestic pipeline for future national squad selection."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "Concussion litigation",
          "heading": "High Court legal challenge over rugby brain injuries remains unresolved today",
          "body": "The high-profile legal dispute concerning concussion-related brain injuries in rugby continues to progress through the courts. While the High Court recently ruled to allow the case to proceed, avoiding a potential collapse, there has been no new movement or verdict reported as of today. The ongoing proceedings have prompted wider industry discussions, including calls from figures like Steve Hansen to refine tackle techniques and player safety protocols in response to the legal and medical scrutiny."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "Professional structure",
          "heading": "Welsh Rugby Union faces continued uncertainty over future professional team strategy",
          "body": "The future of Welsh professional rugby remains subject to ongoing debate following reports of a radical strategy to reduce the number of professional teams to 3. While the union has acknowledged the significant anger surrounding the proposal, no final decision has been confirmed to resolve the long-term uncertainty beyond 2028. Recent coverage highlights that the four-region model is currently considered unsustainable, leaving stakeholders awaiting further clarity on how the WRU will restructure its professional commitments to ensure financial viability."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "Home defeat",
          "heading": "Argentina falls to Australia as Los Pumas face mounting pressure",
          "body": "Los Pumas endured a frustrating 27-21 defeat to Australia in San Salvador de Jujuy, marking a concerning slide for the side. It is now only 1 victory in 5 matches for Argentina, with that dismal run occurring entirely on home soil. While Boris Wenger, Geronimo Prisciantelli and Joaquin Moro crossed for tries, Australia’s pack controlled the breakdown and lineout defensively. Coach Les Kiss admitted his side was not perfect, yet Argentina’s inability to capitalise at home continues to dominate the discourse."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "461": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "Selection news",
          "heading": "Les Kiss plans smart changes after identifying clunky bits against Argentina",
          "body": "Les Kiss has confirmed he will make tactical adjustments for the upcoming series finale in Mendoza following his side's 27-21 victory over Argentina. While Australia secured a fourth consecutive win, the coach admitted there were \"clunky bits\" in the performance, particularly regarding ruck speed and defensive pressure. Kiss noted that the team needs to be more compact to break down opposition lines, stating, \"We're going to have to be better in that area next week.\""
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "Selection news",
          "heading": "Japan League One revises registration rules after settling player court challenge",
          "body": "Japan Rugby League One has officially amended its controversial player registration system following a settlement with players who filed a legal challenge against the initial proposals. Under the revised framework, naturalised players holding citizenship since May 2025 or earlier will maintain their status alongside native-born players. Additionally, the league introduced \"special measures\" that grant Category A-1 status to any player with 30 or more caps for the Brave Blossoms, directly addressing concerns raised by a group of 25 prominent players."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "Series setback",
          "heading": "New Zealand fall to South Africa as Springboks level the series",
          "body": "The All Blacks saw their series lead vanish in Cape Town, falling 33-26 to a clinical South African side. Despite outscoring the hosts four tries to three through Roigard, McKenzie, Carter, and Savea, New Zealand struggled to contain the Boks’ physical pressure and tactical efficiency. Rassie Erasmus’ late front-row reshuffle proved decisive, with the world champions dominating key collisions. The two nations now head to Johannesburg for the third Test with the series deadlocked at 1-1."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "467": {
      "date": "2026-08-31",
      "edition": "Monday 31 August",
      "sections": [
        {
          "kicker": "Series levelled",
          "heading": "South Africa hold off All Blacks fightback to level the series",
          "body": "South Africa drew level in the four-Test series after edging New Zealand 33-26 in Cape Town on Saturday. Rassie Erasmus masterminded the victory by switching his front row shortly before kick-off, a move that helped the world champions control the collision zones. Cheslin Kolbe starred with 18 points, while a crucial late turnover from replacement Cameron Hanekom secured the result. Following the win, Erasmus hit back at claims regarding his side's scrummaging, stating: “Don't come with that nonsense saying we're walking around.”"
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    }
  }
