  "digests": {
    "28": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "Cup final",
          "heading": "Fiji lose Pacific Nations Cup crown to Japan after late try",
          "body": "A costly yellow card and defensive lapses saw Fiji yield their Pacific Nations Cup crown in Saturday's final, losing 20-15 to Japan in Tokyo. Prop Mesake Doge's first-half sin-binning allowed the hosts to capitalise, though tries from Virimi Vakatawa and Tevita Ikanivere kept the holders ahead 12-10 at half-time. After Isaiah Armstrong-Ravula levelled the scores at 15-15, Japan took advantage of late fatigue, with Samisoni Tua crashing over inside the final ten minutes."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "386": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "COACHING INTEREST",
          "heading": "Shaun Edwards confirms interest in joining Steve Borthwick’s England coaching staff",
          "body": "Former France defence coach Shaun Edwards has expressed a desire to return to international rugby for the 2027 Six Nations, specifically noting his openness to working under Steve Borthwick. Speaking after his recent departure from the French set-up, the 59-year-old described himself as a \"proud Englishman\" who would be disappointed to miss next year’s tournament. Edwards, who won three titles with Les Bleus, told the Daily Mail he has no grudge against France but remains keen to represent his country."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "WORLD CUP PLANNING",
          "heading": "Fabien Galthié secures protected status for Antoine Dupont and elite stars",
          "body": "The French Rugby Federation has reached a landmark agreement with Top 14 clubs to safeguard 33 \"premium\" players in the build-up to the 2027 World Cup. This protected list, which includes 13 Toulouse stars such as Romain Ntamack, mandates a rest weekend every four club matches to mitigate injury risks. Selection is also capped, with those named restricted to just nine Tests per season across the Nations Championship and Six Nations windows as Les Bleus prioritise long-term conditioning after sitting third in the current standings."
        }
      ]
    },
    "388": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "COACHING PERSPECTIVE",
          "heading": "Jacques Nienaber claims club rugby innovation outpaces Andy Farrell's Ireland squad",
          "body": "Leinster senior coach Jacques Nienaber believes the club game is \"two years or three years ahead\" of Test rugby regarding tactical innovation. The former Springboks boss argued that the heavier club schedule allows for bolder system designs than the international arena, where the historical weight of results often discourages creativity. Nienaber noted that while Test matches are \"written in history\", the volume of fixtures at Leinster provides a superior laboratory for testing the \"new systems\" and \"new plans\" required to stay ahead."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "COACHING BAN",
          "heading": "World Rugby bans Italy head coach Gonzalo Quesada following refereeing comments",
          "body": "World Rugby has issued a touchline ban to Italy head coach Gonzalo Quesada following his public criticism of officiating during the ongoing Nations Championship. The disciplinary ruling comes as a significant blow to the Azzurri, who remain winless after three rounds of the competition. With the side currently sitting 11th in the standings, Quesada’s absence from the technical zone will complicate preparations for the upcoming fixture against South Africa, as the squad seeks to rectify a porous defence that has surrendered 131 points to date."
        }
      ]
    },
    "390": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "EXPANSION DEBATE",
          "heading": "Jim Hamilton warns \"sacred\" Six Nations does not need US move",
          "body": "Former Scotland lock Jim Hamilton has criticised World Rugby proposals to move Six Nations fixtures to the United States, insisting the tournament’s traditional format is \"sacred\". The governing body recently floated plans to stage flagship matches across the Atlantic to grow the game ahead of the 2031 World Cup. While discussions have reportedly opened, Hamilton argued that the competition should remain in its European heartlands, joining a growing chorus of former players questioning any commercial shift away from loyal home supporters."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "REGIONAL RESTRUCTURE",
          "heading": "Welsh Rugby Union commits to reducing professional regions from four to three",
          "body": "The WRU has confirmed a commitment to reduce Wales' professional men's regions from four to three, heightening off-field uncertainty despite an increased annual budget. This structural overhaul arrives as several national stalwarts, including Jac Morgan and Dewi Lake, depart their respective clubs. While the regions have secured 2026-27 signings like Gareth Anscombe and Tom Rogers, the consolidation aims to address long-term viability. Discussing Rogers, Ospreys coach Mark Jones said: \"Tom is a bit of a Swiss Army Knife in the fact he is equally adept at full-back and wing.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "DEFENSIVE METRICS",
          "heading": "Argentina concede 346 points across 11 matches during defensive slump",
          "body": "Argentina have conceded 346 points across their last 11 fixtures, averaging 31.5 points per game during a period of significant defensive pressure. While Los Pumas have maintained an attacking output of 29.2 points per match in that same window, their biggest recent success remains the 52-28 victory over Wales in November 2025. Squad depth remains a focus for captain Julián Montoya, who holds 120 caps, as Felipe Contepomi’s side looks to improve on a negative points difference before their Nations Championship meeting with Ireland."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "SQUAD RECALL",
          "heading": "Jordan Petaia returns to Wallabies squad after injury ruined NFL stint",
          "body": "Jordan Petaia has been recalled to the Wallabies squad following the revelation that a misdiagnosed hamstring injury ended his NFL career with the Los Angeles Chargers. The 26-year-old utility back, who recently joined Urayasu D-Rocks in Japan, was included in Les Kiss’s latest 34-man selection, ending an international exile dating back to the 2023 Rugby World Cup. Petaia explained that he attempted to train through what was thought to be minor tendonitis before a second opinion confirmed a more serious injury."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "Historic Victory",
          "heading": "Eddie Jones guides Japan to Pacific Nations Cup triumph over Fiji",
          "body": "Japan secured their first Pacific Nations Cup title since 2019, defeating Fiji 20-15 in a physical encounter at Prince Chichibu Memorial Stadium. After trailing by two points at half-time, Japan’s forwards fronted up, with flanker Ben Gunter scoring a crucial second-half try. Samisoni Tua crossed for the winner with 10 minutes remaining to seal the result. Captain Naoto Saito described the win as a \"great breakthrough to create history for Japan\" that provides the young squad with significant confidence."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "465": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "Scrum scrutiny",
          "heading": "Shane Howarth backs coach’s theory regarding New Zealand’s set-piece struggles",
          "body": "The All Blacks’ scrum dominance remains a primary focus following the recent series against South Africa. Former All Black Shane Howarth suggests that the loss of South African teams from Super Rugby has hindered the development of New Zealand’s forward pack. “When we lost South Africa from Super Rugby, we lost a strong ability of scrummaging and that's now gone to Europe, that's gone to the URC,” Howarth noted. He argued that facing that physicality regularly is essential for catching up to their rivals."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Rassie Erasmus releases Pieter-Steph du Toit and Damian de Allende early",
          "body": "Coach Rassie Erasmus has released flank Pieter-Steph du Toit and centre Damian de Allende from the Springbok squad ahead of next Sunday’s one-off Test against the Wallabies. The pair will return home to spend time with their families following the demanding workload of the four-match Rugby’s Greatest Rivalry series against the All Blacks. Erasmus confirmed there is sufficient cover within the travelling squad to manage their absence for the upcoming fixture at Optus Stadium."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
}