  "digests": {
    "28": {
      "date": "2026-08-06",
      "edition": "Thursday 6 August",
      "sections": [
        {
          "kicker": "COACHING APPOINTMENT",
          "heading": "Willie Walker departs the Blues for new Fiji Rugby coaching opportunity",
          "body": "Fiji Rugby has secured a major coup by appointing three-time champion coach Willie Walker, who is leaving the Blues. Walker, who guided the New Zealand franchise to three consecutive Super Rugby Aupiki titles, departs after six seasons to take up a new coaching opportunity with the union. While his specific role within the Fijian setup remains unconfirmed, his pedigree is undeniable. The former Māori All Black built a dominant women's programme in Auckland, and his arrival marks a significant boost for the national system."
        }
      ]
    },
    "386": {
      "date": "2026-08-06",
      "edition": "Thursday 6 August",
      "sections": [
        {
          "kicker": "Financial deficit",
          "heading": "RFU expects £10m loss after Steve Borthwick oversaw fifth-place finish",
          "body": "The Rugby Football Union (RFU) projects a total net loss of £10m for the financial year ending June 2026, largely attributed to a disappointing campaign in the Six Nations. England lost four of their five fixtures under Borthwick, leading to a significant drop in prize money. Despite the shortfall, chief executive Bill Sweeney insisted the union has \"continued to perform in line with our plans,\" pointing to a 50% rise in sponsorship revenue as the RFU targets the largest commercial income in world rugby."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "387": {
      "date": "2026-08-06",
      "edition": "Thursday 6 August",
      "sections": [
        {
          "kicker": "RANKING RECORD",
          "heading": "France reached the summit of the world rankings for one week",
          "body": "France reached the summit of the World Rugby rankings for a single week in July 2022. This remains the side's longest unbroken spell at No. 1. In the current Nations Championship, the squad sits third in the standings after three matches. Following the 42-15 win over Japan, the team has registered two victories and one defeat. This record includes 116 points scored and 75 points conceded — a point difference of +41 — across the opening three rounds of the tournament."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-06",
      "edition": "Thursday 6 August",
      "sections": [
        {
          "kicker": "LEGAL CHALLENGE",
          "heading": "Former players face concussion lawsuit dismissal as lead solicitor departs landmark case",
          "body": "Rugby’s landmark legal action regarding brain injuries is facing potential collapse following reports today that the lead solicitor representing former players has departed. This setback occurs at a critical juncture for the case, as the High Court evaluates applications that could see 95% of the claims struck out. With the matter in jeopardy, the future of the lawsuit remains uncertain while the judge considers the standing of the remaining claimants. No final ruling or settlement has been reached in the ongoing proceedings."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-08-05",
      "edition": "Wednesday 5 August",
      "sections": [
        {
          "kicker": "Transfer news",
          "heading": "Italy international Ion Neculai joins Gallagher Premiership champions Northampton Saints",
          "body": "Tighthead prop Ion Neculai has signed with Northampton Saints ahead of the 2026/27 season, departing Zebre Parma after five years. The 25-year-old, who earned his 4th Italy cap against Australia last month, arrives at Franklin's Gardens having made 51 appearances for his former club. Saints director of rugby Phil Dowson praised the forward's physicality and potential. Italy have previously reached a best-ever world ranking of No. 8, a benchmark achieved in both 2007 and 2024."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-06",
      "edition": "Thursday 6 August",
      "sections": [
        {
          "kicker": "Coaching exit",
          "heading": "Sione Fukofuka steps down as Scotland head coach following family relocation difficulties",
          "body": "Sione Fukofuka has unexpectedly stepped down as Scotland Women head coach, citing the \"stress and the strain\" of being separated from his family in Australia. Having led the side through the Women's Six Nations, the former USA boss requested a release on compassionate grounds after personal circumstances made his family's relocation to Scotland unfeasible. Forwards coach Dave Butcher takes interim charge for the upcoming WXV series, supported by new assistants Chris Laidlaw and Tom Luke, as the governing body manages another significant departure from its coaching stable."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-08-06",
      "edition": "Thursday 6 August",
      "sections": [
        {
          "kicker": "World Rankings",
          "heading": "Wales set for top 10 return without playing a match",
          "body": "Wales are on the verge of returning to the world’s top 10 for the first time since July 2024. Steve Tandy’s side, currently ranked 11th, will move up in the World Rugby rankings should Japan lose to Australia in Osaka this weekend. The Brave Blossoms, who sit just 0.04 points ahead of Wales, face a difficult test against the Wallabies. A defeat for the hosts would see them drop two places, allowing Wales and Italy to climb in the standings by default."
        }
      ]
    },
    "460": {
      "date": "2026-08-06",
      "edition": "Thursday 6 August",
      "sections": [
        {
          "kicker": "Disciplinary blow",
          "heading": "Tomás Albornoz receives four-match suspension for intimidating referee after England defeat",
          "body": "Argentina flyhalf Tomás Albornoz has been issued a four-match ban following a disciplinary hearing into his conduct after the Nations Championship defeat to England. The committee found that his actions towards referee Angus Gardner were intimidatory, noting he had to be restrained by teammates. Having accepted the misconduct charge and offered apologies, Albornoz will miss this weekend's fixture against South Africa, upcoming Tests against Australia, and a club match for Toulon. His absence leaves a significant gap in the Pumas' tactical line-up."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "461": {
      "date": "2026-08-06",
      "edition": "Thursday 6 August",
      "sections": [
        {
          "kicker": "Selection talk",
          "heading": "Quade Cooper eyes Wallabies return for the 2027 home World Cup",
          "body": "Thirty-eight-year-old Quade Cooper has declared he is interested in a Wallabies comeback for the 2027 home World Cup. Despite not playing professionally since May 2025, Cooper insists he never officially retired. While former teammates Drew Mitchell and Matt Giteau have publicly backed his ambition, reporting suggests there is currently no appetite from Australian Super Rugby clubs to offer the playmaker a contract. Cooper remains based in Japan, where he is currently working in a coaching capacity for his club."
        }
      ],
      "match": {
        "venue": "Hanazono Rugby Stadium, Osaka",
        "referee": "Eoghan Cross"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-06",
      "edition": "Thursday 6 August",
      "sections": [
        {
          "kicker": "Tournament update",
          "heading": "Japan to host shortened Pacific Nations Cup featuring four teams",
          "body": "Japan will host the 2026 Asahi Super Dry Pacific Nations Cup from 12–19 September, featuring a reduced field of four nations. The hosts will compete alongside defending champions Fiji, Canada, and the USA. Semifinals are scheduled for 12 September at Hanazono Rugby Stadium in Osaka, with the finals to follow on 19 September at Prince Chichibu Memorial Stadium in Tokyo. The condensed format aligns with the wider transformation of the international calendar and the inaugural Nations Championship."
        }
      ],
      "rung": "data"
    },
    "465": {
      "date": "2026-08-06",
      "edition": "Thursday 6 August",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Beauden Barrett returns to start as All Blacks face the Stormers",
          "body": "Beauden Barrett will headline the All Blacks’ tour opener against the Stormers, marking his return to the side after sitting out the Nations Championship. Head coach Dave Rennie has named an experienced squad for the Cape Town clash, with Patrick Tuipulotu set to captain the team as Codie Taylor continues his recovery from a calf injury. Rennie expects a stern test from a motivated home side looking to impress, noting that every squad member is eager to stake a claim."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-08-06",
      "edition": "Thursday 6 August",
      "sections": [
        {
          "kicker": "Coaching scrutiny",
          "heading": "Rassie Erasmus questions World Rugby's attacking agenda before Argentina Test match",
          "body": "Rassie Erasmus has challenged the global trend prioritising attacking spectacle over traditional set-piece battles. While acknowledging World Rugby’s success in driving higher scores, the Springboks head coach remains wary of the shift, noting that World Cup knockout stages often revert to defensive pressure. “World Rugby is definitely driving and supporting the attacking side of the game a hell of a lot,” Erasmus told reporters. As South Africa prepares to face Argentina, the focus remains on maintaining balance across all fundamental phases."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
