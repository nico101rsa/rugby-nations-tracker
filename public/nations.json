  "digests": {
    "28": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
          "kicker": "WORLD RANKINGS",
          "heading": "Fiji reached their peak global position of No. 7 in 2023",
          "body": "Fiji achieved their highest-ever world ranking of No. 7 in 2023, representing the peak of their modern achievements. Currently, the team sit 12th in the tournament standings after three matches. In this three-game block, they have suffered three losses. They managed to score 49 points during those three matches. Over the same three games, they conceded 145 points. These results leave the side with a point difference of minus 96 ahead of their upcoming fixtures."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
          "kicker": "Contract news",
          "heading": "Rugby league monitors Henry Pollock amid Eddie Hearn's £1m wage demands",
          "body": "Rugby league is reportedly monitoring Henry Pollock as the fallout from Eddie Hearn's £1m-a-season valuation of the flanker continues. Although Pollock was overlooked for the start against Argentina, his off-field value remains the main talking point. England greats have warned Hearn that union's financial landscape cannot replicate Riyadh-style boxing purses, but rival league scouts are alert to the rising star's situation as contract talks loom under salary cap rules."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "387": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
          "kicker": "FORM GUIDE",
          "heading": "Fabien Galthié's France secure second consecutive victory with dominant win over Japan",
          "body": "France go into the autumn break sitting third in the Nations Championship table following their 42-15 victory against Japan. That result in July marks a second consecutive win for Fabien Galthié's side, who have now found their rhythm with three victories from their last five outings. Having scored 116 points across the opening three rounds, the squad currently holds a positive points difference of 41 as they prepare for the November window."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
          "kicker": "Concussion litigation",
          "heading": "Ireland face uncertainty as High Court allows landmark rugby concussion lawsuit",
          "body": "The High Court has granted a reprieve to former players by allowing a landmark brain injury lawsuit against rugby’s governing bodies to continue. The ruling follows an unsuccessful bid by World Rugby and national unions to have the litigation dismissed. Although the lawyer leading the case has reportedly been forced out, the decision ensures the legal challenge remains active. With today’s press offering no coverage of a specific Irish response, the focus remains on the broader implications for the sport’s administration and the evolution of player welfare standards."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
          "kicker": "Transfer news",
          "heading": "Benetton confirms Tommaso Menoncello departure as domestic clubs reshape squads",
          "body": "Benetton has confirmed the departure of centre Tommaso Menoncello as part of a significant summer turnover for the Treviso club. While the side has bolstered its ranks with international signings including Jean Smith and Louis Werchon to sustain their push for playoff positions, the loss of Menoncello alongside other Italian prospects like Roberto Fasti and Matteo Noventa signals a transition in the club’s development pipeline. Both Benetton and Zebre Parma now look to integrate these new-look squads ahead of the coming campaign."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
          "kicker": "Community outreach",
          "heading": "Scotland Women players visit grassroots clubs to inspire future talent",
          "body": "Scotland Women stars have spent the week engaging with local clubs and schools as part of a Community Bus Tour ahead of the upcoming WXV series. Players including Evie Gallagher and Elis Martin held rugby sessions at Balfron High School and Lenzie RFC to connect with young supporters. Elis Martin noted, \"Building a legacy is one of the most important reasons for why we do what we do,\" as the squad prepares for fixtures against Canada, New Zealand, and Australia."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
          "kicker": "Selection news",
          "heading": "Prop Stella Orrin eyes maiden Wales cap in upcoming WXV series",
          "body": "Young prop Stella Orrin is targeting a senior Test debut this autumn as Wales prepare for the WXV Global Series. After earning her first matchday squad selection earlier this year, the 20-year-old remains optimistic about her prospects against South Africa, the USA, and Japan. While Orrin previously appeared off the bench during the victory over the Barbarians in June, she is now eager to secure her first official international cap, stating: \"I really trust the coaches and the girls that are around me.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
          "kicker": "Match analysis",
          "heading": "Argentina struggles at home as Australia secures 27-21 series advantage",
          "body": "Los Pumas now face a challenging path following Saturday’s 27-21 defeat against Australia in San Salvador de Jujuy. Despite tries from Geronimo Prisciantelli, Joaquin Moro, and Boris Wenger, Argentina could not bridge the gap created by a clinical Australian side. The result leaves the team searching for answers, having managed only one victory in their last 5 home matches. Coach Les Kiss acknowledged the match was far from perfect, noting \"clunky bits\" in the visitors' performance that Argentina must exploit in the Mendoza return leg."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "461": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Les Kiss eyes smart changes after admitting to Argentina win clunkiness",
          "body": "Les Kiss has promised tactical adjustments for the upcoming series finale in Mendoza after identifying “clunky bits” in Saturday’s 27-21 victory over Argentina. While Australia extended their winning streak to 4 matches, Kiss noted that his side struggled to manage the ruck and lacked compactness in defence against a high-pressure Pumas outfit. “We’re going to have to be better in that area next week,” Kiss said, though he praised his leaders for remaining calm while under pressure in the San Salvador de Jujuy altitude."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
          "kicker": "Selection news",
          "heading": "Japan Rugby League One reverses restrictive policy on naturalised player status",
          "body": "Japan Rugby League One has officially backtracked on controversial registration rules that would have categorised naturalised players as foreigners. Following legal challenges and a fierce backlash from players, the league confirmed that those who held Japanese citizenship by May 2025 will maintain their status as domestic players. Managing Executive Director Hajime Shoji admitted, \"The criticism was much stronger than we expected. We underestimated the reaction,\" while promising that the league will better prioritise communication with affected athletes moving forward."
        }
      ]
    },
    "465": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
          "kicker": "Series tied",
          "heading": "South Africa overcome All Blacks fightback to level the Test series",
          "body": "The All Blacks saw their bid for a series-defining victory ended in Cape Town, as South Africa secured a 33-26 win to level the series at 1-1. Despite New Zealand scoring four tries to three—through Roigard, McKenzie, Carter and Savea—the world champions’ clinical edge proved decisive. Rassie Erasmus has since identified the All Blacks’ attacking ability in the wider channels as a primary concern, insisting that his side must better contain the visitors' one-on-one threats ahead of Saturday’s third Test."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "467": {
      "date": "2026-09-01",
      "edition": "Tuesday 1 September",
      "sections": [
        {
