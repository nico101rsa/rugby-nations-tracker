    "389": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "WXV campaign",
          "heading": "Italy women dominate Japan 55-21 in WXV Global Series tournament opener",
          "body": "The Italy women's side opened their WXV Global Series campaign with a commanding 55-21 victory over the Sakura XV at Stadio Omero Tognon. After briefly trailing early, the Azzurre responded with a flurry of tries from Alyssa D'Inca, Vittoria Vecchini, and Giordana Duca to seize control. Captain Vittoria Ostuni Minuzzi marked her 50th cap with a second-half score, helping Italy record their highest-ever points tally against Japan in a dominant display that saw the visitors outplayed in all facets."
        },
        {
          "kicker": "Around the world",
          "heading": "Japan beat Fiji 20-15 to win Pacific Nations Cup title",
          "body": "Australia: Wallabies recall Jordan Petaia for upcoming Springboks Test. New Zealand: All Blacks captain Ardie Savea faces six-month injury layoff. South Africa: Springboks release Pieter-Steph du Toit and Damian de Allende early."
