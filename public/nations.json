  "digests": {
    "28": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Transfer U-Turn",
          "heading": "Joji Nasova remains with Fijian Drua after Newcastle Red Bulls move collapses",
          "body": "Fijian wing Joji Nasova will remain with the Fijian Drua after his planned transfer to Premiership side Newcastle Red Bulls was called off. The 25-year-old Olympic sevens silver medallist had signed a deal to move to England, but the club agreed to release him from his contract due to personal reasons. Newcastle general manager Neil McIlroy stated the club respected the \"unique personal circumstances\" behind the decision. Nasova, who has scored four tries in three test appearances for Fiji, provides a significant boost for the local franchise."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "386": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Rivalry Fuel",
          "heading": "Ellis Genge invoked England football’s World Cup defeat to inspire Argentina victory",
          "body": "Newly released dressing room footage has revealed how vice-captain Ellis Genge used England’s midweek football World Cup semi-final loss to Argentina to galvanise the squad in Santiago. Genge urged teammates to “cause some f***** pain with ball in hand” during an emotional pre-match address featuring 16 dubbed-out expletives. While the speech fuelled a 31-24 win last Saturday, former Lions captain Sam Warburton has since warned Steve Borthwick to employ “tough love” following a run of 14 yellow cards in eight matches this year."
        }
      ],
      "match": {
        "venue": "Santiago del Estero"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Power Rankings",
          "heading": "France Set Alarm Bells Ringing Following Recent Nations Championship Power Rankings",
          "body": "Les Bleus have faced fresh criticism in the latest international power rankings after a mixed Nations Championship campaign. While France secured a convincing 42-15 victory over Japan in Round 3 to sit third on the current tournament log, observers have questioned their overall form. This assessment comes as analysts suggest recent opponents have failed to test the top-ranked sides effectively, leaving questions regarding how France will perform against more challenging defensive structures in the upcoming November series."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "388": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Coaching Scrutiny",
          "heading": "Andy Farrell rues Ireland errors as All Blacks extend unbeaten streak",
          "body": "Andy Farrell expressed frustration following Ireland’s 40-21 defeat to New Zealand in the Nations Championship, labelling the team’s performance \"inaccurate.\" A series of handling errors and disciplinary lapses proved costly at Eden Park, where the All Blacks extended their long-standing unbeaten run. Despite second-half tries from Joe McCarthy and Hugo Keenan, the result leaves Ireland reflecting on a season-ending loss, with the head coach highlighting a clear need for his side to learn from these southern hemisphere experiences."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "389": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Disciplinary update",
          "heading": "Marco Riccioni receives two-match ban following sideline red card incident",
          "body": "Italy tighthead prop Marco Riccioni has been handed a two-match suspension following his red card in the defeat to Australia. The Foul Play Review Committee found Riccioni guilty of conduct contrary to the spirit of good sportsmanship under Law 9.27 after he was involved in a touchline brawl in the 66th minute. While the sanction was reduced from four weeks due to his admission and remorse, the ban excludes him from Perpignan’s upcoming pre-season friendlies."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Competition Accolades",
          "heading": "Gregor Townsend’s Scotland Earn High Praise Following Strong Nations Championship Showing",
          "body": "Scotland’s momentum continues to draw international attention following their mid-year tour. Having beaten Argentina and Fiji while pushing South Africa close at Loftus Versfeld, the squad has earned recognition in the Nations Championship awards. While a signature win against a top-three side remains the primary objective, Pierre Schoeman believes the team’s recent trajectory confirms their status among the global elite. Gregor Townsend has been credited for his role in building a side now capable of competing consistently at this level."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "391": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Squad Development",
          "heading": "Jac Morgan insists Wales are closing the gap to world’s best",
          "body": "Flanker Jac Morgan remains optimistic that Wales are making progress despite their recent 43-0 Nations Championship defeat to South Africa. While Steve Tandy’s side finished the season with 3 wins from 12 Tests, Morgan pointed to improvements in the squad’s cohesion and performances earlier in the campaign against Scotland and Ireland. Tandy, who admitted to being \"bitterly disappointed\" by the Durban result, is now looking to refine his side's accuracy before the autumn fixtures against Japan, New Zealand and Australia."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Disciplinary fallout",
          "heading": "Nigel Owens demands action following referee abuse after Argentina’s England loss",
          "body": "Nigel Owens has condemned the treatment of Angus Gardner after the match official was subjected to abuse following Argentina’s 24-31 defeat to England. The former referee labelled the post-match scenes and the behaviour of Tomás Albornoz towards the officiating team as \"totally, totally unacceptable\" during a review of the game’s controversial final moments. With World Rugby issuing misconduct charges against the player, Owens insisted such incidents must be dealt with strictly to protect the integrity of the sport."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Selection Call",
          "heading": "Les Kiss recalls Lukhan Salakaia-Loto for his first Wallabies training squad",
          "body": "New head coach Les Kiss has signalled the start of his tenure by including Lukhan Salakaia-Loto in his initial 34-man squad for the upcoming Tests against Japan. The Reds forward returns to the fold following a \"robust conversation\" among the coaching staff, with Kiss emphasising that no positions are guaranteed as the team builds towards the 2027 World Cup. The squad, which retains Harry Wilson as captain, features Isaac Henry as the sole uncapped player following Len Ikitau’s injury."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Statistical Overview",
          "heading": "Japan maintains attacking intent despite defensive challenges in recent test matches",
          "body": "In their last 11 games, Japan has demonstrated a high-octane but demanding approach, scoring 278 points while conceding 334. This period reflects an average of 25.3 points scored and 30.4 points conceded per match. The side’s most clinical display in this window remains their 62-24 victory away against Tonga during the 2025 Pacific Nations Cup knockout stage, highlighting the team's ability to dominate when finding their rhythm."
        }
      ],
      "rung": "data"
    },
    "465": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Transfer news",
          "heading": "All Blacks legend Ma'a Nonu makes bombshell move to the Sharks",
          "body": "Former All Black Ma'a Nonu has confirmed a short-term move to the Sharks in Durban. The 44-year-old double World Cup winner, who recently completed a stint with RC Toulon, arrives on a modest salary to provide leadership and mentorship to the squad’s emerging talent, such as Jurenzo Julius and Ethan Hooker. Nonu returns to professional rugby for an eighth team, aiming to support the franchise following their recent internal restructuring and the permanent appointment of head coach JP Pietersen."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Tournament Accolades",
          "heading": "Springboks and Rassie Erasmus named winners in Nations Championship awards",
          "body": "South Africa have been recognised as the standout performers of the inaugural Nations Championship's southern pool, with Rassie Erasmus securing the coach of the series title after an unbeaten campaign. Despite rotating his squad heavily, Erasmus oversaw three consecutive victories, including a 43-0 win against Wales. Pieter-Steph du Toit was named player of the series for his versatile contributions across multiple positions, helping the Springboks finish with 130 points scored and only 49 conceded across their three matches."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
