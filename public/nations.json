  "digests": {
    "28": {
      "date": "2026-09-22",
      "edition": "Tuesday 22 September",
      "sections": [
        {
          "kicker": "PNC heartbreak",
          "heading": "Vakatawa's early try in vain as Fiji lose Pacific Nations Cup final",
          "body": "Fiji's bid for a third consecutive Pacific Nations Cup title ended in heartbreak after a late Samisoni Tua try condemned them to a 20-15 defeat against Japan in Tokyo on Saturday. Despite losing Mesake Doge to a first-half yellow card, the Flying Fijians led 12-10 at the interval through tries from Virimi Vakatawa and hooker Tevita Ikanivere. Isaiah Armstrong-Ravula locked the scores at 15-15 with a penalty midway through the second half, but the visitors could not hold out as the Brave Blossoms struck late to reclaim the trophy."
        },
        {
          "kicker": "Around the world",
          "heading": "All Blacks captain Ardie Savea faces lengthy sideline spell after surgery",
          "body": "Wallabies recall Jordan Petaia after brief NFL stint. Springboks release Pieter-Steph du Toit and Damian de Allende home."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "386": {
      "date": "2026-09-22",
      "edition": "Tuesday 22 September",
      "sections": [
        {
          "kicker": "Winning streak ends",
          "heading": "England Women held to draw as historic winning run reaches conclusion",
          "body": "The Red Roses’ remarkable 39-match winning run came to an end on Friday after being held to a 26-26 draw by Canada at Sandy Park. Despite tries from Claudia Moloney-MacDonald, Hannah Botterman and Bryony Field, John Mitchell’s side could not overcome a relentless Canadian effort in the WXV Global Series fixture. Canada become the first team to avoid defeat against England since the 2022 World Cup final, though the team remains unbeaten in 40 Tests."
        },
        {
          "kicker": "Around the world",
          "heading": "Japan defeat Fiji to secure Pacific Nations Cup title",
