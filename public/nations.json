  "digests": {
    "28": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Transfer u-turn",
          "heading": "Joji Nasova remains with Fijian Drua as Newcastle Red Bulls move collapses",
          "body": "Olympic sevens silver medallist Joji Nasova has withdrawn from a move to Newcastle Red Bulls, with the Premiership side agreeing to release the 25-year-old wing for personal reasons. Nasova, who has scored four tries in three test appearances, will now remain in Fiji with the Drua. Newcastle general manager Neil McIlroy stated the club \"fully understand and respect\" the circumstances behind the decision. The retention provides a timely boost for the domestic game following the national side's winless opening leg of the Nations Championship."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "386": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Disciplinary row",
          "heading": "Ben Youngs brands Argentina \"disgraceful\" as fallout from England's victory intensifies",
          "body": "Former England internationals Ben Youngs and Anthony Watson are urging World Rugby to take action following the chaotic conclusion of the round three win over Argentina. The former scrum-half criticised Los Pumas head coach Felipe Contepomi—who accused England of a \"lack of respect\" before storming out of his press conference—while labelling the team's conduct toward referee Angus Gardner as \"unforgivable behaviour.\" The Santiago fixture was marred by a record number of yellow cards and scuffles, including an alleged strike on Tommy Freeman. England sit fourth in the table."
        }
      ],
      "match": {
        "venue": "Santiago",
        "referee": "Angus Gardner"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Travel concerns",
          "heading": "France sit third as tournament organisers ignore Ben Earl's travel schedule complaints",
          "body": "There has been no update today from tournament organisers regarding the \"brutal\" travel schedule criticised by players earlier this week. The issue remains unresolved following the conclusion of the first Nations Championship leg, with no new reports of officials addressing the logistical concerns first raised by England's Ben Earl on Wednesday. France currently sit third in the overall standings following their 42-15 win over Japan, though today's press carries no mention of the French camp commenting on their recent cross-hemisphere tour travel."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "388": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "FLY-HALF DEBATE",
          "heading": "Brian O'Driscoll insists Jack Crowley remains Ireland's premier fly-half over Sam Prendergast",
          "body": "Brian O'Driscoll has dismissed suggestions that Sam Prendergast’s mid-year run has jeopardised Jack Crowley’s status as Ireland’s first-choice No. 10. Prendergast had a \"mixed bag\" in the 40-21 defeat to New Zealand, missing six of 22 tackle attempts as the All Blacks targeted his defensive channel. Crowley has been sidelined since April with a blood vessel injury, but O'Driscoll believes the defensive gap between the playmakers remains \"night and day\" as Farrell’s squad concludes the season with two wins from three matches."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-07-24",
      "edition": "Friday 24 July",
      "sections": [
        {
          "kicker": "Form slump",
          "heading": "Italy suffer fourth consecutive defeat after heavy loss away to Australia",
          "body": "Italy's current run of form shows four straight defeats following their away loss to Australia in the Nations Championship group stage. In their last five fixtures, they have won just once and lost four times, with that sole victory now followed by a mounting losing streak. The latest setback came in a 57-10 defeat in Australia."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "World status",
          "heading": "Pierre Schoeman claims Scotland are a top-five team after Nations Championship tour",
          "body": "Pierre Schoeman has rejected the idea that Scotland are merely \"closing the gap\" on rugby's elite, asserting that Gregor Townsend’s side already belongs in the world’s top five. Following the 33-17 victory over Fiji, the loosehead prop echoed recent praise from Rassie Erasmus, who suggested the Scots are currently a top-three nation. While a narrow defeat in Pretoria denied them a statement victory, two wins from three in the Southern Hemisphere leg leave Scotland as the leading Home Union on 11 points."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "COACHING APPOINTMENT",
          "heading": "Leigh Halfpenny joins Cardiff full-time after Nations Championship stint with Wales",
          "body": "Leigh Halfpenny has formalised his move into coaching by joining Cardiff full-time following a stint with the Wales national squad. The 101-cap legend, who scored 801 points during his decorated international career, served as kicking coach during the opening three rounds of the Nations Championship. Cardiff head coach Corniel van Zyl cited Halfpenny’s \"meticulous approach\" as key to his appointment. The 37-year-old will now lead kicking and skills development at the Arms Park, working across the senior squad and academy systems."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "460": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "DISCIPLINARY OUTCOME",
          "heading": "World Rugby charges Tomás Albornoz with misconduct after contact with Angus Gardner",
          "body": "Tomás Albornoz faces a World Rugby misconduct charge following his confrontation with referee Angus Gardner after the 31-24 defeat to England. The fly-half made contact with the official while protesting the decision to disallow Bautista Delguy’s last-minute try in Santiago del Estero. Nigel Owens condemned the \"totally unacceptable\" behaviour of the players and the crowd, who threw objects at the officials. Owens backed the call but noted the lengthy review fuelled the post-match hostility."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Selection news",
          "heading": "Les Kiss recalls Lukhan Salakaia-Loto in his first Wallabies squad",
          "body": "New head coach Les Kiss has unveiled his first 34-man Wallabies squad, headlined by the return of Reds forward Lukhan Salakaia-Loto. Following a \"robust conversation\" among the coaching staff, the powerhouse lock joins uncapped centre Isaac Henry and Isaac Kailea as the primary new faces. While Kiss has retained Harry Wilson as captain, he warned that nobody is guaranteed a spot, prioritising form and cohesion as the team begins preparations for the upcoming two-Test series against Japan."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Les Kiss names 34-man Wallabies squad for Japan test series",
          "body": "New Wallabies head coach Les Kiss has named a 34-man squad for the upcoming two-test series against Japan, featuring Reds centre Isaac Henry as the group's only uncapped player. Henry earns his call-up following an ankle injury to Len Ikitau. Kiss also confirmed that Harry Wilson will retain the captaincy for the tour, which begins in Osaka on August 8. Addressing the selection process, Kiss said: “As coaches we’ve looked to bring together a group based on form, cohesion and how we want to play.”"
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "465": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Injury boost",
          "heading": "Fabian Holland makes successful return for Otago ahead of Springboks tour",
          "body": "All Blacks second-row Fabian Holland has returned to action following a five-month layoff caused by a shoulder dislocation. The 23-year-old played 40 minutes for Otago in their 78-14 victory over Mid Canterbury on Friday. Having established himself as a first-choice starter with 12 Test appearances last year, Holland’s comeback provides head coach Dave Rennie with a vital option for the upcoming tour of South Africa, where New Zealand will face the Springboks in a high-stakes four-match series."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Squad update",
          "heading": "Rassie Erasmus recalls 10 Springboks as five players are released",
          "body": "Rassie Erasmus has bolstered his 43-man squad with 10 returning players, including Siya Kolisi and Sacha Feinberg-Mngomezulu, as focus shifts to upcoming Tests against Argentina and New Zealand. Erasmus stated that splitting the squad will allow players returning from injury to gain valuable game time while others prepare for the All Blacks series. Meanwhile, five players including Embrose Papier have been released to their franchises, providing them an opportunity to face the All Blacks in midweek fixtures."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
