  "digests": {
    "28": {
      "date": "2026-08-21",
      "edition": "Friday 21 August",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Fijian forward Saimoni Vunilagi dies in Japan from suspected heatstroke",
          "body": "Fijian rugby is mourning back-row forward Saimoni Vunilagi, who passed away on Friday 7 August in Japan. The 26-year-old was hospitalised with symptoms consistent with severe heatstroke after a training session with his second-division club, Kyushu KV, on Monday 3 August. Temperatures in Fukuoka reached 35 degrees Celsius during the practice. The 196-centimetre forward, who began his professional career in 2023, was highly regarded by his club, who expressed devastation at the sudden loss."
        }
      ]
    },
    "386": {
      "date": "2026-08-21",
      "edition": "Friday 21 August",
      "sections": [
        {
          "kicker": "Drought impact",
          "heading": "RFU postpones start of England community rugby season over drought",
          "body": "The Rugby Football Union has postponed the start of England's community rugby season by at least two weeks due to widespread drought conditions. With 71.3% of the country currently in a drought after its driest July since 1836, many pitches are unsafe for contact play. Originally scheduled to begin on the fifth of September, opening fixtures have been pushed back to the week commencing 21 September to protect player welfare."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-08-21",
      "edition": "Friday 21 August",
      "sections": [
        {
          "kicker": "By the numbers",
          "heading": "France hit 426 points across their last 11 international matches",
          "body": "France have demonstrated serious attacking threat in recent months, scoring 426 points across their last 11 matches. Over that same 11-game span, they have conceded 291 points. These figures mean the team averages 38.7 points scored per game, whilst letting in an average of 26.5 points per match. The high point of this window was a 54-12 away victory against Wales in February 2026."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-21",
      "edition": "Friday 21 August",
      "sections": [
        {
          "kicker": "LEGAL BATTLE",
          "heading": "Irish rugby watch closely as landmark concussion lawsuit faces potential dismissal",
          "body": "The landmark concussion lawsuit against rugby's governing bodies is at risk of being dismissed after a major lawyer change. The legal action, which involves former players seeking damages for brain injuries, has been thrown into jeopardy after a key solicitor quit. Claimants are now seeking new legal representation to keep the case alive. With the high-profile proceedings under threat of collapse, Irish rugby continues to monitor the development as the sport grapples with the long-term safety and welfare of its retired athletes."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-08-21",
      "edition": "Friday 21 August",
      "sections": [
        {
          "kicker": "FORM TRACKER",
          "heading": "Italy slide to four straight defeats following heavy loss against Australia",
          "body": "Italy have struggled for form on the international stage. In their last five matches, the team have secured only one victory. That same five-game window contains four defeats. This means the Azzurri are currently on a run of four straight defeats. In their most recent game, Italy lost to Australia 57-10 away in July 2026 during the Nations Championship Group Stage."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-21",
      "edition": "Friday 21 August",
      "sections": [
        {
          "kicker": "Legal battle",
          "heading": "Scottish rugby awaits crucial court ruling as landmark concussion case remains unresolved",
          "body": "There is no coverage in today's press regarding the landmark concussion lawsuit against rugby's governing bodies. Last week, the case reached a critical phase as the presiding judge retired to consider applications that could strike out up to 95% of the players' claims. Scottish rugby's stake in the joint litigation remains in limbo while the court prepares its ruling. Further updates on the legal action are expected once the court delivers its decision."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-21",
      "edition": "Friday 21 August",
      "sections": [
        {
          "kicker": "Backroom staff",
          "heading": "Steve Tandy appoints Alex Davies as the new Wales kicking coach",
          "body": "Head coach Steve Tandy has added former Leicester coach Alex Davies to his backroom staff ahead of the autumn internationals. Davies, who officially starts next month, will work with the senior squad during Test windows and support age-grade development. He fills the void left by Leigh Halfpenny and Rhys Patchell, who previously held temporary roles. Tandy welcomed his new recruit, saying: \"It's great to have Alex join the coaching team. He's a very talented coach who will be another asset for us as a group.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-08-21",
      "edition": "Friday 21 August",
      "sections": [
        {
          "kicker": "Opposition news",
          "heading": "Len Ikitau and Joseph Suaalii return to Wallabies squad for Argentina tour",
          "body": "Australia head coach Les Kiss has named a 34-man squad for the upcoming two-Test tour of Argentina, headlined by the return of fit-again midfielders Len Ikitau and Joseph-Aukuso Suaalii. Ikitau has recovered from an ankle injury, while Suaalii returns after overcoming a hamstring strain. The Wallabies, who recently registered successive victories over Japan, will depart for Buenos Aires on Sunday. Prop Zane Nonggorr misses the trip through injury, while lock Miles Amatosero remains suspended."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-08-21",
      "edition": "Friday 21 August",
      "sections": [
        {
          "kicker": "SQUAD SELECTION",
          "heading": "Les Kiss recalls Len Ikitau and Joseph Suaalii for Argentina tour",
          "body": "Wallabies coach Les Kiss has named a 34-man squad for the upcoming tour of Argentina, headlined by the return of Len Ikitau and Joseph-Aukuso Suaalii. Ikitau returns from an ankle injury sustained against Italy, while Suaalii recovers from a hamstring strain. Despite impressive form, fullback Jock Campbell is a notable omission as Kiss prioritises continuity. \"Touring Argentina presents another tough challenge,\" Kiss noted, following recent victories over Japan that leave Australia seventh in the log."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-21",
      "edition": "Friday 21 August",
      "sections": [
        {
          "kicker": "TRAGIC NEWS",
          "heading": "Fijian player Saimoni Vunilagi dies after suspected heatstroke during training in Japan",
          "body": "The Japanese rugby community is mourning the death of Saimoni Vunilagi after the 26-year-old Fijian passed away following a suspected case of heatstroke. Vunilagi died after collapsing during a training session in Japan, a tragedy that has sparked immediate concerns regarding player safety during the intense summer heat. While the Brave Blossoms focus on their international schedule, this loss has cast a shadow over the domestic landscape. Officials are yet to provide further details on the specific circumstances surrounding the incident."
        }
      ]
    },
    "465": {
      "date": "2026-08-21",
      "edition": "Friday 21 August",
      "sections": [
        {
          "kicker": "Injury boost",
          "heading": "Dave Rennie recalls Will Jordan and Cam Roigard for Ellis Park opener",
          "body": "Dave Rennie has handed the All Blacks a significant fitness boost, naming Will Jordan, Cam Roigard and Damian McKenzie to start Saturday’s tour opener at Ellis Park. Jordan and Roigard make their first appearances of the trip after overcoming injury, while McKenzie starts at full-back following an ankle scare. In the second row, Fabian Holland earns a start alongside Josh Lord, with Rennie preferring the youngster’s mobility over Patrick Tuipulotu’s power for the first of three Tests against the world champions."
        }
      ],
      "match": {
        "venue": "Ellis Park, Johannesburg"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-21",
      "edition": "Friday 21 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Damian de Allende earns 100th cap as Pieter-Steph du Toit leads Springboks",
          "body": "The Springboks have named a powerful matchday squad for the opening Test against New Zealand at Ellis Park, headlined by Damian de Allende becoming South Africa's 10th centurion. Pieter-Steph du Toit captains the side in the absence of Siya Kolisi, who is being rested as a precaution. Erasmus explained that although they could have selected Kolisi, \"we thought it would be best to select Paul for this weekend's game,\" handing 23-year-old Paul de Villiers a start at openside flank."
