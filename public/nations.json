  "digests": {
    "28": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Senirusi Seruvakula hands Caleb Muntz fly-half start for Pacific Nations final",
          "body": "Interim head coach Senirusi Seruvakula has reshuffled his backline for Saturday's Pacific Nations Cup final in Tokyo, handing Caleb Muntz the No. 10 jersey. The shift moves Isaiah Armstrong-Ravula to full-back, while Elia Canakaivata starts at No. 8 ahead of the benched Isoa Tuwai. Seeking a third consecutive final win over Japan, Seruvakula also named uncapped pair Vilikesa Nairau and Isaac Ratumaitavuki-Kneepkens on a refreshed bench. Seruvakula noted that Japan \"are a well-coached side\" but expects Fiji to focus on their own physical strengths."
        }
      ],
      "match": {
        "venue": "Prince Chichibu Memorial Stadium, Tokyo"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "386": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Autumn ultimatum",
          "heading": "Fin Smith says England must improve to justify team direction",
          "body": "Fly-half Fin Smith has challenged England to prove their worth during the upcoming autumn schedule, admitting that a poor run would force the team to take a \"pretty hard look at ourselves.\" With the side recording only three wins in eight Tests this year, Smith stated he will not rely on common rhetoric about building for the future. England face Australia, Japan, and New Zealand in November, with Smith aiming to implement his own footprint on the tactical gameplan."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Psychological hurdle",
          "heading": "Ben Youngs warns France must defeat South Africa before World Cup",
          "body": "Former England scrum-half Ben Youngs has challenged Les Bleus to overcome their psychological barrier against the world champions this November. Despite France’s ability to compete at the highest level, Youngs suggests that recent losses to the Springboks—including the 2023 quarter-final and last year’s defeat in Paris—have created a lingering mental block. According to Youngs, securing a win against Rassie Erasmus' side is a prerequisite if the French are to navigate a successful World Cup campaign in Australia next year."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "388": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Scott Bemand hands Jemima Adams Verling Ireland debut for WXV opener",
          "body": "Connacht back row Jemima Adams Verling will make her senior international debut in Sunday’s WXV Global Series opener against the United States at Tallaght Stadium. Head coach Scott Bemand has included the 20-year-old at blind-side flanker, completing a back row alongside captain Erin King and Aoife Wafer. Bemand described the series as a \"turning of the page\" for his squad as they begin a new three-year cycle towards the next Women’s Rugby World Cup, prioritising the development of international depth."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "WXV global series",
          "heading": "Plinio Sciamanna leads the Azzurre against Japan in Fontanafredda fixture",
          "body": "The Azzurre open their WXV Global Series campaign today against Japan at Stadio Omero Tognon. This match marks the beginning of a new era for Italy under head coach Plinio Sciamanna, who steps into the role after serving as assistant coach for five years. The squad features 7 potential new caps, blending emerging talent with a side that ranked sixth during the Six Nations, where they notably led the competition in turnovers and jackals."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Ceitidh Ainsworth makes first Scotland start as Sarah Bonar returns",
          "body": "Ceitidh Ainsworth earns her maiden international start for Scotland Women in today’s WXV Global Series encounter against New Zealand at Hive Stadium. The Glasgow Warriors scrum-half replaces Rhea Clarke in one of four changes following last week’s defeat by Canada. Interim head coach Dave Butcher also welcomes back experienced lock Sarah Bonar, who is named on the bench to potentially earn her 52nd cap, marking her first appearance in the match-day squad since the 2025 Rugby World Cup."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Sean Lynn moves Keira Bevan to fly-half for South Africa",
          "body": "Wales head coach Sean Lynn has opted for a tactical shift for the WXV Global Series opener against South Africa, naming experienced scrum-half Keira Bevan at fly-half. Lynn, who has been impressed by the 29-year-old’s versatility during pre-season, has urged his squad to remain brave in their decision-making. The side features three debutants, including former footballer Amy Williams on the wing, as Wales look to improve their standing after a challenging run of results."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Recent form",
          "heading": "Argentina reflects on recent series draw and latest tournament standings",
          "body": "Argentina enters the latest stage of the season having secured one win, zero draws, and two losses across their three matches in the current tournament. In their five most recent international outings across all competitions, the team has recorded one win, three losses, and one draw. This recent run includes a 28-28 draw against Australia in Mendoza earlier this month, a result that concluded the international series between the two nations."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Deepest condolences",
          "heading": "Phil Waugh and family mourning the loss of eldest son Jack",
          "body": "The Australian rugby community is rallying around Rugby Australia chief executive Phil Waugh and his family following the tragic death of his 21-year-old son, Jack. In a statement released this week, the family described Jack as a \"fun-loving young man whose warmth and spirit touched all who knew him,\" while requesting privacy during this difficult time. Tributes have poured in from across the sport for the former Wallabies flanker, who played 79 Tests for his country."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Eddie Jones names experienced Japan side for Pacific Nations Cup final",
          "body": "Eddie Jones has recalled Faulua Makisi to start at No. 8 for today's Pacific Nations Cup final against Fiji in Tokyo, prompting a reshuffle that sees Jack Cornelsen move to lock. Tomoki Osada also earns a start on the wing as Japan seeks their first title since 2019. Reflecting on their third consecutive appearance in the final, Jones stated: “Our aim this weekend is to win the final and we’re 100 per cent concentrated on that.”"
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "465": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Coaching growth",
          "heading": "Murray Mexted: Springboks series will be the making of Dave Rennie",
          "body": "Former All Black Murray Mexted believes the recent 3-1 series loss to South Africa provides a vital lesson that will ultimately aid Dave Rennie’s World Cup preparations. Mexted argued that despite the \"hell of a surprise\" the team faced against the world champions, the experience has clarified which players possess the required international standard. He noted that Rennie is currently undertaking \"hard thinking\" to ensure the squad is sufficiently hardened for the challenges awaiting them in the upcoming Nations Championship."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Aerial dominance",
          "heading": "Shane Howarth labels South Africa's high-ball retention as 'frighteningly' effective",
          "body": "Former All Blacks fullback Shane Howarth has praised the Springboks’ \"phenomenal\" ability to reclaim contestable kicks, a weapon that proved decisive during the recent series victory. Following the 43-28 win in Baltimore, Howarth admitted that the world champions' aerial dominance was \"frightening\" and noted that their ability to retain possession from kicks was a constant frustration for the opposition. He added, \"I’ve never seen a team in international rugby put kicks up and retain every single kick they put up.\""
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
}