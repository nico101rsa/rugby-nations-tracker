  "digests": {
    "28": {
      "date": "2026-08-13",
      "edition": "Thursday 13 August",
      "sections": [
        {
          "kicker": "TRAGIC LOSS",
          "heading": "Fijian forward Saimoni Vunilagi dies in Japan from suspected heatstroke",
          "body": "The Fijian rugby community is mourning the tragic passing of Saimoni Vunilagi, who has died in Japan aged 26 from suspected heatstroke. The 117kg back-rower, who recently joined second-division side Kyuden Voltex after a spell with Tokyo Sungoliath, collapsed following a training session in Fukuoka. Temperatures in the southern Japanese city reached 35C before Vunilagi passed away in hospital. His club expressed devastation at the sudden loss of the promising forward, who began his professional career in 2023."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "386": {
      "date": "2026-08-13",
      "edition": "Thursday 13 August",
      "sections": [
        {
          "kicker": "Contract shake-up",
          "heading": "Elliot Daly and Ollie Lawrence lose central contracts in Borthwick shake-up",
          "body": "Steve Borthwick has omitted Ollie Lawrence and Elliot Daly from England’s 25-man list of enhanced Elite Player Squad contracts. The high-profile duo are joined by Ben Curry, Tom Roebuck and France-bound Tom Willis in losing their £150,000-a-year deals as Borthwick plans for next year’s World Cup. Five players, including Gloucester centre Seb Atkinson and Sale prop Asher Opoku-Fordjour, received contracts for the first time, giving the head coach final say over their medical and conditioning matters."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "387": {
      "date": "2026-08-13",
      "edition": "Thursday 13 August",
      "sections": [
        {
          "kicker": "Stat watch",
          "heading": "France defeat Japan 42-15 to secure third in the Nations Championship",
          "body": "France currently occupy third place in the Nations Championship table after three rounds of play. In their first three fixtures of the tournament, Les Bleus have secured two victories. They have also suffered one defeat during that same opening block. The team has scored 116 points across those three games, whilst conceding 75 points over the same period. Their most recent performance produced a 42-15 victory over Japan. Looking at the global rankings, France's longest unbroken spell at No. 1 is just one week, recorded in July 2022."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-13",
      "edition": "Thursday 13 August",
      "sections": [
        {
          "kicker": "Sad passing",
          "heading": "Former Ireland rugby international Brian Smith dies from cancer aged 59",
          "body": "The Irish rugby community is mourning former international Brian Smith, who has passed away from cancer at the age of 59. The versatile playmaker, who represented Australia six times including at the first World Cup, later won nine caps for Ireland while studying at Oxford University. Following a rugby league spell, he moved into coaching, guiding London Irish before working under England's Martin Johnson. The IRFU paid tribute to his \"long and illustrious career as a player and coach.\""
        }
      ]
    },
    "389": {
      "date": "2026-08-13",
      "edition": "Thursday 13 August",
      "sections": [
        {
          "kicker": "Form guide",
          "heading": "Italy struggle defensively over 11-match run ahead of South Africa test",
          "body": "Italy head into their next fixture searching for defensive stability after conceding 318 points across their last 11 matches. Over that same 11-game span, the Azzurri scored 190 points in total, while conceding an average of 28.9 points per game. Their biggest win in that window was a 34-19 home victory against Chile in November 2025. Following a 10-57 loss to Australia, Italy are currently 11th in the table with three defeats from three matches."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-13",
      "edition": "Thursday 13 August",
      "sections": [
        {
          "kicker": "Concussion litigation",
          "heading": "Scotland awaits High Court ruling on stalled rugby brain injury lawsuit",
          "body": "There are no fresh updates in today's coverage regarding the High Court's ruling on the governing bodies' applications to dismiss the landmark rugby brain injury lawsuit. The legal action remains paused after the judge retired in late July to consider strike-out applications that could throw out the vast majority of the claims. Scottish rugby's stake in the multi-party litigation remains unresolved until the court delivers its judgment on the future of the claimants' representation and whether the hundreds of cases will be allowed to proceed."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-13",
      "edition": "Thursday 13 August",
      "sections": [
        {
          "kicker": "WXV selection",
          "heading": "Lisa Neumann returns to Wales training squad for autumn WXV campaign",
          "body": "Head coach Sean Lynn has recalled unattached wing Lisa Neumann to an extended 46-player Wales training squad for the WXV Global Series. The 32-year-old missed most of the Six Nations with a hamstring injury but returns alongside 14 uncapped players. Lynn is rebuilding after another winless Six Nations campaign. \"This is a new look Wales squad for a new season as we prepare for an exciting and demanding WXV campaign,\" Lynn said. The squad will undergo pre-season before autumn tests against South Africa, the USA and Japan."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-08-13",
      "edition": "Thursday 13 August",
      "sections": [
        {
          "kicker": "Tactical praise",
          "heading": "Contepomi's tactics showed All Blacks how to defuse Springboks, says Dave Rennie",
          "body": "All Blacks head coach Dave Rennie believes Los Pumas have provided a tactical blueprint on how to handle South Africa. Reflecting on Argentina's narrow 17-10 defeat in Buenos Aires last week, Rennie praised Felipe Contepomi’s side for forcing the world champions into errors and disrupting their game. 'The Argentinians did a really good job defusing their kicking game,' Rennie noted, as his squad prepares to face the Springboks. Despite missing most of their European-based squad, Los Pumas' defensive effort has caught the attention of their rivals."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "461": {
      "date": "2026-08-13",
      "edition": "Thursday 13 August",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Joseph-Aukuso Suaalii ruled out of Wallabies' Japan rematch with hamstring injury",
          "body": "Wallabies head coach Les Kiss has been forced to reshuffle his backline for Saturday's second Test against Japan in Townsville after Joseph-Aukuso Suaalii was ruled out with a minor hamstring strain. The injury halts plans to trial the cross-code star on the wing after he finished last weekend's tense 35-32 victory in Osaka there. Queensland Reds centre Josh Flook joins the squad as cover, while lock Tom Hooper is also back in the mix following a shoulder injury."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-13",
      "edition": "Thursday 13 August",
      "sections": [
        {
          "kicker": "DISCIPLINARY RULING",
          "heading": "Wallabies lock Miles Amatosero suspended for dangerous contact on Warner Dearns",
          "body": "Australian lock Miles Amatosero has received a three-match suspension following his red card in Saturday’s Test in Osaka. A disciplinary committee ruled the Wallaby guilty of dangerous play after his shoulder contacted the head of Brave Blossoms captain Warner Dearns during a 33rd-minute ruck. The ruling sidelines the second-rower for the squad's upcoming rematch in Australia, though he may reduce the ban via a coaching intervention programme. Eddie Jones described the narrow 35-32 defeat as \"disappointing\" as his side prepares to travel."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "465": {
      "date": "2026-08-13",
      "edition": "Thursday 13 August",
      "sections": [
        {
          "kicker": "Haka response",
          "heading": "Ma’a Nonu performs solo Kapa o Pango haka against the All Blacks",
          "body": "Former midfield powerhouse Ma’a Nonu provided the defining image of the Durban tour match by performing a solo Kapa o Pango in response to the All Blacks' challenge. Now 44 and recently signed to a player-coach role at the Sharks, Nonu was drafted onto the bench following a local injury crisis. After consulting assistant coach Tana Umaga, the 104-cap veteran stood alone to answer his former side’s haka before the visitors secured a 54-0 victory in waterlogged conditions. \"I thought it was the right thing to do,\" Nonu said."
        }
      ],
      "match": {
        "venue": "Durban"
      },
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "467": {
      "date": "2026-08-13",
      "edition": "Thursday 13 August",
      "sections": [
        {
          "kicker": "SELECTION CALL",
          "heading": "Deon Fourie earns shock Springboks recall as Siya Kolisi hamstring concerns persist",
          "body": "Rassie Erasmus has turned to veteran flanker Deon Fourie to reinforce his squad as captain Siya Kolisi struggles with a recurring hamstring injury. The 39-year-old utility forward, nicknamed \"Brannas\", has joined the camp despite not featuring for South Africa since the 2023 World Cup final. While Paul de Villiers has impressed in the No. 6 jersey this year, Erasmus is prioritising the experience of the old guard for the upcoming series. Rassie believes that Kolisi’s brief shift in Argentina last weekend proved his value despite persistent fitness concerns."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
}