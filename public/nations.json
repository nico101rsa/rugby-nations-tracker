  "digests": {
    "28": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Form guide",
          "heading": "Fiji fell 34-21 to France in their last international friendly meeting",
          "body": "In their last three tournament matches, Fiji suffered three defeats. Over those three fixtures, they scored 49 points. They also conceded 145 points during that period, leaving them 12th in the table. Their last match ended in a 17-33 defeat against Scotland. In their last meeting with France, which was an away international friendly in November 2025, Fiji lost 34-21."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Ben Spencer emerges as November doubt for England after shoulder surgery",
          "body": "Steve Borthwick faces a major scrum-half dilemma after Ben Spencer was ruled out of the start of the Premiership season. Bath confirmed the 34-year-old underwent shoulder surgery to address a long-standing issue following England’s summer tour. While Spencer is expected to return later in the autumn, he is now in a race against time to prove his fitness before November's Nations Championship Tests. In his absence, Borthwick will likely lean on Alex Mitchell and Jack van Poortvliet as his primary options for the autumn campaign."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "By the numbers",
          "heading": "France score 426 points across their last 11 international matches",
          "body": "France have shown incredible attacking power across their last 11 games, scoring 426 points in that window. This run averages 38.7 points per match in those 11 fixtures. Defensively, Les Bleus conceded 291 points over the same 11 matches, averaging 26.5 points per game in that period. The biggest win in this 11-game window came in February 2026, when France beat Wales 54-12 away in the Six Nations."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Jack Crowley ruled out of November internationals with vascular injury",
          "body": "Ireland fly-half Jack Crowley has been ruled out of action until the new year, delivering a major selection blow ahead of the November internationals. Munster head coach Clayton McMillan confirmed the 26-year-old is still recovering from a lower-limb vascular injury suffered in April. Having missed July's tests, Crowley will now sit out the upcoming clashes against Argentina, Fiji and South Africa. McMillan emphasised the recovery is the main focus, stating, \"ensuring he gets back to 100% is the priority.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Form slump",
          "heading": "Italy slumped to fourth consecutive defeat after losing 57-10 to Australia",
          "body": "Italy suffered a 57-10 away defeat against Australia in July during the Nations Championship group stage. That result means the Azzurri have now slumped to four straight defeats. Looking at a broader window, the team has registered one win and four losses in their last five games. Italy currently sit 11th out of 12 teams in the tournament standings after losing all three of their fixtures so far."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Legal battle",
          "heading": "No new High Court rulings emerged in Scotland's ongoing concussion lawsuit",
          "body": "There have been no fresh updates or rulings delivered in the High Court regarding the landmark rugby brain injury litigation since the case was allowed to proceed earlier this month. The legal battle, which involves former Scotland players among hundreds of claimants, remains unresolved as both sides prepare for procedural hearings. There is no coverage of any new developments in today's press."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Regional future",
          "heading": "Proposed Welsh Rugby Union professional team cuts receive no new coverage",
          "body": "The debate surrounding the Welsh Rugby Union's proposal to reduce the country's professional teams to three remains unresolved, with no new details emerging in today's press. The issue, which first drew heavy criticism from Ospreys and prompted calls for the WRU board to step down on 15 August, has seen no fresh developments or official statements. The future of Wales' regional structure stays in limbo until a final decision is announced."
        }
      ],
      "match": {
        "venue": "Principality Stadium, Cardiff"
      },
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Felipe Contepomi names unchanged Argentina starting team to face Australia",
          "body": "Los Pumas head coach Felipe Contepomi has named an unchanged starting XV for Saturday's first Test against Australia in Jujuy, backing the side that pushed South Africa close in a 17-10 defeat. Pablo Matera continues as captain in the absence of Julián Montoya, who remains unavailable alongside Marcos Kremer and Mateo Carreras. The only adjustments come on the bench, where Contepomi has opted for a 5-3 split, bringing in Rodrigo Martínez and Nicolás Roger."
        }
      ],
      "match": {
        "venue": "Estadio 23 de Agosto, San Salvador de Jujuy",
        "referee": "Ben O'Keeffe"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Team selection",
          "heading": "Les Kiss drops Harry Wilson and benches Joseph-Aukuso Suaalii for Argentina",
          "body": "Wallabies head coach Les Kiss has made the bold call to rotate his entire starting forward pack for Saturday's Test against Argentina in Jujuy, resting captain Harry Wilson completely. Allan Alaalatoa takes over the captaincy, while fit-again recruit Joseph-Aukuso Suaalii must settle for a place on the bench as Kiss seeks to build squad depth ahead of the 2027 World Cup. \"I need to know that I’ve got two good XVs,\" Kiss explained. Isaac Kailea also returns to start at prop for his first international appearance since 2024."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Eligibility u-turn",
          "heading": "Japan Rugby League One scraps controversial restrictions on naturalised Brave Blossoms",
          "body": "Japan Rugby League One has abandoned plans to restrict naturalised players in matchday squads following a legal settlement with 25 professionals. The proposed system would have categorised foreign-born athletes without six years of Japanese schooling differently from domestic-born players, even those with citizenship. Under the agreement reached at the Tokyo District Court, naturalised stars like Timothy Lafaele and Jiwon Gu will retain their primary registration status. The league admitted that its prior communication with players was \"insufficient\" after the group alleged the rules threatened their professional livelihoods."
        }
      ]
    },
    "465": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Anton Segner ruled out of South Africa tour following ankle surgery",
          "body": "Anton Segner has become the fifth New Zealand player to be ruled out of the current tour following surgery on an infected ankle. The flanker, who debuted in July, will remain with the squad in Cape Town but will not feature in the remaining matches. Despite losing him alongside four other squad members including Caleb Clarke and Billy Proctor, coach Dave Rennie will not call up a replacement. Rennie remains confident in his loose forward depth as his unbeaten side prepares for today’s second Test against South Africa."
        }
      ],
      "match": {
        "venue": "Cape Town Stadium, Cape Town"
      },
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Sacha Feinberg-Mngomezulu replaces Handré Pollard for South Africa’s vital Cape Town Test",
          "body": "Rassie Erasmus has been forced into a late fly-half adjustment after Handré Pollard failed a fitness test on the eve of the second Test against New Zealand. Pollard, initially selected to anchor a conservative gameplan, suffered a \"niggle\" during training. His withdrawal elevates 24-year-old Sacha Feinberg-Mngomezulu to the starting No. 10 jersey as the Springboks seek to level the series following their 33-16 defeat in Johannesburg. Elsewhere, Cheslin Kolbe returns to the wing for the must-win encounter at Cape Town Stadium."
        }
      ],
      "match": {
        "venue": "Cape Town Stadium, Cape Town"
      },
      "source": {
        "name": "Guardian Rugby Union"
      }
    }
  }
