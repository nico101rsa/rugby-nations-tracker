  "digests": {
    "28": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "Performance role",
          "heading": "Andrew Durutalo appointed Fiji High Performance head to align national pathways",
          "body": "Fiji Rugby has named former USA international and Olympian Andrew Durutalo as the new Head of Men’s High Performance. Durutalo, who recently served as director of rugby operations at Hong Kong Football Club, is tasked with strengthening the bridge between age-grade programmes and the senior squad. General Manager Naca Cawanibuka stated that Durutalo will ensure \"greater alignment\" from youth levels through to the Flying Fijians. The appointment follows Fiji's semi-final victory over Canada, as the team prepares for the Pacific Nations Cup final against Japan."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "386": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "Contract news",
          "heading": "Tommy Freeman signs new Northampton deal to secure his England future",
          "body": "Tommy Freeman has signed a new contract to remain at Northampton Saints for the \"foreseeable future\". The 25-year-old utility back, who has 30 caps and started all three Lions Tests in Australia last year, joins teammates Fin Smith and Alex Mitchell in staying with the Premiership champions. Phil Dowson described the deal as a \"huge boost\" for the club, while Saints coach Sam Vesty indicated Freeman may feature more at full-back this season, offering Steve Borthwick further tactical flexibility for England."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "Tournament expansion",
          "heading": "World Rugby continues exploring potential Six Nations matches in the US",
          "body": "Proposals to host Six Nations fixtures in the United States remain under active consideration by tournament organisers. While World Rugby has floated the concept as a strategy to expand the sport's global footprint, the initiative faces logistical and calendar hurdles. Previous reporting indicated that participating unions are divided on the feasibility of such a move, with England reportedly showing significant resistance to relocating home games. No official confirmation for a trans-Atlantic test has been announced as discussions persist."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "388": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Jimmy O’Brien reveals Andy Farrell’s blunt warning during Ireland recall",
          "body": "Jimmy O’Brien has opened up about the abrupt message he received from Andy Farrell upon his unexpected return to the Ireland squad this summer. After a prolonged period in the international wilderness, O’Brien found himself thrust into the side following a series of injury-enforced withdrawals. Recalling the moment on the training ground, the 29-year-old revealed that Farrell approached him and told him, “You’re in, don’t f*** it up.” O’Brien subsequently started all three of Ireland’s tour matches."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "Tournament expansion",
          "heading": "Six Nations officials continue exploring potential expansion into United States venues",
          "body": "The proposal to stage Six Nations fixtures in the United States remains an open topic as governing bodies seek to grow the sport's reach. As reported by the Guardian and BBC last week, World Rugby is actively exploring plans for a tournament match to be held on American soil. While discussions regarding the logistical viability are ongoing, reports indicate that England remains unlikely to participate in such an arrangement. There has been no further confirmation or official withdrawal of these plans today."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "WXV series",
          "heading": "Scotland women look to rebound following heavy opening defeat to Canada",
          "body": "Scotland’s WXV campaign began with a difficult 64-26 loss to Canada in Edinburgh. Despite tries from Evie Gallagher, Shona Campbell, Lana Skeldon, and Rhona Lloyd, the visitors’ attack proved too clinical, running in 10 tries throughout the contest. Following the transition to interim head coach Dave Butcher last month, the squad now turns its focus toward preparing for the upcoming challenge against New Zealand, aiming to improve upon their defensive structure after being outclassed by the World Cup finalists in the opening round."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Kayleigh Powell ruled out as Wales assess WXV tournament options",
          "body": "Wales have been dealt a significant setback with the news that Kayleigh Powell will miss the entire WXV campaign due to a hamstring injury sustained in training. Head coach Sean Lynn described the Harlequins full-back as a major loss, noting she provided a crucial dimension to the attack. Lleucu George and scrum-half Keira Bevan have emerged as potential options to fill the vacancy at 10, with Lynn confirming that Bevan has been training in the role during a demanding pre-season."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "Squad depth",
          "heading": "Felipe Contepomi evaluates player options ahead of Rugby World Cup 2027",
          "body": "As Argentina looks toward the 2027 tournament, recent analysis highlights the depth currently available to Felipe Contepomi across the squad. Thomas Gallo remains the primary choice at loosehead prop, with competition for roster spots intensifying. Captain Julián Montoya continues to lead at hooker, supported by Ignacio Ruiz. While Los Pumas reached the semi-finals in 2007, 2015, and 2023, the current cycle is focused on identifying players capable of pushing the side to further success in Australia."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Jordan Petaia returns to Wallabies squad for one-off Springboks Test",
          "body": "Jordan Petaia has been recalled to the Wallabies squad for the upcoming one-off Test against South Africa in Perth. The utility back, who recently moved to Japan to join Urayasu D-Rocks, has not featured for Australia since the 2023 Rugby World Cup. Head coach Les Kiss has also called up uncapped playmaker Harry McLaughlin-Phillips to replace the injured Carter Gordon. Reflecting on the squad's development, Kiss stated, “We’ve learned a bit more about ourselves as a group over the last four Tests.”"
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "PNC final",
          "heading": "Mamoru Harada targets Pacific Nations Cup victory against Fiji this weekend",
          "body": "Japan hooker Mamoru Harada has confirmed the squad's intent to hoist the Pacific Nations Cup following their comprehensive 63-14 semi-final victory over the United States. While the team produced an attacking masterclass in Osaka, head coach Eddie Jones warned that building greater consistency remains the priority for Saturday’s final against Fiji. Jones stressed that the side must eliminate the concentration lapses and compounding penalties that occurred during the semi-final if they are to overcome the three-time defending champions."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      },
      "rung": "storyline"
    },
    "465": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Plumtree questions whether All Blacks must select bigger players for physicality",
          "body": "Former All Blacks assistant coach John Plumtree has suggested the team may need to recruit larger personnel to compete with South Africa’s physical dominance. Following the recent series defeat, Plumtree noted that the All Blacks struggled to contain the Springboks' forward momentum. He questioned whether the issue was technical or physical, stating: \"If it’s a physical thing and these guys are just too big for us, then they have to start picking some bigger players.\""
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "Tactical evolution",
          "heading": "Victor Matfield predicts more expansive Springboks now that pressure has lifted",
          "body": "South Africa legend Victor Matfield expects a more experimental and expansive approach from the Springboks following their 3-1 series victory over the All Blacks. With the intensity of the Greatest Rivalry series concluded, Matfield believes Rassie Erasmus will now feel empowered to broaden the team’s attacking DNA beyond their traditional reliance on physical dominance. “We’ll probably see it now with the pressure being off, you’ll see South Africa go and add a little bit of attack to their game,” Matfield noted."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
}