    "388": {
      "date": "2026-10-27",
      "edition": "Tuesday 27 October",
      "sections": [
        {
          "kicker": "Disciplinary case",
          "heading": "Ireland's Tadhg Furlong cited over alleged groin grab against Munster",
          "body": "Tadhg Furlong has been cited over an alleged groin grab on Munster back row Gavin Coombes in Leinster's URC win at the Aviva Stadium on Saturday, a case with direct consequences for Ireland's November plans. The TMO found no video evidence at the time. The URC says disciplinary arrangements are in progress. If found guilty, the 33-year-old would be in danger of missing Ireland's matches with Argentina, Fiji and South Africa in Dublin, as well as the finals weekend in London."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa's Cheslin Kolbe out of Nations Championship with broken jaw",
