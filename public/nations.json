  "digests": {
    "28": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "CAMPAIGN OUTLOOK",
          "heading": "Fiji search for first Nations Championship win after three opening defeats",
          "body": "Fiji are searching for their first win of the campaign as they prepare for their next match against France. In their first three matches of the tournament, the team suffered three defeats. They have scored 49 points across those three opening fixtures. However, they have conceded 145 points over the same three-match period. Their most recent outing ended in a 17-33 loss to Scotland. Historically, the highest world ranking the side has ever reached is No. 7, achieved in 2023."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "Coaching Debate",
          "heading": "Ben Youngs claims RFU bosses have 'blinkers on' over Steve Borthwick",
          "body": "Former England scrum-half Ben Youngs has criticised the Rugby Football Union's decision to award head coach Steve Borthwick a contract extension. Speaking on the For The Love Of Rugby podcast, Youngs claimed performance director Conor O'Shea has 'blinkers on' after the RFU extended Borthwick's terms until the end of the 2028 Six Nations. Despite a historically poor 2026 Six Nations campaign, the governing body chose to avoid World Cup uncertainty, but Youngs warned that O'Shea and chief executive Bill Sweeney will be 'all accountable' if the move fails."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "Form guide",
          "heading": "France secure consecutive victories after defeating Japan in the Nations Championship",
          "body": "France have established a run of two straight wins following their most recent match, where they beat Japan 42-15 away in the Nations Championship group stage. In their last five games, the side has registered three wins alongside two losses. This sequence includes a 42-26 victory over Australia, which immediately followed a narrow opening-round defeat against New Zealand in the tournament."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "Six Nations",
          "heading": "Ireland dismisses proposal to play Six Nations matches in United States",
          "body": "The IRFU has swiftly dismissed suggestions of moving Six Nations fixtures to the United States, stating there are \"currently no plans or discussions\" regarding such a move. World Rugby chief executive Alan Gilpin had floated the concept of hosting matches like Ireland against Italy in cities like Boston or New York to engage expatriate fanbases. However, the Irish union emphasised that playing on home soil remains central to the tournament's appeal, while the Italian Rugby Federation similarly distanced itself from taking matches across the Atlantic."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "FIXTURE PROPOSAL",
          "heading": "Italy await decision on playing proposed Six Nations match in America",
          "body": "World Rugby's proposal to stage a Six Nations match in the United States remains unresolved, with no official decision yet made on which teams will travel. While the Irish Rugby Football Union ruled out relocating any of Ireland's home fixtures and England are highly unlikely to participate, Italy remain a potential option for the American showcase. Supporters must wait for formal confirmation from tournament organisers to see if the Azzurri will be chosen to grow the game overseas."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "Ball trial",
          "heading": "Scotland prepare to play with size 4.5 ball in WXV trial",
          "body": "World Rugby’s trial of the smaller size 4.5 ball in women's rugby continues through the WXV tournament, where Scotland will test the new equipment. The initiative has generated mixed reactions across the sport. While some players and coaches have noted key differences in handling and kicking, others have expressed concerns, suggesting the change makes their role on the pitch more difficult. The trial remains open as the governing body gathers performance data and player feedback to determine whether to adopt the smaller ball permanently."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "Ball trial",
          "heading": "Wales's Jones outlines key differences in WXV women's smaller ball trial",
          "body": "The trial of a size 4.5 ball for the women's WXV tournament has brought a mixed bag of emotions. Wales's Jones has revealed key differences when playing with the smaller ball, while other critics argue that women do not need the change. Opposing views suggest the adjustment actually makes it harder for players to do their jobs. The debate remains open as World Rugby evaluates the trial before making a permanent decision on adoption."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "Series conclusion",
          "heading": "Argentina secure dramatic Mendoza draw against Harry Wilson's experimenting Wallabies",
          "body": "The storyline surrounding Les Kiss’s squad experimentation resolved last Saturday as Argentina fought back to secure a 28-28 draw in Mendoza. Returning Wallabies captain Harry Wilson crossed for an early try as the visitors built an initial 14-0 lead, but Los Pumas rallied with scores from Pablo Matera and Ignacio Ruiz. Despite playing the final ten minutes with 13 players due to yellow cards, Argentina held on to deny Australia a series sweep, though the visitors still claimed a historic trophy."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "461": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "Off-field role",
          "heading": "Wallabies legend James Slipper pauses playing career for Brumbies coaching role",
          "body": "Australia's most experienced Test prop, James Slipper, has temporarily paused his playing career to join the Brumbies' backroom staff as their new scrum coach. The 154-cap veteran, who recently signed a one-year contract extension, will remain sidelined as a player during the Super Rugby AUS campaign to focus on developing the club’s next generation of forwards. Slipper steps into the role after regular Brumbies scrum coach John Ulugia departed to join the Wallabies' national coaching set-up."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "PNC semifinal",
          "heading": "Eddie Jones targets Pacific Nations Cup glory as Japan face USA",
          "body": "Japan face the USA Eagles in Saturday's Pacific Nations Cup semifinal at Osaka's Hanazono Rugby Stadium, with head coach Eddie Jones targeting a return to regional dominance. The Brave Blossoms are clear favourites on paper, sitting 12th in the world rankings to their opponents' 14th. History also heavily favours the hosts, who have triumphed in nine of their last ten meetings against the Americans, including a 47-21 victory when they last clashed in 2025."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Richie Mo'unga returns to start as Dave Rennie reshuffles All Blacks",
          "body": "Fly-half Richie Mo'unga has been recalled to start Saturday's final Test against South Africa in Baltimore as coach Dave Rennie rings the changes. Desperate to level the series at 2-2, Rennie has also brought winger Josh Moorby and experienced centre Anton Lienert-Brown into a reshuffled backline. Ruben Love makes way after starting the first six Tests under Rennie. Springboks assistant Mzwandile Stick admitted his side are preparing for an 'even more bold' All Blacks attack now that their world-class playmaker has returned to direct the wider channels."
        }
      ],
      "match": {
        "venue": "M&T Bank Stadium, Baltimore"
      },
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-12",
      "edition": "Saturday 12 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Rassie Erasmus recalls Damian Willemse as Cheslin Kolbe misses Baltimore decider",
          "body": "The Springboks aim to clinch the inaugural Greatest Rivalry trophy in Baltimore on Saturday as Rassie Erasmus maintains selection continuity for the tour finale. Damian Willemse returns at full-back to replace Cheslin Kolbe, who is unavailable after suffering a broken jaw in Soweto. It is one of only two changes to the starting XV, with Morne van den Berg promoted at scrum-half. Lock Eben Etzebeth earns a record-extending 146th cap, while the Siya Kolisi-led loose trio sets a national record with their 19th start together."
        }
      ],
      "match": {
        "venue": "M&T Bank Stadium, Baltimore"
      },
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
}