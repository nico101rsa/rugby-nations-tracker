  "digests": {
    "28": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "PNC heartbreak",
          "heading": "Interim coach Senirusi Seruvakula's Fiji lose tense final to Japan",
          "body": "Conceding a late try in Tokyo, the Flying Fijians fell 20-15 to Japan in Saturday's Pacific Nations Cup final. Tries from Virimi Vakatawa and Tevita Ikanivere, alongside an Isaiah Armstrong-Ravula penalty, kept the defending champions in the contest despite Mesake Doge's costly yellow card. Although Armstrong-Ravula levelled the scores in the final quarter, Samisoni Tua's late strike secured the trophy for Eddie Jones' side, denying Fiji a third consecutive tournament title."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "386": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "World Cup ambition",
          "heading": "Scrum-half Jack van Poortvliet backs England to win 2027 World Cup",
          "body": "Scrum-half Jack van Poortvliet believes Steve Borthwick's side possesses the \"100% capability\" required to win the 2027 Rugby World Cup. Having started all three Nations Championship fixtures this summer, the 25-year-old credits a previous ankle injury for providing a \"better perspective\" and a \"new-found enjoyment\" of the game. Following the recent victory over Argentina, van Poortvliet has reclaimed the No. 9 shirt during Alex Mitchell's absence, asserting that he is nowhere near his performance ceiling despite the squad's upward trajectory."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Mental barrier",
          "heading": "Ben Youngs claims France must defeat South Africa to break psychological barrier",
          "body": "Ben Youngs warns that Fabien Galthié’s men must overcome a \"psychological barrier\" by defeating South Africa during the upcoming November tests. Following a narrow 29-28 exit from the 2023 World Cup and a 32-17 loss in Paris last year, Youngs believes Les Bleus risk a permanent mental block ahead of the next World Cup. Despite sitting third in the Nations Championship following their 42-15 win over Japan, France require a statement victory against the world champions to prove they can truly compete at the summit."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "388": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Club innovation",
          "heading": "Jacques Nienaber reveals why club rugby prioritises creative tactical system design",
          "body": "Leinster senior coach Jacques Nienaber has explained his preference for the club game, claiming it remains two to three years ahead of international rugby. Nienaber, currently preparing his squad for upcoming United Rugby Championship fixtures in South Africa, argued that the increased volume of club matches allows coaches to be bolder with new systems. Unlike the high-stakes pressure of Test rugby, where results are immediately inscribed in history, he believes the club environment provides the necessary testing ground for genuine tactical innovation."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Tournament expansion",
          "heading": "World Rugby continues discussions regarding staging a Six Nations fixture overseas",
          "body": "The prospect of hosting a Six Nations match in the United States remains an open topic as World Rugby continues formal discussions with tournament stakeholders. While the governing body has prioritised the potential move to expand the game's global footprint, the initiative faces significant hurdles. Reports from earlier this month confirmed that individual unions—notably England—have expressed reservations regarding the proposal, citing the impact on existing broadcast and commercial revenues generated by traditional home fixtures."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Ceitidh Ainsworth earns first Scotland start as Sarah Bonar returns bench",
          "body": "Interim head coach Dave Butcher has reshuffled his side for the WXV Series encounter with New Zealand, handing a first start to scrum-half Ceitidh Ainsworth. She replaces Rhea Clarke, who moves to the replacements. In a significant boost to the pack, experienced lock Sarah Bonar returns to the match-day squad for the first time since the 2025 Rugby World Cup. The changes follow last weekend’s defeat to Canada, as the side looks to recover against the world's second-ranked team."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "New DNA",
          "heading": "Sean Lynn praises Wales players after dominant eight-try victory over South Africa",
          "body": "Wales ended a nine-test winless streak with an emphatic 50-19 victory over South Africa at Cardiff Arms Park. Head coach Sean Lynn described the result as a foundation for a new approach, noting, \"This is just the start for us, this is going to be our new DNA.\" Tight-head prop Sisilia Tuipulotu impressed with two tries, while co-captain Alex Callender secured player-of-the-match honours as the hosts capitalised on their early dominance to lead 38-5 at half-time."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Historical Context",
          "heading": "Argentina maintain pursuit of historic highs following recent international test results",
          "body": "As Los Pumas reflect on their recent campaign, the squad continues to measure their progress against the nation's proud history. Argentina’s peak in the official World Rugby rankings remains the No. 3 position they first achieved during the 2007–08 period. Following their recent result against England, the team remains focused on refining their performance ahead of their next test against Ireland as they look to improve their current standing in the log."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Rugby Australia community mourns the death of CEO Phil Waugh's son",
          "body": "The Australian rugby community is in mourning following the death of Jack Waugh, the 21-year-old son of Rugby Australia chief executive and former Wallabies flanker Phil Waugh. In a statement, the family remembered Jack as a \"fun-loving young man\" whose warmth touched all who knew him. Messages of condolence have arrived from across the global game, with the family requesting privacy as they navigate this profound loss. The thoughts of the entire rugby fraternity are with the Waugh family."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Tournament triumph",
          "heading": "Eddie Jones' Japan secure historic Pacific Nations Cup final win today",
          "body": "Japan claimed the Pacific Nations Cup title for the first time since 2019 after a 20-15 victory over Fiji in Tokyo. Following a tight first half, Ben Gunter scored a crucial second-half try to shift the momentum, before Samisoni Tua crossed for the winner with 10 minutes remaining. Having suffered defeats to the Flying Fijians in the previous two finals, this result provides a significant boost for Eddie Jones as he builds towards the 2027 Rugby World Cup."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "465": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Series review",
          "heading": "Backs assessed as star trio cement status after Springboks series defeat",
          "body": "Following the 3-1 series loss to the Springboks in Rugby’s Greatest Rivalry, the performance of the All Blacks’ backline has come under scrutiny. Will Jordan emerged as a standout, scoring four tries in as many Tests and adding breakdown turnovers to his repertoire. Conversely, the tour proved a steep learning curve for others; while Leroy Carter impressed in Cape Town, his display in Soweto was labelled a disaster. Dave Rennie now faces critical decisions regarding his squad depth ahead of the upcoming Bledisloe Cup."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Rassie Erasmus releases Pieter-Steph du Toit and Damian de Allende",
          "body": "Coach Rassie Erasmus has released flank Pieter-Steph du Toit and centre Damian de Allende from the Springbok squad ahead of next Sunday’s one-off Test against the Wallabies. Erasmus confirmed the decision on Saturday, citing the need for the pair to spend time with their families following a heavy workload during the recent series against the All Blacks. The coach remains confident that there is sufficient depth within the travelling group to cover the vacancies for the fixture in Perth."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
}