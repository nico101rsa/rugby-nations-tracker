    "387": {
      "date": "2026-11-08",
      "edition": "Sunday 8 November",
      "sections": [
        {
          "kicker": "Halfback reunion",
          "heading": "Dupont and Ntamack start together for first time in 609 days",
          "body": "Antoine Dupont and Romain Ntamack started together for France for the first time in 609 days on Saturday, one year and eight months after their last joint start. The reunion came against Fiji, whose 11 players who play in France brought familiarity and physicality to Lyon. France won 54-17, and the Stade de France hosts South Africa later this month."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa thrash Italy 66-7 with nine tries",
          "body": "Fraser McReight earns 50th Wallabies cap against England."
