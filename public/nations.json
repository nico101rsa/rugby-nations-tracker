    "389": {
      "date": "2026-11-28",
      "edition": "Saturday 28 November",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Tommaso Menoncello needs shoulder surgery, putting his Italy Six Nations in doubt",
          "body": "Italy's Nations Championship ended with a 23-21 win over Fiji, their first of the campaign, but Friday brought bad news: Toulouse said Menoncello requires surgery next week on a recurring shoulder injury, likely ruling him out for three to four months and leaving next year's tournament in doubt. The 24-year-old was hurt in training on Monday, the latest setback in an injury-blighted first season since joining the French champions as their sole recruit. Named 2024 Six Nations player of the tournament, he has been a cornerstone of Italy's upsurge under Gonzalo Quesada."
        },
        {
          "kicker": "Around the world",
          "heading": "Ireland's Dan Sheehan misses Wallabies Test through suspension",
          "body": "Springboks' Damian Willemse ruled out after injury against Ireland. Scotland's Rory Darge returns from injury to captain against Argentina."
        }
