  "digests": {
    "28": {
      "date": "2026-08-27",
      "edition": "Thursday 27 August",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Fijian player Saimoni Vunilagi dies of suspected heatstroke in Japan",
          "body": "Fijian player Saimoni Vunilagi has died in a Fukuoka City hospital after suffering suspected heatstroke during a training session in Japan. The 26-year-old, who played for second-division side Kyushu KV, was hospitalised earlier this month after showing severe symptoms following team practice. The Japanese club confirmed they are \"devastated by this sudden news\" as temperatures soared across the country."
        }
      ]
    },
    "386": {
      "date": "2026-08-27",
      "edition": "Thursday 27 August",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Ben Spencer undergoes shoulder surgery leaving Steve Borthwick with autumn selection concerns",
          "body": "England scrum-half Ben Spencer is set to miss the opening block of the Premiership season after undergoing surgery to resolve a long-standing shoulder issue. The 34-year-old went under the knife following England's summer tour and is not expected to return until later in the autumn. His absence leaves Steve Borthwick facing a potential vacancy at No. 9 for October's Nations Championship fixtures, while loosehead Beno Obano is also recovering from a \"significant\" hamstring injury sustained during the recent Test against South Africa."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-27",
      "edition": "Thursday 27 August",
      "sections": [
        {
          "kicker": "Log standings",
          "heading": "France maintain third place in standings after Round 3 win against Japan",
          "body": "France occupy third place in the Nations Championship table after three rounds. The squad have recorded two wins and one defeat in the current tournament. Les Bleus secured a 42-15 victory over Japan in their most recent outing. The side have scored 116 points across their three matches to date. Fabien Galthié's men currently maintain a points difference of +41. In the last meeting with upcoming opponents Fiji, France recorded a 34-21 home victory in November 2025."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-27",
      "edition": "Thursday 27 August",
      "sections": [
        {
          "kicker": "Legal update",
          "heading": "High Court ruling allows former Ireland players' concussion lawsuits to proceed",
          "body": "The High Court in London has dismissed a bid by World Rugby and governing bodies to throw out legal claims brought by hundreds of former players suffering from permanent brain injuries. This landmark ruling ensures the group litigation, which includes several former Ireland internationals, can move towards a full trial. The defendants had argued the claims were insufficient, but the court’s decision keeps the case active. It marks a pivotal moment for the sport's accountability regarding long-term player welfare and historic concussion management."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-08-27",
      "edition": "Thursday 27 August",
      "sections": [
        {
          "kicker": "Log standings",
          "heading": "Italy fall to 11th in Nations Championship after heavy Australia loss",
          "body": "Italy occupy 11th place in the 12-team Nations Championship table following three consecutive defeats to Japan, New Zealand and Australia. The Azzurri have conceded 131 points across those three fixtures while scoring 37, leaving the side with a points difference of -94. Although the squad equalled their record world ranking of No. 8 earlier in 2024 — a height previously reached in 2007 — they currently remain without a victory. Focus now turns to South Africa in Round 4."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-27",
      "edition": "Thursday 27 August",
      "sections": [
        {
          "kicker": "LEGAL BATTLE",
          "heading": "High Court rejects World Rugby and SRU bid to block concussion lawsuits",
          "body": "Scotland’s governing body faces a continued legal challenge after the High Court rejected a bid by World Rugby and UK bodies to strike out concussion-related claims. The ruling ensures that lawsuits brought by former players regarding neurological injuries will proceed toward a full trial. This decision follows a protracted attempt by rugby’s authorities to have the litigation dismissed on procedural grounds. The case now persists as a major concern for the SRU, with the court prioritising the players' right to seek damages."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-27",
      "edition": "Thursday 27 August",
      "sections": [
        {
          "kicker": "LEGAL BATTLE",
          "heading": "High Court rejects bid by World Rugby to dismiss player concussion lawsuits",
          "body": "The High Court has rejected a bid by World Rugby and UK governing bodies to dismiss lawsuits brought by former players over brain injuries. The ruling allows the group litigation to proceed, ensuring that claims regarding the management of concussion and long-term neurological health will be heard. This reprieve for the claimants follows attempts by the sport’s authorities to halt the legal action. The case remains open as the legal teams for the former professionals prepare for the next stage of the proceedings."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-08-27",
      "edition": "Thursday 27 August",
      "sections": [
        {
          "kicker": "Selection blow",
          "heading": "Felipe Contepomi loses captain Julián Montoya and nine veterans for upcoming series",
          "body": "Los Pumas will be without a significant core of experience for their upcoming series against Australia, as captain Julián Montoya headlines a list of 10 major absentees. Felipe Contepomi is missing influential figures including Santiago Chocobares, Marcos Kremer, and Juan Martín González. With fly-half Tomás Albornoz suspended, the squad leans on youth like 143kg prop Francisco Moreno, who signed for Newcastle this week. Newcastle boss Dan McFarland noted: 'Francisco is a relatively young tighthead who has already taken his first steps in international rugby, and shows a lot of promise.'"
        }
      ]
    },
    "461": {
      "date": "2026-08-27",
      "edition": "Thursday 27 August",
      "sections": [
        {
          "kicker": "Injury boost",
          "heading": "Tom Hooper returns to Wallabies squad after declaring injury a \"blessing\"",
          "body": "Tom Hooper is available for the two-Test tour of Argentina after recovering from a hairline scapula fracture suffered against Ireland in July. The Exeter Chiefs back-rower missed four internationals but believes the layoff was a \"blessing in disguise\" to recover from a gruelling 25-game club campaign. Coach Les Kiss also welcomes back Joseph-Aukuso Suaalii from a hamstring strain for Sunday's series opener in San Salvador de Jujuy. The Wallabies boss intends to keep Suaalii at 13, stating: \"I think it’s right to just keep persisting in that space for now.\""
        }
      ],
      "match": {
        "venue": "San Salvador de Jujuy"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-27",
      "edition": "Thursday 27 August",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Stephen Meehan names Canada squad for Japan’s 100th anniversary match",
          "body": "Canada head coach Stephen Meehan has named a 32-man squad for the upcoming tour of Japan, featuring a one-off Test match. The fixture at Denka Big Swan Stadium in Niigata City will mark the Japan Rugby Football Union’s 100th anniversary. Canada’s preparations have involved a soft centralisation programme in Langford, with Meehan noting that the extended time together has been beneficial for building connections and refining set-piece details ahead of their arrival in Japan for a week-long training camp."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-08-27",
      "edition": "Thursday 27 August",
      "sections": [
        {
          "kicker": "Cultural moment",
          "heading": "Ma’a Nonu performs solo haka against All Blacks in tour match",
          "body": "In an unprecedented scene at the tour match in Durban, 104-cap All Black great Ma’a Nonu performed a solo Kapa o Pango before the Sharks faced New Zealand. Nonu, who recently signed with the South African side, stepped forward to deliver the challenge alone, explaining that he felt it was the right thing to do to show respect for both his new teammates and the visiting All Blacks. New Zealand ultimately won the encounter 54-0."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "467": {
      "date": "2026-08-27",
      "edition": "Thursday 27 August",
      "sections": [
        {
          "kicker": "Coaching scrutiny",
          "heading": "Rassie Erasmus rejects pre-match referee meetings ahead of second Test",
          "body": "Rassie Erasmus has confirmed he will skip the formal pre-match meeting with referee Nika Amashukeli, criticising World Rugby’s protocol that requires both coaches to be present. The Springboks boss maintains that discussing tactical concerns in front of an opposing coach is counterproductive. “In my opinion, it’s impossible to discuss something with the referee with the other coach present,” Erasmus said. While he is avoiding official talks, he plans to meet New Zealand counterpart Dave Rennie for a beer, “without the referee.”"
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
