  "digests": {
    "28": {
      "date": "2026-09-15",
      "edition": "Tuesday 15 September",
      "sections": [
        {
          "kicker": "Pathway appointment",
          "heading": "Fiji Rugby names former USA international Andrew Durutalo as Head of Men’s High Performance",
          "body": "Fiji Rugby Union has appointed former age-grade captain Andrew Durutalo as the new Head of Men’s High Performance. The Olympian and former USA Eagle returns to the system where he began his career, tasked with aligning pathways from the U18s through to the Flying Fijians. General Manager Naca Cawanibuka confirmed Durutalo will work across sports science while the union continues its search for a head coach, stating his role is vital in \"ensuring greater alignment from our U18 and U20 programmes through to Fiji 7s, professional rugby and ultimately the Flying Fijians.\""
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "386": {
      "date": "2026-09-15",
      "edition": "Tuesday 15 September",
      "sections": [
        {
          "kicker": "Coaching update",
          "heading": "Stuart Barnes slams RFU as Steve Borthwick receives contract extension through 2028",
          "body": "Stuart Barnes has criticised the RFU’s “ostrich policy” following the confirmation that the head coach has signed a new deal until the end of the 2027/28 season. The move aims to prevent coaching uncertainty from distracting England’s 2027 World Cup preparations, despite a Six Nations campaign that Barnes labelled an “unmitigated disaster.” While the governing body has steeled its support for Borthwick, critics have questioned the decision following a first-ever defeat to Italy and a heavy loss against South Africa earlier this year."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-09-15",
      "edition": "Tuesday 15 September",
      "sections": [
        {
          "kicker": "PERFORMANCE DATA",
          "heading": "France maintain high-scoring match average after record away win over Wales",
          "body": "France have established a high-scoring rhythm across their last 11 games, averaging 38.7 points per match. In this timeframe, the side scored 426 points. They conceded 291 in the same period, an average of 26.5 per fixture. This clinical form was highlighted by a 54-12 away win over Wales in February, the largest margin of victory recorded in the current window. The squad now holds third place in the Nations Championship standings before November's fourth round."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-15",
      "edition": "Tuesday 15 September",
      "sections": [
        {
          "kicker": "SQUAD AMBITION",
          "heading": "Ben Donnell targets Ireland call-up after joining Ulster to catch Farrell’s eye",
          "body": "New Ulster signing Ben Donnell has confirmed his move to Belfast was primarily motivated by a desire to represent Ireland. The 26-year-old forward is Irish-qualified through his father and aims to impress Andy Farrell during the United Rugby Championship season. Donnell represented England at age-grade level but remained ineligible for Wales. Explaining the move from Cardiff, he said it \"gives me the chance to play international rugby\" as he looks to force his way into the Test frame."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-15",
      "edition": "Tuesday 15 September",
      "sections": [
        {
          "kicker": "US PROPOSAL",
          "heading": "Italy to remain in Dublin as IRFU rejects United States proposal",
          "body": "The Irish Rugby Football Union has rejected World Rugby’s proposal to relocate a Six Nations fixture, potentially involving Italy, to the United States. Despite reports yesterday that organisers were floating neutral-site matches to expand the sport’s American profile before the 2031 World Cup, the IRFU stated it has \"no plans\" to move home championship games to the US. While England also appears unlikely to participate, the dismissal preserves the traditional home-and-away format for Italy’s upcoming visits to Dublin."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-15",
      "edition": "Tuesday 15 September",
      "sections": [
        {
          "kicker": "BALL TRIAL",
          "heading": "Dave Butcher demands greater physicality as Scotland adapt to smaller ball trial",
          "body": "Scotland head coach Dave Butcher must address his side's defensive physicality following Saturday's 64-26 defeat to Canada in the WXV opener. While the trial of a smaller Size 4.5 ball has divided opinion—with some players claiming the change makes it \"harder to do my job\"—Butcher’s priority is hardening a defence that conceded 10 tries. The Scots remain in Edinburgh to host New Zealand this weekend, seeking a response before concluding their series against Australia."
        }
      ],
      "match": {
        "venue": "Hive Stadium, Edinburgh",
        "referee": "Holly Wood"
      },
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-15",
      "edition": "Tuesday 15 September",
      "sections": [
        {
          "kicker": "International ambitions",
          "heading": "Megan Davey reignites international ambitions after earning surprise Wales squad call-up",
          "body": "Half-back Megan Davey has set her sights on a Wales debut after being named in the 39-strong squad for the WXV Global Series. The Loughborough Lightning player, who qualified via her Llanelli-born grandfather, admitted she considered leaving the sport for teaching after missing earlier selections this year. Davey is now competing with Keira Bevan and Seren Lockwood for a spot in the side, noting that the group enjoys a supportive dynamic despite the intense competition for the starting jersey."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-15",
      "edition": "Tuesday 15 September",
      "sections": [
        {
          "kicker": "Recent form",
          "heading": "Argentina reflect on inconsistent run following draw against the Wallabies",
          "body": "Argentina head into their next international block looking to find greater consistency after a testing period. In their last five matches, Los Pumas have recorded one win, three losses, and one draw. Their most recent outing saw them draw 28-28 with Australia in Mendoza, a result that concluded a series defeat. As the squad prepares for the upcoming round of fixtures, they will look to improve on their current form and climb from their position of 8th in the standings."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-15",
      "edition": "Tuesday 15 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Jordan Petaia returns to Wallabies squad for Springboks Test in Perth",
          "body": "Jordan Petaia has been recalled to the Wallabies fold ahead of the one-off Test against South Africa, marking the utility back's first international involvement since the 2023 World Cup. Petaia joins a squad that sees uncapped playmaker Harry McLaughlin-Phillips included as cover for the injured Carter Gordon. Reflecting on the upcoming challenge, head coach Les Kiss stated, “South Africa have been the benchmark team in World Rugby for a long time, and we’re motivated by the challenge of meeting them in our own backyard.”"
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-15",
      "edition": "Tuesday 15 September",
      "sections": [
        {
          "kicker": "Eligibility Settlement",
          "heading": "Japan Rugby League One resolves nationality dispute for foreign-born players",
          "body": "Japan Rugby League One has reached a formal settlement following a legal challenge by 24 players regarding eligibility restrictions. Under the revised terms, any player who acquired Japanese nationality prior to the end of May 2025 will now be granted parity with native-born players under the upcoming league rules. This decision concludes a high-profile dispute involving notable figures like Timothy Lafaele, effectively overturning proposed barriers that would have restricted the status of players who were born and educated outside of Japan."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      },
      "rung": "storyline"
    },
    "465": {
      "date": "2026-09-15",
      "edition": "Tuesday 15 September",
      "sections": [
        {
          "kicker": "Selection and officiating",
          "heading": "Neil Barnes slams officials as All Blacks reflect on series loss",
          "body": "All Blacks senior assistant coach Neil Barnes has publicly criticised the officiating during the final test of the Greatest Rivalry series in Baltimore. Following the 43-28 defeat, Barnes claimed the Springboks benefited from inconsistent calls, suggesting the world champions repeatedly gained penalties for \"bugger all\" which stifled his side's momentum. As the team reviews a 3-1 series loss, local media commentary has highlighted a growing physical and tactical gap between the two sides as the World Cup approaches."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-09-15",
      "edition": "Tuesday 15 September",
      "sections": [
        {
          "kicker": "Series victory",
          "heading": "South Africa overcome New Zealand to secure series win in Baltimore",
          "body": "The Springboks completed a 3-1 series victory over New Zealand on Saturday, securing a 43-28 win in the fourth Test at M&T Bank Stadium. After losing the opener in Johannesburg, Rassie Erasmus’ side responded with three consecutive victories, showcasing a potent mix of forward power and attacking variety. While New Zealand challenged throughout the final encounter in front of a record 68,173 spectators, the world champions’ cohesion proved decisive, leaving them well-placed as they head into the upcoming international schedule."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    }
  }
}