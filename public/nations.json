  "digests": {
    "28": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "Title surrendered",
          "heading": "Frank Lomani laments second-half errors as Japan snatch Fiji's PNC title",
          "body": "The Flying Fijians failed to defend their Pacific Nations Cup title on Saturday, falling 20-15 to Japan in a tense final in Tokyo. Despite leading 12-10 at the interval following tries from Virimi Vakatawa and captain Tevita Ikanivere, Fiji succumbed to a late Samisoni Tua score. Halfback Frank Lomani admitted the squad were \"gutted\" after mistakes and poor discipline — including a Mesake Doge yellow card — allowed the hosts to dominate possession and territory during the closing stages."
        },
        {
          "kicker": "Around the world",
          "heading": "Australia: Wallabies recall Jordan Petaia for upcoming Springboks Test",
          "body": "New Zealand: All Blacks captain Ardie Savea faces six-month injury layoff. South Africa: Springboks release Pieter-Steph du Toit and Damian de Allende early."
        }
      ],
      "match": {
        "venue": "Prince Chichibu Memorial Rugby Ground, Tokyo"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "386": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "Winning streak ends",
          "heading": "England women share spoils as Canada draw halts record-breaking winning run",
          "body": "The Red Roses saw their remarkable 39-match winning streak come to a conclusion at Sandy Park, as Canada held the world champions to a 26-26 draw. Despite the result, John Mitchell’s side remains unbeaten in 40 Tests. England led through tries from Claudia Moloney-MacDonald, Hannah Botterman, and Bryony Field but were unable to convert sustained pressure into a victory during a chaotic final quarter. Mitchell remains optimistic, stating, \"I'm a realist; there will be greater things come as a result of this.\""
        },
        {
          "kicker": "Around the world",
          "heading": "Japan beat Fiji 20-15 to win Pacific Nations Cup title",
          "body": "Australia: Wallabies recall Jordan Petaia for upcoming Springboks Test. New Zealand: All Blacks captain Ardie Savea faces six-month injury layoff. South Africa: Springboks release Pieter-Steph du Toit and Damian de Allende early."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "Miracle comeback",
          "heading": "France women overcome 19-point deficit to defeat Australia in Aix-en-Provence",
          "body": "The France women’s side conjured a remarkable 29-26 comeback win against Australia on Saturday, despite being reduced to 11 players during a chaotic first half at the Stade Maurice David. The match was further disrupted when a bus caught fire adjacent to the stadium, delaying the second-half restart. Despite suffering a sixth card after the break, France reeled off 17 unanswered points in the final 25 minutes to turn a 26-12 deficit into a victory, frustrating the Wallaroos."
        },
        {
          "kicker": "Around the world",
          "heading": "Japan beat Fiji 20-15 to win Pacific Nations Cup title",
          "body": "Australia: Wallabies recall Jordan Petaia for upcoming Springboks Test. New Zealand: All Blacks captain Ardie Savea faces six-month injury layoff. South Africa: Springboks release Pieter-Steph du Toit and Damian de Allende early."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "388": {
      "date": "2026-09-21",
      "edition": "Monday 21 September",
      "sections": [
        {
          "kicker": "WXV disappointment",
          "heading": "Ireland women surrender 19-point lead in narrow defeat to USA",
          "body": "Ireland women suffered a frustrating 40-36 defeat against the USA in their WXV Global Series opener at Tallaght Stadium on Saturday. Scott Bemand’s side dominated the opening period, leading 31-12 early in the second half, before a loss of discipline and a yellow card for Vicky Elmes Kinlan allowed the visitors to rally with four successive tries. Bemand admitted the result was \"a game we should have won,\" as his side now looks to respond in upcoming fixtures against Japan."
        },
        {
          "kicker": "Around the world",
          "heading": "Japan beat Fiji 20-15 to win Pacific Nations Cup title",
          "body": "Australia: Wallabies recall Jordan Petaia for upcoming Springboks Test. New Zealand: All Blacks captain Ardie Savea faces six-month injury layoff. South Africa: Springboks release Pieter-Steph du Toit and Damian de Allende early."
