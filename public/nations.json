  "digests": {
    "28": {
      "date": "2026-10-17",
      "edition": "Saturday 17 October",
      "sections": [
        {
          "kicker": "Eligibility watch",
          "heading": "Fiji's interest in Mark Nawaqanitawase stays open; Les Kiss waits to year-end",
          "body": "Mark Nawaqanitawase, the former Wallabies winger with 11 Test caps, is eligible for Fiji, Italy and Australia after his three-year stand-down, and was reported to be weighing a switch before his return to union. Fiji Rugby chief executive Koli Sewabu says the governing body is following developments with interest and would support whatever decision the player makes. Wallabies head coach Les Kiss says he will wait until the end of the year to see where the player sits."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "386": {
      "date": "2026-10-17",
      "edition": "Saturday 17 October",
      "sections": [
        {
          "kicker": "Women's test",
          "heading": "England women met Canada in Toronto on Friday, before an expected 18,000",
          "body": "England women played third-ranked Canada in Toronto on Friday, a fixture billed as the most-anticipated home rugby match in Canada's history. Canada were looking to avenge their 2025 Women's Rugby World Cup final defeat to No. 1-ranked England, with an expected 18,000 fans at BMO Field. Paige DeNeve, a former Brock University rugby star, said a Canada win would be historic."
        }
      ]
    },
    "387": {
      "date": "2026-10-17",
      "edition": "Saturday 17 October",
      "sections": [
        {
          "kicker": "Rankings race",
          "heading": "Wallabies could overtake France in world rankings with Bledisloe win",
          "body": "France sit fourth in the World Rugby men's rankings on 87.43 points, but the second Bledisloe Test in Sydney could take that place away. Australia, sixth after a 50-19 defeat at Eden Park, would climb above Les Bleus into fourth with a win over New Zealand by more than 15 points, ending a 12-match losing run against the All Blacks. A narrower win would leave France in fourth."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "388": {
      "date": "2026-10-17",
      "edition": "Saturday 17 October",
      "sections": [
        {
          "kicker": "Rivalry recall",
          "heading": "Steven Kitshoff recalls Springboks' Paris bar fury at Finn Russell's jibe",
          "body": "Steven Kitshoff, the retired Springbok prop, recalls in his memoir Kitsie how a Paris bar encounter with Scotland's Finn Russell turned personal. Springbok teammate Franco Mostert told Springbok coach Jacques Nienaber about Russell's jibe about beating the Springbok defence, and Kitshoff says Russell's manner towards teammate Handré Pollard was what pushed the squad over the edge. The book also explains why South Africa's rivalry with Ireland flared after a 2017 loss in Dublin."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-10-17",
      "edition": "Saturday 17 October",
      "sections": [
        {
          "kicker": "Losing run",
          "heading": "Italy's only win in their last five came before four straight defeats",
          "body": "In their last five games, Italy have won one and lost four. The four defeats are their current run, the latest a 57-10 loss away to Australia in July during the Nations Championship group stage. There are no draws in that five, and the lone win is the oldest of the five results. Their next fixture is against South Africa in Round 4."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-10-17",
      "edition": "Saturday 17 October",
      "sections": [
        {
          "kicker": "Last meeting",
          "heading": "Scotland lost 25-17 at home to New Zealand in November 2025",
          "body": "Scotland's most recent meeting with New Zealand was a 25-17 defeat at home in November 2025, in an International Friendly. It is a single result, not a head-to-head record, so no wider pattern is implied. Scotland's three matches so far in the competition have produced two wins and one defeat, with 108 points scored and 97 conceded across them."
        }
      ],
      "rung": "data"
    },
    "391": {
      "date": "2026-10-17",
      "edition": "Saturday 17 October",
      "sections": [
        {
          "kicker": "Welsh pathway",
          "heading": "Dafydd Jenkins says Wales's English-based players can strengthen Welsh game",
          "body": "Exeter lock Dafydd Jenkins says the growing number of Wales players in the English Premiership can strengthen the game at home. The 23-year-old, who has spent his whole senior career at Sandy Park, believes the exposure opens space for younger hookers and back-rowers in the URC regions. Wales captains Jac Morgan and Dewi Lake moved from Ospreys to Gloucester this summer, and Jenkins admitted he was 'pretty gutted' after their opening-day win over Exeter Chiefs."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-10-17",
      "edition": "Saturday 17 October",
      "sections": [
        {
          "kicker": "2035 bid race",
          "heading": "Spain tipped as front-runner against Argentina's South American 2035 World Cup bid",
          "body": "Argentina's South American bid for the 2035 World Cup now faces a rival: one report makes Spain front-runner, with a Nou Camp final in its pitch. The four-nation bid, Argentina, Uruguay, Chile and Brazil, would all host matches, and World Rugby is expected to name its preferred hosts in May 2027. World Rugby's council decides in November. Félix Páez Molina, president of the Argentine rugby union, called the candidacy \"a very important step for Argentine rugby and the whole region.\""
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "461": {
      "date": "2026-10-17",
      "edition": "Saturday 17 October",
      "sections": [
        {
          "kicker": "Rankings stakes",
          "heading": "Wallabies could climb to fifth in rankings with a Bledisloe II win",
          "body": "A win over New Zealand in Sydney would lift the Wallabies from sixth to fifth on World Rugby's men's rankings, passing England (85.68) who sit fifth in the latest table, against Australia's 84.89. A win by more than 15 points would send coach Les Kiss' side north ranked fourth, above France. A second All Blacks win would see Australia slip to seventh, swapping places with Scotland."
        }
      ],
      "match": {
        "venue": "Accor Stadium, Sydney"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
