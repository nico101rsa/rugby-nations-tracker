  "digests": {
    "28": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "By the numbers",
          "heading": "Fiji concede 326 points during defensive struggles over last 11 games",
          "body": "Fiji have experienced a mixed run of form across their last 11 games. During this 11-game window, the side conceded 326 points in total, working out at an average of 29.6 per match. On the attacking side, they scored 315 points over those same 11 games, averaging 28.6 points per match. The high point of this period came in September 2025, when they defeated Canada 63-10 at home in the Pacific Nations Cup knockout stage."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Steve Borthwick drops Ollie Lawrence and Elliot Daly from England contract list",
          "body": "Steve Borthwick has omitted the seasoned pair from his 25-man centrally contracted squad as he prioritises the roadmap to next year's World Cup. While Lawrence and Daly lose their £150,000 deals, the squad welcomes five fresh faces including Asher Opoku-Fordjour and Seb Atkinson. Borthwick’s shake-up also rewards Jack van Poortvliet’s return to fitness, though Ben Curry misses out following an injury-hit year and Tom Roebuck drops down the pecking order after the Nations Championship window."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "Coaching exit",
          "heading": "Vlok Cilliers departs France coaching team for return to Bulls role",
          "body": "Long-serving kicking coach Vlok Cilliers has left Fabien Galthié's backroom staff following a seven-year tenure with the national side. The French Rugby Federation confirmed the departure, which is part of a broader shake-up under Galthié as the team looks toward future campaigns. Cilliers, who was instrumental in developing the tactical kicking game and Thomas Ramos’s goal-kicking accuracy, has returned to the Bulls. He stated, “Being with France for seven years was an amazing time, and I picked up so much experience.”"
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "388": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "Player recognition",
          "heading": "Dan Sheehan ranked among the world’s elite hookers by Planet Rugby",
          "body": "Dan Sheehan has been identified as a premier talent in the global game, placing second in a recent ranking of the world’s top 10 hookers. The Ireland carrying king was noted for his consistent impact, sitting just behind Springbok powerhouse Malcolm Marx in the latest analysis. Sheehan continues to be a cornerstone for Andy Farrell’s side, distinguishing himself through his work rate in the loose and effectiveness in the set-piece during this campaign."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "Coaching scrutiny",
          "heading": "Gonzalo Quesada banned following World Rugby match official abuse ruling",
          "body": "Italy head coach Gonzalo Quesada has been issued a two-match suspension following critical comments regarding match official performance. The sanction, which follows the recent implementation of World Rugby’s new Match Official Abuse Sanctioning Process, prohibits Quesada from all match-day proceedings for the upcoming Round 4 fixture against South Africa. This decision represents the first such ban handed down under the framework agreed at the recent Shape of the Game forum, with the coach maintaining his right to appeal the governing body's ruling."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "Legal proceedings",
          "heading": "Scotland players monitor landmark concussion case as collapse risk persists today",
          "body": "The high-profile legal challenge concerning brain injuries among former rugby players remains in a state of uncertainty. Recent reports indicate the court case is at risk of collapse while a judge considers strikeout applications from the governing bodies involved. The litigation continues to loom over the sport as the claimants seek to establish liability for long-term neurological conditions. Until a definitive judicial decision is reached, the potential outcomes for the future of professional rugby’s approach to concussion remain unresolved."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "Boardroom appointment",
          "heading": "Alun Wyn Jones is set to join the Ospreys board next week",
          "body": "Former Wales captain Alun Wyn Jones is set to return to the Ospreys as a director. The 40-year-old will take up the board position during a period of significant uncertainty, as the Swansea-based club continues to challenge Welsh Rugby Union plans to reduce the professional game to three sides. While the Ospreys navigate a difficult period of transition, head coach Mark Jones has focused on recruitment, securing signings such as Tom Rogers and a trio of Australians to bolster the squad."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "Disciplinary sanction",
          "heading": "Fly-half Tomás Albornoz receives four-match suspension for intimidating match official",
          "body": "Tomás Albornoz has been handed a four-match ban following a disciplinary hearing regarding his conduct after the defeat to England. The fly-half accepted allegations that his approach towards referee Angus Gardner was intimidatory after a late try was denied. The committee noted Albornoz made physical contact with the official and required restraining by teammates. The suspension, which covers the recent clash with South Africa and two fixtures against Australia, accounts for his early guilty plea and previously clear disciplinary record."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "461": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "Winning momentum",
          "heading": "Australia sweep past Japan as eight-try blitz secures third straight victory",
          "body": "Australia dominated Japan 56-17 in Townsville on Saturday, claiming a third consecutive win for the first time since 2024. Despite trailing early, the Wallabies surged in the second half, racking up 35 unanswered points to overwhelm the Brave Blossoms. Taniela Tupou crossed twice, while debutant prop Massimo De Lutiis and Josh Nasser were among eight individual try-scorers. The result builds on last week’s tense victory in Osaka and continues a positive start to the reign of new head coach Les Kiss."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "463": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "Heavy defeat",
          "heading": "Japan overwhelmed as Australia dominates second half in Townsville test",
          "body": "Japan’s competitive start in Saturday’s second test was dismantled as the Wallabies ran away with a 56-17 victory. Despite leading 17-14 late in the first half following a sharp Dylan Riley try, Japan conceded 35 unanswered points after the interval. The hosts capitalised on physical superiority, with their front row scoring four times in total. Japan, having struggled to maintain the intensity shown in Osaka, now face a difficult period as they look to address significant defensive lapses."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "465": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Dave Rennie confirms Richie Mo'unga will miss first Springboks Test",
          "body": "Despite his late arrival in Gauteng to cover the injured Billy Proctor, Richie Mo'unga will not feature in the opening Test against the Springboks. Head coach Dave Rennie confirmed the fly-half will instead target the midweek fixture against the Lions to build match fitness. With Damian McKenzie also in doubt for the Johannesburg clash, Ruben Love is poised to start in the 10 jersey. Rennie noted that his Test lineup will look significantly different from the side that defeated the Bulls."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Rassie Erasmus eyes 'challenging' series as Bok squad reunites for Test",
          "body": "Rassie Erasmus has confirmed the Springboks have reconvened as a full group following the return of the squad from Argentina. After a period of managed recovery, players have shifted focus to the Rugby's Greatest Rivalry series, which kicks off next week. The head coach described the upcoming Tests as being like the knockout stages of a World Cup. Bulls duo Johan Grobbelaar and Elrigh Louw are expected to rejoin the national squad today after featuring for their franchise against the All Blacks."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
