    "465": {
      "date": "2026-11-08",
      "edition": "Sunday 8 November",
      "sections": [
        {
          "kicker": "Milestone try",
          "heading": "Beauden Barrett brings up 50 Test tries against Scotland at Murrayfield",
          "body": "Beauden Barrett's first try, his 49th in Test rugby, came off a Damian McKenzie flat pass and stretched New Zealand's lead to 24-14 in the first half. His second, two minutes after Josh Moorby's try following the break, brought up 50. Only Will Jordan has also reached that mark for the All Blacks. Their 43-21 win at Murrayfield on Saturday was their fourth straight in the Nations Championship."
        },
        {
          "kicker": "Around the world",
          "heading": "Wales edge Japan 28-21 in autumn opener",
          "body": "England's George Furbank returns for Australia after injury absence."
