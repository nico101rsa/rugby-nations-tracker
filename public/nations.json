  "digests": {
    "28": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Tragic news",
          "heading": "Fijian forward Saimoni Vunilagi dies in Japan from suspected heatstroke",
          "body": "Fijian back rower Saimoni Vunilagi has tragically passed away in Japan at the age of 26. His club, Kyuden Voltex, confirmed that Vunilagi died in a Fukuoka hospital on Friday following a training session where he suffered severe symptoms of suspected heatstroke. The Fukuoka-based second-division side, along with Japan Rugby League One, expressed deep devastation. The forward, who previously represented top-flight Tokyo Sungoliath, had only joined his new club last month, with Kyushu KV staff praising his generous spirit."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "386": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Disciplinary fallout",
          "heading": "Tomás Albornoz receives four-match ban for intimidating referee after England victory",
          "body": "The fallout from England's controversial 31-24 victory in Santiago del Estero has culminated in a four-match ban for Pumas fly-half Tomás Albornoz. A disciplinary committee suspended Albornoz after he admitted to intimidating referee Angus Gardner following the final whistle. The fly-half, who had to be restrained by teammates, was incensed after being denied a last-gasp try that would have given him a conversion to draw the match. The decision secured a much-needed victory for Steve Borthwick's side, while Albornoz will now miss Argentina’s Test against South Africa."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "387": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Transfer bombshell",
          "heading": "Superstar Thomas Ramos confirms departure from Toulouse to join Racing 92",
          "body": "France fullback Thomas Ramos has confirmed his departure from Toulouse to join Top 14 rivals Racing 92 at the end of the 2026-27 season. Describing the move as \"particularly difficult to make\", the superstar ends a career-long association with the red and black to seek a new challenge. Toulouse officials verified the bombshell transfer following Friday's reports, marking a significant shift for the national team's primary goal-kicker. Elsewhere, the Under-18s suffered a heavy 52-7 defeat against South Africa in Durbanville on Friday."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "388": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "U18 International Series",
          "heading": "Ireland U18 suffer narrow defeat against South Africa in series opener",
          "body": "Ireland’s U18s opened their international series with a painful 32-31 defeat to South Africa U18 A at Hoërskool Durbanville on Friday. Despite trailing at half-time, Ireland surged back in the second period, with hooker Herbie Doyle crossing for a brace of tries to secure a late lead. However, the hosts regained the advantage in the dying minutes when replacement flyhalf Travis Pheiffer slotted a decisive penalty, leaving the Irish side just one point short at the final whistle."
        }
      ],
      "match": {
        "venue": "Not verified",
        "referee": "Not verified"
      },
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Transfer news",
          "heading": "Ion Neculai joins Northampton Saints following five seasons at Zebre Parma",
          "body": "Italian international Ion Neculai has signed for Northampton Saints after completing five seasons with Zebre Parma. The 25-year-old tight-head prop, who has earned four senior caps for Italy, moves to the English Premiership champions ahead of the new campaign. Saints director of rugby Phil Dowson described the forward as a \"very physical prop who enjoys the tough side of the game.\" Neculai most recently featured for the Azzurri during their Nations Championship match against Australia in Perth."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Coaching upheaval",
          "heading": "Sione Fukofuka steps down as Scotland Women head coach citing stress",
          "body": "Sione Fukofuka has resigned as Scotland Women head coach due to the personal strain of living apart from his family in Australia. Forwards coach Dave Butcher will lead the team on an interim basis as they prepare for the upcoming WXV Global Series. The union has also confirmed the departure of senior assistant Ioan Cunningham, with Chris Laidlaw and Tom Luke joining the coaching ticket to support the transition ahead of next month's home fixtures."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Prospect Watch",
          "heading": "Teenage Cardiff hooker Tom Howe prioritises club debut over national hype",
          "body": "Cardiff academy hooker Tom Howe is focusing on his domestic development rather than recent speculation regarding a senior Wales call-up. Despite an impressive showing at the Junior World Championship, the 18-year-old remains grounded as he transitions to professional training. Former Wales hooker Scott Baldwin noted that Tandy has already identified the teenager as a prospect for the next 18 months, yet Howe insists he is simply looking to learn from his peers while working toward a senior club debut."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Selection blow",
          "heading": "Tomas Albornoz misses four matches after admitting to intimidating match official",
          "body": "Argentina will be without fly-half Tomas Albornoz for the immediate future following a four-match suspension for his conduct towards referee Angus Gardner after the recent defeat to England. Albornoz accepted charges of intimidation at a disciplinary hearing, where it was noted he made contact with the official. The ban rules him out of the upcoming fixture against South Africa and the subsequent double-header with Australia, forcing Felipe Contepomi to reshuffle his backline as the team looks to recover its 2025 form."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "461": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Winning start",
          "heading": "Les Kiss guides Australia to dramatic victory over Japan in Osaka",
          "body": "Les Kiss began his tenure as Wallabies head coach with a hard-fought 35-32 win against Japan on Saturday. Despite playing a significant portion of the match with 14 men following a red card for Miles Amatosero, Australia secured the result through tries from Harry Potter, Tom Wright, Max Jorgensen, Fraser McReight, and Taniela Tupou. Reflecting on the challenging, high-tempo conditions, Kiss admitted: “I’m really enjoying this process and obviously, it comes down to 80 minutes where it won’t be cooling.”"
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Narrow defeat",
          "heading": "Japan Brave Blossoms fall to Australia in tight Osaka Test match",
          "body": "Eddie Jones’ side fell to a 32-35 defeat against Australia in Osaka on Saturday. Despite Japan capitalising on a 20-minute red card for Australian lock Miles Amatosero, the visitors held firm in sweltering conditions. Tries from Ryunosuke Ito, Faulua Makisi, Kazuma Ueda and captain Warner Dearns kept the hosts in contention until the final whistle, but the Wallabies ultimately secured a three-point victory in Les Kiss’s first match as head coach."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "465": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Tour scrutiny",
          "heading": "Media criticise All Blacks following unconvincing victory over the Stormers side",
          "body": "The All Blacks have faced heavy criticism at home following their 38-21 win against the Stormers in Cape Town. While Dave Rennie’s side secured the result, commentators identified significant flaws, including a messy scrum, poor high-ball reception, and an inability to contain the driving maul. Media analysis warns that repeating these errors against the Springboks in the upcoming Test series will leave the team unable to compete against the intensity of the back-to-back world champions."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Greatest Rivalry",
          "heading": "Springboks and All Blacks kick off the Greatest Rivalry tour series",
          "body": "The highly anticipated Rugby’s Greatest Rivalry series has begun with the opening provincial fixture in Cape Town. While the four-Test series between the Springboks and the All Blacks does not commence until 22 August, the tour—which marketing departments have heavily promoted—is already generating significant interest. South African union president Mark Alexander believes the series could eclipse the stature of British & Irish Lions tours, despite ongoing legal discussions regarding the commercial branding of the event."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    }
  }
