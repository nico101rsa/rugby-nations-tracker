  "digests": {
    "28": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "TRAGIC LOSS",
          "heading": "Fijian rugby player Saimoni Vunilagi dies in Japan of suspected heatstroke",
          "body": "The Fijian rugby community is mourning the tragic passing of 26-year-old back-row forward Saimoni Vunilagi, who died in Japan following a club training session. Vunilagi, who represented second-division side Kyushu KV in Fukuoka, was hospitalised on Monday after displaying severe symptoms consistent with heatstroke during practice in 35C temperatures. His club confirmed he passed away on Friday morning, leaving staff and teammates \"devastated\". The 196cm forward had played professionally in Japan since 2023."
        }
      ]
    },
    "386": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "Junior series",
          "heading": "England U18s and Archie Guyver fall as South Africa clinch series sweep",
          "body": "England U18s finished their South African tour without a win after a 68-40 defeat north of Cape Town on Saturday. Despite early tries from Archie Guyver and Will Moore, the visitors trailed by a narrow margin at the interval before the hosts pulled away with six second-half scores. The result completes a series sweep for the South Africans, leaving the English youngsters to reflect on a difficult defensive display where they conceded 10 tries across the final-round encounter at Stellenberg High."
        }
      ],
      "match": {
        "venue": "Stellenberg High, Cape Town"
      },
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "387": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "Coaching staff exit",
          "heading": "Vlok Cilliers departs France setup to return to Bulls coaching role",
          "body": "Vlok Cilliers has officially left Fabien Galthié's coaching team following a seven-year tenure that saw the French side develop into a world-class tactical kicking unit. The French Rugby Federation confirmed his exit alongside Shaun Edwards, as Galthié seeks to refresh his backroom staff ahead of the next World Cup. Cilliers, who was instrumental in refining Thomas Ramos’ goal-kicking, has returned to his former club, the Bulls, to serve as their kicking coach, reuniting with head coach Johan Ackermann."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "388": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "Sad loss",
          "heading": "Former Ireland and Wallabies international Brian Smith dies aged 59",
          "body": "The rugby world is mourning the loss of former Ireland and Australia international Brian Smith, who has died at the age of 59. A versatile half-back, Smith earned nine caps for Ireland after previously representing the Wallabies six times. Following his playing career, he moved into coaching, including roles as an assistant to Martin Johnson with England and as director of rugby at London Irish. Tributes have flowed for the Queensland native, remembered as a great coach and mentor."
        }
      ]
    },
    "389": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "Disciplinary update",
          "heading": "Gonzalo Quesada faces two-match ban following post-match referee criticism",
          "body": "Head coach Gonzalo Quesada has been issued a two-match suspension under World Rugby’s new Match Official Abuse Sanctioning Process. The ban follows public criticism of referee Luc Ramos after the Nations Championship meeting with New Zealand. Consequently, Quesada is prohibited from attending match-day proceedings for upcoming fixtures. This follows the recent two-week suspension handed to prop Marco Riccioni for a red card offence during the loss to Australia. Italy continues to seek its first victory, currently sitting 11th in the standings."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "Coaching shock",
          "heading": "Sione Fukofuka named Australia head coach days after Scotland exit",
          "body": "Scottish Rugby has expressed surprise following the appointment of Sione Fukofuka as the new head coach of Australia. The news arrives only days after Fukofuka stepped down from his role with Scotland, a departure that was publicly attributed to family reasons. This development leaves the search for a permanent successor to the Scotland head coach position ongoing, as the organisation addresses the vacancy created by his abrupt resignation earlier this month."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "Boardroom appointment",
          "heading": "Alun Wyn Jones set to join Ospreys as new board member",
          "body": "Former Wales captain Alun Wyn Jones is poised to return to the Ospreys as a director, with an official announcement expected next week. The 40-year-old’s arrival comes at a turbulent time for the Swansea-based club as they navigate Welsh Rugby Union plans to consolidate professional sides. While the Ospreys have publicly criticised the proposed three-team model, they are currently finalising a move to a revamped St Helen’s ahead of their upcoming United Rugby Championship campaign."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "Disciplinary update",
          "heading": "Tomás Albornoz serves first match of four-game ban for intimidation",
          "body": "Fly-half Tomás Albornoz has begun his four-match suspension following his conduct after the defeat to England. The disciplinary committee found Albornoz made contact with referee Angus Gardner and required restraint from teammates after a late try was denied. While he accepted the charge of intimidation, a four-match sanction was applied—reduced from a six-match entry point due to an early guilty plea. Albornoz sat out the recent fixture against South Africa and will miss the upcoming double-header against Australia plus a club fixture."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "461": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "Winning streak",
          "heading": "Taniela Tupou leads Wallabies to dominant victory over Japan in Townsville",
          "body": "Australia secured three consecutive wins for the first time since 2024, dismantling Japan 56-17 on Saturday. The hosts utilised a ruthless second-half display, scoring 35 unanswered points after trailing early. Taniela Tupou crossed for two tries, while debutant prop Massimo De Lutiis also touched down during a match that saw the pack control proceedings. Reflecting on the tactical selection, head coach Les Kiss noted, “The coaches have looked to find some balance in the selection after what was a physically taxing Test week.”"
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "463": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "Heavy defeat",
          "heading": "Japan suffer second-half collapse as Wallabies secure convincing 56-17 victory",
          "body": "Japan’s Nations Championship campaign hit a difficult hurdle in Townsville on Saturday as a competitive first half gave way to a one-sided second. Trailing by only 4 points at the interval, Eddie Jones’ side were unable to contain Australia’s momentum, conceding 35 unanswered points after the break. While tries from Harry Hockings and Naoto Saitō kept the contest tight early on, the Brave Blossoms struggled to maintain their discipline, ultimately finishing the match with 14 men following a late yellow card."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "465": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Caleb Clarke ruled out as All Blacks suffer another backline casualty",
          "body": "Caleb Clarke will return home after rupturing a shoulder tendon during Tuesday’s win over the Sharks, becoming the second backline player forced out of the tour. Clarke follows centre Billy Proctor, who departed last week with a serious shoulder injury. Head coach Dave Rennie confirmed no immediate replacement will be called up, though he noted that performances against the Bulls could still influence final selections for the upcoming series against the Springboks, where positions remain under consideration."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-16",
      "edition": "Sunday 16 August",
      "sections": [
        {
          "kicker": "Series preparation",
          "heading": "Rassie Erasmus previews challenging All Blacks series as duo returns home",
          "body": "Rassie Erasmus has confirmed that hooker Johan Grobbelaar and utility forward Elrigh Louw will rejoin the Springbok squad this Sunday following their release to face the All Blacks for the Bulls. After integrating the 26-man group that travelled to Argentina, Erasmus believes the side is now well-positioned for the upcoming four-Test series. “It will undoubtedly be a very challenging tournament,” said the head coach, noting the intensity required for a contest he likened to the knockout stages of a World Cup."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
