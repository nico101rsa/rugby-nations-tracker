  "digests": {
    "28": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Tragic news",
          "heading": "Fijian forward Saimoni Vunilagi dies in Japan following suspected training heatstroke",
          "body": "Fijian rugby is in mourning following the tragic death of 26-year-old forward Saimoni Vunilagi in Japan. The back-rower, who recently joined second-division club Kyuden Voltex after a spell with top-flight Tokyo Sungoliath, passed away on Friday after showing symptoms of severe heatstroke following a training session on Monday. Temperatures in Fukuoka reached 35C during a week of intense summer heat. The 117-kilogram forward, who moved to Japan for university before turning professional in 2023, was highly regarded for his generous spirit and powerful play."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "386": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "PREMIERSHIP MOVES",
          "heading": "George Furbank joins Harlequins as Premiership clubs confirm several major new signings",
          "body": "Former Northampton Saints skipper George Furbank has moved to the Stoop as part of a major rebuild under new Harlequins coaching staff. His arrival coincides with Joe Marchant’s high-profile move to Sale Sharks, where the versatile back is targeting a Test recall following his recent stint in France. These signings highlight a significant league-wide recruitment drive ahead of the 2026/27 domestic season, as several established international stars return to the English top flight to push for national selection."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Club future",
          "heading": "Thomas Ramos confirms Toulouse departure to join Racing 92 in 2027",
          "body": "France fullback Thomas Ramos has confirmed his departure from Toulouse to join Top 14 rivals Racing 92. The versatile playmaker described the decision to leave the reigning champions as particularly difficult to make after a career spent at the Stade Toulousain. Ramos, who remains a core component of Fabien Galthié's national squad, will move to the Parisian club for the 2027-28 campaign after opting for a fresh challenge in the capital."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      },
      "rung": "storyline"
    },
    "388": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "JUNIOR SERIES",
          "heading": "Herbie Doyle brace not enough; Ireland U18 lose to South Africa A",
          "body": "Ireland Under-18s suffered a narrow 32-31 defeat to South Africa A on Friday in the opening match of the International Series. Despite holding a late 29-28 lead following a brace from hooker Herbie Doyle, the visitors were undone by a final Travis Pheiffer penalty goal. Micheal Smyth and Matthew McCarthy also crossed for Ireland, with David Nolan and Luke Coffey contributing 11 points from the tee. The loss in Durbanville follows a physical encounter where Ireland fought back from a 10-point half-time deficit."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "389": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Log status",
          "heading": "Gonzalo Quesada's Italy side remain 11th after heavy defeat against Australia",
          "body": "Italy sit 11 of 12 in the Nations Championship standings after three opening defeats. The Azzurri were beaten 10-57 by the Wallabies in their last fixture, leaving the squad with a points difference of -94. Gonzalo Quesada’s side now look ahead to their meeting with South Africa, having lost the previous home encounter against the Springboks 32-14 in 2025. With zero points on the log, Italy remain under pressure to find their first victory."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Leadership crisis",
          "heading": "Mark Williamson sacked as chief executive while Sione Fukofuka vacates coaching role",
          "body": "Scottish Rugby is managing a leadership vacuum after chief executive Mark Williamson was sacked following an internal inquiry. The administrative upheaval at Murrayfield intensified this week as Sione Fukofuka resigned as head coach of the women's side, citing the 'stress and the strain' of being apart from his Australia-based family. Fukofuka described the exit as the hardest professional decision of his life. Forwards coach Dave Butcher takes interim charge while the organisation seeks to stabilise its senior management structure during this transition."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "RANKING BOOST",
          "heading": "Wales return to the world top 10 despite having no game",
          "body": "Wales have climbed back into the world’s top 10 nations despite having no fixture this weekend. The movement follows a sequence of results elsewhere in the international window, providing a minor statistical boost for a side that sat ninth in the Nations Championship log after July’s 0-43 loss to South Africa. While the squad remains out of action until the autumn, the rise offers a reprieve from recent criticism as preparations begin for the November series."
        }
      ]
    },
    "460": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Disciplinary blow",
          "heading": "Tomás Albornoz receives four-match ban for intimidating referee after England defeat",
          "body": "Los Pumas enter Saturday's clash against South Africa at Vélez without Tomás Albornoz, who received a four-match suspension for intimidating referee Angus Gardner in Santiago del Estero. With Albornoz sidelined and regular captain Julián Montoya unavailable, Felipe Contepomi has made 13 changes to the starting XV. Santiago Carreras shifts to fly-half to pull the strings, while Pablo Matera takes the captaincy. The matchday squad features four uncapped players, including tighthead prop Francisco Moreno, who makes his debut in a heavily rotated side."
        }
      ],
      "match": {
        "venue": "Vélez, Buenos Aires"
      },
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "461": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Winning start",
          "heading": "Les Kiss secures first victory as Australia edge Japan in Osaka",
          "body": "The Les Kiss era has begun with a hard-fought 35-32 victory against Japan at Hanazono Rugby Stadium. Despite losing Miles Amatosero to a 20-minute red card following a high tackle in the first half, the Wallabies maintained their composure to secure the result. The visitors relied on a disciplined second-half performance, with tries from Fraser McReight and Taniela Tupou proving decisive in the stifling conditions. Kiss described his initial weeks in charge as a process where he was ready for the ride."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Wallabies clash",
          "heading": "Eddie Jones targets historic first Japan victory over Wallabies in Osaka",
          "body": "Eddie Jones leads a refreshed Brave Blossoms side into Saturday's clash against Australia in Osaka, chasing Japan's first-ever victory over the Wallabies. Amid forecast temperatures of 36C at Hanazono Rugby Stadium and the looming threat of Typhoon Dolphin, Japan field a vastly altered squad from their narrow 19-15 defeat to Australia in Tokyo last year, with only 11 players retained in the matchday 23. Wallabies coach Les Kiss, taking charge of his first Test, has resisted major changes despite the extreme humidity."
        }
      ],
      "match": {
        "venue": "Hanazono Rugby Stadium, Higashiosaka"
      },
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Selection scrutiny",
          "heading": "Media critics label All Blacks’ performance against Stormers as deeply concerning",
          "body": "Following a narrow 38-21 win over the Stormers, New Zealand media have slammed the team’s lacklustre outing in Cape Town. Despite the margin, the side conceded three yellow cards and struggled at both the scrum and with the high ball. Gregor Paul of the NZ Herald warned that should the team perform similarly against South Africa, they can \"forget about winning the series\" or even being \"vaguely competitive,\" noting that disciplined, technical accuracy is essential for success in the Republic."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-08",
      "edition": "Saturday 8 August",
      "sections": [
        {
          "kicker": "Match build-up",
          "heading": "Siya Kolisi returns as Springboks brace for an emotional Argentina clash",
          "body": "Captain Siya Kolisi leads the Springboks in Buenos Aires, making his first appearance this year after a period of injury rehabilitation. Assistant coach Mzwandile Stick warned the squad to expect an intense encounter, noting that Argentina are an emotional nation who derive significant energy from their home supporters. Despite the Pumas' recent disciplinary troubles, Stick confirmed the world champions have maintained their standard preparations, insisting that the Springboks will be focused on controlling the collision areas to manage the hosts' aggression."
        }
      ],
      "match": {
        "venue": "Vélez, Buenos Aires"
      },
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
}