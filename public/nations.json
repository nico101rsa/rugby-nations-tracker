    "387": {
      "date": "2026-09-22",
      "edition": "Tuesday 22 September",
      "sections": [
        {
          "kicker": "Test victory",
          "heading": "Pauline Bourdon Sansus leads France Women to comeback win against Australia",
          "body": "France Women staged a miraculous comeback to beat Australia 29-26 on Saturday despite a burning bus delaying the second half. Trailing 19-0 and temporarily reduced to just 11 players following a red card and three yellows, the hosts rallied through Pauline Bourdon Sansus to stun the Wallaroos. France conceded six cards in total but finished the match with 17 unanswered points in the final quarter. The victory maintains their momentum ahead of upcoming tests against the Black Ferns."
        },
        {
          "kicker": "Around the world",
          "heading": "Japan defeat Fiji 20-15 to claim Pacific Nations Cup",
          "body": "All Blacks captain Ardie Savea sidelined indefinitely after surgery. South Africa: Rassie Erasmus releases Pieter-Steph du Toit and Damian de Allende."
        }
      ],
      "match": {
