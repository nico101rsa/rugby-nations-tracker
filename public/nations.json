    "387": {
      "date": "2026-10-27",
      "edition": "Tuesday 27 October",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Galthié reshuffles France squad as Brau-Boirie, Hastoy and Gazzotti withdraw",
          "body": "Fabien Galthié has been forced into a late reshuffle of his Nations Championship squad, with Fabien Brau-Boirie, Antoine Hastoy and Marko Gazzotti all ruled out by injuries picked up in Top 14 action. Nicolas Depoortere, Anthony Jelonch and uncapped Louis Le Brun are the replacements, adding to a squad already missing Matthieu Jalibert, Thomas Ramos and Julien Marchand. The campaign opens against Fiji before the Springboks and Argentina."
        },
        {
          "kicker": "Around the world",
