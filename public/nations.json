    "390": {
      "date": "2026-10-01",
      "edition": "Thursday 1 October",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Scotland wing Darcy Graham misses Nations Championship following bicep rupture injury",
          "body": "Scotland and Edinburgh star Darcy Graham has been ruled out for the remainder of the year after suffering a ruptured bicep. The injury forces the wing to miss the upcoming Nations Championship campaign, including November's meeting with New Zealand. He is not expected to return to action until January, leaving Gregor Townsend to reassess his back-three options as the national side prepares for the autumn series without one of its most prolific finishers."
        },
        {
          "kicker": "Around the world",
          "heading": "Wallabies name Toby Macpherson in 34-man Bledisloe Cup squad",
          "body": ""
        }
      ],
