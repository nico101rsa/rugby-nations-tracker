  "digests": {
    "28": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "France test",
          "heading": "Fiji reset for France test following winless Nations Championship start",
          "body": "Fiji head into Round four of the Nations Championship seeking their first points of the campaign. The Flying Fijians currently sit 12th in the 12-team log after losing all three opening matches. In their last fixture, they suffered a 17-33 defeat against Scotland in Round three. That result left them with 49 points scored in their three tournament games, while conceding 145 points. Fiji next face France, who won the last meeting between the sides 34-21 in an away friendly in November 2025."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Contract talk",
          "heading": "Eddie Hearn demands £1 million contract for England back-rower Henry Pollock",
          "body": "Promoter Eddie Hearn has been warned that rugby lacks the Saudi-style riches of boxing after demanding a £1 million annual contract for England’s Henry Pollock. The 21-year-old Northampton back-rower, capped 13 times and a recent Lions tourist, is the first major rugby client for Hearn’s agency. Discussing the move, Dan Cole noted that Hearn will \"soon realise\" the sport’s financial limits compared to Riyadh. Pollock is among 25 players recently awarded enhanced elite player contracts by Steve Borthwick for the upcoming season."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Transfer report",
          "heading": "François Cros reportedly agrees Lyon move as Toulouse lose back-row stalwart",
          "body": "Reports from Midi Olympique suggest François Cros has agreed a three-year deal with Lyon, ending his career-long stint at Toulouse. The back-rower, a mainstay of the Fabien Galthié era, reportedly turned down interest from Montpellier to secure the move. While the national side looks ahead to their November test against Fiji, Cros remains central to a squad that has scored 426 points across their last 11 fixtures. This attacking form peaked in February's 54-12 victory over Wales, before most recently beating Japan 42-15."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Selection blow",
          "heading": "Ireland fly-half Jack Crowley ruled out of action until 2027",
          "body": "Ireland and Munster playmaker Jack Crowley will not return to the pitch until the new year following a lower limb vascular injury. The 26-year-old, who has been sidelined since April, will now miss the remainder of the Nations Championship, including the upcoming November window against Argentina, Fiji, and South Africa. Munster head coach Clayton McMillan confirmed the news this week, stating, \"ensuring he gets back to 100% is the priority\" for the 35-cap international."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Disciplinary update",
          "heading": "Marco Riccioni serves suspension following Nations Championship red card incident",
          "body": "Italy prop Marco Riccioni will miss two club matches after receiving a red card during the recent defeat to Australia. Although not in the match-day squad, Riccioni was dismissed for an altercation on the touchline during the second half of the 57-10 loss. Having admitted to the act of foul play, he will now sit out upcoming fixtures for Perpignan. Italy currently find themselves on a run of 4 consecutive defeats, having won only one of their last 5 matches."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Player recognition",
          "heading": "Scotland's centre earns top-tier global ranking for individual performance levels",
          "body": "Planet Rugby has identified a Scotland centre as a premier force in the current international game. While the midfield rankings continue to be led by New Zealand and South Africa, the report highlights the Scottish 'powerhouse' as a leading challenger among the world’s best. This recognition comes as the national side maintains a positive tournament trajectory, with the squad currently sitting 5th in the log following a solid victory over Fiji in the most recent round of the Nations Championship."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Obituary",
          "heading": "Wales rugby legend Sir Billy Boston passes away aged 92",
          "body": "The Welsh rugby community is mourning the loss of Sir Billy Boston, who has died at the age of 92. The Cardiff-born icon, who achieved legendary status for his 15-year career at Wigan and international success with Great Britain, passed away just weeks after the death of his wife, Lady Joan. Knighted by King Charles last year, Boston was celebrated for his immense contribution to the sport and his role as a trailblazer who overcame prejudice to reach the top of the game."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Felipe Contepomi retains starting XV for Argentina test against the Wallabies",
          "body": "Felipe Contepomi has kept faith with his side, naming an unchanged starting lineup for the clash against Australia. After a narrow 17-10 defeat to the Springboks, the head coach has prioritised consistency, though he has adjusted the bench to a 5:3 split. Captain Pablo Matera will lead the team again, as several senior players, including Julián Montoya, remain unavailable due to club commitments. Rodrigo Martinez and Nicolas Roger are the fresh additions to the matchday squad for the home fixture."
        }
      ],
      "match": {
        "venue": "Estadio 23 de Agosto, San Salvador de Jujuy",
        "referee": "Ben O'Keeffe"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Allan Alaalatoa captains Australia as Les Kiss rotates forward pack",
          "body": "Coach Les Kiss has reshaped his forward pack for the upcoming Test in Argentina, installing Allan Alaalatoa as captain in the absence of Harry Wilson, who has been rested. Kiss described the personnel changes as a \"worthwhile exploring\" exercise to assess squad depth ahead of next year’s World Cup. While the forward unit sees significant turnover, including a start for Isaac Kailea, the backline remains settled, with Joseph-Aukuso Suaalii named on the bench as cover for the midfield."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "League One",
          "heading": "Japan Rugby League One settles legal dispute over player eligibility rules",
          "body": "Japan Rugby League One has reached a settlement regarding controversial registration categories, effectively rolling back proposed restrictions on foreign-born players. Following a legal challenge at the Tokyo District Court by 25 players, including Timothy Lafaele and Lomano Lemeki, the league confirmed that those holding Japanese citizenship since May 2025 will maintain parity with native-born players. The league acknowledged that previous communication regarding these system changes was insufficient and committed to reflecting this feedback in all future management."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Selection twist",
          "heading": "New Zealand prepares for Springboks shift as Sacha replaces injured Handré",
          "body": "The All Blacks head into today’s Test anticipating a tactical shift after South Africa confirmed Sacha Feinberg-Mngomezulu will replace the injured Handré Pollard at fly-half. While Pollard was expected to anchor a narrow, set-piece-focused gameplan, the introduction of Feinberg-Mngomezulu brings a more expansive skill set to the contest. Dave Rennie has prioritised improvements in the contact area and scrum discipline following a week of communication with World Rugby, noting that the team must lift their level to counter an inevitable home response."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "467": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Selection change",
          "heading": "Sacha Feinberg-Mngomezulu replaces Handré Pollard for second All Blacks Test",
          "body": "Rassie Erasmus has been forced into a late change for the Cape Town showdown after Handré Pollard was ruled out with a training-ground injury. The shift to Sacha Feinberg-Mngomezulu at fly-half introduces a more dynamic, albeit less conventional, tactical option than the initial selection. Erasmus had previously emphasised the need for better game management, noting, “we made a lot of stupid calls. Three points is two less than five. Handré is a guy that has always done it for us”."
        }
      ],
