  "digests": {
    "28": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Fijian back-rower Saimoni Vunilagi dies of suspected heatstroke in Japan",
          "body": "Fijian back-rower Saimoni Vunilagi has died at the age of 26 following a training session in Japan. His club, Kyuden Voltex, confirmed the forward passed away on Friday after showing symptoms of severe heatstroke during practice earlier in the week in Fukuoka, where temperatures reached 35C. The giant back-rower, who previously represented Tokyo Sungoliath in Japan Rugby League One, had only recently joined the second-division side, who expressed deep devastation."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "386": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Contract impasse",
          "heading": "Henry Pollock and Northampton Saints remain in contract negotiation stand-off stalemate",
          "body": "Negotiations between Henry Pollock and Northampton Saints remain unresolved following reports earlier this week that the England flanker’s camp is holding out for a £1 million annual salary. Despite speculation surrounding his future at the club, there have been no confirmed developments since the initial reporting of the seven-figure demand. The standoff continues to draw significant attention as stakeholders debate whether the financial package requested is sustainable for a Premiership side, leaving the young international’s immediate club future uncertain."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "387": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Transfer news",
          "heading": "Thomas Ramos confirms departure from Toulouse to join Racing 92 squad",
          "body": "Thomas Ramos is set to depart Toulouse for Racing 92, bringing an end to his long tenure at the club. Following the initial speculation surrounding his future, recent reports have confirmed the fullback’s move to the Parisian side. Ramos has previously described the decision to leave as particularly difficult to make. This high-profile switch marks a significant change for the French international as he prepares to transition into a new chapter of his professional career ahead of the 2027-28 season."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      },
      "rung": "storyline"
    },
    "388": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "U18 International Series",
          "heading": "Ireland Under-18s suffer narrow defeat against South Africa in thriller",
          "body": "Ireland’s Under-18 side fell to a 32-31 defeat against South Africa U18 A in the opening match of their International Series on Friday. Despite a spirited performance featuring a brace of tries from hooker Herbie Doyle and further scores from Micheal Smyth and Matthew McCarthy, the visitors were unable to hold a late lead. A penalty goal from replacement flyhalf Travis Pheiffer proved decisive, securing the win for the hosts at Hoërskool Durbanville."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Transfer news",
          "heading": "Ion Neculai joins Northampton Saints after leaving Italian side Zebre",
          "body": "Italian international prop Ion Neculai has signed for Northampton Saints following five seasons at Zebre Parma. The 25-year-old, who has earned four senior caps for his country, most recently featured off the bench against Australia in the Nations Championship. Saints director of rugby Phil Dowson described the tight-head as a very physical prop who enjoys the tough side of the game. Neculai has already linked up with his new squad for pre-season training ahead of the upcoming campaign."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Coaching upheaval",
          "heading": "Sione Fukofuka resigns as Scotland Women head coach due to stress",
          "body": "Sione Fukofuka has stepped down as Scotland Women head coach, citing the personal strain of living away from his family in Australia. Forwards coach Dave Butcher will lead the team on an interim basis for the upcoming WXV Global Series. The news follows a broader reshuffle within the coaching set-up, with senior assistant Ioan Cunningham also departing the organisation. Scottish Rugby confirmed that Chris Laidlaw and Tom Luke have been appointed as assistant coaches to support Butcher during this transition period."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Rising talent",
          "heading": "Tom Howe prioritises Cardiff debut over premature international Wales selection hype",
          "body": "Cardiff academy hooker Tom Howe is focusing on his domestic breakthrough despite growing external speculation regarding his international prospects. Following a strong showing at the Junior World Championship, where he impressed with 28 carries and 54 tackles, Steve Tandy has reportedly earmarked the 18-year-old as a long-term prospect. However, Howe remains grounded, looking to challenge established internationals for a starting berth in the coming campaign rather than chasing early Test honours in a position where Wales currently possess significant depth."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Pablo Matera captains much-changed Argentina against touring South Africa side",
          "body": "Pablo Matera will lead a vastly altered side at Vélez as Argentina navigate significant unavailability. With Julián Montoya back at his club and fly-half Tomás Albornoz serving a four-match suspension following his confrontation with officials, head coach Felipe Contepomi has made 13 changes to the starting XV. The match-day 23 features four uncapped players as Los Pumas attempt to reset after a challenging run of results, including last month’s narrow defeat to England in Santiago del Estero."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Winning start",
          "heading": "Les Kiss guides Australia to narrow victory over Eddie Jones’ Japan",
          "body": "The Les Kiss era began with a hard-fought 35-32 victory against Japan in Osaka. Australia secured the win through tries from Harry Potter, Tom Wright, Max Jorgensen, Fraser McReight and Taniela Tupou. The match was defined by a frantic pace and a major disciplinary setback, as lock Miles Amatosero was issued a 20-minute red card for a high tackle. Reflecting on the challenge of his first match, Kiss noted, “Smooth waters at the moment. They can get rough at any time, and I’m ready for the ride.”"
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Kyuden Voltex confirm Saimoni Vunilagi passes away from suspected heatstroke",
          "body": "The Japanese rugby community is mourning the death of Saimoni Vunilagi, who has died aged 26 following a training session with his club, Kyuden Voltex. The second-division side announced that Vunilagi suffered symptoms consistent with severe heatstroke after practice on Monday. Despite being hospitalised, he passed away on Friday. The back rower, who previously played for Tokyo Sungoliath, was remembered by his club for his generous spirit and powerful style of play during his short tenure in Fukuoka."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "465": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Media backlash",
          "heading": "New Zealand media criticise All Blacks for flawed performance against Stormers",
          "body": "The All Blacks have faced heavy criticism following their victory over the Stormers in Cape Town. While Dave Rennie’s side secured the result, commentators were quick to highlight a string of technical errors, including a struggling scrum, conceded penalties, and difficulties with the high ball. “The All Blacks pulled off the improbable feat in Cape Town of managing to secure a victory in which they filled the bingo card of all the things that teams can’t afford to get wrong,” wrote Gregor Paul."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-09",
      "edition": "Sunday 9 August",
      "sections": [
        {
          "kicker": "Greatest Rivalry",
          "heading": "Springboks and All Blacks kick off the Greatest Rivalry tour series",
          "body": "The highly anticipated Rugby’s Greatest Rivalry series has begun with the opening provincial fixture in Cape Town. While the four-Test series between the Springboks and the All Blacks does not commence until 22 August, the tour—which marketing departments have heavily promoted—is already generating significant interest. South African union president Mark Alexander believes the series could eclipse the stature of British & Irish Lions tours, despite ongoing legal discussions regarding the commercial branding of the event."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    }
  }
