    "463": {
      "date": "2026-11-22",
      "edition": "Sunday 22 November",
      "sections": [
        {
          "kicker": "Log jeopardy",
          "heading": "Japan's 67-5 Murrayfield defeat leaves southern hemisphere fifth place exposed to Fiji",
          "body": "Saturday's 67-5 defeat to Scotland — 11 tries conceded, after a 78-15 hammering by England the week before — may cost Eddie Jones' side more than pride. OnRugby reckoned it could knock Japan out of fifth place among the southern hemisphere sides should Fiji beat Italy with a bonus point and a decent margin. Rugby Asia 247's preview had already tipped the Brave Blossoms to finish bottom or second-bottom of their pool, potentially setting up a finals-weekend rematch with Wales or a meeting with Italy."
        },
        {
          "kicker": "Around the world",
          "heading": "France beat Argentina 45-17 to reach Springboks final",
          "body": "Ireland beat South Africa 20-17 to finish third in north. Wallabies beat Wales 29-26 to finish third in south. Fiji's second-string Latui lose 62-12 to Ireland XV."
        }
      ],
