    "28": {
      "date": "2026-11-09",
      "edition": "Monday 9 November",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Vilimoni Botitu starts late as Isikeli Rabitu is reportedly sick",
          "body": "Fiji changed their starting XV late, with Vilimoni Botitu coming in after Isikeli Rabitu was reportedly sick. Botitu spilled the ball inside his own 22, and France's Aaron Grandidier-Nkanang secured the attacking bonus point before half-time, the hosts leading 26-3 at the break. Coach Jake White's side, which started with 10 France-based players, got tries from Vinaya Habosi and Selestino Ravutaumada, but the 54-17 defeat was a fourth straight loss in the inaugural Nations Championship."
        },
        {
          "kicker": "Around the world",
          "heading": "England beat Australia 45-22, Henry Pollock scoring twice",
          "body": "South Africa's Pieter-Steph du Toit quits Japan to return home. France recall Marchand, Fickou and Thomas for Springboks test."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "386": {
      "date": "2026-11-09",
      "edition": "Monday 9 November",
      "sections": [
        {
          "kicker": "Result",
          "heading": "Henry Pollock scores twice as England beat Australia 45-22 at Twickenham",
          "body": "Henry Pollock's two tries, in the 55th and 58th minutes, came three minutes apart and turned a 19-10 half-time lead into a rout. The win came amid reports of a rift between Steve Borthwick and his players, a report England's hooker Jamie George called shocking. Ollie Chessum also crossed, and Henry Slade was named player of the match."
        },
        {
          "kicker": "Around the world",
          "heading": "Fiji fall 54-17 to France in Nations Championship",
          "body": "South Africa's Pieter-Steph du Toit quits Japan to return home. France recall Marchand, Fickou and Thomas for Springboks test."
        }
      ]
    },
    "387": {
      "date": "2026-11-09",
      "edition": "Monday 9 November",
      "sections": [
        {
          "kicker": "Squad call-up",
          "heading": "Galthié recalls Julien Marchand, Gaël Fickou and Teddy Thomas for Springboks test",
          "body": "Romain Ntamack's shoulder injury has forced a fly-half reshuffle, and Galthié has turned to experience for the Paris test. Hooker Julien Marchand, sidelined since a thigh injury in early October, returned for Toulouse on Saturday and could go straight into the starting XV. Centre Gaël Fickou, 32, and winger Teddy Thomas, 33, are back in the group, along with flyhalf Louis Carbonel, who has not featured in a France matchday 23 since 2022."
        },
        {
          "kicker": "Around the world",
          "heading": "England beat Australia 45-22, Henry Pollock scoring twice",
          "body": "Fiji fall 54-17 to France in Nations Championship. South Africa's Pieter-Steph du Toit quits Japan to return home."
        }
      ],
