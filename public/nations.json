      }
    },
    "389": {
      "date": "2026-11-08",
      "edition": "Sunday 8 November",
      "sections": [
        {
          "kicker": "Heavy defeat",
          "heading": "Quesada's injury-hit Azzurri lose 66-7 to Springboks in Turin on Saturday",
          "body": "Italy head coach Gonzalo Quesada named Giacomo Nicotera captain for the Turin match, with Michele Lamaro out, and the side were also missing centres Tommaso Menoncello and Nacho Brex. The Springboks won 66-7, and Sacha Feinberg-Mngomezulu scored an early try in the eighth minute. Brex expects surgery on a detached bicep next week, and Menoncello faces 12 weeks out after a shoulder injury. Italy remain without a win after four matches, with Argentina next up in Round 5."
        },
        {
          "kicker": "Around the world",
          "heading": "England recall George Furbank at full-back; Fin Smith passes fitness test",
          "body": "Wallabies' Fraser McReight earns 50th cap against England."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "390": {
      "date": "2026-11-08",
      "edition": "Sunday 8 November",
      "sections": [
        {
          "kicker": "Referee appointment",
          "heading": "Andrew Brace referees Scotland v All Blacks after recent Furlong grab incident",
          "body": "Andrew Brace, a 38-year-old IRFU official who has worked two Rugby World Cups, takes charge of Saturday's Test at Murrayfield. He was refereeing Leinster v Munster when Gavin Coombes reported that his groin had been grabbed in a ruck, and Tadhg Furlong was cited for allegedly grabbing him. Brace referred the incident to TMO Colin Stanley, but the broadcast angles were inconclusive and no penalty or card followed. Furlong was later found not guilty by the citing commission."
        },
        {
          "kicker": "Around the world",
          "heading": "Springboks beat Italy 66-7",
          "body": "Italy's Tommaso Menoncello out 12 weeks with shoulder injury. England recall George Furbank at full-back; Fin Smith passes fitness test. Wallabies' Fraser McReight earns 50th cap against England."
        }
