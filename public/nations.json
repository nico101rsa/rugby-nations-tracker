  "digests": {
    "28": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Previous meeting",
          "heading": "Fiji prepare to face France next after three consecutive tournament defeats",
          "body": "Fiji confront a formidable challenge in their next fixture against France after suffering a 17-33 loss to Scotland in the third round. This result leaves them bottom of the table with three defeats from their opening three matches of the campaign. In their most recent meeting with France in November 2025, the Flying Fijians suffered a 34-21 away defeat."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "AUTUMN ULTIMATUM",
          "heading": "Fin Smith says England require hard look if autumn results prove ropey",
          "body": "The fly-half insists an under-par November must trigger fundamental questions about Steve Borthwick's side following a stuttering 2026. Smith, who has started the last five Tests, warned that England \"will need to have a pretty hard look at ourselves\" if they fail to find consistency against Australia and New Zealand. Despite a narrow 31-24 win over Argentina in the summer, only three victories from eight matches this year—including a first-ever loss to Italy—have left the squad searching for their identity."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Mental hurdle",
          "heading": "Ben Youngs asserts France must beat South Africa to break mental block",
          "body": "Former England scrum-half Ben Youngs believes Les Bleus face a defining mental test against the Springboks during the upcoming Nations Championship. Speaking on the For the Love of Rugby podcast, Youngs argued that Fabien Galthié's side must secure a victory in Paris to dismantle the \"psychological barrier\" created by recent defeats. South Africa edged France 29-28 in the 2023 World Cup quarter-final and triumphed 32-17 last year. Youngs insists a win is essential before the 2027 World Cup in Australia."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "388": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "TACTICAL DEBATE",
          "heading": "Jacques Nienaber claims club rugby is years ahead of international game",
          "body": "Leinster coach Jacques Nienaber argues that club-level innovation is currently years ahead of the international game. Speaking before Leinster's upcoming trip to South Africa, the former Springboks boss suggested that the high volume of club fixtures allows for bolder tactical experimentation than the high-stakes environment of Test rugby. Nienaber noted that while international losses are \"written in history,\" the club scene provides a superior laboratory for designing new systems and testing elite players with more frequency than the international calendar allows."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "GLOBAL EXPANSION",
          "heading": "World Rugby proposes moving a future Italy Six Nations fixture overseas",
          "body": "World Rugby officials are advocating for the United States to host flagship matches, including Six Nations fixtures, to accelerate North American growth. While the Irish Rugby Football Union recently dismissed reports of moving their home games, the proposal remains a live issue for nations like Italy. Relocating a match from Rome to a neutral American venue would provide a significant commercial boost, yet fans remain wary of losing home advantage as the Azzurri currently sit 11th in the Nations Championship log."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Ball trial",
          "heading": "Rachel Malcolm leads Scotland against Black Ferns during controversial ball trial",
          "body": "Captain Rachel Malcolm leads Scotland into Saturday’s WXV fixture against New Zealand as scrutiny intensifies over World Rugby’s ongoing trial of a smaller ball. Interim coach Dave Butcher hands scrum-half Ceitidh Ainsworth a first start, yet she must handle the ball that England’s Zoe Harrison recently labelled the \"worst decision ever.\" The trial aims to increase handling speed, though players have criticised the lack of consultation. Scotland enter the match seeking a response following last week's 64-26 defeat by Canada."
        }
      ],
      "match": {
        "venue": "Hive Stadium, Edinburgh"
      },
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "WXV STATEMENT",
          "heading": "Coach Sean Lynn hails 'new DNA' after Wales crush South Africa 50-19",
          "body": "Coach Sean Lynn praised his side’s clinical edge after Wales ended a nine-test losing streak with an eight-try demolition of South Africa on Friday night. The 50-19 victory at Cardiff Arms Park saw tighthead Sisilia Tuipulotu cross twice as the hosts raced to a 38-5 lead by half-time. Co-captain Alex Callender secured player-of-the-match honours on her return from injury, while debutant Freya Bell added 10 points from the tee. Lynn noted the performance set a \"new DNA\" for a squad entering the WXV Global Series with renewed confidence."
        }
      ],
      "match": {
        "venue": "Cardiff Arms Park, Cardiff"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Results update",
          "heading": "Argentina battle to home draw against Australia in latest international friendly",
          "body": "Argentina recorded a 28-28 draw against Australia at home in a September international friendly. In their last five games overall, Los Pumas have secured one victory, suffered three defeats, and registered one draw. They sit eighth in the Nations Championship table. Across three rounds, the team have won one match. They have also lost two fixtures. Argentina have scored 97 points in the competition. They have conceded 99 points, leaving them with a points difference of minus two following their recent 24-31 loss to England."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Coaching insight",
          "heading": "Les Kiss challenges Wallabies to bite back against world-leading Springboks",
          "body": "Australia coach Les Kiss has urged his side to embrace an unconventional approach as they prepare for the challenge of the world No 1 Springboks. Despite Australia currently sitting seventh on the log, Kiss remains confident in his squad's resilience, suggesting that the team will not shy away from the test. “It’s a massive opportunity to challenge a fantastic team that is second to none in the world,” said Kiss. He noted that the team’s upcoming performance represents their current development."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Eddie Jones names experienced Japan side for Pacific Nations Cup final",
          "body": "Japan aim to secure their first Pacific Nations Cup title since 2019, with head coach Eddie Jones selecting a squad boasting 312 caps. Faulua Makisi starts at No.8, pushing Jack Cornelsen to lock, while Tomoki Osada joins the wing. Jones highlighted that he is relying on the group’s “good experience and toughness” to overcome Fiji. “Our aim this weekend is to win the final and we’re 100 per cent concentrated on that,” Jones stated ahead of the tournament decider in Tokyo."
        }
      ],
      "match": {
        "venue": "Prince Chichibu Memorial Stadium, Tokyo"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "465": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Dave Rennie weighs up fly-half options after challenging Springboks Test series",
          "body": "Following a testing 3-1 series loss to South Africa, head coach Dave Rennie faces key decisions regarding his playmaker hierarchy. While Ruben Love handled the reins for the first three encounters, Richie Mo'unga received his opportunity in the final Test in Baltimore. Former All Black Murray Mexted suggests the tour has been vital for identifying which players can handle the highest level, noting that Rennie is now better positioned to determine who will feature in next year’s Rugby World Cup campaign."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-09-19",
      "edition": "Saturday 19 September",
      "sections": [
        {
          "kicker": "Tactical edge",
          "heading": "Shane Howarth labels Springboks' frightening high-ball dominance as a major advantage",
          "body": "Former All Blacks and Wales fullback Shane Howarth has hailed the Springboks' ability in the air as \"phenomenal,\" noting that their consistency in reclaiming contestable kicks was a defining factor in the recent series. Howarth admitted he was stunned by the aerial superiority displayed during the final Test in Baltimore. He noted that while the team can play with flair, their ability to revert to a highly effective, structured kicking game remains a frightening weapon for any opposition."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
}