    "389": {
      "date": "2026-11-03",
      "edition": "Tuesday 3 November",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Italy call up ex-Pumas flyhalf Domingo Miotti for Springboks Test",
          "body": "Montpellier flyhalf Domingo Miotti has been included in Quesada's 33-man squad for Saturday's Test against South Africa in Turin, the former Argentina No 10 qualifying through an Italian grandfather. His last Argentina Test came in 2022, and he gives Quesada a fourth flyhalf option alongside Paolo Garbisi, Tommaso Allan and Giacomo Da Re. Quesada said: \"Domingo is a great player and an excellent person.\" He was unavailable last week through injury but can now resume training as normal."
        },
        {
          "kicker": "Around the world",
          "heading": "England call up Spencer and Randall; Mitchell, McParland out",
          "body": "Scotland lose Jamie Ritchie and Elliot Millar Mills to injury. Wallabies name Kurtley Beale in touring party."
