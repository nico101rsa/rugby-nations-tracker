  "digests": {
    "28": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Fijian rugby forward Saimoni Vunilagi dies after training session in Japan",
          "body": "The Fijian rugby community is mourning the sudden death of back-row forward Saimoni Vunilagi, who has passed away in Japan at the age of 26. Vunilagi’s second-division club, Kyushu KV, confirmed he died on Friday morning in a Fukuoka hospital after developing severe symptoms consistent with heatstroke following a team practice. The 196cm, 117kg forward had played in Japan since beginning his professional career in 2023. His club expressed their devastation, extending condolences to the family."
        }
      ]
    },
    "386": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Contract Shake-up",
          "heading": "Steve Borthwick awards five new England contracts while axing Elliot Daly",
          "body": "England head coach Steve Borthwick has shaken up his squad, awarding five players their first enhanced Elite Player Squad contracts. Prop Asher Opoku-Fordjour, lock Alex Coles, flanker Guy Pepper, scrum-half Jack van Poortvliet, and centre Seb Atkinson have secured the £150,000 deals. Conversely, Elliot Daly and Ben Curry have been axed alongside Ollie Lawrence, Tom Roebuck, and France-bound Tom Willis. The hybrid deals give Borthwick final say over medical and conditioning matters as England build towards their autumn campaign."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Coaching exit",
          "heading": "Kicking coach Vlok Cilliers joins Bulls after shock France departure",
          "body": "Former France kicking coach Vlok Cilliers has joined the Bulls backroom staff following his sudden departure from Fabien Galthié's setup. The French Rugby Federation confirmed reports that Cilliers — who spent seven years sharpening the national side's tactical kicking and Thomas Ramos' goal-kicking — was relieved of his duties alongside defence specialist Shaun Edwards. Galthié reportedly instigated the shake-up to revitalise the squad ahead of the World Cup, prompting the 58-year-old Cilliers to return to Pretoria."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "388": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Obituary",
          "heading": "Former Ireland out-half Brian Smith has passed away aged 59",
          "body": "The Irish rugby community is mourning the death of former dual-international playmaker Brian Smith, who has passed away aged 59. Capped nine times for Ireland at out-half during his studies at Oxford University, Smith also won six Test caps for Australia. The IRFU stated they were 'saddened to hear of the passing of former out-half Brian Smith following a short illness', paying tribute to a player and coach who excelled across both hemispheres."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "FORM GUIDE",
          "heading": "Italy target South Africa turnaround after losing last year's home test",
          "body": "Italy lost 32-14 to South Africa in their last meeting at home during an international friendly in November 2025. Gli Azzurri enter the next round of fixtures sitting 11th out of 12 teams in the Nations Championship table. The side has suffered three defeats from their opening three games of the tournament. Their most recent outing resulted in a heavy 57-10 loss against Australia in the third round."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Legal battle",
          "heading": "Landmark concussion lawsuit at risk of dismissal after claimants change lawyers",
          "body": "Rugby's landmark concussion group litigation faces potential dismissal after a significant legal shake-up, with claimants seeking new representation. While rugby's governing bodies face the high-stakes proceedings, the transition has placed the long-running lawsuit in jeopardy. The legal action, which addresses brain injuries suffered by former players during their careers, enters a critical phase as the court determines whether the case can proceed under new counsel."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Governance crisis",
          "heading": "Welsh Rugby Union governance dispute remains unresolved as regional reform stalls",
          "body": "There is no new coverage in today's press regarding the WRU governance dispute. The thread remains open following the Welsh Rugby Union's October 2025 plan to cut a professional region, which players previously warned would drive elite talent away. Critics continue to demand the governing body publish the underlying evidence behind the decision, while clubs have accused the union of 'scaremongering' during this prolonged standoff."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Fly-half ban",
          "heading": "Tomás Albornoz remains suspended for upcoming Argentina matches against Australia",
          "body": "Tomás Albornoz’s four-match suspension, handed down last week following his altercation with referee Angus Gardner after the defeat to England, remains ongoing. The ban rules the fly-half out of Argentina’s matches against South Africa and the upcoming double-header against Australia, as well as a fixture for his club Toulon. The disciplinary committee noted Albornoz had to be restrained by teammates after twice approaching Gardner, though he denied his behaviour was abusive or offensive."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "461": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Test triumph",
          "heading": "Taniela Tupou scores twice as Wallabies crush Japan for third straight win",
          "body": "The Wallabies secured their first three-match winning streak since 2024 with a clinical 56-17 victory over Japan in Townsville. After leading 21-17 at the interval, Les Kiss’s side scored 35 unanswered points in the second half, crossing for eight tries in total. Prop Taniela Tupou bagged a brace, while fly-half Carter Gordon impressed on his return from a calf injury. Kiss noted the squad found \"balance in the selection\" after making eight changes to the side that narrowly defeated the Brave Blossoms in Osaka last week."
        }
      ],
      "match": {
        "venue": "Queensland Country Bank Stadium, Townsville"
      },
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "463": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Test defeat",
          "heading": "Eddie Jones' Japan collapses in Townsville as Australia secure dominant 56-17 win",
          "body": "Japan suffered a heavy 56-17 defeat to Australia on Saturday after a competitive opening period in Townsville crumbled into a second-half rout. Despite leading 17-14 following tries from Harry Hockings, Naoto Saito, and Dylan Riley, the Brave Blossoms conceded 42 unanswered points. \"The ball carrier is king, and then everyone else has got to follow after that,\" Jones noted regarding his use of geese videos, yet his side finished with 14 men after Harada's yellow card."
        }
      ],
      "match": {
        "venue": "Townsville, Australia"
      },
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "465": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Caleb Clarke ruled out of South Africa tour following shoulder surgery requirement",
          "body": "All Blacks wing Caleb Clarke is returning home from South Africa after scans confirmed a ruptured shoulder tendon sustained during Tuesday’s victory over the Sharks. The 27-year-old requires surgery, making him the second backline casualty of the tour following Billy Proctor’s earlier exit. While Richie Mo’unga has joined the squad as cover, Dave Rennie is yet to summon a replacement for Clarke, noting that \"the side we are playing against the Bulls will be quite different to the first Test team.\""
        }
      ],
      "match": {
        "venue": "Loftus Versfeld, Pretoria"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-15",
      "edition": "Saturday 15 August",
      "sections": [
        {
          "kicker": "TACTICAL EDGE",
          "heading": "Josh Kronfeld labels Tony Brown the biggest danger to the All Blacks",
          "body": "All Blacks legend Josh Kronfeld believes attack coach Tony Brown is the most significant threat to New Zealand in the upcoming four-Test series. Kronfeld argued that Brown’s influence prevents the Springboks from retreating into a conservative shell under pressure, providing the \"danger factor\" required to maintain an expansive game. While the world champions remain top of the log, Kronfeld warned that Rassie Erasmus’ side now possesses \"way more dynamics\" than previous eras, making it harder for opponents to exploit their traditional reliance on set-piece and kicking."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
