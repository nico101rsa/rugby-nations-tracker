  "digests": {
    "28": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "Pathway boost",
          "heading": "Andrew Durutalo named as the new Fiji men's high-performance head",
          "body": "Former USA international Andrew Durutalo has been appointed as Fiji Rugby's new Head of Men's High Performance, tasked with strengthening the development pathways underpinning the national teams. Durutalo, who previously captained Fiji at age-grade levels before representing the United States, will oversee the transition of young talent into the senior set-up. The appointment comes as the national side searches for a new head coach ahead of their November test against France."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "386": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "Contract extension",
          "heading": "England winger Tommy Freeman commits future to Northampton with new contract",
          "body": "Northampton Saints have secured the future of England winger Tommy Freeman, who signed a new contract to remain at Franklin's Gardens. The 25-year-old utility back, who has won 30 caps, follows international teammates Fin Smith, Fraser Dingwall and Alex Mitchell in recommitting to the Premiership champions. Freeman also featured in three Lions Tests against Australia last year. Saints director of rugby Phil Dowson welcomed the deal, calling the retention \"a huge boost\" for the club."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "Tournament update",
          "heading": "France sit third in tournament standings after defeating Japan in Round 3",
          "body": "France occupy third place in the tournament standings after their first three fixtures. Les Bleus have recorded two victories and one defeat in this tournament window. The team have scored 116 points across these three matches. They have conceded 75 points in the same period. Following a 42-15 victory against Japan in Round 3, the side next face Fiji in Round 4. During an international friendly in November 2025, France secured a 34-21 home victory over Fiji."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "Squad recall",
          "heading": "Andy Farrell issued blunt warning to Jimmy O'Brien before Ireland return",
          "body": "Jimmy O’Brien has revealed the blunt motivation behind his unexpected Ireland recall during the July tour. The Leinster winger, who had spent years in the international wilderness, disclosed that head coach Andy Farrell delivered a characteristically direct ultimatum on the Sydney training ground, telling him: “You’re in, don’t f*** it up.” O’Brien took the advice to heart, starting all three Nations Championship fixtures against Australia, Japan and New Zealand. His redemption has catapulted him back up the pecking order."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "Ball trial",
          "heading": "Italy's silence continues as World Rugby debates controversial women's ball trial",
          "body": "There is no coverage of Italy’s response to the controversial smaller ball trial in today's press. While other competitors like England's Red Roses have begun debating the impact of the experimental ball during WXV preparations, the Azzurre have remained silent. The trial remains an open storyline for World Rugby, but we cannot report on Italy’s specific feedback or how the change is affecting their training, as no updates have emerged from their camp today."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "Ball trial",
          "heading": "Scotland camp holds its counsel as WXV smaller ball trial continues",
          "body": "The controversial World Rugby trial of a smaller ball in women's internationals remains unresolved as WXV matches continue. While some players and coaches across the tournament have voiced a mixed bag of emotions over the adjustment, today's coverage is silent on the Scotland camp's specific stance, and fly-half Helen Nelson has not commented on whether it affects her kicking. The trial will stay open until World Rugby decides whether to adopt the smaller ball permanently or scrap it."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "Award recognition",
          "heading": "Prop Rhys Carre wins Welsh Rugby Writers' Association player of the year",
          "body": "Saracens loose-head Rhys Carre has been named the Welsh Rugby Writers' Association men's player of the season. The 28-year-old is the first prop to claim the honour since Gethin Jenkins in 2009. Having been dropped before the 2023 World Cup, Carre was recalled by boss Steve Tandy in 2025 and played 11 of Wales' 12 Tests last season. Carre said he was \"honoured that the Welsh rugby media think I deserve it,\" while Cardiff centre Steffan Emanuel was named men's young player of the year."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "Historic peak",
          "heading": "Argentina squad retains all-time peak of third in World Rugby rankings",
          "body": "Argentina reached their highest ever position in the World Rugby rankings during the 2007-08 period. During that window, the national side climbed to No. 3 in the global standings. This remains the peak achievement for the team in the professional era. The side currently sits eighth in the Nations Championship log following three rounds of play. Following a 24-31 loss to England, the team has one win and two losses with 97 points for and 99 points against."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Les Kiss hands Jordan Petaia international recall for Springboks Perth Test",
          "body": "Jordan Petaia returns to the Wallabies squad for the first time since the 2023 World Cup following a stint in the NFL. Head coach Les Kiss has also handed a surprise call-up to uncapped Western Force playmaker Harry McLaughlin-Phillips, who replaces the injured Carter Gordon after he suffered a leg fracture against Argentina. The squad, which includes a fit-again Zane Nonggorr, assembles in Perth on Friday. Kiss acknowledged the challenge of facing the back-to-back world champions, stating: \"We still have a lot to work on.\""
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "PNC final",
          "heading": "Mamoru Harada targets Pacific Nations Cup title ahead of Fiji final",
          "body": "Japan are preparing for Saturday's Pacific Nations Cup final against Fiji following their 63-14 semi-final demolition of the United States. Hooker Mamoru Harada has confirmed the squad's target is to beat the Flying Fijians and win the championship, but Eddie Jones remains wary of lapses in discipline. Despite the nine-try victory in Osaka, Jones warned his side \"lost a bit of concentration\" during periods of the match. The Brave Blossoms now face a Fiji side seeking a fourth consecutive title after their semi-final win over Canada."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      },
      "rung": "storyline"
    },
    "465": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "John Plumtree claims New Zealand may need bigger players to match South Africa",
          "body": "Former assistant coach John Plumtree has warned that New Zealand may need to sacrifice mobility for size after being physically outmatched by South Africa. Despite an undefeated start to the Nations Championship, the fallout from the recent 3-1 series loss to the Springboks continues, with Plumtree telling the TMO podcast that the All Blacks looked \"passive\" in their own 22. He suggested that if the current personnel cannot stop gainline momentum or compete at the set-piece, Dave Rennie must consider selecting larger forwards."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-17",
      "edition": "Thursday 17 September",
      "sections": [
        {
          "kicker": "Selection strategy",
          "heading": "Victor Matfield expects 'braver' Springboks as Rassie Erasmus prioritises experimentation",
          "body": "Following the 3-1 series victory over the All Blacks, former lock Victor Matfield predicts a shift in approach as the team pivots toward upcoming challenges. Matfield notes that with the series pressure now lifted, the Springboks will likely become \"a bit more brave with ball in hand\" and experiment with more expansive attacking patterns. He also suggests that Rassie Erasmus will now look to rotate the squad, providing more opportunities for younger players to stake their claims for the 2027 World Cup."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
}