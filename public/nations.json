    "386": {
      "date": "2026-11-03",
      "edition": "Tuesday 3 November",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Borthwick calls up Spencer and Randall as injuries sideline Mitchell, McParland",
          "body": "Steve Borthwick has added Ben Spencer (19 caps) and Harry Randall (14) to England's Nations Championship squad after injuries ruled Northampton's Alex Mitchell and uncapped Archie McParland out of the Australia match. Mitchell pulled up with a hamstring issue on top of three earlier hamstring injuries this year and faces a scan, while McParland, 21, picked up a calf injury at last week's three-day camp. Fin Smith's calf problem also opens up fly-half, with Marcus Smith and George Ford competing to deputise."
        },
        {
          "kicker": "Around the world",
          "heading": "Scotland lose Jamie Ritchie and Elliot Millar Mills to injury",
          "body": "Italy call up ex-Pumas flyhalf Domingo Miotti for Springboks test. Wallabies name Kurtley Beale in touring party."
        }
      ],
      "match": {
        "venue": "Allianz Stadium, Twickenham"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-11-03",
      "edition": "Tuesday 3 November",
      "sections": [
        {
          "kicker": "Squad change",
          "heading": "Galthié adds five to his 42-man France squad, including uncapped Léon Darricarrère",
          "body": "Five new names have come into Fabien Galthié's 42-man group. Clermont prop Régis Montagne replaces Bayonne's Tevita Tatafu, and Toulouse scrumhalf Paul Graou comes in for La Rochelle's Nolann Le Garrec, who has suffered another hamstring injury. Florian Verhaeghe, Rodrigue Neti and uncapped Clermont centre Léon Darricarrère complete the additions. France host the Springboks at the Stade de France and Argentina there on 21 November."
        },
        {
          "kicker": "Around the world",
          "heading": "England call up Spencer and Randall; Mitchell, McParland out",
