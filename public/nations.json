    "461": {
      "date": "2026-10-01",
      "edition": "Thursday 1 October",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Les Kiss refreshes Wallabies squad for upcoming Bledisloe Cup series",
          "body": "Head coach Les Kiss has named a 34-man squad for the October Bledisloe Cup matches, opting to release overseas-based forwards Tom Hooper and Taniela Tupou. The pair return to their respective clubs as the fixtures fall outside World Rugby Regulation Nine. In their place, uncapped forward Toby Macpherson earns a maiden call-up, while Massimo de Lutiis is recalled. “It’s pleasing to keep the core of our squad together,” said Kiss, noting the group remains motivated to face the challenge in New Zealand."
        },
        {
          "kicker": "Around the world",
          "heading": "Scotland wing Darcy Graham ruled out for remainder of year",
          "body": ""
