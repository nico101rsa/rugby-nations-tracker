  "digests": {
    "28": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "Tournament form",
          "heading": "Fiji target redemption against France after suffering three consecutive tournament defeats",
          "body": "Fiji sit at the bottom of the Nations Championship log after three matches, having failed to secure a win in their opening three fixtures. The Flying Fijians suffered a 17-33 defeat against Scotland in their last outing, bringing their total points conceded to 145 over those three games. Looking ahead to their next test against France, Fiji will hope to reverse their fortunes. In the last meeting between the sides, Fiji lost 34-21 away to France."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "Borthwick backing",
          "heading": "Ben Youngs accuses Conor O'Shea of having 'blinkers on' over Borthwick",
          "body": "Former England scrum-half Ben Youngs has criticised the RFU’s decision to extend head coach Steve Borthwick’s contract until after the 2028 Six Nations. Despite a dismal 2026 campaign that yielded just one victory, performance director Conor O’Shea defended the extension as crucial for avoiding World Cup uncertainty. Speaking on the For The Love Of Rugby podcast, Youngs claimed O’Shea has 'some blinkers on' by offering the deal now, warning that union bosses must be held accountable if the gamble fails."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "Squad statistics",
          "heading": "France accumulate more than 400 points across their past 11 fixtures",
          "body": "Les Bleus have shown formidable attacking power, scoring 426 points across their last 11 games. In that same 11-match window, France conceded 291 points. This represents an average of 38.7 points scored per game. Defensively, they allowed an average of 26.5 points per match. The biggest win of this sequence was a 54-12 victory away to Wales in the Six Nations in February 2026."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "O'Brien ambitions",
          "heading": "Tommy O'Brien targets 2027 World Cup after missing Ireland tour",
          "body": "Leinster centre Tommy O'Brien is targeting the 2027 World Cup as his career pinnacle after a cruel groin injury ruled him out of Ireland's recent Nations Championship tour. The nine-cap back sustained the injury during the United Rugby Championship final, forcing coach Andy Farrell into a late squad alteration before departing for the southern hemisphere. Refusing to be discouraged, the 28-year-old remains optimistic about his international future, stating, 'I should hopefully be in my peak rather than being 33 for the next one.'"
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "Recent form",
          "heading": "Italy endure fourth consecutive defeat after heavy Nations Championship loss",
          "body": "In their last five games, Italy have recorded just one victory. The team also suffered four defeats in that five-match window, which has contributed to their current run of four straight losses. Their most recent fixture ended in a 57-10 away defeat against Australia in the Nations Championship group stage in July 2026. This leaves them sitting 11th out of 12 teams in the standings."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "WXV selection",
          "heading": "Rhea Clarke earns first Scotland start for WXV opener against Canada",
          "body": "Scrum-half Rhea Clarke will make her first international start as Scotland begin their WXV Series campaign against Canada in Edinburgh. Interim head coach Dave Butcher has also recalled openside flanker Evie Gallagher for her first appearance since last year's World Cup. Uncapped backs Ceitidh Ainsworth and Katie Buchanan are named on the bench, while second-row Adelle Ferrie joins them after replacing the injured Alex Stewart in the squad. Canada have won seven of their eight meetings with Scotland."
        }
      ],
      "match": {
        "venue": "The Hive, Edinburgh"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "Ben Carter",
          "heading": "Ben Carter cleared for Dragons return following ankle injury with Wales",
          "body": "Dragons co-captain Ben Carter is fit for the United Rugby Championship season after recovering from an ankle injury. The 25-year-old lock was on crutches and missed the Nations Championship loss to South Africa after a training blow. Carter had started Wales' six previous games, and his recovery boosts country and region before the autumn campaign, starting against Japan at Cardiff's Principality Stadium. Defence coach Dale MacLeod confirmed he is \"probably in the best nick that I have seen him.\""
        }
      ],
      "match": {
        "venue": "Principality Stadium, Cardiff"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "Mendoza draw",
          "heading": "Late penalty try denies Los Pumas as Wallabies salvage Mendoza draw",
          "body": "Los Pumas fought out a gripping 28-28 draw against Australia in Mendoza, but a late penalty try denied the hosts a second Test victory. Trailing 14-0 early on, Argentina roared back with tries from Pablo Matera and Ruiz to lead 28-21. However, a 70th-minute penalty try pulled the Wallabies level. Despite playing the final 10 minutes with 13 men following Cinti's yellow card, the home side held on to secure a share of the spoils, though Australia clinched the series."
        }
      ],
      "match": {
        "venue": "Mendoza"
      },
      "source": {
        "name": "Planet Rugby"
      },
      "rung": "storyline"
    },
    "461": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "James Slipper",
          "heading": "James Slipper puts playing career on pause to coach Brumbies scrum",
          "body": "James Slipper has temporarily paused his playing career to become the Brumbies' new scrum coach for the upcoming Super Rugby AUS campaign. The veteran Wallabies prop, who has 154 Test caps, recently signed a one-year contract extension but will join Stephen Larkham's staff after John Ulugia moved to the national set-up. Slipper is embracing the transition, saying: \"I’ve been around a lot of scrums over the years, so hopefully I can pass on a bit of what I’ve learnt and help the boys get better.\""
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "Semifinal showdown",
          "heading": "Eddie Jones targets home final as Japan face USA in Osaka",
          "body": "Eddie Jones enters Saturday’s Pacific Nations Cup semi-final against the USA demanding home glory following two years of finishing behind Fiji. Japan host the Eagles at Hanazono Rugby Stadium boasting a dominant recent record; the Americans have not won on Japanese soil since 2005. While the visitors arrive in Osaka undefeated this season, the Brave Blossoms remain firm favourites. Jones is desperate to secure the team's first title since 2019 and must overcome a physical American side to reach the final."
        }
      ],
      "match": {
        "venue": "Hanazono Rugby Stadium, Osaka"
      },
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "Selection shuffle",
          "heading": "Dave Rennie must name new captain as injury sidelines skipper Ardie Savea",
          "body": "Coach Dave Rennie will rotate his squad for Saturday’s Test against South Africa in Baltimore following injuries to captain Ardie Savea, Luke Jacobson and Quinn Tupaea. Rennie confirmed that significant changes were always planned for the fourth encounter to introduce \"plenty of energy\" against the world champions after a 26-hour journey from Johannesburg. Ethan Blackadder and Richie Mo’unga are expected to feature, though the match-day 23 has yet to be named. Rennie admitted that training immediately after the long journey would have been \"beating a dead horse\"."
        }
      ],
      "match": {
        "venue": "M&T Bank Stadium, Baltimore"
      },
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "Selection reward",
          "heading": "Rassie Erasmus hands Morné van den Berg first start against All Blacks",
          "body": "Rassie Erasmus has rewarded Morné van den Berg with a starting role for Saturday's fourth and final Test against the All Blacks in Baltimore. The Lions scrum-half replaces Cobus Reinach in one of only two changes to the XV that secured a 2-1 series lead in Soweto. With Cheslin Kolbe sidelined by a broken jaw, Damian Willemse returns at full-back. Erasmus praised Van den Berg's \"fantastic impact\" off the bench last weekend, choosing to prioritise continuity as South Africa chase a rare series victory."
        }
      ],
      "match": {
        "venue": "Baltimore"
      },
      "source": {
        "name": "Planet Rugby"
      }
