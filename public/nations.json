  "digests": {
    "28": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Defensive struggles",
          "heading": "Fiji ship 326 points across their last 11 international matches",
          "body": "Fiji have conceded 326 points across their last 11 matches, shipping an average of 29.6 points per game. Over that same 11-match span, the team scored 315 points to average 28.6 points per fixture. This run of form did include the biggest win of the window, a 63-10 home victory against Canada in September 2025 during the Pacific Nations Cup knockout stage."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Itoje's Sabbatical",
          "heading": "Maro Itoje discusses mental recovery after missing England’s summer Test series",
          "body": "England captain Maro Itoje has opened up about his summer absence, admitting he was initially taken aback when Steve Borthwick suggested a break from international duty. After a heavy year personally and professionally, the 31-year-old opted out of the July matches against South Africa, Fiji, and Argentina to prioritise recovery. While he found it \"very weird\" to watch from afar, Itoje feels the period away was a \"wise and prudent decision\" to ensure he returns better for the season ahead."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Transfer Rumour",
          "heading": "Thomas Ramos linked with sensational move from Toulouse to Racing 92",
          "body": "France international Thomas Ramos is reportedly set to depart Toulouse following the 2027 Rugby World Cup. According to reports in L’Equipe, the full-back is being targeted by Top 14 rivals Racing 92 in a move that could see the 29-year-old transition into a fly-half role. Ramos has enjoyed a decorated tenure in the Pink City, securing four league titles and two Investec Champions Cups over the past five years while establishing himself as an ever-present for Les Rouge et Noir."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "388": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Player wellbeing",
          "heading": "Ryan Caldwell details his arduous journey from injury to personal peace",
          "body": "Former Ireland international Ryan Caldwell has shared a harrowing account of his transition from professional rugby to a life of recovery. The former second-row, who represented Ulster, Bath and Exeter, discusses his struggles with addiction, depression, and the impact of the injuries that cut his career short. Currently living in Belfast, the 41-year-old now works as a meditation and breathwork teacher, a path he details in his forthcoming book, which charts his experience of being broken and successfully rebuilt."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Disciplinary Sanction",
          "heading": "Gonzalo Quesada Banned Under World Rugby’s New Match Official Abuse Process",
          "body": "Italy head coach Gonzalo Quesada has been issued a two-Test suspension, becoming the first coach sanctioned under World Rugby’s new Match Official Abuse Sanctioning Process. The ban follows comments made by the Argentine regarding referee Luc Ramos after the loss to the All Blacks. Consequently, Quesada is prohibited from all match-day proceedings—including stadium attendance—for the upcoming fixtures against Australia and the November Test against South Africa. He retains the right to appeal the governing body’s decision."
        }
      ]
    },
    "390": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Pathways integration",
          "heading": "Edinburgh and Glasgow bolster squads with Scottish Rugby pathway graduates",
          "body": "As professional clubs finalise preparations for the 2026/27 season, several Scottish Rugby pathway products are set for senior opportunities. Edinburgh includes tighthead Jamie Stewart and back-rower James Dalrymple in their current programme, with a host of 2024 U20s World Rugby Trophy winners also featuring. Meanwhile, Glasgow Warriors have secured professional deals for emerging talents including centre Kerr Yule. These inclusions highlight a concerted effort to integrate homegrown prospects into the professional setup as both sides launch their campaigns."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Injury Update",
          "heading": "Taulupe Faletau remains on road to recovery following recent injury setback",
          "body": "Taulupe Faletau’s return to action remains the primary focus for Cardiff as the club navigates his latest injury recovery. The back-row forward, who sustained an injury during the defeat by the Sharks, has been working through protocols to regain full fitness. While Cardiff remains hopeful of his availability for the upcoming United Rugby Championship campaign, his return to the Wales squad remains dependent on his ability to regain consistent match form at club level."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Selection Change",
          "heading": "Australia recall Suaalii and Donaldson for second Test against Argentina",
          "body": "Australia have made nine alterations to their starting XV for the Mendoza rematch, with coach Les Kiss recalling Joseph-Aukuso Suaalii and Ben Donaldson to the run-on side. Donaldson earns his first start at flyhalf since 2024, while Harry Wilson returns to captain the tourists from number eight. Los Pumas enter the fixture following a narrow 27-21 defeat in San Salvador de Jujuy, looking to level the series in what would prevent Australia from securing their first-ever clean sweep on Argentine soil."
        }
      ],
      "match": {
        "venue": "Estadio Malvinas Argentinas, Mendoza"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Selection Change",
          "heading": "Les Kiss shuffles Wallabies lineup as Tom Wright hits 50th cap",
          "body": "Australia have made 9 changes to their starting side for the second Test against Argentina in Mendoza. Captain Harry Wilson returns to lead the team from number eight, while flyhalf Ben Donaldson makes his first start in two years. The rotation also sees Joseph-Aukuso Suaalii and Len Ikitau reunite in the midfield. Head coach Les Kiss explained, “We’ve brought in some fresh bodies alongside some existing combinations as we continue to look to build Test experience across the group.”"
        }
      ],
      "match": {
        "venue": "Estadio Malvinas Argentinas, Mendoza",
        "referee": "James Doleman"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Centenary Test",
          "heading": "Japan Brave Blossoms host Canada to mark JRFU’s 100th anniversary match",
          "body": "Japan host Canada at Denka Big Swan Stadium in Niigata City this weekend, celebrating the JRFU’s centenary. Eddie Jones has made five changes to the starting XV that faced Australia, handing a debut to Inoke Burua. Japan will look to break a four-match losing streak against a Canada side currently ranked 24th in the world. Japan have historically dominated this fixture, having not lost to the Canadians in their past 10 meetings, with their last encounter resulting in a 57-15 victory."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Ardie Savea ruled out of fourth Test following shoulder injury",
          "body": "The All Blacks must look to salvage a 2-2 series draw without captain Ardie Savea, who has been ruled out of next Saturday’s final Test in Baltimore. Savea sustained a shoulder injury in the 30th minute of Saturday’s 29-24 defeat in Johannesburg. Addressing the setback post-match, head coach Dave Rennie confirmed the skipper will not travel with the squad, though he praised the contribution of replacement Wallace Sititi, insisting the team will not use the captain's absence as an excuse."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Series Lead",
          "heading": "South Africa overcome All Blacks at FNB Stadium to lead 2-1",
          "body": "The Springboks secured a 29-24 victory over New Zealand on Saturday, moving into a 2-1 series lead with one Test remaining. After trailing in the second half, the world champions relied on their set-piece dominance and a decisive late surge to overcome the visitors in Soweto. However, the win came at a cost, with head coach Rassie Erasmus confirming that Cheslin Kolbe sustained a broken jaw during the match, ruling him out of the final fixture in Baltimore."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
