  "digests": {
    "28": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Fijian rugby player Saimoni Vunilagi dies aged 26 after suspected heatstroke",
          "body": "The Fijian rugby community is mourning the tragic death of Saimoni Vunilagi, who has died aged 26 after suffering suspected heatstroke in Japan. The second-division club Kyushu KV confirmed the player was hospitalised in Fukuoka City after developing severe symptoms following team practice. Despite the medical team's best efforts, Vunilagi passed away, leaving his club 'devastated' during a period of extreme summer temperatures. Kyushu KV expressed deep condolences to his family and loved ones."
        }
      ]
    },
    "386": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "Selection policy",
          "heading": "Courtney Lawes urges England to scrap overseas rule during international comeback bid",
          "body": "Courtney Lawes has targeted an England return with Sale Sharks but is already demanding the RFU scrap its overseas selection ban. The 37-year-old forward, who has 105 caps, was left out of Steve Borthwick's 36-man training squad alongside Joe Marchant to prove his form in the Premiership first. Lawes insisted England must select top talent like Jack Willis, arguing: \"I just reckon you make your best players available and by any means necessary.\""
        }
      ],
      "match": {
        "venue": "Allianz Stadium, Twickenham"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "Domestic power",
          "heading": "Vibrant Top 14 depth primes robust France to challenge dominant Springboks",
          "body": "As South Africa and New Zealand clash on the global stage, analysis highlights France as the northern hemisphere's sole force equipped to match the Springboks' long-term supremacy. Unlike England's heavily managed structures, the French game is propelled by the sheer, unmanufactured passion of the Top 14. A dramatic opening weekend saw Bayonne edge Toulon 27-26 and La Rochelle snatch a thrilling 30-27 victory over champions Toulouse. This ferocious domestic environment ensures Fabien Galthié's squad retains a self-sustaining depth that rivals the very best in the world."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "388": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "Life after rugby",
          "heading": "Former Ireland lock Ryan Caldwell reveals his battle with addiction in memoir",
          "body": "Former Ireland lock Ryan Caldwell has opened up about his harrowing post-career journey in his upcoming autobiography, White Lines: a Rugby Life Broken and Rebuilt. The former Ulster, Bath and Exeter second-row detailed how a final severe concussion ended his playing career and triggered a deep spiral of suicidal depression, drug addiction and imprisonment. Now working as a meditation and breathwork teacher in Belfast, the retired forward credits his recovery to a therapeutic journey into the Amazon jungle."
        }
      ]
    },
    "389": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Italy lock Andrea Zambonin misses Exeter season start following shoulder surgery",
          "body": "Today's press offers no fresh updates on Andrea Zambonin's recovery following his recent shoulder surgery. The lock is set to miss the start of Exeter Chiefs' season, a setback first reported on Sunday. Italy face a difficult test against South Africa next, and coaching staff will be anxious for news on the forward's rehabilitation timeline. For now, his return date remains unconfirmed, leaving the national side's second-row depth uncertain."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "Fixture history",
          "heading": "Scotland chase New Zealand response after suffering 25-17 home defeat in 2025",
          "body": "Scotland sit fifth in the tournament standings after three matches. Gregor Townsend's side have won two matches in the current campaign, alongside one defeat. Across those three fixtures, they have accumulated 108 points. The team have conceded 97 points in that same period. They maintain a tournament point difference of plus-11. Scotland enter the break following a 33-17 victory over Fiji in Round 3. However, they must now prepare for New Zealand, who won the last meeting between the sides 25-17 in November 2025."
        }
      ],
      "rung": "data"
    },
    "391": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "Injury boost",
          "heading": "Wales lock Ben Carter recovers from ankle injury before domestic opener",
          "body": "Wales lock Ben Carter has been cleared to return for the Dragons after recovering from the ankle injury he sustained in international training. The 25-year-old was forced out of July's Nations Championship Test against South Africa but has avoided surgery. Having started Wales' six previous games before his setback, his recovery provides a timely boost. Dragons defence coach Dale MacLeod confirmed: \"He is fit and ready to go for collisions and game time.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "Dramatic draw",
          "heading": "Argentina fight back to secure dramatic 28-28 draw against Australia in Mendoza",
          "body": "Argentina drew 28-28 with Australia in Mendoza in Saturday's second Test. Los Pumas fell 14-0 behind after Franco Molina's yellow card, but rallied with first-half tries from Pablo Matera and Ignacio Mendy. Ignacio Ruiz and Matera crossed in the second half to lead 28-21, but a Wallabies penalty try levelled the match. Despite two late yellow cards, including one for Lucio Cinti, which left Argentina defending with 13 men, the hosts held on to secure a share of the spoils."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Playmaker Carter Gordon fractures leg to hand Australia major injury blow",
          "body": "The Wallabies are bracing for a two-month spell without first-choice fly-half Carter Gordon after scans confirmed the 25-year-old playmaker suffered a leg fracture during the 28-28 draw against Argentina in Mendoza. The injury rules Gordon out of this month's Test against South Africa and the upcoming Bledisloe Cup series. However, coach Les Kiss hopes the luckless playmaker can recover in time for November's clash with England at Twickenham. Ben Donaldson and Tom Lynagh are now poised to compete for the vacant No. 10 jersey."
        }
      ],
      "match": {
        "venue": "Twickenham, London"
      },
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "Eligibility rules",
          "heading": "Japan Rugby League One backtracks on proposed limits for naturalised players",
          "body": "There has been no further update in today's Japanese press regarding the proposed Japan Rugby League One player eligibility reforms. The situation remains unresolved since late last month, when officials rolled back proposed restrictions on naturalised and foreign-born players on 28 August. While the U-turn followed backlash from players and clubs, the official regulations for the 2026-2027 season have yet to be finalised and formally accepted, keeping the league's long-term category structures in limbo."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      },
      "rung": "storyline"
    },
    "465": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Dave Rennie loses Ardie Savea to shoulder injury amongst nine squad departures",
          "body": "The All Blacks have confirmed captain Ardie Savea will return to New Zealand after suffering a dislocated shoulder. He is one of nine players leaving the touring group, alongside injured pair Quinn Tupaea and Luke Jacobson. Senior assistant coach Neil Barnes called for a \"humble pie\" review following the recent physical toll, as Dave Rennie names a 36-man squad to travel to Baltimore. Despite 12 linebreaks in their last outing, the camp is focused on correcting a dominant opposition set-piece that Mike Blair noted has stifled recent momentum."
        }
      ],
      "match": {
        "venue": "M&T Bank Stadium, Baltimore"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "Series lead",
          "heading": "South Africa secure 2-1 series lead after defeating the All Blacks",
          "body": "The Springboks head to Baltimore for the final Test of the 'Greatest Rivalry' series with a series advantage after their 29-24 victory in Soweto. Second-half tries from Jesse Kriel and Malcolm Marx proved pivotal as the world champions overcame a resilient New Zealand side. Rassie Erasmus has urged his team to maintain their attacking intent for the decider, noting, “I think the important thing is we just have to score more points than them.”"
        }
      ],
      "match": {
        "venue": "M&T Stadium, Baltimore"
      },
      "source": {
        "name": "Guardian Rugby Union"
      }
    }
  }
