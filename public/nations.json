    "389": {
      "date": "2026-11-23",
      "edition": "Monday 23 November",
      "sections": [
        {
          "kicker": "Foreign press",
          "heading": "Sarugbymag says 16-21 Fiji loss capped Quesada's winless Nations Championship campaign",
          "body": "Saturday's 16-21 defeat in Udine drew broadly even-handed verdicts abroad, but South Africa's Sarugbymag.co.za was the bluntest, calling it the end of a disappointing season for Quesada's Italy, six losses from six, ahead of the finals weekend at Twickenham. AP News and Reuters framed it as Fiji's first Nations Championship win; Rugbyrama noted Italy led 13-7 at the break before Ikanivere's second-half double turned it. TNT Sports' headline cast both sides as teams in difficulty."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa's banned Rassie Erasmus seen speaking into earbuds",
