    "460": {
      "date": "2026-10-27",
      "edition": "Tuesday 27 October",
      "sections": [
        {
          "kicker": "Coaching move",
          "heading": "Shaun Edwards signs with Argentina as defence coach until 2027 World Cup",
          "body": "Shaun Edwards, the former France and Wales assistant, has signed as Argentina's defence coach through to the 2027 World Cup in Australia, ending speculation that England's Steve Borthwick could bring him in. Edwards told Rugby World: \"Argentina was the first team to offer me a contract.\" He will link up with the Pumas once his current England commitment ends after next Friday's match away to the USA. He admits he would like to represent England, but says the men's boss told him the staff were happy."
        },
        {
          "kicker": "Around the world",
          "heading": "Fiji beat Japan 34-28 in the centenary Test",
          "body": "Ardie Savea left out of New Zealand's Nations Championship squad. Ireland wings Tommy and Jimmy O'Brien forced off in URC interpro."
        }
      ],
