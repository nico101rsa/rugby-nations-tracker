  "digests": {
    "28": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Fijian forward Saimoni Vunilagi dies aged 26 in Japan of suspected heatstroke",
          "body": "The rugby community is mourning the tragic death of Fijian back-row forward Saimoni Vunilagi, who has passed away in Japan aged 26. Vunilagi, a towering 196cm loose forward for second-division club Kyushu KV, died in a Fukuoka hospital after displaying symptoms consistent with severe heatstroke following a team practice on Monday. The club released a statement expressing they are \"devastated by this sudden news\" as local temperatures reached 35 degrees Celsius. Vunilagi had relocated to Japan for university before starting his professional career in 2023."
        }
      ]
    },
    "386": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Selection scrutiny",
          "heading": "Jeremy Guscott urges Steve Borthwick to start Henry Pollock for England",
          "body": "Former England centre Jeremy Guscott has publicly urged Steve Borthwick to promote Henry Pollock from the bench to the starting XV. Describing the 21-year-old as one of the most gifted modern back-rowers, Guscott argued that England must be more adventurous to succeed at the next World Cup. He further suggested that Borthwick needs to grant coach Lee Blackett more influence on the team's attacking imprint, while also questioning the continued exclusion of centre Max Ojomoh."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Scrum-half rankings",
          "heading": "Planet Rugby ranks Maxime Lucu ahead of Antoine Dupont in standings",
          "body": "In a recent global assessment of scrum-halves, Planet Rugby has positioned La Rochelle’s Nolann Le Garrec as a high-level operator despite his status as backup, while identifying Maxime Lucu as the most in-form nine currently playing. Although Antoine Dupont remains a significant figure in the position, the publication suggests that Lucu’s recent contributions have seen him command the primary role. Le Garrec, meanwhile, continues to be recognised for his creative attacking repertoire, including his trademark out-the-back passes."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "388": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Injury update",
          "heading": "Iain Henderson remains sidelined as recovery from hip surgery continues",
          "body": "The Ireland squad continues to monitor the status of captain Iain Henderson, who remains unavailable for selection. As reported last week, the Ulster skipper is set to miss the start of the season following recent hip surgery. He is expected to be out of action for a number of months as part of a wider period of recovery for several key players who have undergone medical procedures."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Team history",
          "heading": "Italy rugby team holds record for highest world ranking reached",
          "body": "Italy has previously attained a peak position of No. 8 in the World Rugby rankings. This historical high for the national side was first achieved during the 2007 calendar year and was matched subsequently in 2024. As the team looks towards the upcoming fixture against South Africa, they currently sit 11th on the log following their opening three matches of the competition."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Leadership search",
          "heading": "Scottish Rugby continues its hunt for a permanent chief executive successor",
          "body": "The search for a permanent Scottish Rugby chief executive remains ongoing following the departure of Alex Williamson. Since his removal earlier this month following an investigation into inappropriate conduct, the organisation has provided no further updates regarding the appointment of a successor. With the vacancy currently unfilled, the governing body is yet to announce an interim structure or a timeline for the recruitment process to replace the former executive."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Board appointment",
          "heading": "Alun Wyn Jones joins Ospreys board to aid club's survival fight",
          "body": "Former Wales captain Alun Wyn Jones has been appointed as a director at the Ospreys with immediate effect. The 40-year-old former lock joins the board at a turbulent period for the region, which is currently competing against the Scarlets for one of the three professional licences proposed by the Welsh Rugby Union. Jones stated that he intends to use his experience in business and rugby to help drive long-term stability as the club prepares for its move to St Helen’s."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Tactical analysis",
          "heading": "Kieran Read identifies Argentina’s effective blueprint for unlocking South African defence",
          "body": "Former All Black captain Kieran Read believes Argentina provided the perfect tactical template for exploiting South Africa’s rush defence. While Los Pumas narrowly lost their recent encounter, Read noted that their use of width, chip kicks, and cross-field play successfully exposed space behind the Springbok line. He suggested that New Zealand should adopt a similar approach to target the fringes, trusting quick ball and depth to manipulate a South African defensive system that remains reliant on their traditional structure."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "461": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Selection pressure",
          "heading": "Fraser McReight insists internal competition drives performance for Les Kiss’s Wallabies",
          "body": "Wallabies flanker Fraser McReight has highlighted the intensifying competition for spots as Les Kiss continues to refine his squad for the 2027 World Cup. Following recent wins over Italy and Japan, Kiss has rotated his starters to test depth, notably leaving out star backrowers in the Townsville victory. McReight, who recently partnered with Carlo Tizzano in a high-intensity back-row combination, noted: \"Kissy’s doing a good job of keeping it all together. He’s just come in and he understands that his job is to win.\""
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "463": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Japan rugby community mourns following death of Saimoni Vunilagi",
          "body": "The Japanese rugby community is in mourning after the death of Saimoni Vunilagi, who passed away on Friday from suspected heatstroke. The 26-year-old Kyuden Voltex back-rower, who previously played for Suntory Sungoliath, fell ill following a training session in Fukuoka. A minute’s silence was observed before the most recent international match to honour his memory. The Japan Rugby League One office extended its heartfelt condolences to his family as the club asks for privacy during this period of profound grief."
        }
      ]
    },
    "465": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Statement victory",
          "heading": "New Zealand defeat South Africa as Will Jordan shines at Ellis Park",
          "body": "The All Blacks claimed a 33-16 victory over the world champion Springboks in Saturday’s opening test. Will Jordan scored two tries in a clinical performance, with New Zealand crossing the whitewash five times compared to South Africa's one. Despite facing intense scrum pressure, the visitors dominated key efficiency metrics, averaging 3.67 points per entry into the 22. Coach Dave Rennie noted the scoreline was flattering, admitting it was an absolute arm wrestle before his side pulled away to secure the win."
        }
      ],
      "match": {
        "venue": "Ellis Park, Johannesburg",
        "referee": "Matthew Carley"
      },
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "467": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
