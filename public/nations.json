  "digests": {
    "28": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "SUPER RUGBY WOMEN",
          "heading": "Fijian Drua lose historic home grand final to NSW Waratahs",
          "body": "The Fijian Drua missed out on the Super Rugby Women's title after falling 17-34 to the NSW Waratahs in a historic grand final in Ba. Playing the showcase match in Fiji for the first time, the minor premiers struggled with execution at Four R Stadium, conceding six lost lineout throws and falling behind 24-0 shortly after half-time. Although the Drua crossed for three second-half tries, replacement Amelia Whitaker scored twice to seal a record-extending seventh crown for the clinical visitors."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "386": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "RACIAL ABUSE",
          "heading": "Jamie George warns England could walk off against Argentina over racist abuse",
          "body": "England captain Jamie George revealed his squad discussed walking off the pitch in Santiago del Estero if they faced a repeat of the racist abuse directed at black players last year. Ahead of last month's final Test against Argentina, George confirmed contingency plans were made after Asher Opoku-Fordjour and Chandler Cunningham-South were targeted in San Juan. Warning of 'the strongest of reactions' to further slurs, George consulted his team-mates to ensure a unified response, stating, 'This isn't just my call to make.'"
        }
      ]
    },
    "387": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "WORLD RANKINGS",
          "heading": "France held the world number one ranking for just one week",
          "body": "France held the world number one ranking for a single week during July 2022. This stands as the longest unbroken spell the national side has spent at the top of the world standings. Within the current Nations Championship, the squad occupies third place in the table after three rounds of play. In their opening three fixtures of the tournament, the team has recorded two wins and one loss. The side has registered 116 points scored against 75 conceded."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "MATCH REVIEW",
          "heading": "Andy Farrell rues error-strewn display as Ireland fall to New Zealand",
          "body": "Andy Farrell has criticised his side's lack of accuracy following their 40-21 defeat to New Zealand at Eden Park. Ireland struggled for continuity throughout the contest, with the head coach highlighting missed tackles, discipline issues, and unforced errors as the primary factors behind the result. While acknowledging the squad's character, Farrell insisted that Ireland must learn from the experience, noting, \"You can’t make so many errors against a quality side like New Zealand.\""
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "389": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "STATISTICAL REVIEW",
          "heading": "Italy statistics reveal significant defensive pressure across recent international match fixtures",
          "body": "In their last 11 matches, Italy have scored 190 points and conceded 318, resulting in averages of 17.3 points scored and 28.9 points conceded per game. These figures reflect the challenging period the side has faced in the Nations Championship. Despite current difficulties, the team’s most successful outing within this specific 11-game window remains their 34-19 home victory against Chile in November 2025. The squad now looks to recalibrate defensive structures ahead of their upcoming test."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "LEADERSHIP CHANGE",
          "heading": "Scottish Rugby dismisses chief executive Alex Williamson following independent conduct investigation",
          "body": "Scottish Rugby has sacked chief executive Alex Williamson with immediate effect following the conclusion of an independent investigation. Chairman John McGuigan confirmed that the board determined Williamson’s conduct had fallen significantly below the standards expected of the organisation. Having served in the role for 18 months, Williamson had been on extended leave since May. Current chief financial officer David White will assume interim duties while the governing body commences the recruitment process for a permanent successor."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "REGIONAL REFORM",
          "heading": "Scarlets vow to remain at heart of west Wales amidst uncertainty",
          "body": "The Scarlets have publicly committed to their future in west Wales after the Welsh Rugby Union confirmed plans to reduce the professional game to three teams by 2028. With Cardiff and Dragons already positioned for licences, the Scarlets and Ospreys must now compete for the final spot in the west. The governing body will open formal licensing in December, leaving both clubs to present their financial plans to the Professional Rugby Board following the conclusion of the upcoming November Nations Championship fixtures."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "SQUAD BOOST",
          "heading": "Rassie Erasmus names Siya Kolisi and four returnees for Argentina Test",
          "body": "South Africa head coach Rassie Erasmus has named a 26-man squad for the upcoming clash in Buenos Aires, boosted by the return of captain Siya Kolisi, Eben Etzebeth, Lood de Jager, Sacha Feinberg-Mngomezulu and Morné van den Berg. Erasmus admitted the match is a balancing act, stating, “We tried to get the balance right between giving some guys who are returning from injury a valuable run against Argentina, while at the same time managing the players who have played a lot of rugby.”"
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "COACHING TRANSITION",
          "heading": "Harry Wilson Praises Les Kiss’ Impact Ahead Of Japan Test Series",
          "body": "Wallabies captain Harry Wilson has praised the energy brought by new head coach Les Kiss as the team prepares for their upcoming two-match series against Japan. Wilson noted that the squad has responded positively to the new leadership, stating, \"It's been really exciting for us.\" While Kiss has prioritised a new defensive strategy, he remains focused on competitive squad selection, confirming that winger Zac Lomax will still be considered for Test honours despite his upcoming return to rugby league."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "LEGAL CHALLENGE",
          "heading": "Timothy Lafaele joins 24 players challenging Japan Rugby League One rules",
          "body": "Japan Rugby League One faces a legal complaint from 24 foreign-born players, including national team star Timothy Lafaele, over new eligibility rules. The players have lodged their challenge with the Japan Fair Trade Commission, arguing that the regulations unfairly discriminate against naturalised Japanese citizens who have represented the country internationally. The complainants claim these changes threaten career pathways for foreign-born players, potentially forcing out experienced internationals who have served the sport in Japan for many years."
        }
      ]
    },
    "465": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "TOUR PREPARATION",
          "heading": "Dave Rennie welcomes All Blacks squad to Cape Town for tour",
          "body": "The All Blacks have officially assembled in Cape Town for their seven-match South African tour, with head coach Dave Rennie confirming that 43 of his 44-man squad have arrived. Rennie, overseeing his first tour as coach, emphasised the importance of balancing physical preparation with downtime. Ardie Savea remains the sole absentee and is scheduled to link up with the group later this month. Rennie described the local reception as “incredible” as the team prepares to face the Stormers."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-08-02",
      "edition": "Sunday 2 August",
      "sections": [
        {
          "kicker": "COACHING PHILOSOPHY",
          "heading": "Rassie Erasmus reveals his biggest fear is losing the national joy",
          "body": "Springbok coach Rassie Erasmus has admitted that his greatest fear is not defeat on the scoreboard, but losing the profound connection the team has built with the South African public. Speaking on the Rassie+ podcast, Erasmus explained that the \"lekker feeling\" of shared national happiness is what drives his planning. \"I'm so nervous of that going away,\" he said. \"That's my biggest fear. That's my nightmare.\" Captain Siya Kolisi supported this sentiment, noting the painful, empty-stadium reality of past eras."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
}