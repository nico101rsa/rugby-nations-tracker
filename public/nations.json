  "digests": {
    "28": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Fijian forward Saimoni Vunilagi dies in Japan of suspected heatstroke",
          "body": "The rugby community is mourning after Kyushu KV confirmed the tragic death of Saimoni Vunilagi at the age of 26. The Fijian forward, who stood 196cm tall, passed away in a Fukuoka hospital after displaying symptoms of severe heatstroke following a team practice. Vunilagi began his professional career in Japan in 2023 after attending university there. His club expressed devastation, praying for the repose of his soul and praising his generous spirit."
        }
      ]
    },
    "386": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Red Roses win",
          "heading": "England Women dominate second half to defeat Australia in tournament opener",
          "body": "John Mitchell’s side secured an emphatic 48-15 victory over Australia in their WXV Global Series opener, overcoming a rare half-time deficit. Trailing 10-5 at the interval, the world champions responded with seven second-half tries, including scores from captain Meg Jones, Sadia Kabeya, and Lucy Packer. Head coach Mitchell praised the group's ability to solve problems under pressure during what he termed a \"pre-season game.\" England now prepare for a high-profile fixture against Canada at Sandy Park next weekend."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Match history",
          "heading": "France look to replicate last victory against upcoming opponents from Fiji",
          "body": "As the team prepares for their upcoming encounter, France will look to draw confidence from their most recent meeting against Fiji. In their last clash during the November 2025 international friendlies, France secured a 34-21 victory on home soil. That result serves as the final meeting between the two sides heading into this fixture, where France aim to maintain their momentum after a successful recent performance against Japan."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Six Nations status",
          "heading": "IRFU confirms no plans to move Six Nations matches to US",
          "body": "The IRFU has officially ruled out moving Six Nations fixtures to the United States. Following suggestions from World Rugby chief executive Alan Gilpin that taking a match like Ireland versus Italy to the American market could help grow the sport, the governing body issued a statement on Friday. The IRFU asserted that there are \"currently no plans or discussions\" regarding such a move, reiterating that home matches in Ireland remain a central component of the competition's appeal and heritage."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Team stats",
          "heading": "Italy aims to climb back towards their best world ranking position",
          "body": "As the side reflects on their recent form, Italy looks to recover ground within the international hierarchy. The Azzurri’s best world ranking remains No. 8, a position they last achieved in 2024, having previously reached that same height in 2007. Following a difficult run in the current tournament, where they currently sit 11th in the log, the squad will focus on improving their competitive standing when they return to action."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "WXV opener",
          "heading": "Scotland Women suffer heavy defeat against clinical Canada at Hive Stadium",
          "body": "Scotland faced a difficult start to their WXV campaign on Saturday, falling 26-64 to a ruthless Canada side in Edinburgh. Despite four tries from Evie Gallagher, Shona Campbell, Lana Skeldon, and Rhona Lloyd, the visitors’ physical intensity proved overwhelming, with Canada crossing 10 times. Interim head coach Dave Butcher acknowledged the need for increased physicality, noting he has plenty to ponder as the side turns its focus toward upcoming home fixtures against New Zealand and Australia."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Injury recovery",
          "heading": "Dragons co-captain Ben Carter cleared to begin new domestic season",
          "body": "Dragons co-captain Ben Carter is set for a return to action after recovering from the ankle injury that ruled him out of Wales' heavy defeat to South Africa in July. The 25-year-old lock, who previously started 6 consecutive Tests for his country, avoided surgery during his rehabilitation. Dragons defence coach Dale MacLeod confirmed the forward is \"in the best nick that I have seen him\" and is now preparing to join the team for their opening league fixture later this month."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Historical perspective",
          "heading": "Argentina maintain impressive history while currently ranked outside top three",
          "body": "As the squad prepares for upcoming international windows, it remains worth noting that Argentina reached their best world ranking of No. 3 during the 2007–08 period. Following three matches in the current cycle, the side maintains a focus on tactical development. The team has shown consistency in high-scoring encounters throughout their recent outings, reflecting a style that continues to challenge established international opposition as they look to build upon their current standing in the log."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "WXV Global Series",
          "heading": "England crushes Australia in WXV Global Series opener at CorpAcq Stadium",
          "body": "Australia suffered a heavy defeat in the opening match of the WXV Global Series on Friday, falling 48-15 to England. Despite leading 10-5 at half-time following tries from Faliki Pohiva and Asoiva Karpani, the Wallaroos were overwhelmed by a dominant second-half display from the world champions. England scored seven tries after the interval to extend their winning streak to 39 matches, leaving the Australians to regroup before their next outing in the tournament."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "463": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "PNC Semifinal",
          "heading": "Eddie Jones Targets Pacific Nations Cup Glory Against USA In Osaka",
          "body": "Japan returns to action at Hanazono Rugby Stadium aiming to reach the Asahi Super Dry Pacific Nations Cup final. Having finished behind Fiji in the standings for two consecutive years, Eddie Jones is hunting a first title since 2019. Japan enters the clash as favourites, holding home advantage and a superior head-to-head record, having won nine of the last 10 meetings against the USA. Jones will look to capitalise on that momentum to move past Scott Lawrence’s undefeated Eagles."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "465": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Richie Mo’unga returns as All Blacks shuffle side for Baltimore finale",
          "body": "Dave Rennie has reshuffled his side for the series finale in Baltimore, with Richie Mo'unga returning to the starting fly-half position. The coaching staff expects a bolder approach as the tourists look to level the series at two apiece. Josh Moorby also rejoins the starting backline on the wing, while Anton Lienert-Brown takes over at outside centre. Springbok assistant Mzwandile Stick acknowledged the threat, noting, \"They will be even more bold tomorrow when it comes to keeping the ball alive.\""
        }
      ],
      "match": {
        "venue": "M&T Bank Stadium, Baltimore"
      },
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-13",
      "edition": "Sunday 13 September",
      "sections": [
        {
          "kicker": "Series decider",
          "heading": "Springboks and All Blacks prepare for historic series finale in Baltimore",
          "body": "South Africa heads into the final showdown of the four-Test series leading 2-1, seeking to cement their series victory on neutral ground. For World Rugby, the match at M&T Bank Stadium serves as a significant staging post for the 2031 World Cup hosted by the United States. Rassie Erasmus, who reaches his 100th Test at the helm, will look to maintain the momentum from the recent Soweto victory while navigating the commercial and logistical demands of this unique international fixture."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    }
  }
