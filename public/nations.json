  "digests": {
    "28": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Fijian forward Saimoni Vunilagi dies of suspected heatstroke in Japan",
          "body": "Fijian rugby is mourning the tragic passing of back-row forward Saimoni Vunilagi, who died in hospital earlier this month after developing severe heatstroke symptoms. The 26-year-old fell ill following a Kyushu KV training session in Fukuoka, where temperatures reached 35C. The Japanese second-division club expressed their profound grief, stating they are \"devastated by this sudden news\" and paying tribute to Vunilagi's \"generous spirit and powerful style of play\" after he recently joined the side."
        }
      ]
    },
    "386": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Selection debate",
          "heading": "Jeremy Guscott calls on Steve Borthwick to unleash 'awesome' Henry Pollock",
          "body": "Former England centre Jeremy Guscott has urged Steve Borthwick to hand Henry Pollock a starting role, calling the 21-year-old loose forward 'one of the most gifted players we have ever seen as a seven.' Pollock has established himself in the national squad, earning 13 caps, but 12 of those have come as a replacement. Guscott also questioned the omission of Max Ojomoh and called for Borthwick to give coach Lee Blackett more influence if England are to succeed at the next World Cup."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Scrum-half rankings",
          "heading": "Maxime Lucu leads French contingent in latest global scrum-half rankings",
          "body": "Planet Rugby has identified Maxime Lucu as the most in-form scrum-half currently operating in the game. While Antoine Dupont collects bronze in the latest top 10 list, Lucu and Nolann Le Garrec remain key figures in the French setup. Le Garrec, currently with La Rochelle, is noted as a world-class operator despite the high level of competition for the starting berth. The recognition reflects the ongoing depth available at nine for Les Bleus as they continue their Nations Championship campaign."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "388": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Obituary",
          "heading": "Rugby journalism mourns as Edmund Van Esbeck dies aged 94",
          "body": "The Irish rugby community is in mourning following the death of former Irish Times correspondent Edmund ‘Ned’ Van Esbeck at the age of 94. A defining voice for over 30 years, Van Esbeck charted the sport’s evolution from its amateur roots to the professional era. He authored several authoritative texts on the national team and remained a vocal advocate for the game’s unique ability to transcend divisions, famously noting that rugby succeeded where generations of politicians failed to unite the island."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Club movement",
          "heading": "Tommaso Menoncello departs Benetton as Italy’s professional clubs reset rosters",
          "body": "Benetton Rugby has confirmed the departure of Tommaso Menoncello ahead of the 2026-27 season. The move forms part of a wider reshuffle at the Treviso club, which has looked to international markets to bolster its squad while managing the exits of several domestic talents. As the national team continues preparations for the next World Cup cycle, the development of these homegrown prospects remains a focal point for the Italian professional pathway and the long-term future of the Azzurri squad."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Legal proceedings",
          "heading": "High Court brain injury litigation involving former players remains currently unresolved",
          "body": "There have been no further developments in the High Court brain injury litigation involving over 500 former players. As reported previously, the case remains active after the High Court ruled it could proceed, with the matter awaiting a final judgment or a negotiated settlement between the claimants and the governing bodies. Separately, recent media coverage has highlighted six Scotland players facing a pivotal period to secure their standing under Gregor Townsend as the new season approaches, though this remains general analysis."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Board appointment",
          "heading": "Alun Wyn Jones returns to Ospreys as a new board director",
          "body": "Former Wales captain Alun Wyn Jones has joined the Ospreys board of directors with immediate effect. The 40-year-old, who made his debut for the region in 2005, returns at a turbulent time as the club navigates the WRU’s controversial proposal to reduce the professional game to three sides. Chairman James Davies-Yandle stated the club was not looking for a figurehead, but a director who understands the organisation from the inside to help drive long-term stability and growth."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Tactical analysis",
          "heading": "Kieran Read highlights how Argentina exposed Springboks’ defensive rush system",
          "body": "Former All Blacks captain Kieran Read has pointed to Argentina’s strategy in Buenos Aires as a potential blueprint for unlocking the Springboks’ rush defence. Despite a narrow loss, Los Pumas successfully created space on the fringes by using chips and cross-field kicks to bypass the heavy defensive pressure in the middle. Read noted that Argentina’s willingness to trust their depth and move the ball quickly against the South African defensive line provided a template for other teams to follow."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "461": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Selection uncertainty",
          "heading": "Les Kiss faces midfield puzzle as Ikitau and Suaalii return availability",
          "body": "Wallabies coach Les Kiss faces a significant selection headache as the squad prepares for the Argentina tour. While Isaac Henry impressed during his debut start in the recent win over Japan, the return of established centre pairing Len Ikitau and Joseph-Aukuso Suaalii complicates the backline mix. As noted in recent reports, Kiss is currently weighing whether to stick with his current midfield or pivot Suaalii to a different role—such as fullback or wing—to accommodate the emerging depth in the squad."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      },
      "rung": "storyline"
    },
    "463": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Tragic loss",
          "heading": "Japanese rugby mourns death of Saimoni Vunilagi following training session",
          "body": "The Japanese rugby community is in mourning following the death of Kyushu Kyuden Voltex back-rower Saimoni Vunilagi. The 26-year-old passed away after suffering suspected heatstroke during a training session. A minute’s silence was observed in his honour before the recent Test against Australia, where former teammates Kanji Shimokawa and Naoto Saito were in the starting XV. The Japan Rugby League One expressed their condolences to Vunilagi’s family as the nation continues to navigate an exceptionally intense summer of record-breaking heat."
        }
      ],
      "match": {
        "venue": "N/A",
        "referee": "N/A"
      }
    },
    "465": {
      "date": "2026-08-23",
      "edition": "Sunday 23 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Anton Segner ruled out as Simon Parker joins All Blacks bench",
          "body": "Coach Dave Rennie has been forced into a late change for the opening Test against South Africa at Ellis Park. Flanker Anton Segner was withdrawn from the squad after presenting with a swollen ankle, which has been assessed as acute inflammatory arthritis. Simon Parker has been named as his replacement on the bench. An All Blacks spokesperson confirmed that Segner's return to play is yet to be determined, leaving Parker to provide loose forward cover for the series opener."
        }
      ],
      "match": {
        "venue": "Ellis Park, Johannesburg"
