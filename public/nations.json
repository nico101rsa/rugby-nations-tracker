  "digests": {
    "28": {
      "date": "2026-08-19",
      "edition": "Wednesday 19 August",
      "sections": [
        {
          "kicker": "HOMECOMING",
          "heading": "Leone Nakarawa signs with Fijian Drua for 2027 Super Rugby season",
          "body": "Olympic gold medallist Leone Nakarawa has signed with the Fijian Drua for the 2027 Super Rugby Pacific season. The 38-year-old utility forward, who has won 68 caps for Fiji, will return home from French Top 14 club Castres. Expressing his excitement about the move, Nakarawa said he is 'looking forward to be playing for the Drua and playing professional and staying Fiji.' Drua general manager Baden Stephenson hailed the veteran lock as a 'quality leader' who brings vast top-level experience to the squad."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "386": {
      "date": "2026-08-19",
      "edition": "Wednesday 19 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Steve Borthwick axes Ollie Lawrence and Elliot Daly from central contracts",
          "body": "Steve Borthwick has omitted Ollie Lawrence and Elliot Daly from his 25-man list of centrally contracted players, despite both featuring heavily in the recent Six Nations. The surprise move comes as Borthwick rewards emerging talent, handing inaugural deals to Seb Atkinson, Alex Coles, Guy Pepper, Jack van Poortvliet and the versatile Sale prop Asher Opoku-Fordjour. While Daly and Lawrence have fallen out of favour, the head coach retains final say over the conditioning and medical management of this elite core."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "387": {
      "date": "2026-08-19",
      "edition": "Wednesday 19 August",
      "sections": [
        {
          "kicker": "RECENT FORM",
          "heading": "France move into third after securing a second consecutive Nations Championship win",
          "body": "Following their 42-15 victory over Japan in the Nations Championship, France currently sit third in the table after three rounds of competition. Fabien Galthié's side have secured two consecutive wins and have a record of three wins and two losses across their last five matches. With two victories from three fixtures in the current tournament, Les Bleus have registered 116 points while conceding 75, leaving them with a positive points difference of 41 as they prepare for the November window."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-19",
      "edition": "Wednesday 19 August",
      "sections": [
        {
          "kicker": "TRIBUTE",
          "heading": "Former Ireland player Brian Smith dies at 59 after dual-international career",
          "body": "The rugby community is mourning the death of Brian Smith, the former dual-international who represented both Ireland and Australia, at the age of 59. Smith’s career across both hemispheres saw him become one of a select group of players to earn caps for two major nations. Tributes have poured in today following the news, acknowledging his significant contribution to the sport. He is remembered by Irish supporters for his stint in the national side, honouring the loss of a rare talent who represented two Tier One countries."
        }
      ]
    },
    "389": {
      "date": "2026-08-19",
      "edition": "Wednesday 19 August",
      "sections": [
        {
          "kicker": "Log standing",
          "heading": "Italy occupy eleventh place after suffering three consecutive Nations Championship defeats",
          "body": "Italy occupy 11th place in the standings after three rounds of the Nations Championship. The side remain winless in the competition following a 10-57 loss to Australia in their most recent fixture. Italy have conceded 131 points across their opening three matches and have scored 37 points during the same period. When the team face South Africa in Round 4, they will look to improve on the 32-14 home defeat recorded during the last meeting in November 2025."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-19",
      "edition": "Wednesday 19 August",
      "sections": [
        {
          "kicker": "COACHING VACANCY",
          "heading": "Sione Fukofuka's resignation leaves Scotland Women coaching search in limbo",
          "body": "Scottish Rugby has yet to name a successor to Sione Fukofuka following his departure on 6 August. The former head coach resigned citing \"family stress,\" leaving a vacancy at the top of the women's programme. There has been no confirmation of a recruitment timeline or an interim appointment to manage the squad's upcoming preparations. The search remains active but unresolved, with no new candidates or shortlists emerging in the most recent reports from Murrayfield as the union seeks a permanent replacement."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-19",
      "edition": "Wednesday 19 August",
      "sections": [
        {
          "kicker": "RETIREMENT",
          "heading": "Former Wales centre Willis Halaholo retires after his body \"had enough\"",
          "body": "Auckland-born centre Willis Halaholo has retired from professional rugby at 36, admitting his body \"had enough\" despite a mind still keen to play. Halaholo earned nine Wales caps following his 2021 debut and made over 100 appearances for Cardiff before a final stint with Bay of Plenty. Though he finished his international career representing Tonga, his time in Wales was defined by flair and resilience through several major leg surgeries. He now moves into coaching after ending his eight-year association with the Welsh game."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-08-19",
      "edition": "Wednesday 19 August",
      "sections": [
        {
          "kicker": "Selection vacancy",
          "heading": "Tomás Albornoz suspension leaves Argentina seeking a new fly-half for Ireland",
          "body": "There is no update in today's coverage regarding a successor at fly-half following the four-match ban handed to Tomás Albornoz on 5 August. The suspension, triggered by Albornoz intimidating referee Angus Gardner after the 31-24 defeat to England, leaves a vacancy in the squad ahead of the November internationals. While the Pumas have already played South Africa since the ruling, today’s press remains silent on who will be trusted to start at No. 10 against Ireland later this year."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "461": {
      "date": "2026-08-19",
      "edition": "Wednesday 19 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Les Kiss faces Wallabies selection headache as Isaac Henry stars against Japan",
          "body": "Australia’s 56-17 victory over Japan in Townsville has sparked a midfield selection debate ahead of the upcoming tour to Argentina. Starting debutant Isaac Henry impressed at centre, challenging the established hierarchy of Joseph-Aukuso Suaalii and the returning Len Ikitau. Coach Les Kiss rested senior figures Allan Alaalatoa and Rob Valetini for the eight-try rout, which saw Massimo De Lutiis become the 1,000th Wallaby to be capped. With Ikitau recovered from an ankle injury, Kiss must now determine if Henry’s direct line-running merits a sustained role."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-19",
      "edition": "Wednesday 19 August",
      "sections": [
        {
          "kicker": "Coaching scrutiny",
          "heading": "Eddie Jones highlights Japan’s breakdown struggles after heavy defeat to Australia",
          "body": "Japan’s Nations Championship campaign faced a setback in Townsville last Saturday, falling 56-17 to Australia. Despite staying within striking distance at half-time, the Brave Blossoms were eventually overwhelmed in a match where their set-piece and breakdown work faltered. Reflecting on the result, Eddie Jones noted: “When we were forced to go on the defensive in those situations, it became a difficult game for us.” Japan must now address their lack of possession to remain competitive against top-ten ranked opponents."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-08-19",
      "edition": "Wednesday 19 August",
      "sections": [
        {
          "kicker": "Greatest Rivalry",
          "heading": "Dave Rennie leads New Zealand into historic tour against the Springboks",
          "body": "New Zealand’s tour of South Africa officially kicks off this weekend, marking a significant departure from the traditional Rugby Championship schedule. Dave Rennie takes his undefeated side into the first of three Tests, following a series of warm-up matches against provincial opposition. The venture, designed to emulate the financial impact of British and Irish Lions tours, serves as a new chapter for the sport. Rennie expects a rigorous physical challenge, having noted the contrast in ball-in-play speeds during recent provincial encounters."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "467": {
      "date": "2026-08-19",
      "edition": "Wednesday 19 August",
      "sections": [
        {
          "kicker": "Selection boost",
          "heading": "Siya Kolisi and Ox Nché track well for All Blacks opener",
          "body": "Siya Kolisi and Ox Nché are trending positively for Saturday's first Test against the All Blacks. Assistant coach Felix Jones confirmed the pair completed training on Tuesday without any setbacks, though they must clear one final session before Thursday’s squad announcement. Rassie Erasmus previously identified the duo as the only remaining injury concerns within his extended training group. Their potential return provides a significant boost for the world champions as they prepare to host New Zealand at Ellis Park."
        }
      ],
      "match": {
        "venue": "Ellis Park, Johannesburg"
      },
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
}