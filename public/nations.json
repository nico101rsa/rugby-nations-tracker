  "digests": {
    "28": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Final defeat",
          "heading": "Fiji surrender Pacific Nations Cup title following narrow defeat in Tokyo",
          "body": "The Flying Fijians surrendered their Pacific Nations Cup crown in Saturday's final, falling 20-15 to Japan in a tense Tokyo encounter. Despite first-half tries from Virimi Vakatawa and hooker Tevita Ikanivere, the defending champions struggled with discipline, losing Mesake Doge to a yellow card. Isaiah Armstrong-Ravula levelled the scores at 15-15 with a penalty in the final quarter, but Tongan-born Samisoni Tua crashed over with 10 minutes left to secure victory for Eddie Jones' side."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "386": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "WORLD CUP AMBITION",
          "heading": "Jack van Poortvliet backs England to win the 2027 Rugby World Cup",
          "body": "Scrum-half Jack van Poortvliet has declared that Steve Borthwick’s squad possesses the \"100% capability of winning\" the 2027 Rugby World Cup. After starting all three Nations Championship Tests during the summer, the 25-year-old revealed that his previous ankle injury allowed for a period of reflection and \"new-found enjoyment\" of the game. Van Poortvliet, who reclaimed the No. 9 shirt following Alex Mitchell’s hamstring issues, remains critical of his own form, stating he is not \"anywhere near\" his desired level despite England’s recent victories."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Psychological barrier",
          "heading": "Ben Youngs claims France must beat South Africa before World Cup",
          "body": "Former England scrum-half Ben Youngs has urged France to secure a victory against the Springboks when the two sides meet in Paris this November. Youngs suggests that recent losses to the world champions have left Fabien Galthié’s side with a significant mental hurdle. He argues that overcoming this psychological barrier is essential for Les Bleus to validate their status as serious contenders before the World Cup in Australia, as South Africa remains the benchmark in the international game."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "388": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "WXV Global Series",
          "heading": "Jemima Adams Verling debuts as Ireland face USA in Tallaght Stadium",
          "body": "Ireland begin a new three-year World Cup cycle today as they host the USA in the WXV Global Series at Tallaght Stadium. Head coach Scott Bemand has handed a senior debut to Connacht back row Jemima Adams Verling, who starts at blind-side flanker. With Sam Monaghan sidelined by an Achilles injury, Bemand described the series as a \"turning of the page\" to build squad depth. Ireland have won three consecutive meetings against the USA, most recently in 2024."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "389": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Six Nations",
          "heading": "World Rugby's ambition to stage Six Nations match in USA stalls",
          "body": "Plans to host a Six Nations fixture in the United States remain in limbo despite ongoing discussions led by World Rugby. Reports from earlier this month confirmed that while World Rugby is pushing the concept to expand the tournament's global reach, resistance persists among the unions. With major stakeholders like England expressing reluctance due to potential financial losses and other nations citing no current plans for such a move, a specific venue or confirmed date for the fixture remains elusive."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "WXV tournament",
          "heading": "Scotland Women suffer heavy home defeat against clinical New Zealand side",
          "body": "Scotland Women endured a difficult afternoon at Hive Stadium, falling to a 66-14 defeat against a clinical New Zealand team in the WXV Global Series. Despite Evie Gallagher’s brace of first-half tries providing a brief glimmer of competition at 24-14, the visitors’ pace proved insurmountable as they registered 10 tries in total. The result marks Scotland's second successive loss in the series following last weekend’s setback against Canada. The squad now turns its attention to an upcoming fixture against Australia."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Stunning victory",
          "heading": "Wales Women crush South Africa as Sean Lynn hails new DNA",
          "body": "Wales ended a nine-match winless streak in spectacular fashion, dismantling South Africa 50-19 at Cardiff Arms Park on Friday. Head coach Sean Lynn’s bold decision to shift scrum-half Keira Bevan to fly-half paid dividends as Wales ran in eight tries, with Sisilia Tuipulotu scoring a brace and co-captain Alex Callender earning player-of-the-match honours. Reflecting on the dominant performance, Lynn stated, \"This is just the start for us, this is going to be our new DNA.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Historical standing",
          "heading": "Argentina reflects on historical rankings as they look to build depth",
          "body": "As the current squad looks towards international tests, it is worth noting that Los Pumas reached their best ever world ranking of No. 3 during the 2007–08 period. The current focus remains on developing depth ahead of the 2027 World Cup. Following recent fixtures, coaches are evaluating a mix of established figures and newer talent to strengthen the roster across all positions, ensuring the team remains competitive as they prepare for their next encounter against Ireland."
        }
      ],
      "rung": "data"
    },
    "461": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Coaching challenge",
          "heading": "Les Kiss urges Wallabies to embrace unconventional play against formidable Springboks",
          "body": "Wallabies coach Les Kiss has issued a rallying cry ahead of next week’s showdown with South Africa, insisting that his side will not shy away from the world’s top-ranked team. Drawing inspiration from unconventional strategic thinking, Kiss believes the Wallabies can find a competitive edge against the Springboks. While South Africa arrives battle-hardened from a grueling series against New Zealand, Kiss remains defiant: “Take your eye off us, we’ll come back and bite you.”"
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "PNC CHAMPIONS",
          "heading": "Eddie Jones’ Japan defeat Fiji to secure Pacific Nations Cup title",
          "body": "Japan claimed the Pacific Nations Cup on Saturday, defeating Fiji 20-15 in a tense final in Tokyo. After falling short against the Flying Fijians in the previous two finals, the Brave Blossoms secured victory through a late try by Samisoni Tua. Ben Gunter and Mamoru Harada also crossed for the hosts in a match that remained in the balance until the final 10 minutes. The win provides a significant boost for Eddie Jones’ squad ahead of the 2027 Rugby World Cup cycle."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "465": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "WXV campaign",
          "heading": "Black Ferns cruise to victory as New Zealand dismantle Scotland side",
          "body": "The Black Ferns secured a dominant 66-14 victory against Scotland at Hive Stadium to open their WXV campaign. New Zealand established control early, with tries from Mo’omo’oga Palu and Maama Mo’onia Vaipulu setting the tempo. Despite two first-half scores from Evie Gallagher, the visitors’ attack proved unstoppable, running in 10 tries in total. Layla Sae and Amy Du Plessis helped extend the lead before half-time, ensuring a comfortable start to the tournament ahead of next Saturday's fixture against England."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "467": {
      "date": "2026-09-20",
      "edition": "Sunday 20 September",
      "sections": [
        {
          "kicker": "Team news",
          "heading": "Rassie Erasmus releases Pieter-Steph du Toit and Damian de Allende early",
          "body": "Coach Rassie Erasmus has confirmed that key duo Pieter-Steph du Toit and Damian de Allende will return home to South Africa ahead of the upcoming one-off Test in Perth. Erasmus explained that the pair required a break following their demanding workload throughout the recent Rugby’s Greatest Rivalry series against the All Blacks. The coach remains confident that there is sufficient depth within the travelling squad to cover their absence for the assignment at Optus Stadium."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
}