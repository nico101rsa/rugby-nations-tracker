  "digests": {
    "28": {
      "date": "2026-11-27",
      "edition": "Friday 27 November",
      "sections": [
        {
          "kicker": "Opposition view",
          "heading": "Italy coach Gonzalo Quesada rates Fiji's physicality impressive ahead of Twickenham rematch",
          "body": "Quesada told his pre-match press conference that playing the same side twice helps preparation, though he reminded listeners rugby is not purely physical. The Italian federation's own review of Fiji's 21-16 win in Udine last weekend credits the visitors with slowing Azzurri rucks and winning several turnovers at the breakdown. Jake White has since made nine changes for today's 11th-place final at Twickenham. He starts Tamani and Muntz at half-back and hands the front row to Ravuiwasa, Narisia and Nairau."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa lose Pieter-Steph du Toit to injury for final",
          "body": "France's Thomas Ramos reportedly returns at fullback against Springboks. Former England scrum-half Nigel Starmer-Smith dies. Wales hand Dafydd Jenkins captaincy as Dewi Lake drops to bench."
        }
      ],
      "match": {
        "venue": "Allianz Stadium Twickenham, London"
      },
      "source": {
        "name": "Federazione Italiana Rugby"
      }
    },
    "386": {
      "date": "2026-11-27",
      "edition": "Friday 27 November",
      "sections": [
        {
          "kicker": "Tribute",
          "heading": "Former England scrum-half and Rugby Special presenter Nigel Starmer-Smith dies aged 81",
          "body": "His family announced the death on Thursday. A Harlequins and Barbarians scrum-half, Starmer-Smith made seven appearances for England between 1969 and 1971 before moving into the media, where he fronted the BBC's weekly highlights programme Rugby Special for 15 years. He had been diagnosed with dementia in 2015. His son Charlie called him \"one of life's great tourists\" — a player, commentator, editor, writer and charity fundraiser who would \"hate for people to make a fuss.\""
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa lose Pieter-Steph du Toit to injury for final",
          "body": "France's Thomas Ramos reportedly returns at fullback against Springboks. Wales hand Dafydd Jenkins captaincy as Dewi Lake drops to bench."
        }
      ],
      "match": {
        "venue": "Allianz Stadium Twickenham, London"
      }
    },
    "387": {
      "date": "2026-11-27",
      "edition": "Friday 27 November",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Thomas Ramos set to return at fullback for France against Springboks",
          "body": "Rugbyrama reports that Ramos will start at No. 15 in Sunday's Nations Championship final against the Springboks at Twickenham, with the official team due on Friday. Toulouse's goal-kicker has not played since 27 September. A thigh injury and then a relapse cost him France's three earlier November tests, including the 21-19 win over South Africa. Aaron Grandidier-Nkanang's ankle sprain, picked up against Argentina, and Romain Ntamack's unavailability shaped the call: Théo Attissogbe moves to the wing to make room."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa lose Pieter-Steph du Toit to injury for final",
          "body": "Former England scrum-half Nigel Starmer-Smith dies. Wales hand Dafydd Jenkins captaincy as Dewi Lake drops to bench."
        }
      ],
      "match": {
        "venue": "Twickenham, London"
      },
      "source": {
        "name": "Rugbyrama"
      }
    },
    "388": {
      "date": "2026-11-27",
      "edition": "Friday 27 November",
      "sections": [
        {
          "kicker": "Fly-half call",
          "heading": "Farrell hands Sam Prendergast fourth November start at No. 10 against Australia",
          "body": "Prendergast has started all three November games, and Farrell resisted the case for Ciarán Frawley, again on the bench, saying the 23-year-old Leinster man has \"got his mojo back and is playing some excellent rugby,\" and wants to see him back it up. The shirt opened up with Jack Crowley sidelined: the Munster out-half remains out with a vascular issue in his leg but was in camp before the Springbok win and has begun a gradual return that Farrell insists will not be rushed."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa lose Pieter-Steph du Toit to injury for final",
          "body": "France's Thomas Ramos reportedly returns at fullback against Springboks. Former England scrum-half Nigel Starmer-Smith dies. Wales hand Dafydd Jenkins captaincy as Dewi Lake drops to bench."
        }
      ],
      "match": {
        "venue": "Twickenham, London"
      },
      "source": {
        "name": "The42"
      }
    },
    "389": {
      "date": "2026-11-27",
      "edition": "Friday 27 November",
      "sections": [
        {
          "kicker": "Attitude audit",
          "heading": "Gonzalo Quesada calls out Italy's attitude against South Africa, Australia and Wales",
          "body": "Against the Springboks, the Italy coach said, his side did not even believe they could compete. He also singled out the Australia match and passages against Wales as moments when Italy were not themselves. Speaking before the 11th-place final against Fiji at Twickenham, Quesada said he was dissatisfied with results but calm and clear-headed: the defeats to Argentina and Fiji showed Italy can build the conditions to win, only to fall short of finishing the job. What is missing, he added, is a little confidence."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa lose Pieter-Steph du Toit to injury for final",
          "body": "France's Thomas Ramos reportedly returns at fullback against Springboks. Former England scrum-half Nigel Starmer-Smith dies. Wales hand Dafydd Jenkins captaincy as Dewi Lake drops to bench."
        }
      ],
      "match": {
        "venue": "Allianz Stadium, Twickenham"
      },
      "source": {
        "name": "Federazione Italiana Rugby"
      }
    },
    "390": {
      "date": "2026-11-27",
      "edition": "Friday 27 November",
      "sections": [
        {
          "kicker": "Pumas rivalry",
          "heading": "Scotland take on Argentina at Twickenham after trading wins over past year",
          "body": "Sunday's Twickenham warm-up act to the France–South Africa grand final pits fourth from the northern hemisphere against fourth from the south. Gregor Townsend's side lost at home to the Pumas last November before winning in Argentina in July. Scotland arrive off an 11-try, 67-5 rout of Japan, though BBC Scotland's Tom English singled out the seven penalties they conceded in that game's first half as the soft moments stronger opponents punish."
        },
        {
