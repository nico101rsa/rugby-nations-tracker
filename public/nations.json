  "digests": {
    "28": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "Nations Championship",
          "heading": "Fiji drop to bottom of Nations Championship log after Scotland defeat",
          "body": "Fiji go into the weekend bottom of the Nations Championship log after a 17-33 loss against Scotland in Round 3. The Flying Fijians have failed to secure a victory in their opening three tournament matches. They have conceded 145 points in those three games, while scoring 49 points in the same three-match window. Attention now turns to their next fixture against France, who defeated Fiji 34-21 in November 2025."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "Contract debate",
          "heading": "Ben Youngs accuses RFU of having 'blinkers on' over Steve Borthwick's contract",
          "body": "Former England scrum-half Ben Youngs has criticised the RFU for extending Steve Borthwick's contract, claiming performance director Conor O'Shea has \"some blinkers on.\" The RFU handed Borthwick an extension through to the end of the 2028 Six Nations, despite a 2026 campaign featuring five Test defeats, including a first-ever loss to Italy. Speaking on the *For The Love Of Rugby* podcast, Youngs questioned the timing of the decision ahead of next year's World Cup, warning that union bosses remain accountable if the campaign fails."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "Scoring statistics",
          "heading": "France surpass 400 points across their last 11 international test matches",
          "body": "In their last 11 outings, Les Bleus have registered 426 points while conceding 291, a run that highlights the side's clinical offensive form. This sequence yields an average scoreline of 39-27 in favour of Fabien Galthié's men. The most prolific performance within this window remains the 54-12 victory away to Wales during the Six Nations in February 2026, which stands as their largest winning margin of the year."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "Tommy O’Brien",
          "heading": "Tommy O’Brien targets 2027 World Cup after injury-enforced Nations Championship absence",
          "body": "Leinster back Tommy O’Brien has set his sights on the 2027 World Cup after a groin injury forced him to miss Ireland’s recent Nations Championship tour. O’Brien, who earned nine caps during a breakthrough season featuring tries against England and Scotland, was sidelined after sustaining the injury during the United Rugby Championship final at Croke Park. Despite the setback, the 28-year-old remains determined to reach his peak for the tournament in Australia, describing the prospect as the \"pinnacle of my career\" following his 11th-hour omission from the squad."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "Form guide",
          "heading": "Italy suffer fourth consecutive defeat after 10-57 loss away against Australia",
          "body": "Italy have recorded one win and four defeats across their last five international fixtures. The side currently endure a run of four straight losses, including a 10-57 defeat away against Australia in their most recent Nations Championship match. This sequence of results leaves the team sitting 11th in the tournament standings, having failed to secure a victory in their opening three games. Italy remain without a win in the competition as they prepare for their round four meeting with South Africa."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "Squad update",
          "heading": "Gregor Townsend's men's squad remains unchanged as focus turns to New Zealand",
          "body": "There is no fresh news regarding Gregor Townsend’s men's squad in today’s press as the Scottish media focuses on the women’s WXV campaign. Following their 33-17 victory over Fiji, Scotland currently sit fifth in the standings with two wins from three matches. No injury concerns or selection changes were reported this morning, suggesting the settled group that finished the Fiji match will be preserved for the upcoming Test against New Zealand."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "Injury boost",
          "heading": "Ben Carter cleared for season start following Nations Championship ankle injury",
          "body": "Ben Carter is fit for the United Rugby Championship season after recovering from the ankle injury that curtailed his Nations Championship campaign. The Dragons lock, who started six consecutive Tests for Wales before being sidelined in July, has avoided surgery and is expected to feature in his club’s opener on 25 September. Defence coach Dale MacLeod confirmed Carter is in the \"best nick\" he has seen, providing Steve Tandy with a key reinforcement ahead of the November meeting with Japan."
        }
      ],
      "match": {
        "venue": "Principality Stadium, Cardiff"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "Series review",
          "heading": "Argentina reflects on series draw as focus turns to Ireland challenge",
          "body": "Following the hard-fought 28-28 draw in Mendoza last weekend, Argentina’s two-match series against Australia has officially concluded. Despite the result, Los Pumas showed resilience by holding firm during the final quarter while two men down. With the series now behind them, the squad’s attention shifts to their upcoming Round 4 fixture against Ireland. Coach Felipe Contepomi will look to build on the grit displayed in the series finale as the team prepares for the next phase of the international calendar."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      },
      "rung": "storyline"
    },
    "461": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "Coaching transition",
          "heading": "James Slipper pauses playing career to join the Brumbies coaching staff",
          "body": "Wallabies centurion James Slipper has been appointed as the Brumbies' new scrum coach on a temporary basis. The 154-Test veteran, who recently signed a one-year contract extension, will step away from on-field duties during the upcoming Super Rugby AUS campaign to focus on his new role. Slipper, the most capped prop in international history, aims to mentor the next generation of forwards while maintaining his status as an emergency option for the Wallabies' 2027 World Cup squad."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "Pacific Nations Cup",
          "heading": "Eddie Jones targets Japan cup glory against USA in Osaka semifinal",
          "body": "Japan host the USA in the Asahi Super Dry Pacific Nations Cup semifinal this weekend, with Eddie Jones aiming to secure his first title since taking charge. Despite trailing Fiji in the standings for the last two years, the hosts enter the fixture as favourites, backed by a dominant recent record of nine victories in their last 10 encounters with the Eagles. Jones will look to capitalise on home advantage at Hanazono Rugby Stadium as Japan seek to progress to the final."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Richie Mo'unga returns as Dave Rennie reshuffles for Baltimore Test finale",
          "body": "Richie Mo'unga will make his first Test appearance since the 2023 World Cup final after being named to start at fly-half against the Springboks in Baltimore. Following tour-ending injuries to Ardie Savea, Luke Jacobson and Quinn Tupaea, head coach Dave Rennie has confirmed Codie Taylor will captain the side. Rennie noted that the changes were planned, stating: “Every player here has worked incredibly hard over the last seven weeks to prepare the team for the seven games we’ve played so far.”"
        }
      ],
      "match": {
        "venue": "M&T Bank Stadium, Baltimore"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-09-11",
      "edition": "Friday 11 September",
      "sections": [
        {
          "kicker": "Centenary milestone",
          "heading": "Rassie Erasmus reaches 100 Tests in charge of the Springboks",
          "body": "Rassie Erasmus will oversee his 100th Test as Springbok boss in this weekend’s series finale in Baltimore. Erasmus has served as head coach for 60 Tests across two spells, having previously guided the team as director of rugby during Jacques Nienaber’s 39-Test tenure. Since 2018, the Springboks have maintained a 73.7% win rate under his oversight, securing back-to-back World Cup titles and three Rugby Championship trophies, and he now seeks to celebrate this century with a series victory."
        }
      ],
      "match": {
        "venue": "M&T Bank Stadium, Baltimore"
      },
      "source": {
        "name": "SA Rugby Magazine"
      }
    }
  }
