  "digests": {
    "28": {
      "date": "2026-11-29",
      "edition": "Sunday 29 November",
      "sections": [
        {
          "kicker": "White's blueprint",
          "heading": "Jake White hails Fiji as rugby's 'Harlem Globetrotters' and predicts World Cup improvement",
          "body": "Speaking after Friday's 23-21 defeat by Italy at Twickenham, White described his squad as “the Harlem Globetrotters of world rugby” and said his task is to blend that flair with lessons from coaching in South Africa, France, Japan and at the Brumbies. His first fixes are stopping mauls and building a scrum that stops conceding penalties. That is pointed, given a scrum penalty set up Tommaso Allan's winning kick. He predicted Fiji will be much better by next October's World Cup in Australia, citing a two-and-a-half-month training camp."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa's Manie Libbok replaces Feinberg-Mngomezulu at fly-half for final",
          "body": "Wales beat Japan 40-10 in Nations Championship play-off. Italy's Tommaso Menoncello has shoulder surgery, likely out of Six Nations."
        }
      ]
    },
    "386": {
      "date": "2026-11-29",
      "edition": "Sunday 29 November",
      "sections": [
        {
          "kicker": "Itoje revival",
          "heading": "Sam Warburton hails Borthwick's Itoje sabbatical call as 'a stroke of genius'",
          "body": "Writing in The Times, the former Lions captain credited Borthwick with suggesting the break that kept Itoje out of July's Tests against South Africa, Fiji and Argentina. That gave a lock who had not had a full pre-season in more than a decade time away from the international grind. “Maro has simply been on fire this autumn.” Warburton pointed to the 37-12 pool win over New Zealand, in which Itoje made 49 ruck entries. Ollie Chessum was next highest with 31."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa's Manie Libbok replaces Feinberg-Mngomezulu at fly-half for final",
          "body": "Wales beat Japan 40-10 in Nations Championship play-off. Italy's Tommaso Menoncello has shoulder surgery, likely out of Six Nations."
        }
      ],
      "match": {
        "venue": "Allianz Stadium, Twickenham, London"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-11-29",
      "edition": "Sunday 29 November",
      "sections": [
        {
          "kicker": "Front-row gamble",
          "heading": "Planet Rugby backs Galthié's all-Bordeaux front-row to beat Springboks in final",
          "body": "The all-Bordeaux trio of Jefferson Poirot, Maxime Lamothe and Sipili Falatea start together in Sunday's Nations Championship final at Twickenham, with Jean-Baptiste Gros and Peato Mauvaka held back for the last half-hour. Planet Rugby reads it as a side picked to win the collisions and breakdown before a powerful bench finishes the job. It also says South Africa, shorn of Pieter-Steph du Toit, need a perfect storm. A fortnight ago in Paris, France scored three first-half tries to lead 21-7 before hanging on to win 21-19."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa's Manie Libbok replaces Feinberg-Mngomezulu at fly-half for final",
          "body": "Wales beat Japan 40-10 in Nations Championship play-off. Italy's Tommaso Menoncello has shoulder surgery, likely out of Six Nations."
        }
      ],
      "match": {
        "venue": "Allianz Stadium, Twickenham"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "388": {
      "date": "2026-11-29",
      "edition": "Sunday 29 November",
      "sections": [
        {
          "kicker": "Defensive graft",
          "heading": "Nick Timoney praises Ireland's instant rebound in 215-tackle win over Wallabies",
          "body": "Friday's 38-14 win at Twickenham began with Australia holding more than 90% possession before Jeremy Williams burrowed over for a 7-0 lead. Robbie Henshaw's try levelled it within minutes. \"That's massive,\" Timoney said of the instant reply, adding: \"It didn't come all that naturally.\" Ireland made 215 tackles to the Wallabies' 129. From 11 entries to the 22 apiece, Andy Farrell's side scored five tries and a penalty, while Les Kiss's men were limited to two tries."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa's Manie Libbok replaces Feinberg-Mngomezulu at fly-half for final",
          "body": "Wales beat Japan 40-10 in Nations Championship play-off. Italy's Tommaso Menoncello has shoulder surgery, likely out of Six Nations."
        }
      ],
      "source": {
        "name": "RTÉ Sport Rugby"
      }
    },
    "389": {
      "date": "2026-11-29",
      "edition": "Sunday 29 November",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Tommaso Menoncello to have shoulder surgery, likely out of Italy's Six Nations",
          "body": "The Toulouse centre's shoulder gave way again in training, leaving no option but an operation. He first damaged it in a mid-October Champions Cup tie against Exeter, an acromioclavicular sprain. After a month and a half of conservative treatment he was back in training and looked close to playing. OnRugby puts the lay-off at three to four months. Even on the shortest timeline he would return in late February or early March without match minutes, which it judges too late to risk for the closing rounds."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa's Manie Libbok replaces Feinberg-Mngomezulu at fly-half for final",
          "body": "Wales beat Japan 40-10 in Nations Championship play-off."
        }
      ],
      "source": {
        "name": "OnRugby"
      }
    },
    "390": {
      "date": "2026-11-29",
      "edition": "Sunday 29 November",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Finn Russell returns at fly-half as Townsend makes 11 changes for Argentina",
          "body": "Rory Darge is back from injury to captain the side, with only four starters from the 67-5 rout of Japan keeping their places, Jamie Dobie among them at scrum-half inside the returning Russell. With the squad's number eights injured, Magnus Bradbury gets his chance in the back row; Townsend called it \"a big opportunity for him ahead of the Six Nations.\" Rory Hutchinson starts at 12, forming a centre pairing with Huw Jones that the coach likens to Sione Tuipulotu and Jones."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa's Manie Libbok replaces Feinberg-Mngomezulu at fly-half for final",
          "body": "Wales beat Japan 40-10 in Nations Championship play-off. Italy's Tommaso Menoncello has shoulder surgery, likely out of Six Nations."
