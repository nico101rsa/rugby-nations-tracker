    "28": {
      "date": "2026-11-09",
      "edition": "Monday 9 November",
      "sections": [
        {
          "kicker": "Fourth straight loss",
          "heading": "Vinaya Habosi scores in Fiji's fourth straight defeat, 54-17 to France",
          "body": "Fiji lost 54-17 in Lyon, a fourth straight defeat in the inaugural Nations Championship, but Vinaya Habosi beat four defenders to score and Selestino Ravutaumada added a second consolation try. Jake White's side, who started with ten France-based players, were typically physical yet trailed 26-3 at the break. Mesake Vocevoce's sin-bin for collapsing a maul added to the damage, and Jiuta Wainiqolo, playing in his adopted home, could not make an impact."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa thrash Italy 66-7",
          "body": "England's Immanuel Feyi-Waboso limps off with leg injury. France's Hastoy, Jalibert and Ramos all injured ahead of Springboks."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "386": {
      "date": "2026-11-09",
      "edition": "Monday 9 November",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Immanuel Feyi-Waboso and Seb Atkinson limp off in England's Australia win",
          "body": "Immanuel Feyi-Waboso limped off at half-time with a leg injury after repeatedly punching holes in Australia's defence, and Henry Pollock moved onto the wing to replace him. Seb Atkinson also limped off, which The42 described as a setback, and Planet Rugby reports Feyi-Waboso never returned for the second half. Today's coverage gives no diagnosis for either player, so their availability for Saturday's game against Japan is unclear."
        },
        {
          "kicker": "Around the world",
          "heading": "South Africa thrash Italy 66-7",
          "body": "France's Hastoy, Jalibert and Ramos all injured ahead of Springboks."
