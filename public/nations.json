  "digests": {
    "28": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "Tragedy",
          "heading": "Fijian rugby player Saimoni Vunilagi dies after suspected training heatstroke",
          "body": "The Fijian rugby community is mourning the tragic passing of 26-year-old player Saimoni Vunilagi, who died in a Fukuoka City hospital following a training session. His Japanese second-division club, Kyushu KV, confirmed that Vunilagi developed symptoms of severe heatstroke after training on Monday 3 August and succumbed on Friday. Kyushu KV released a statement saying, 'The players, staff, and all team associates are devastated by this sudden news.' No further details have been disclosed amid soaring summer temperatures in Japan."
        }
      ]
    },
    "386": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "LEADERSHIP RETURN",
          "heading": "Maro Itoje returns to England training squad ahead of Nations Championship",
          "body": "Maro Itoje has rejoined England for a three-day alignment camp at Pennyhill Park after missing July’s fixtures to recover from a taxing season. The 102-cap Saracens lock is expected to reclaim the captaincy from Jamie George, who remains in the 36-man group despite a groin injury. While Steve Borthwick has integrated uncapped talent like Charlie Bracken—a late replacement for the ill Archie McParland—he has omitted Courtney Lawes and Joe Marchant, requiring the pair to prove their form in the Premiership first."
        }
      ],
      "match": {
        "venue": "Allianz Stadium, Twickenham"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "TOP 14 RETURN",
          "heading": "Antoine Hastoy secures 30-27 La Rochelle win over champions Toulouse after hooter",
          "body": "Les Bleus fly-half Antoine Hastoy underscored France’s domestic depth by kicking a last-minute penalty to earn La Rochelle a 30-27 victory over Toulouse. The Sunday night clash headlined a high-scoring opening weekend for the Top 14, which also saw Bordeaux rout Racing 92 64-5. While the Nations Championship table shows France in third place following their win over Japan, pundits argue the sheer intensity of the French league—highlighted by Charles Ollivon’s return for Toulon—keeps the national side uniquely prepared to rival the world-leading Springboks."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "388": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "Form scrutiny",
          "heading": "Van der Flier rejects claims Ireland are treading water after defeat",
          "body": "Josh van der Flier has dismissed suggestions that Andy Farrell’s squad are \"treading water\" following their 21-40 loss to New Zealand in Round 3. Speaking at a jersey launch, the back-rower claimed he had not seen much of the negative talk surrounding Ireland’s current form or their world ranking. Despite a sobering performance in Auckland, Van der Flier described watching recent southern hemisphere Tests as a \"neutral\" experience, prioritising recovery before the November meeting with Argentina."
        }
      ],
      "match": {
        "venue": "Aviva Stadium, Dublin"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "EQUIPMENT TRIAL",
          "heading": "Women’s rugby players criticise smaller ball trial ahead of WXV series",
          "body": "The trial of a smaller ball in women’s international rugby has encountered significant resistance from players as the WXV Global Series approaches. Athletes have criticised the change, with some describing the equipment pilot as the \"worst decision ever\" for the professional game. Concerns persist that the smaller ball makes technical execution more difficult for specialists. The trial will continue through the October WXV fixtures before World Rugby determines whether to adopt the smaller ball size permanently for all women's Test matches."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "Ball trial",
          "heading": "Scotland Women must adapt to technical changes following ball trial expansion",
          "body": "World Rugby’s decision to expand the trial of a smaller ball into the WXV Global Series has sparked significant backlash across the game. While intended to improve handling, England head coach John Mitchell weighed in on the controversial initiative, while some players claimed the change makes it \"harder to do my job\" on the field. For Scotland, the shift introduces a major technical adjustment ahead of the September tournament, forcing players to recalibrate their skills during a critical international window."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "CARTER FITNESS",
          "heading": "Ben Carter recovers from ankle injury to boost Wales’ pack options.",
          "body": "Wales lock Ben Carter has been cleared to return for the Dragons’ domestic opener after recovering from an ankle injury. The 25-year-old sustained the blow during training prior to July’s 43-0 loss against South Africa, forcing him to miss the final Nations Championship round on crutches. Dragons defence coach Dale MacLeod confirmed the co-captain is in the \"best nick\" after avoiding surgery. Carter’s availability provides a significant physical boost for head coach Steve Tandy ahead of November’s Nations Championship fixtures."
        }
      ],
      "match": {
        "venue": "Principality Stadium, Cardiff"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "Series deadlock",
          "heading": "Argentina and Australia battle to draw in tense Mendoza Test match",
          "body": "Los Pumas secured a 28-28 stalemate against Australia in Mendoza, as the series concluded with the visitors claiming a historic victory. Trailing 14-0 early, Argentina clawed back through Pablo Matera’s brace and tries from Ignacio Mendy and Ignacio Ruiz. Despite playing the final stages with 13 men due to two yellow cards, the hosts denied Australia a series sweep. Wallabies captain Harry Wilson admitted the squad was hurting, as a late penalty try ultimately settled the hard-fought, error-riddled affair."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Carter Gordon sustains leg fracture, ruling playmaker out for two months",
          "body": "The Wallabies are expected to be without first-choice flyhalf Carter Gordon for approximately two months after scans confirmed a leg fracture sustained during Saturday's 28-28 draw with Argentina. The 25-year-old playmaker, who suffered the injury after attacking the line in Mendoza, will miss the upcoming Perth Test against the Springboks as well as the Bledisloe Cup series. Ben Donaldson and the returning Tom Lynagh are set to compete for the vacant No 10 jersey in the coming weeks."
        }
      ],
      "match": {
        "venue": "Optus Stadium, Perth"
      },
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "Eligibility rules",
          "heading": "Japan Rugby League One backtracks on proposed limits for naturalised players",
          "body": "There has been no further update in today's Japanese press regarding the proposed Japan Rugby League One player eligibility reforms. The situation remains unresolved since late last month, when officials rolled back proposed restrictions on naturalised and foreign-born players on 28 August. While the U-turn followed backlash from players and clubs, the official regulations for the 2026-2027 season have yet to be finalised and formally accepted, keeping the league's long-term category structures in limbo."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      },
      "rung": "storyline"
    },
    "465": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "Set-piece focus",
          "heading": "Neil Barnes demands set-piece improvement before final Springboks test match",
          "body": "Senior assistant coach Neil Barnes has challenged his squad to rectify their scrummaging woes ahead of the final test in Baltimore. Following last weekend’s defeat in Soweto, Barnes acknowledged that the Springboks currently maintain a \"pretty damn dominant\" set-piece, which has yielded a consistent flow of penalties for the world champions. While admitting the team is currently \"on the wrong side of the scoreboard,\" Barnes emphasised that the All Blacks must remain solution-based to alter the officials' perception and regain parity."
        }
      ],
      "match": {
        "venue": "M&T Bank Stadium, Baltimore"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "Series decider",
          "heading": "South Africa overcome All Blacks to take 2-1 Test series lead",
          "body": "South Africa secured a 29-24 victory over New Zealand in Soweto on Saturday, moving 2-1 ahead in the ‘Greatest Rivalry’ series. Tries from Kurt-Lee Arendse, Jesse Kriel, and Malcolm Marx, alongside a penalty try, powered a dominant final quarter after the hosts trailed at the break. Rassie Erasmus has since dismissed any defensive-first approach for the Baltimore finale, telling the media: “I think the important thing is we just have to score more points than them.”"
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    }
  }
}