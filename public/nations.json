  "digests": {
    "28": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "Tournament standings",
          "heading": "Fiji drop to twelfth in international standings after three consecutive defeats",
          "body": "Fiji currently occupy 12th place in the international table after failing to secure a victory in their opening three matches. Across these fixtures, the side has conceded 145 points. They have scored 49 points over the same period, leaving them with a points difference of minus 96. This run follows their last outing, which ended in a 17-33 defeat against Scotland in the third round. Despite this sequence, they hope to return to the heights of 2023, when they achieved their highest ever world ranking of No. 7."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "Recall warning",
          "heading": "Richard Wigglesworth warns Courtney Lawes and Joe Marchant over England recalls",
          "body": "England assistant coach Richard Wigglesworth has warned returning veterans Courtney Lawes and Joe Marchant that they must perform \"over and above\" their Premiership rivals to earn autumn recalls. Despite returning to England with Sale after spells in France, neither player was named in Steve Borthwick's 36-man training squad this week. Wigglesworth confirmed the door remains open, but stressed the duo must outshine incumbent squad members during the opening weeks of the domestic season to force their way back into Borthwick's plans."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "Ball trial",
          "heading": "France offer no fresh stance on controversial smaller rugby ball trial",
          "body": "Today's press provides no fresh updates or reaction from France regarding the controversial trial of a smaller ball in women's international rugby. While the trial remains a talking point in the wider media, there is no coverage of the French camp's stance today. The experiment is set to run through the September and October WXV Global Series before a final decision is made, meaning Les Bleues' views remain under wraps for now."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "388": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "Defiant response",
          "heading": "Josh van der Flier rejects claims that struggling Ireland are treading water",
          "body": "Ireland flanker Josh van der Flier has shrugged off suggestions that Andy Farrell’s side are treading water following a difficult run of results. Despite media scrutiny labelling Ireland’s third-place world ranking as a reflection of past glories rather than current form, the 33-year-old remains insulated from the criticism. While modelling the country's new Canterbury kit during his pre-season break, Van der Flier admitted he had not paid attention to the negative commentary. Instead, he focused on recharging ahead of November's international schedule."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "BALL SIZE TRIAL",
          "heading": "Italy await final decision on the controversial smaller rugby ball trial",
          "body": "The controversial trial of a smaller ball in women’s international rugby remains unresolved as teams prepare for the WXV Global Series. Debate has intensified following criticism that the change is unnecessary, with some claiming it makes playing harder, while Red Roses coach John Mitchell has also revealed his stance. The trial will continue through the tournament in September and October before a permanent decision is made. Italian coverage is silent on how the national squad views the ongoing trial."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "390": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "YOUTH DEVELOPMENT",
          "heading": "Sean Everitt bloods Edinburgh youngsters in narrow 26-28 defeat against Ulster",
          "body": "Edinburgh head coach Sean Everitt handed crucial opportunities to the club's academy graduates during a narrow 26-28 pre-season loss to Ulster at Hive Stadium. Despite the defeat, young prospects Geordie Gwynn, Hector Paterson, and Conor McAlpine all crossed for tries alongside senior prop Paul Hill. Player of the Match Jerry Blyth-Lafferty praised Everitt's willingness to reward hard work on the training field, highlighting a positive culture as both Scottish professional franchises focus on developing next-generation depth ahead of the United Rugby Championship."
        }
      ]
    },
    "391": {
      "date": "2026-09-08",
      "edition": "Tuesday 8 September",
      "sections": [
        {
          "kicker": "CARTER FITNESS",
          "heading": "Ben Carter recovers from ankle injury to boost Wales’ pack options.",
          "body": "Wales lock Ben Carter has been cleared to return for the Dragons’ domestic opener after recovering from an ankle injury. The 25-year-old sustained the blow during training prior to July’s 43-0 loss against South Africa, forcing him to miss the final Nations Championship round on crutches. Dragons defence coach Dale MacLeod confirmed the co-captain is in the \"best nick\" after avoiding surgery. Carter’s availability provides a significant physical boost for head coach Steve Tandy ahead of November’s Nations Championship fixtures."
        }
      ],
      "match": {
        "venue": "Principality Stadium, Cardiff"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "A-team fixture",
          "heading": "Argentina XV announce November tour clash against England 'A' at Bath",
          "body": "The Argentina XV will travel to face England 'A' for the first time in nearly two decades at Bath's Recreation Ground this November. The uncapped fixture, confirmed by organisers, will run in parallel with the senior national side's Nations Championship test against Ireland in Dublin. After finishing second in the recent Americas Rugby Championship, this developmental opportunity offers crucial exposure against northern hemisphere secondary selections, reviving a cross-hemisphere rivalry dormant since 2009."
        }
      ]
    },
    "461": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "Playmaker setback",
          "heading": "Carter Gordon fractures leg during Argentina draw to disrupt Wallabies' backline",
          "body": "The Wallabies' playmaking depth faces a severe test after first-choice fly-half Carter Gordon suffered a leg fracture during Sunday's 28-28 draw with Argentina in Mendoza. Scans confirmed the 25-year-old will miss around two months, ruling him out of the upcoming clash against South Africa and the Bledisloe Cup. Head coach Les Kiss must now choose between Ben Donaldson, who struggled to impress in Mendoza, and the fit-again Tom Lynagh, who is scheduled to return from a lengthy injury lay-off in Super Rugby AU this Saturday."
        }
      ],
      "match": {
        "venue": "Twickenham, London"
      },
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "Eligibility dispute",
          "heading": "Timothy Lafaele and fellow Japan stars settle League One eligibility court battle",
          "body": "Japan Rugby League One has revised its controversial player registration rules after reaching a court settlement with a group of 25 players. The legal challenge, spearheaded by high-profile Brave Blossoms internationals including Timothy Lafaele and Jiwon Gu, opposed a planned domestic split. Under the new agreement reached at the Tokyo District Court, the league introduced special measures, ensuring that any veteran with 30 or more test caps will be reclassified under the premier category."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "LEADERSHIP VACANCY",
          "heading": "Dave Rennie loses captain Ardie Savea as injuries force Baltimore rotation",
          "body": "Dave Rennie must name a new captain for Saturday’s series finale in Baltimore after Ardie Savea was ruled out with a shoulder injury. The All Blacks arrived in the United States following a gruelling journey from Johannesburg, with Luke Jacobson and Quinn Tupaea also sidelined following the third test. Rennie confirmed he will \"share the load\" to bring in players with fresh energy. Richie Mo’unga is under consideration to replace Ruben Love at fly-half, while Ethan de Groot and Josh Lord could return from concussion."
        }
      ],
      "match": {
        "venue": "M&T Bank Stadium, Baltimore"
      },
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Rassie Erasmus promotes Morné van den Berg to start against New Zealand",
          "body": "Rassie Erasmus has handed Morné van den Berg a start for Saturday’s series finale against New Zealand in Baltimore. The Lions scrum-half replaces Cobus Reinach, who drops to the bench, in one of only two changes to the starting line-up. Damian Willemse also returns to the XV to replace the injured Cheslin Kolbe. Erasmus explained that Van den Berg \"deserves a start\" following a strong cameo during the victory in Soweto as South Africa target a series victory on neutral ground."
        }
      ],
      "match": {
        "venue": "M&T Bank Stadium, Baltimore"
      },
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
}