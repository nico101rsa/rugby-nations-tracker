  "digests": {
    "28": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Form tracker",
          "heading": "Fiji concede more than they score across their last 11 matches",
          "body": "In their last 11 fixtures, Fiji have scored 315 points. Across that same 11-game window, the team has conceded 326 points. Fiji have averaged 28.6 points scored per match over those 11 games, while conceding 29.6 points per game in the same period. The biggest win of this 11-match span came in September 2025, when they beat Canada 63-10 at home during the Pacific Nations Cup knockout stage."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Captain's Sabbatical",
          "heading": "Maro Itoje feels rejuvenated after taking a break from England duty",
          "body": "England captain Maro Itoje has reflected on his summer sabbatical, describing the experience as a vital period for mental and physical recovery. After an intense campaign, head coach Steve Borthwick suggested the forward take time away, leading him to miss England’s July fixtures. Itoje confirmed he feels refreshed ahead of the new season, stating, “I don't regret it at all.” Having returned to his first full pre-season with Saracens since 2014, he is now targeting a strong return to the international stage."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "TRANSFER RUMOUR",
          "heading": "L'Équipe reports Thomas Ramos set for shock Toulouse exit to Racing 92",
          "body": "France full-back Thomas Ramos is reportedly considering a \"sensational\" departure from Toulouse after the 2027 Rugby World Cup, with Racing 92 his likely destination. According to L’Équipe, the move to Paris could see the France star transition to a primary fly-half role, a position he has frequently occupied at Test level but rarely for his club. Ramos has made 200 appearances for Toulouse, winning four league titles and two Champions Cups during an era of sustained domestic dominance."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "388": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Personal Reflection",
          "heading": "Former Ireland Lock Ryan Caldwell Opens Up On Life After Rugby",
          "body": "Former Ireland international Ryan Caldwell has shared a candid account of his transition from the professional game to his current role as a meditation teacher. In a recent interview, the 41-year-old discussed his journey through injury, addiction, and depression following a playing career that saw him represent Ulster, Bath, and Exeter. Caldwell, who is preparing to release an autobiography, detailed how he moved past his playing days to find peace and now supports others through breathwork and meditation techniques."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "389": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Disciplinary Sanction",
          "heading": "Gonzalo Quesada banned under World Rugby’s match official abuse process",
          "body": "Italy head coach Gonzalo Quesada has become the first individual sanctioned under World Rugby’s new Match Official Abuse Sanctioning Process. Following critical comments made regarding referee Luc Ramos after the loss to the All Blacks, the Argentine has been handed a two-Test suspension. This ruling prohibits him from all match-day proceedings, including stadium attendance, for the upcoming fixture against South Africa. While Quesada retains the right to appeal the decision, the governing body confirmed the ban remains in effect."
        }
      ]
    },
    "390": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Pathway development",
          "heading": "Scottish Rugby pathway graduates feature in Edinburgh and Glasgow season openers",
          "body": "As the 2026/27 season gets underway, several of Scotland’s most promising pathway graduates are set for significant exposure with their respective clubs. Following successful U20 campaigns, talents like Jerry Blyth-Lafferty, Euan McVie, and Rory McHaffie are integrating into the Edinburgh setup, while Glasgow Warriors have secured the services of their most-capped U20 player, Kerr Yule, on his first professional contract. These early-season opportunities provide a vital platform for these players to push for further professional and international recognition."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Selection Ambition",
          "heading": "Tom Rogers targets Wales recall following summer move to the Ospreys",
          "body": "After securing a move to the Ospreys this summer, Tom Rogers is focused on forcing his way back into the international fold. The versatile back, who famously scored a hat-trick against New Zealand in Cardiff, has not featured for his country since that record-breaking performance. Rogers admitted he was disappointed with his recent outing for the Barbarians, stating, \"I just need to play well with the Ospreys and show I deserve to be in the squad\" under new coach Steve Tandy."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Selection bombshell",
          "heading": "Australia makes nine changes to starting XV for Mendoza rematch",
          "body": "Wallabies coach Les Kiss has overhauled his side for the return fixture in Mendoza, making nine alterations to the team that won in San Salvador de Jujuy. Joseph-Aukuso Suaalii and Len Ikitau reunite in the midfield, while Ben Donaldson starts at flyhalf for the first time in two years. Australia aims to secure a historic two-Test series sweep on Argentine soil. Kiss noted, \"We’ve brought in some fresh bodies alongside some existing combinations as we continue to look to build Test experience.\""
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Selection Change",
          "heading": "Les Kiss shuffles Wallabies lineup as Tom Wright reaches 50 caps",
          "body": "Coach Les Kiss has made 9 alterations to the side for the Argentina rematch, including a milestone 50th appearance for full-back Tom Wright. Ben Donaldson returns at flyhalf to steer the attack, while captain Harry Wilson leads the side from the back of the scrum. Kiss noted the need for fresh bodies following a physical opening contest, stating, \"We’ve brought in some fresh bodies alongside some existing combinations as we continue to look to build Test experience across the group.\""
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Centenary Test",
          "heading": "Japan Brave Blossoms Host Canada to Celebrate JRFU Centenary Match",
          "body": "Japan host Canada at Denka Big Swan Stadium in Niigata City as part of the Lipovitan D Challenge Cup. The match marks the JRFU’s 100th anniversary, returning international rugby to the region for the first time in 18 years. Eddie Jones has made five changes to his side following their recent test against Australia, with Inoke Burua set to make his debut. Japan are ranked 12th globally, while Canada arrive in Niigata currently sitting 24th in the world rankings."
        }
      ],
      "match": {
        "venue": "Denka Big Swan Stadium, Niigata City"
      },
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Ardie Savea ruled out of fourth test after suffering shoulder injury",
          "body": "All Blacks captain Ardie Savea will miss next Saturday’s fourth test in Baltimore after sustaining a shoulder injury during yesterday’s 29-24 defeat at FNB Stadium. Savea, who scored two first-half tries, left the field in the 30th minute and will not travel with the squad to the United States. His absence creates a significant leadership and tactical void for Dave Rennie’s side as they look to salvage a 2-2 series draw in the final outing of the rivalry."
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-06",
      "edition": "Sunday 6 September",
      "sections": [
        {
          "kicker": "Series triumph",
          "heading": "South Africa edge New Zealand 29-24 to take home-leg series lead",
          "body": "South Africa secured a hard-fought 29-24 victory against New Zealand in Saturday's third Test at FNB Stadium to take a 2-1 series lead. The encounter lived up to its billing as a thriller, with both sides crossing for 4 tries. After a deadlocked 12-12 half-time score, the hosts surged ahead through second-half efforts from Jesse Kriel and Malcolm Marx. A late penalty from Sacha Feinberg-Mngomezulu proved decisive before New Zealand added a final consolation score after the clock turned red."
        }
      ],
      "match": {
        "venue": "FNB Stadium, Johannesburg"
      },
      "source": {
        "name": "Guardian Rugby Union"
      }
    }
  }
