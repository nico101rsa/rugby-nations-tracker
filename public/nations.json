    "28": {
      "date": "2026-11-07",
      "edition": "Saturday 7 November",
      "sections": [
        {
          "kicker": "Player talk",
          "heading": "Fiji's Wainiqolo relishing speed duel with France's Bielle-Biarrey in Lyon",
          "body": "Fiji's Wainiqolo is relishing the prospect of facing Bielle-Biarrey, France's fellow speedster, in Lyon on Saturday. Fiji arrive after losing 39-24 to Wales in Cardiff and 73-8 to England, both in July, under coach Jake White, who was appointed after Senirusi Seruvakula's interim spell. Planet Rugby's preview expects France to use their attacking excellence to test a Fiji side it describes as having an underwhelming start to the Nations Championship."
        },
        {
          "kicker": "Around the world",
          "heading": "England captain Itoje returns; Fin Smith starts at fly-half",
