      }
    },
    "387": {
      "date": "2026-10-15",
      "edition": "Thursday 15 October",
      "sections": [
        {
          "kicker": "Women's fixture",
          "heading": "France women to meet Lions women in Cardiff in historic first match",
          "body": "France women will face the British and Irish Lions women in a historic first at Cardiff's Principality Stadium before the Lions' 2027 tour to New Zealand. Jo Yapp, the Lions head coach, leads a side facing the French, who are ranked fourth in the world. It is only the second meeting between the Lions and France, after the men won a friendly in Paris in 1989. Lions women's committee chair Carol Isherwood hopes for a sea of red in the stadium, not just Wales."
        },
        {
          "kicker": "Around the world",
          "heading": "Fiji hire Jake White as head coach after Mick Byrne's removal",
          "body": "Wallabies' Nawaqanitawase out of UK Nations Championship Tests. All Blacks call in replacements for injured Bledisloe squad players."
        }
      ],
