    "388": {
      "date": "2026-11-05",
      "edition": "Thursday 5 November",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Andy Farrell hands Nick Timoney and Craig Casey starts against Argentina",
          "body": "Timoney starts at openside and Casey at scrum-half for the Nations Championship clash with Argentina at the Aviva Stadium, Dublin, and Sam Prendergast is fit to start at fly-half after the wrist injury that had him in doubt. Andrew Porter, Ryan Baird and Mack Hansen all return from injuries that kept them out of the green jersey for a year. Sean Jansen wins only his second Test start, at number eight, with Caelan Doris and Jack Conan absent, and Garry Ringrose is sidelined."
        },
        {
          "kicker": "Around the world",
          "heading": "England's Borthwick handed contract extension despite Six Nations slump",
          "body": "Argentina's Mallía returns from ruptured knee ligaments. Wallabies recall Kurtley Beale for northern tour."
