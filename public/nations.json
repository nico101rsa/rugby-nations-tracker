  "digests": {
    "28": {
      "date": "2026-11-15",
      "edition": "Sunday 15 November",
      "sections": [
        {
          "kicker": "Coaching ambition",
          "heading": "Jake White dreams of Fiji hosting Ireland in a Suva Test match",
          "body": "In an interview with The42 this week, Jake White sets out a bigger ambition for Fiji: a Test in Suva against Ireland would be the best of all. It is a notable hope, since Fiji's Nations Championship home games this summer were played on UK soil, their national stadium not considered of a suitable standard for regular Tests. White, who beat Warren Gatland and Shaun Edwards to the job last month, is working towards a more consistent side for next year's World Cup in Australia."
        },
        {
          "kicker": "Around the world",
          "heading": "Wales end 73-year All Blacks drought",
          "body": ""
        }
      ],
      "source": {
        "name": "The42"
      }
    },
    "386": {
      "date": "2026-11-15",
      "edition": "Sunday 15 November",
      "sections": [
        {
          "kicker": "Broadcast row",
          "heading": "Fans rage as ITV runs split-screen adverts during England's Japan rout",
          "body": "Split-screen adverts during ITV's coverage of Saturday's England v Japan game drew complaints on X, with viewers saying the breaks spoiled the experience. \"This is not America.\" one wrote, while another objected to \"watching rugby union, not the NFL.\" One viewer said the broadcaster cut away from a TMO check for an advert, and others defended the ads, arguing that rugby's finances left it in no position to be choosy."
        },
        {
          "kicker": "Around the world",
          "heading": "Wales end 73-year All Blacks drought",
          "body": ""
        }
      ]
    },
    "387": {
      "date": "2026-11-15",
      "edition": "Sunday 15 November",
      "sections": [
        {
          "kicker": "Match report",
          "heading": "Antoine Dupont inspires France to end South Africa run with 21-19 win",
          "body": "France ended a five-match losing run against South Africa at Stade de France on Friday, winning 21-19 after three first-half tries from Aaron Grandidier-Nkanang, Theo Attissogbe and Louis Bielle-Biarrey. Antoine Dupont, named player of the match, gathered the ball that sealed it after Bielle-Biarrey's huge defensive tackle forced a loose ball late on. Manie Libbok had missed the conversion to Malcolm Marx's try that would have levelled the game. The win leaves France six points clear at the top of the northern hemisphere standings before Argentina next Saturday."
        },
        {
          "kicker": "Around the world",
          "heading": "Wales end 73-year All Blacks drought",
          "body": ""
        }
      ],
      "match": {
        "venue": "Stade de France, Saint-Denis"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "388": {
      "date": "2026-11-15",
      "edition": "Sunday 15 November",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Andy Farrell restored Jamison Gibson-Park as Ireland made seven changes against Fiji",
          "body": "Injuries to Dan Sheehan and Sean Jansen forced two of Saturday's changes, while Joe McCarthy and Hugo Keenan were rested from the matchday squad. Jamison Gibson-Park returns as first-choice scrum-half, James Ryan and Tommy O'Brien come in, and Mack Hansen starts at fullback. The 42 judged the team less of an experiment than the number suggests, with James McNabney, Sam Illo and Darragh Murray adding depth on the bench before the South Africa match next week."
        },
        {
          "kicker": "Around the world",
          "heading": "England beat Japan 78-15 with Will Joseph among the tries",
          "body": "South Africa lose 21-19 to France. Argentina beat Italy 19-14 despite playing a man down."
        }
      ],
      "match": {
        "venue": "Aviva Stadium, Dublin"
      },
      "source": {
        "name": "The42"
      }
    },
    "389": {
      "date": "2026-11-15",
      "edition": "Sunday 15 November",
      "sections": [
        {
          "kicker": "Coaching verdict",
          "heading": "Felipe Contepomi says Italy dominated first half but failed to convert pressure",
          "body": "Argentina coach Felipe Contepomi conceded after the Genoa win that Italy had the better of possession and territory in the first half, but said matches like this are decided by who turns control into points. Monty Ioane's fourth-minute try gave the Azzurri the early lead, yet they could not convert sustained pressure, and Bautista Bernasconi's maul try before the break put Argentina ahead 7-5 at half-time. Italy's yellow cards for Joel Sclavi and Efrain Elias proved costly in the second half, and Argentina went on to win 19-14."
        },
        {
          "kicker": "Around the world",
          "heading": "Wales end 73-year All Blacks drought",
          "body": ""
        }
      ],
      "match": {
        "venue": "Stadio Luigi Ferraris, Genoa"
      },
      "source": {
        "name": "OnRugby"
      }
    },
    "390": {
      "date": "2026-11-15",
      "edition": "Sunday 15 November",
      "sections": [
        {
          "kicker": "Captain's motivation",
          "heading": "Tuipulotu says Scotland are set on bouncing back from All Blacks defeat",
          "body": "Scotland's next step after a 21-43 defeat by New Zealand at Murrayfield comes against Australia on Sunday, and captain Sione Tuipulotu says the footage makes hard viewing. Tuipulotu, who was born and raised in Melbourne, says the side missed big chances and let themselves down in certain areas. \"Our minds are firmly set on bouncing back after last week.\" He expects the Wallabies to arrive wounded after their beating by England at Twickenham, and says his own history with Australia adds a little fire."
        },
        {
          "kicker": "Around the world",
          "heading": "Wales end 73-year All Blacks drought",
          "body": ""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-11-15",
      "edition": "Sunday 15 November",
      "sections": [
        {
          "kicker": "Historic win",
          "heading": "Wales end 73-year All Blacks drought with 35-28 win in Cardiff",
          "body": "Wales were given little chance, and the decisive stretch came in the final quarter, when the defence led by James Botham, Jac Morgan and Dafydd Jenkins held New Zealand out after New Zealand flanker Peter Lakai's try had pulled the visitors within seven. Tomos Williams scored one of five Welsh tries and had a hand in all of them, with hooker Dewi Lake, Archie Griffin, Eddie James and Louis Rees-Zammit also crossing. Sections of the New Zealand media had belittled Welsh rugby beforehand."
        }
      ],
      "match": {
        "venue": "Principality Stadium, Cardiff"
      },
      "source": {
        "name": "The42"
      }
    },
    "460": {
      "date": "2026-11-15",
      "edition": "Sunday 15 November",
      "sections": [
        {
          "kicker": "Post-match verdict",
          "heading": "Felipe Contepomi credits Pumas' character after 19-14 Genoa win over Italy",
          "body": "Felipe Contepomi said the Pumas' 19-14 win in Genoa rested on character rather than control, with his side scoring a first-half try while a man down after a yellow card. The Argentina coach conceded that Italy had dominated possession and territory in the first half, stressing that in these matches converting and scoring is what counts. He described a squad still in construction, with two weeks together ahead of the trip to France."
        },
        {
          "kicker": "Around the world",
          "heading": "England beat Japan 78-15 with Will Joseph among the tries",
          "body": "South Africa lose 21-19 to France. Ireland's Dan Sheehan and Sean Jansen injured before South Africa test."
        }
      ],
      "source": {
        "name": "OnRugby"
      }
    },
    "461": {
      "date": "2026-11-15",
      "edition": "Sunday 15 November",
      "sections": [
        {
          "kicker": "Heavy defeat",
          "heading": "Wallabies swatted aside 45-22 by England at Twickenham, conceding seven tries",
          "body": "England scored seven tries in a 45-22 rout at Twickenham last weekend, and the Wallabies were taken apart in a performance the BBC described as listless. The defeat leaves Australia having lost three of their four Nations Championship matches and out of contention for the inaugural final. Sunday's visit to Murrayfield now carries the threat of a fourth straight Test defeat, against a Scotland side also seeking to bounce back from their defeat by New Zealand."
        },
        {
          "kicker": "Around the world",
          "heading": "Wales end 73-year All Blacks drought",
          "body": ""
        }
      ],
      "match": {
        "venue": "Murrayfield, Edinburgh"
      },
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "463": {
      "date": "2026-11-15",
      "edition": "Sunday 15 November",
      "sections": [
        {
          "kicker": "Player profile",
          "heading": "Warner Dearns co-captained Japan in Saturday's 78-15 defeat to England at Twickenham",
          "body": "Warner Dearns took a roundabout route to the Japan side. He was 14 when his father Grant took a strength and conditioning job with NEC Green Rockets, moving the family from New Zealand's North Island to a satellite city outside Tokyo, and he initially did not want to go. Kashiwa Senior High School turned him into a monster prospect, and he debuted for Japan in November 2021 at 19. This year he spent a sabbatical at the Hurricanes, helping Wellington to their first Super Rugby title in a decade."
