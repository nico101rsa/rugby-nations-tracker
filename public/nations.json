  "digests": {
    "28": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Transfer U-turn",
          "heading": "Joji Nasova stays with Fijian Drua after Newcastle contract release",
          "body": "Fijian wing Joji Nasova will remain with the Fijian Drua after Newcastle Red Bulls agreed to release him from his contract due to personal reasons. The 25-year-old, who won an Olympic sevens silver medal in Paris and has scored four tries in three appearances for Fiji, had signed to join the Premiership club. Newcastle general manager Neil McIlroy confirmed the release, stating the club \"fully understand and respect the unique personal circumstances that have led to this decision.\""
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "386": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Santiago fallout",
          "heading": "Ben Youngs urges World Rugby to punish Argentina after 'disgraceful' Santiago antics",
          "body": "Former England players Ben Youngs and Anthony Watson have called on World Rugby to issue bans following Argentina’s \"disgraceful, unforgivable behaviour\" during England’s 31-24 victory in Santiago. Speaking on the For The Love of Rugby podcast, Youngs condemned Los Pumas for confronting referee Angus Gardner and criticised Tomás Albornoz for striking Tommy Freeman in the face. With objects also thrown from the stands and head coach Felipe Contepomi storming out of his press conference, Youngs warned that the hostile attitude \"starts from the head guy\"."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Form guide",
          "heading": "France secure consecutive test victories to conclude their July international fixtures",
          "body": "France ended their July international fixtures with a run of two straight victories. In their last five matches, the team registered three wins. They also suffered two defeats over that same five-game period. The most recent result was a 42-15 away win against Japan in the Nations Championship group stage. Les Bleus have scored 116 points in the tournament. They have conceded 75 points so far."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Playmaker debate",
          "heading": "Brian O'Driscoll backed Jack Crowley as Ireland's premier fly-half after Auckland defeat",
          "body": "Jack Crowley's position as Ireland's premier fly-half remains unchallenged following Sam Prendergast's struggles in last weekend's 40-21 defeat to New Zealand. Sidelined since mid-April with a leg blood vessel injury, the first-choice playmaker watched as his understudy failed to secure the role in Auckland, prompting Brian O'Driscoll to label the performance a 'mixed bag'. Prendergast was targeted defensively by the All Blacks, missing six of his 22 tackle attempts, while also committing several handling errors."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "389": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "SPRINGBOK CHALLENGE",
          "heading": "Italy aim to avenge their 32-14 home defeat against South Africa",
          "body": "The Azzurri face South Africa in their next Nations Championship fixture, aiming to improve on their last encounter. During that single meeting in November 2025, Italy fell to a 32-14 home defeat against the Springboks. The team must rebuild after a difficult tournament campaign so far. In their last three matches, Italy have suffered three losses. They have conceded 131 points across those games, and they have scored 37 points of their own. Their latest fixture ended in a 10-57 defeat against Australia."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Bold claim",
          "heading": "Pierre Schoeman claims Scotland belong in the world's top five rugby nations",
          "body": "Following Scotland's 33-17 victory over Fiji to close their summer campaign, prop Pierre Schoeman rejected the idea that the national side are merely closing the gap on rugby's elite. \"I feel we are a top-three, top-five team in the world,\" the front-rower asserted, pointing to wins over France and England. While a narrow defeat in South Africa showed Scotland can match the world champions, Gregor Townsend's men still chase a defining statement victory. They sit second in the northern standings before the autumn tests."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "391": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Defiant stance",
          "heading": "Jac Morgan defends Wales progression after scoreless thrashing by South Africa",
          "body": "Wales flanker Jac Morgan has defended his side’s progress despite concluding their southern hemisphere Nations Championship tour with a scoreless 43-0 defeat against South Africa. The flanker, who made 22 tackles during the Durban drubbing, believes Steve Tandy’s squad are closing the gap on the world’s elite. Pointing to their opening 39-24 victory over Fiji, Morgan insisted, \"the more we play together, the more experience we gain and the more we can improve.\" Wales finished the three-match leg with a single win."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "460": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "MISCONDUCT CHARGE",
          "heading": "Tomás Albornoz faces World Rugby misconduct charges following loss to England",
          "body": "World Rugby has issued misconduct charges against Tomás Albornoz after the fly-half remonstrated with and made physical contact with referee Angus Gardner following last Saturday’s 31-24 loss to England. Former Test official Nigel Owens condemned the “totally, totally unacceptable” scenes in Santiago del Estero, which included spectators throwing objects at the officiating team. While Albornoz and his teammates protested the decision to deny Bautista Delguy a match-levelling try in the final moments, Owens backed Gardner’s call, suggesting the officials reached the correct conclusion under intense pressure."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Les Kiss retains Harry Wilson as captain and recalls Lukhan Salakaia-Loto",
          "body": "New head coach Les Kiss has signalled \"evolution not revolution\" by naming his first 34-man squad for next month's series against Japan. Harry Wilson remains captain despite speculation regarding Fraser McReight, while lock Lukhan Salakaia-Loto returns following what Kiss described as a robust conversation between the coaching staff. With Len Ikitau sidelined by injury, Reds centre Isaac Henry is the sole uncapped player included. Veteran James Slipper is the most significant omission, with the 154-Test veteran reportedly rested."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "SCORING METRICS",
          "heading": "Japan concede 334 points across last 11 games despite Tonga win",
          "body": "Japan have scored 278 points across their last 11 international fixtures. In that same window, the side have conceded 334 points to their opponents. This results in a per-match average of 25.3 points scored. Furthermore, the defence have shipped 30.4 points per game. The most significant result in this period remains the 62-24 victory over Tonga in September 2025. This offensive peak stands as the team’s biggest winning margin during the current 11-match cycle."
        }
      ],
      "rung": "data"
    },
    "465": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "Club move",
          "heading": "All Blacks legend Ma'a Nonu signs short-term Sharks deal in South Africa",
          "body": "All Blacks legend Ma'a Nonu has completed a surprise move to the Sharks, signing a short-term deal with the Durban-based franchise. The 44-year-old double World Cup winner arrives in South Africa following a second stint at Toulon, where he recently became the oldest player to feature in the Investec Champions Cup. Nonu, who joins his eighth professional club, is expected to provide veteran leadership and mentor young centres Jurenzo Julius and Ethan Hooker. The move follows a high-performance review at the franchise now led by JP Pietersen."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "467": {
      "date": "2026-07-25",
      "edition": "Saturday 25 July",
      "sections": [
        {
          "kicker": "SELECTION CALL",
          "heading": "Rassie Erasmus recalls Siya Kolisi and Handré Pollard while dropping Embrose Papier",
          "body": "Springboks head coach Rassie Erasmus has named a 43-man squad for upcoming Tests against Argentina and New Zealand, welcoming back 10 injury-recovered stars including Eben Etzebeth, Siya Kolisi, and Handré Pollard. Five players were released to their franchises, most notably Bulls scrum-half Embrose Papier. Despite Papier’s domestic form, Erasmus favoured Herschel Jantjies and the fit-again Morné van den Berg for the next phase. Erasmus explained that the side lacked \"wiele\" (pace), a quality Nick Mallett noted Jantjies provided during the recent 43-0 victory over Wales."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
}