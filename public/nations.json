  "digests": {
    "28": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "Ranking history",
          "heading": "Fiji sit bottom of the log following third consecutive defeat",
          "body": "Fiji sit bottom of the 12-team log after three rounds, having suffered a 17-33 defeat against Scotland in their last outing. The team have conceded 145 points across their three matches. They have scored 49 points in that same period — leaving them with a points difference of minus 96. This current run sits in stark contrast to the heights of 2023, when the Flying Fijians achieved their best world ranking of No. 7."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Richard Wigglesworth challenges Courtney Lawes and Joe Marchant to earn England recalls",
          "body": "Richard Wigglesworth has warned Courtney Lawes and Joe Marchant they must perform \"over and above\" their Premiership rivals to force their way back into the England squad. Both players joined Sale Sharks this summer after spells in France, restoring their eligibility for the upcoming autumn series. Despite Lawes’ status as a national legend, both were omitted from Steve Borthwick’s current 36-man training camp and have just five domestic fixtures to prove they warrant an international recall."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "387": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "Log standings",
          "heading": "France secure third in standings following dominant 42-15 victory over Japan",
          "body": "Les Bleus hold a record of three wins and two losses across their last five international fixtures. This recent sequence of results — W, W, L, W, L — includes a current run of two straight victories for the national side. The most recent of these came in July 2026 during the Nations Championship group stage, where France recorded a 42-15 away win against Japan. This leaves the squad third in the overall standings as the mid-year window concluded."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "Remembrance",
          "heading": "Former Ireland international Brian Smith dies aged 59 following cancer battle",
          "body": "The rugby community is mourning former Ireland and Australia international Brian Smith, who has passed away aged 59 following a battle with cancer. A versatile half-back, Smith earned nine caps for Ireland between 1989 and 1991 after previously representing the Wallabies six times. Following a career that spanned both union and league, he transitioned into coaching and served as an England assistant coach. Prop Angus Bell, who was mentored by Smith at school level, paid tribute to the Queensland native as an “avid rugby person.”"
        }
      ]
    },
    "389": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "Springbok clash",
          "heading": "Gonzalo Quesada’s Italy face South Africa after losing their last meeting 32-14",
          "body": "Italy aim to improve their recent record against South Africa after suffering a 32-14 home defeat in November 2025. Currently 11th in the Nations Championship, the Azzurri remain without a win after three matches in the competition. The squad enters the next round looking to recover from a 10-57 loss to Australia. With a points difference of -94 and no victories from three outings, the side seeks its first points of the current campaign."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "Coaching transition",
          "heading": "Dave Butcher leads Scotland women into challenging WXV Global Series campaign",
          "body": "Scotland enters the WXV Global Series under the guidance of interim head coach Dave Butcher following the departure of Sione Fukofuka. Butcher, supported by assistants Chris Laidlaw, Tom Luke, and Robbie Fergusson, inherits a side looking to rebuild after a testing year. With upcoming fixtures against world number three Canada and number two New Zealand at Hive Stadium, the staff must restore the organisation and game plan consistency that have been missing since the recent Women’s Six Nations campaign."
        }
      ]
    },
    "391": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "Coaching scrutiny",
          "heading": "Steve Tandy faces urgent pressure as Wales target key tactical fixes",
          "body": "With only 12 Tests remaining before the Rugby World Cup, Steve Tandy is under pressure to rectify significant performance issues. Critics have directed sustained scrutiny at the team's attack, specifically the selection of a second playmaker at inside centre. With Wales recording only three wins in 12 matches under his leadership, there is an increasing consensus that the side lacks both penetration and direction, necessitating a potential shift in strategy to ensure the pack can provide a platform for an expansive game."
        }
      ]
    },
    "460": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "Fixture news",
          "heading": "Argentina XV to face England A in November fixture at Bath",
          "body": "The Argentina XV have confirmed a non-capped tour match against England 'A', scheduled for 6 November at the Recreation Ground in Bath. This fixture takes place on the same day as the Pumas' Nations Championship test against Ireland in Dublin. The match marks the first meeting between the two nations' secondary sides in nearly two decades, following the Argentina XV's recent second-place finish in the 2026 Americas Rugby Championship. It provides an opportunity for emerging talent to test themselves against elite opposition."
        }
      ]
    },
    "461": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Carter Gordon faces two months out after suffering leg fracture",
          "body": "The Wallabies are set to be without first-choice flyhalf Carter Gordon for the upcoming Test against South Africa and the Bledisloe Cup series. Scans have confirmed a leg fracture sustained during the draw against Argentina, forcing a two-month recovery period. While there is optimism the 25-year-old could return for the England tour, Les Kiss must now evaluate his options. Ben Donaldson remains in the frame, while the impending return of Tom Lynagh offers an alternative during this critical period."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "463": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "Tournament success",
          "heading": "Japan Women retain top spot in Asia Rugby Emirates Sevens Series",
          "body": "The Japan women’s sevens side successfully defended their title at the opening leg of the Asia Rugby Emirates Sevens Series in Suzhou, China. Despite challenging weather conditions across the weekend, Japan proved a class above their rivals, overcoming China 24-7 in the Cup final. The result marks a strong start to the season for the Sakura 7s, maintaining their status as the dominant force in the region while their continental opponents continue to push for parity."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "Selection strategy",
          "heading": "Dave Rennie prepares rotation for final Test after injury-hit Soweto loss",
          "body": "Coach Dave Rennie will inject fresh energy into his side for Saturday’s series finale in Baltimore, with changes planned despite a depleted squad. New Zealand travel to the United States trailing the Springboks 2-1 after their defeat in Soweto. The selection process faces added complexity following injuries to captain Ardie Savea, Luke Jacobson and Quinn Tupaea. Rennie noted that the team would have rotated regardless of the previous result, stating, “We sort of always thought we would make changes in the fourth Test.”"
        }
      ],
      "source": {
        "name": "SA Rugby Magazine"
      }
    },
    "467": {
      "date": "2026-09-09",
      "edition": "Wednesday 9 September",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Morné van den Berg to start as Boks finalise series plans",
          "body": "Morné van den Berg will start at scrum-half in the series decider against the All Blacks, with Rassie Erasmus confirming the Lions playmaker earns his spot after a successful cameo in the third Test. Van den Berg replaces Cobus Reinach in the starting XV, while Damian Willemse returns to the side to replace the injured Cheslin Kolbe. Erasmus noted: \"We think he deserves a start,\" adding that the scrum-half's recovery and impact off the bench have been impressive."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    }
  }
}