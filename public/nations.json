  "digests": {
    "28": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Form tracker",
          "heading": "Fiji seek to end losing streak before facing tough France test",
          "body": "Fiji face a steep challenge in their upcoming Nations Championship fixture against France. The Flying Fijians currently sit bottom of the 12-team table after losing their first three matches of the tournament. The side scored 49 points during those three opening fixtures. The defence conceded 145 points across the same period, which concluded with a 17-33 defeat to Scotland in round three. In their last meeting with France, Fiji suffered a 34-21 away defeat in November 2025."
        }
      ],
      "rung": "data"
    },
    "386": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Scrum-half setback",
          "heading": "Ben Spencer undergoes shoulder surgery to disrupt Steve Borthwick’s autumn plans",
          "body": "Bath scrum-half Ben Spencer is facing a race against time for England's November internationals after undergoing shoulder surgery to address a long-standing issue. His club confirmed the 34-year-old will miss the opening domestic rounds but \"will return later in the autumn.\" This timeline leaves Steve Borthwick with a key selection puzzle ahead of Tests against Australia, Japan, and New Zealand. With Spencer sidelined, Alex Mitchell and Jack van Poortvliet are positioned to spearhead Borthwick’s scrum-half options."
        }
      ],
      "source": {
        "name": "Planet Rugby"
      }
    },
    "387": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Scoring stats",
          "heading": "Fabien Galthié's France average 38 points per game during scoring run",
          "body": "France have scored 426 points over their last 11 fixtures, averaging 38.7 points per game. Fabien Galthié's side conceded 26.5 on average during the same window, which includes a clinical 54-12 victory over Wales away in the Six Nations in February. Les Bleus currently sit third in the Nations Championship standings following their recent win over Japan. Preparation now turns towards the autumn schedule as the squad looks to maintain this offensive productivity."
        }
      ],
      "rung": "data"
    },
    "388": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Injury blow",
          "heading": "Jack Crowley ruled out until new year with lower limb vascular injury",
          "body": "Ireland’s fly-half options are depleted ahead of the November tests following confirmation that Jack Crowley remains sidelined until the new year. Munster head coach Clayton McMillan confirmed the 26-year-old is still recovering from a vascular injury suffered in April, which also saw him miss July's Nations Championship fixtures against Australia, Japan and New Zealand. Crowley has earned 35 caps for Ireland, and McMillan stressed that \"ensuring he gets back to 100% is the priority\" before the playmaker returns to action."
        }
      ],
      "source": {
        "name": "BBC Rugby Union"
      }
    },
    "389": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Form guide",
          "heading": "Italy sit 11th in standings following four consecutive international match defeats",
          "body": "Italy have managed only one win in their last five matches. The side is currently on a run of four straight defeats, including a 10-57 loss away to Australia during the Nations Championship in July. They sit 11th in the 12-team standings after three rounds of the competition. Having failed to secure a victory in the tournament so far, the Azzurri carry a points difference of -94 into the next round of fixtures."
        }
      ],
      "rung": "data"
    },
    "390": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Coaching drama",
          "heading": "Scotland expressed surprise as Sione Fukofuka joins Australia days after resigning",
          "body": "Scottish Rugby officials were reportedly caught off guard after former women’s head coach Sione Fukofuka was unveiled by Australia. The coach resigned his position earlier this month, citing \"family stress\" as the primary reason for his departure. However, his swift appointment by the Wallaroos has sparked frustration within the governing body. The search for a permanent successor remains open as Scotland prepares for upcoming WXV fixtures against Canada, New Zealand and Australia."
        }
      ],
      "match": {
        "venue": "Scottish Gas Murrayfield, Edinburgh"
      },
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "391": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Boardroom crisis",
          "heading": "WRU chief Abi Tierney rejects resignation calls as three-team plan sparks backlash",
          "body": "Welsh Rugby Union chief executive Abi Tierney has dismissed demands for her and the board to step down following criticism from former internationals Tom Shanklin and Jonathan Davies. Tierney told ITV Wales that resigning is not the \"right thing\" as the governing body pushes to reduce Wales' professional regions to three by 2028. She warned that the union cannot sustain four competitive sides and must act to avoid a \"cataclysmic collapse\" of the game. \"We're going to have to make some hard decisions,\" Tierney added."
        }
      ],
      "match": {
        "venue": "Principality Stadium, Cardiff"
      },
      "source": {
        "name": "BBC Rugby Union"
      },
      "rung": "storyline"
    },
    "460": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Felipe Contepomi names unchanged Argentina XV to face rotated Wallabies pack",
          "body": "Felipe Contepomi has rewarded the side that pushed South Africa close, naming an unchanged starting XV for Saturday’s opening Test against Australia in Jujuy. While the run-on group remains intact under captain Pablo Matera, the bench shifts to a five-three split with Rodrigo Martinez and Nicolas Roger promoted to the matchday squad. This selection continuity contrasts with a heavily rotated Wallabies side that has rested regular captain Harry Wilson, as Contepomi looks to build on the defensive grit shown against the Springboks."
        }
      ],
      "match": {
        "venue": "Estadio 23 de Agosto, San Salvador de Jujuy",
        "referee": "Ben O'Keeffe"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "461": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Selection call",
          "heading": "Les Kiss rests Harry Wilson and names Allan Alaalatoa captain against Argentina",
          "body": "Coach Les Kiss has rotated his entire forward pack for Saturday's Test against Argentina in Jujuy, omitting captain Harry Wilson from the matchday 23 entirely. Allan Alaalatoa resumes the captaincy while Rob Valetini shifts to No. 8 to cover Wilson’s absence. Kiss stated the reshaped pack was \"worthwhile exploring\" as he seeks to develop squad depth. Joseph-Aukuso Suaalii returns to the bench after recovering from a minor hamstring strain, while the back three remains unchanged for a fourth consecutive match."
        }
      ],
      "match": {
        "venue": "Salvador de Jujuy"
      },
      "source": {
        "name": "Planet Rugby"
      }
    },
    "463": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "League rule change",
          "heading": "Japan Rugby League One settles legal dispute with revised player eligibility",
          "body": "Japan Rugby League One has amended its proposed player registration categories following a legal challenge from 25 international players. The league will introduce new \"special measures\" allowing players with 30 or more caps for Japan to be reclassified from the restricted Category A-2 to A-1. The JRLO acknowledged that initial communication regarding the changes was insufficient. These revisions, which apply to all players, mark a significant shift after ongoing negotiations at the Tokyo District Courts were settled."
        }
      ],
      "source": {
        "name": "Rugby Asia 247"
      }
    },
    "465": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
          "kicker": "Selection twist",
          "heading": "New Zealand prepares for Springboks shift as Sacha replaces injured Handré",
          "body": "The All Blacks head into today’s Test anticipating a tactical shift after South Africa confirmed Sacha Feinberg-Mngomezulu will replace the injured Handré Pollard at fly-half. While Pollard was expected to anchor a narrow, set-piece-focused gameplan, the introduction of Feinberg-Mngomezulu brings a more expansive skill set to the contest. Dave Rennie has prioritised improvements in the contact area and scrum discipline following a week of communication with World Rugby, noting that the team must lift their level to counter an inevitable home response."
        }
      ],
      "source": {
        "name": "Guardian Rugby Union"
      }
    },
    "467": {
      "date": "2026-08-29",
      "edition": "Saturday 29 August",
      "sections": [
        {
