    "390": {
      "date": "2026-11-16",
      "edition": "Monday 16 November",
      "sections": [
        {
          "kicker": "World rankings",
          "heading": "Scotland close on England in world rankings after Murrayfield win over Australia",
          "body": "World Rugby's men's rankings, as of Sunday, leave Scotland sixth on 85.28 points, with England fifth on 86.99. Neither side moved after Sunday's 15-12 win over Australia at Murrayfield, which left Scotland more than three points clear of the Wallabies, seventh on 82.24. Matt Fagerson and Jack Dempsey scored the tries, with Finn Russell adding a conversion and a late penalty. Scotland remain 1.71 points behind England."
        },
        {
          "kicker": "Around the world",
          "heading": "Wales beat New Zealand 35-28, ending long wait for a win",
          "body": "England recall Furbank, Chessum and Atkinson for All Blacks clash. South Africa's Jesse Kriel signs on in Japan."
        }
      ],
