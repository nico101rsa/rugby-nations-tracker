    "388": {
      "date": "2026-10-01",
      "edition": "Thursday 1 October",
      "sections": [
        {
          "kicker": "Allegiance switch",
          "heading": "Jack Willis opens door to Ireland switch through Belfast grandfather eligibility",
          "body": "Toulouse flanker Jack Willis has hinted at a potential international switch to Ireland to resume his Test career. The 29-year-old, recently crowned the Top 14 Player of the Season for a second consecutive year, remains ineligible for England due to the RFU’s overseas selection policy. Eligible through a grandfather born in Belfast, Willis jokingly told reporters to \"find the way\" around the IRFU's own restrictions on selecting players from abroad. Any formal move would likely require the back rower to join an Irish province before the 2027 World Cup."
        },
        {
          "kicker": "Around the world",
          "heading": "Scotland wing Darcy Graham ruled out for remainder of year",
          "body": "Wallabies name Toby Macpherson in 34-man Bledisloe Cup squad."
        }
      ]
    },
    "389": {
      "date": "2026-10-01",
      "edition": "Thursday 1 October",
      "sections": [
        {
          "kicker": "INVESTMENT TALKS",
          "heading": "Harlequins and Gloucester investment negotiations remain unresolved ahead of Italy's November tests",
          "body": "There have been no further developments today concerning the overseas investment talks involving Premiership clubs Harlequins, Northampton Saints, and Gloucester. These negotiations, first reported on 25 September, remain open as the clubs have yet to confirm a final agreement. In the absence of fresh club news, the Azzurri’s focus remains on the November series. Following the 20 September announcement of the Turin venue, Gonzalo Quesada is preparing for a home return against the Springboks, seeking to improve on a winless Nations Championship record."
        },
        {
          "kicker": "Around the world",
          "heading": "Scotland wing Darcy Graham ruled out for remainder of year",
          "body": "Wallabies name Toby Macpherson in 34-man Bledisloe Cup squad."
